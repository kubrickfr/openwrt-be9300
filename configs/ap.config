# AP-shaped build configuration for the GL.iNet Flint 3 (GL-BE9300)
#
# This is the package selection used for the units that the tested-* tags are
# verified on. It is the configuration those test results actually describe.
#
# It is a dumb-AP profile: bridged into an existing network, so firewall4,
# dnsmasq, odhcpd and the nft/netfilter modules are deliberately absent. If you
# want a router, use the tree's default device profile instead.
#
# It contains NO credentials. SSIDs, PSKs, SSH keys and addresses live in a
# files/ overlay which is gitignored and not part of this repository - you
# supply your own, or configure the device after flashing.
#
# Usage:
#   cp configs/ap.config .config && make defconfig && make -j$(nproc)
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
CONFIG_TARGET_qualcommbe_ipq53xx_DEVICE_glinet_gl-be9300=y

# --- device support (also pulled in by DEVICE_PACKAGES, listed for clarity)
CONFIG_PACKAGE_kmod-ath12k=y
CONFIG_PACKAGE_ath12k-firmware-ipq5332-legacy=y
CONFIG_PACKAGE_ath12k-firmware-qcn9274=y
CONFIG_PACKAGE_ipq-wifi-glinet_gl-be9300=y
CONFIG_PACKAGE_kmod-rtl837x-dsa=y
CONFIG_PACKAGE_kmod-phy-realtek=y
CONFIG_PACKAGE_kmod-qrtr-smd=y
# dumpimage: required on-device by the GL.iNet restore path
# (lib/upgrade/glinet-upgrade.sh extracts hlos/rootfs/wifi_fw from the stock
# FIT). It is listed in DEVICE_PACKAGES upstream but does not get selected
# automatically here, so name it explicitly or the stock-restore silently
# has no way to unpack the image.
CONFIG_PACKAGE_dumpimage=y
# ethtool: needed on-device to poke offload settings while debugging
CONFIG_PACKAGE_ethtool=y

# --- wifi stack
# Full hostapd/wpa_supplicant with OpenSSL. NOT wpad-basic-mbedtls, which is
# what `make defconfig` picks if no variant is named: basic drops the EAP
# server (WPA-Enterprise), DPP, SuiteB-192 and WPS-NFC, and ships no
# hostapd_cli. OpenSSL rather than mbedtls because it is hostap's reference
# crypto backend - the mbedtls port is the one that grows corner cases.
# Note this is a house-wide choice: the E8450 and R7800 trees use it too.
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# hostapd_cli / wpa_cli: raise hostapd log level at runtime while debugging
CONFIG_PACKAGE_hostapd-utils=y
CONFIG_PACKAGE_wpa-cli=y

# --- USB storage stack (Flint 3 has one USB 3.0 port)
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_usbutils=y

# --- ksmbd: SMB server in-kernel
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_ksmbd-tools=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_luci-app-ksmbd=y

# --- hd-idle: spin down USB disks
CONFIG_PACKAGE_hd-idle=y

# --- this is an AP, not a router: drop DEFAULT_PACKAGES.router
# include/target.mk adds dnsmasq, firewall4, nftables, kmod-nft-offload,
# odhcp6c, odhcpd-ipv6only, ppp and ppp-mod-pppoe to every image, because
# DEVICE_TYPE defaults to "router". These boxes bridge everything and the
# gateway does DHCP, DNS, firewalling and PPPoE. Dropping dnsmasq also
# removes the rogue-DHCP foot-gun that bit us once. Name resolution is
# unaffected: netifd writes /etc/resolv.conf straight from `option dns` on
# the static interface - it never pointed at 127.0.0.1.
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_nftables is not set
# CONFIG_PACKAGE_nftables-json is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_kmod-ppp is not set
# CONFIG_PACKAGE_kmod-pppoe is not set
# CONFIG_PACKAGE_kmod-pppox is not set
# CONFIG_PACKAGE_kmod-nft-core is not set
# CONFIG_PACKAGE_kmod-nft-fib is not set
# CONFIG_PACKAGE_kmod-nft-nat is not set
# CONFIG_PACKAGE_kmod-nft-offload is not set
# CONFIG_PACKAGE_kmod-nf-conntrack is not set
# CONFIG_PACKAGE_kmod-nf-conntrack-netlink is not set
# CONFIG_PACKAGE_kmod-nf-flow is not set
# CONFIG_PACKAGE_kmod-nf-ipt is not set
# CONFIG_PACKAGE_kmod-nf-log is not set
# CONFIG_PACKAGE_kmod-nf-log6 is not set
# CONFIG_PACKAGE_kmod-nf-nat is not set
# CONFIG_PACKAGE_kmod-nf-reject is not set
# CONFIG_PACKAGE_kmod-nf-reject6 is not set

# --- one TLS stack, not two
# openssl is in the image anyway for wpad and snmpd, so point apk, curl and
# libustream at it and mbedtls drops out completely.
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_LIBCURL_OPENSSL=y
# CONFIG_PACKAGE_apk-mbedtls is not set
# CONFIG_PACKAGE_libustream-mbedtls is not set
# CONFIG_PACKAGE_libmbedtls is not set
# CONFIG_LIBCURL_MBEDTLS is not set

# --- LuCI
# NOT the `luci` / `luci-ssl` collections: all three collections, luci-light
# included, list +luci-app-firewall and +luci-proto-ppp unconditionally and
# would drag back exactly what was just removed. Select the parts instead.
# px5g-standalone rather than px5g-mbedtls: it bundles its own crypto, so
# uhttpd still self-signs a cert without reintroducing libmbedtls.
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_px5g-standalone=y
CONFIG_PACKAGE_luci-theme-argon=y
# luci-mod-dashboard removed on purpose - do not re-add
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_ucode-mod-digest=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-lua=y
# without firewall4 the firewall app would only ever render an error page
# CONFIG_PACKAGE_luci-app-firewall is not set
# CONFIG_PACKAGE_luci-proto-ppp is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# nlbwmon needs conntrack, which left with firewall4
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
# attendedsysupgrade and owut need a build server that knows this target;
# ipq53xx is out of tree, so both are dead weight here
# CONFIG_PACKAGE_luci-app-attendedsysupgrade is not set
# CONFIG_PACKAGE_owut is not set

# --- monitoring, same set as the other house APs
# No collectd / luci-app-statistics: historically flaky here, and the real
# monitoring path is LibreNMS polling SNMP. snmpd-ssl (not -nossl) so
# SNMPv3 auth/priv is available; libopenssl is in the image anyway.
CONFIG_PACKAGE_snmpd-ssl=y
CONFIG_PACKAGE_luci-app-snmpd=y
# prometheus-node-exporter dropped with collectd: LibreNMS polls SNMP

# --- ip-bridge: the `bridge` utility
# Required by /etc/hotplug.d/net/99-wds-vlan192, which re-adds VLAN 192 to the
# dynamic WDS/4addr station port whenever risc-ap re-associates. Without it the
# guard cannot run and everything behind the wireless backhaul (Risco panel,
# constantgardener, bmg clients) goes dark while VLAN 10 still works. Packages
# never survive a sysupgrade, so this MUST be in the image, not apk-added.
CONFIG_PACKAGE_ip-bridge=y

# --- handy on an AP/router
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tree=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_diffutils=y
CONFIG_PACKAGE_patch=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_grep=y
CONFIG_PACKAGE_sed=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_irqbalance=y
# sftp-server lets scp/sftp and file managers work over the dropbear session
CONFIG_PACKAGE_openssh-sftp-server=y
# full tcpdump, not tcpdump-mini: this port still needs packet-level debugging
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_bridge=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FEATURE_LESS_FLAGS=y
CONFIG_BUSYBOX_CONFIG_FEATURE_LESS_REGEXP=y
CONFIG_BUSYBOX_CONFIG_FEATURE_LESS_WINCH=y

# keep the initramfs image too - it is the safety net for TFTP/RAM boots
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# --- crash forensics: this board has no usable serial console, so a boot
# loop or panic is otherwise completely silent. kmod-ramoops keeps dmesg and
# the console in a reserved RAM region across a warm reset and exposes them
# under /sys/fs/pstore on the next boot - readable even from a TFTP/initramfs
# rescue boot. Needs the matching ramoops node in the board DTS
# (0x4da00000, the 1 MB hole between q6-caldb and mlo-global-mem).
CONFIG_PACKAGE_kmod-ramoops=y
# gdbserver + CONFIG_DEBUG: debug symbols and remote gdb, worth the extra
# build time and image size while this port is still crashing.
CONFIG_PACKAGE_gdbserver=y
CONFIG_DEBUG=y

CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_BUILD_LOG=y
CONFIG_INCLUDE_CONFIG=y
CONFIG_PACKAGE_ucode-mod-math=y
