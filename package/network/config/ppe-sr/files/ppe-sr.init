#!/bin/sh /etc/rc.common
# S-R steering lifecycle (WP3-DESIGN §5.4). The boot path keeps the kernel's
# default: the switch binds rtl8_4s OFF (svlan=1 from the managed line in
# /etc/modules.conf) or rtl8_4 (svlan=0), the PPE starts off. This script only
# keeps that line in step with ppe_sr.main.enabled and, with auto_arm, runs
# the daemon that arms after the holdoff, renews the lease, re-arms after a
# benign PPE disarm and logs health. Stopping the service never disarms:
# shutdown is the kernel's (the PPE reboot notifier, then the switch's
# .shutdown), and a stopped daemon falls back to software within one lease.

START=99
USE_PROCD=1

PROG=/usr/sbin/ppe-sr
BOARD=gl.inet,gl-be9300

start_service() {
	local enabled auto_arm

	[ "$(board_name)" = "$BOARD" ] || return 0
	$PROG modconf
	config_load ppe_sr
	config_get_bool enabled main enabled 0
	config_get_bool auto_arm main auto_arm 0
	[ "$enabled" = 1 ] && [ "$auto_arm" = 1 ] || return 0

	procd_open_instance daemon
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	[ "$(board_name)" = "$BOARD" ] || return 0
	procd_add_reload_trigger ppe_sr
	procd_add_raw_trigger "interface.*.up" 3000 /etc/init.d/ppe-sr reload
}

reload_service() {
	start
	procd_send_signal ppe-sr daemon HUP
}
