config ppe_sr 'main'
	# 1: the managed "options rtl8372n_dsa svlan=1" line in /etc/modules.conf
	# (takes effect at the next boot)
	option enabled '0'
	# 1: arm at boot after the holdoff, and re-arm after a benign PPE disarm
	option auto_arm '0'
	# 0: arm to SR_READY only (no offers)
	option offers '1'
	# the switch lease in s (90..86400); the PPE's ends 30 s earlier
	option lease '86400'
	# renew the lease every s (0: never)
	option renew '3600'
	# minimum uptime before an automatic arm, s
	option holdoff '120'
	# automatic re-arms per rolling hour (the boot arm is free)
	option max_rearm '3'
	# set qcom_ppe flow_offload and pppoe_offload to 1 before arming
	option ppe_params '1'
	# stop's forced rung: 'full', or 'nophy' (only after I4-S2a)
	option stop_force 'full'
	# stop reloads rtl8372n_dsa once the PPE is off after a forced rung
	option stop_rewire '1'
	# option hold, option armed_build: written by ppe-sr
	# 1: more than one C-VID in the scope (after I3 P6)
	option ack_multi_cvid '0'
	# ports checked for S-R (I5)
	list ack_port 'lan1'
	list ack_port 'lan2'
	# the scope: <lanN> <U|T> <vid>, and clients: any, or IPv4 addresses
	list class 'lan2 U 1'
	list class 'lan1 T 1'
	list client 'any'
