+/* Apply profile E for the conduit on PPE port @port. Under priv->lock.
+ *
+ * Return: 0 once it is in place and read back, a negative error code
+ * otherwise (with the registers as they were before).
+ */
+static int ppe_offload_egress_apply(struct ppe_offload_priv *priv, u32 port)
+{
+	struct regmap *regmap = priv->ppe_dev->regmap;
+	unsigned int mark = priv->snap_num;
+	u32 tpid, eg_vlan, want_tpid, want_vlan;
+	int ret;
+
+	lockdep_assert_held(&priv->lock);
+
+	if (priv->egress_port == port)
+		return 0;
+	if (priv->egress_failed || priv->egress_port ||
+	    port >= PPE_PORT_EG_VLAN_TBL_ENTRIES)
+		return -EBUSY;
+
+	ret = ppe_offload_snap_save(priv, PPE_EG_VLAN_TPID_ADDR, 1);
+	if (!ret)
+		ret = ppe_offload_snap_save(priv, PPE_PORT_EG_VLAN_TBL_ADDR +
+					    port * PPE_PORT_EG_VLAN_TBL_INC, 1);
+	if (ret)
+		goto fail;
+
+	tpid = priv->snap[mark].val[0];
+	eg_vlan = priv->snap[mark + 1].val[0];
+
+	/* The third word of the emulated tag, and every C-tag insert. */
+	if (FIELD_GET(PPE_EG_VLAN_TPID_CTPID, tpid) != ETH_P_8021Q) {
+		pr_err("ppe_offload: egress C-TPID is %#lx, not 0x8100: no rtl8_4 egress\n",
+		       FIELD_GET(PPE_EG_VLAN_TPID_CTPID, tpid));
+		ret = -EIO;
+		goto fail;
+	}
+
+	want_tpid = (tpid & ~PPE_EG_VLAN_TPID_STPID) |
+		    FIELD_PREP(PPE_EG_VLAN_TPID_STPID, ETH_P_REALTEK);
+	/* PCP and DEI of the inserts are the protocol byte's top bits in
+	 * the head tag's first word and ALLOW plus mask bits in its last:
+	 * nothing from the ingress tag may be propagated into them (both
+	 * are clear at reset; whether hardware then writes zero is for the
+	 * bench, with PCP and DEI set on the WAN frames).
+	 */
+	want_vlan = (eg_vlan | PPE_PORT_EG_VLAN_TBL_VLAN_TYPE) &
+		    ~(PPE_PORT_EG_VLAN_TBL_PCP_PROP_CMD | PPE_PORT_EG_VLAN_TBL_DEI_PROP_CMD);
+
+	ret = regmap_write(regmap, PPE_EG_VLAN_TPID_ADDR, want_tpid);
+	if (!ret)
+		ret = regmap_write(regmap, PPE_PORT_EG_VLAN_TBL_ADDR +
+				   port * PPE_PORT_EG_VLAN_TBL_INC, want_vlan);
+	if (!ret)
+		ret = regmap_read(regmap, PPE_EG_VLAN_TPID_ADDR, &tpid);
+	if (!ret)
+		ret = regmap_read(regmap, PPE_PORT_EG_VLAN_TBL_ADDR +
+				  port * PPE_PORT_EG_VLAN_TBL_INC, &eg_vlan);
+	if (!ret && (tpid != want_tpid || eg_vlan != want_vlan)) {
+		pr_err("ppe_offload: egress TPID/VLAN type read back %#x/%#x, wrote %#x/%#x\n",
+		       tpid, eg_vlan, want_tpid, want_vlan);
+		ret = -EIO;
+	}
+	if (ret)
+		goto fail;
+
+	WRITE_ONCE(priv->egress_port, port);
+	pr_info("ppe_offload: rtl8_4 head tag emulation on PPE port %u: egress TPIDs %#x, port egress VLAN %#x\n",
+		port, tpid, eg_vlan);
+
+	return 0;
+
+fail:
+	ppe_offload_snap_restore(priv, mark);
+	WRITE_ONCE(priv->egress_failed, true);
+	pr_err("ppe_offload: rtl8_4 egress not set up (%d), flows towards the switch stay in software\n",
+	       ret);
+	return ret;
+}
