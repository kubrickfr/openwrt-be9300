 #define PPE_FLOW_TBL_ROUTE_PORT_VP_VALID	BIT(12)
 #define PPE_FLOW_TBL_ROUTE_PORT_VP		GENMASK(20, 13)
 
+/* TCP-flag exception matchers, in the ingress parser block ("Ingress parse",
+ * 0x1e0000, in ppe_readable_ranges[]). Hardware compares each TCP segment's
+ * flags against eight independent value/mask slots; a hit raises its own
+ * exception, which L3_EXCEPTION_CMD below turns into an action. Eight slots
+ * are packed two per register across four consecutive registers.
+ *
+ * Vendor: IPR_CSR_BASE_ADDR (0x1e0000, its APPE branch) +
+ * L4_EXCEPTION_PARSING_CTRL_{0,1,2,3}_REG_ADDRESS (0x28, 0x2c, 0x30, 0x34).
+ */
+#define PPE_L4_EXCEPTION_PARSING_CTRL_ADDR	0x1e0028
+#define PPE_L4_EXCEPTION_PARSING_CTRL_INC	0x4
+#define PPE_L4_EXCEPTION_TCP_FLAG_SLOTS		8
+
+/* Even slot in the low half of its register, odd slot in the high half. */
+#define PPE_L4_EXCEPTION_TCP_FLAGS_EVEN		GENMASK(5, 0)
+#define PPE_L4_EXCEPTION_TCP_FLAGS_EVEN_MASK	GENMASK(13, 8)
+#define PPE_L4_EXCEPTION_TCP_FLAGS_ODD		GENMASK(21, 16)
+#define PPE_L4_EXCEPTION_TCP_FLAGS_ODD_MASK	GENMASK(29, 24)
+
+/* The six TCP control flags hardware matches on, in their on-the-wire order. */
+#define PPE_TCP_FLAG_FIN			BIT(0)
+#define PPE_TCP_FLAG_SYN			BIT(1)
+#define PPE_TCP_FLAG_RST			BIT(2)
+#define PPE_TCP_FLAG_PSH			BIT(3)
+#define PPE_TCP_FLAG_ACK			BIT(4)
+#define PPE_TCP_FLAG_URG			BIT(5)
+
+/* Per-exception action, and per-exception enable for packets that hit an L3
+ * flow entry. Both are 72-entry arrays indexed by exception code, in IPE_L3.
+ *
+ * Vendor: IPE_L3_BASE_ADDR (0x200000) + L3_EXCEPTION_CMD_ADDRESS (0x81c) and
+ * + L3_EXP_L3_FLOW_CTRL_ADDRESS (0xcdc), both the APPE branch.
+ */
+#define PPE_L3_EXCEPTION_CMD_ADDR		0x20081c
+#define PPE_L3_EXCEPTION_CMD_INC		0x4
+#define PPE_L3_EXCEPTION_ENTRIES		72
+#define PPE_L3_EXCEPTION_CMD_CMD		GENMASK(1, 0)
+#define PPE_L3_EXCEPTION_CMD_DE_ACCE		BIT(2)
+
+#define PPE_L3_EXP_L3_FLOW_CTRL_ADDR		0x200cdc
+#define PPE_L3_EXP_L3_FLOW_CTRL_INC		0x4
+#define PPE_L3_EXP_L3_FLOW_CTRL_EXCEP_EN	BIT(0)
+
+/* On APPE the "any L3 flow" enable above is superseded by a pair that splits
+ * flow hit from flow miss, and the SDK sets the generic one to 0 whenever it
+ * uses them (adpt_hppe_sec_l3_excep_ctrl_set(), "#if defined(APPE)" branch).
+ * Only the hit register is wanted here: an exception must fire for a packet
+ * that matched an offloaded flow, never for one that missed.
+ *
+ * Vendor: IPE_L3_BASE_ADDR (0x200000) + L3_FLOW_HIT_EXP_CTRL_ADDRESS (0x1678).
+ */
+#define PPE_L3_FLOW_HIT_EXP_CTRL_ADDR		0x201678
+#define PPE_L3_FLOW_HIT_EXP_CTRL_INC		0x4
+#define PPE_L3_FLOW_HIT_EXP_CTRL_EXCEP_EN	BIT(0)
+
+/* The flow-MISS half of that APPE split. Wanted off: an exception must fire for
+ * a packet that matched an offloaded flow, never for one that missed -- a miss
+ * goes to the CPU by the ordinary path anyway. Its reset default is documented
+ * as 0, but this driver programs the shared action register for the same
+ * exception codes, so leave nothing to assumption and clear it explicitly.
+ *
+ * Vendor: IPE_L3_BASE_ADDR (0x200000) + L3_FLOW_HIT_MISS_EXP_CTRL_ADDRESS (0x17a8).
+ */
+#define PPE_L3_FLOW_HIT_MISS_EXP_CTRL_ADDR	0x2017a8
+#define PPE_L3_FLOW_HIT_MISS_EXP_CTRL_INC	0x4
+#define PPE_L3_FLOW_HIT_MISS_EXP_CTRL_EXCEP_EN	BIT(0)
+
+/* Action values for PPE_L3_EXCEPTION_CMD_CMD (vendor fal_fwd_cmd_t). */
+#define PPE_L3_EXCEPTION_FORWARD		0
+#define PPE_L3_EXCEPTION_DROP			1
+#define PPE_L3_EXCEPTION_COPY_TO_CPU		2
+#define PPE_L3_EXCEPTION_REDIRECT_TO_CPU	3
+
+/* Exception code of the first TCP-flag slot (vendor FAL_SEC_EXP_TCP_FLAGS_0);
+ * slot n is at PPE_L3_EXCEPTION_TCP_FLAGS_0 + n.
+ */
+#define PPE_L3_EXCEPTION_TCP_FLAGS_0		46
+
+/* Exception code (vendor fal_sec.h FAL_SEC_EXP_*) the parser raises for
+ * an IPv4 fragment, which it cannot classify to an L4 5-tuple the way
+ * software does. Programmed to redirect to the CPU on a flow hit, see
+ * ppe_offload_hdr_exception_init().
+ */
+#define PPE_L3_EXCEPTION_IPV4_FRAG			10
+
 #endif
