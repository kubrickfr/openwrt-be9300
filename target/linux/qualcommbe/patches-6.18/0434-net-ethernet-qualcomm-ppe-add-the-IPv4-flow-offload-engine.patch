+ * Callers that receive a struct net_device * from generic kernel code
+ * (for example a TC/flow-offload action's egress device) must call
+ * this before netdev_priv()-casting it to struct edma_port_priv --
+ * the pointer may belong to a bridge, DSA port, VLAN device, or any
+ * other driver's netdevice entirely.
+ *
+ * Return: true if @netdev is an EDMA port netdevice owned by this driver.
+ */
+bool edma_port_is_edma_netdev(const struct net_device *netdev)
+{
+	return netdev->netdev_ops == &edma_port_netdev_ops;
+}
