+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_sr_cli.h
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * S-R control files, the parsers and printers (WP3-DESIGN §4.2-§4.6): the
+ * verbs of offload_sr, the scope lines of offload_sr_scope, and the lines
+ * of offload_sr, offload_sr_scope and offload_sr_status. Pure (compiles in
+ * user space with -DPPE_SR_PURE, for the desk harness); ppe_sr_ctl.c binds
+ * them to debugfs.
+ */
+
+#ifndef __PPE_SR_CLI_H__
+#define __PPE_SR_CLI_H__
+
+#include <linux/compiler.h>
+#include <linux/stdarg.h>
+#include <linux/types.h>
+
+#include "ppe_sr.h"
+#include "ppe_sr_eng.h"
+
+/* One offload_sr write holds one verb, in fewer bytes than this. */
+#define PPE_SR_CMD_MAX		64
+/* The seconds of arm and deadline. */
+#define PPE_SR_SECS_MIN		PPE_SR_DEADLINE_MIN_S
+#define PPE_SR_SECS_MAX		86400
+/* A scope line, without its newline, is at most this long. */
+#define PPE_SR_SCOPE_LINE_MAX	48
+
+/**
+ * struct ppe_sr_cmd - A parsed offload_sr verb.
+ * @verb: enum ppe_sr_verb.
+ * @on: arm: offers on after arming; offers: on (else off).
+ * @secs: arm, deadline: seconds from now, PPE_SR_SECS_MIN..PPE_SR_SECS_MAX.
+ * @gen: uninhibit: the inhibit generation.
+ */
+struct ppe_sr_cmd {
+	u8 verb;
+	bool on;
+	u32 secs;
+	u32 gen;
+};
+
+/**
+ * struct ppe_sr_scope_edit - An offload_sr_scope file's scope being written.
+ * @scope: The classes and clients given since the last commit (or open),
+ * classes in the order given.
+ * @client_line: A client line was given since then.
+ * @lines: Lines consumed since open.
+ * @bad: The first line with a syntax error, 0 for none: every commit on
+ * this open file fails from then on.
+ * @len: Bytes in @line.
+ * @skip: The line being read is too long: the rest of it is dropped.
+ * @line: The line being read, carried over from one write to the next.
+ */
+struct ppe_sr_scope_edit {
+	struct ppe_sr_scope scope;
+	bool client_line;
+	unsigned int lines;
+	unsigned int bad;
+	unsigned int len;
+	bool skip;
+	char line[PPE_SR_SCOPE_LINE_MAX + 1];
+};
+
+/**
+ * typedef ppe_sr_commit_fn - Puts a committed scope in force.
+ * @ctx: The caller's.
+ * @scope: The scope, sorted and checked (ppe_sr_scope_finish()); NULL for
+ * none, which denies every class.
+ *
+ * Return: 0 or an error, which the write returns.
+ */
+typedef int (*ppe_sr_commit_fn)(void *ctx, const struct ppe_sr_scope *scope);
+
+/**
+ * struct ppe_sr_out - Where the printers write.
+ * @ctx: Passed to @vprintf.
+ * @vprintf: Append a formatted string.
+ */
+struct ppe_sr_out {
+	void *ctx;
+	void (*vprintf)(void *ctx, const char *fmt, va_list ap) __printf(2, 0);
+};
+
+const char *ppe_sr_verb_name(unsigned int verb);
+int ppe_sr_cmd_parse(const char *buf, size_t len, struct ppe_sr_cmd *cmd);
+int ppe_sr_guard_parse(const char *buf, size_t len);
+int ppe_sr_ipv4_parse(const char *s, size_t len, __be32 *addr);
+void ppe_sr_scope_edit_init(struct ppe_sr_scope_edit *e);
+int ppe_sr_scope_finish(struct ppe_sr_scope *scope, bool client_line,
+			const struct ppe_sr_scope **out);
+int ppe_sr_scope_edit_feed(struct ppe_sr_scope_edit *e, const char *buf, size_t len,
+			   ppe_sr_commit_fn commit, void *ctx);
+void ppe_sr_scope_print(const struct ppe_sr_scope *scope, u32 gen, bool u_uploads,
+			const struct ppe_sr_out *out);
+void ppe_sr_ctl_print(const struct ppe_sr_status *st, const struct ppe_sr_out *out);
+void ppe_sr_status_print(const struct ppe_sr_status *st, const struct ppe_sr_out *out);
+
+#endif /* __PPE_SR_CLI_H__ */
