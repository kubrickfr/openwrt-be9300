+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_sr_ctl.c
@@ -0,0 +1,340 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * S-R control files in the PPE's debugfs directory (WP3-DESIGN §4.1):
+ *
+ *   offload_sr         0600  one verb per write; read: one state line
+ *   offload_sr_scope   0600  scope lines and commit; read: the scope in force
+ *   offload_sr_status  0400  the status, from memory: safe under load
+ *   offload_sr_hw      0400  the idle verify and counters: reads registers
+ *   offload_sr_guard   0200  "1": the bounded disarm without RTNL
+ *
+ * The syntax is ppe_sr_cli.c's. A write returns its length, or the error of
+ * what it ran. Locks (WP3-DESIGN §4.1, §4.2): arm takes the parameter lock,
+ * then RTNL (ppe_offload_ctl_lock(), which restarts the write while RTNL is
+ * busy, so that it stays killable), then the offload lock; offers and
+ * deadline the parameter lock, then the offload lock, killably; disarm and
+ * uninhibit the offload lock only, killably; the guard the offload lock
+ * only, for PPE_SR_LOCK_WAIT_S at most. A scope write takes the parameter
+ * lock and RTNL before it parses anything, so that a restart finds the edit
+ * as it was and the writers of one open file are serialized; its commits
+ * run under them. The reads take the offload lock killably and print
+ * outside it; the status and state reads call no register accessor.
+ * ppe_offload_stop() removes these files before it takes any lock.
+ */
+
+#include <linux/array_size.h>
+#include <linux/debugfs.h>
+#include <linux/err.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/seq_file.h>
+#include <linux/sizes.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include "ppe_offload.h"
+#include "ppe_sr.h"
+#include "ppe_sr_cli.h"
+#include "ppe_sr_eng.h"
+
+/* The largest offload_sr_scope write taken at once: a whole scope. */
+#define PPE_SR_CTL_SCOPE_WRITE_MAX	SZ_16K
+/* offload_sr_status's first buffer: the whole status at once. */
+#define PPE_SR_CTL_STATUS_SIZE		SZ_16K
+
+static __printf(2, 0) void ppe_sr_ctl_vprintf(void *ctx, const char *fmt, va_list ap)
+{
+	seq_vprintf(ctx, fmt, ap);
+}
+
+/* The status from memory, the offload lock taken killably. */
+static struct ppe_sr_status *ppe_sr_ctl_status(struct ppe_offload_priv *priv)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	struct ppe_sr_status *st;
+
+	st = kzalloc(sizeof(*st), GFP_KERNEL);
+	if (!st)
+		return ERR_PTR(-ENOMEM);
+	if (mutex_lock_killable(sr->lock)) {
+		kfree(st);
+		return ERR_PTR(-EINTR);
+	}
+	ppe_sr_status_fill(priv, st);
+	ppe_offload_sr_flags(priv, &st->off_enabled, &st->off_degraded, &st->off_tripped);
+	mutex_unlock(sr->lock);
+
+	return st;
+}
+
+/* offload_sr read: "state S td SW/PPE inhibit ... last VERB RET". */
+static int ppe_sr_ctl_show(struct seq_file *m, void *v)
+{
+	const struct ppe_sr_out out = { .ctx = m, .vprintf = ppe_sr_ctl_vprintf };
+	struct ppe_sr_status *st = ppe_sr_ctl_status(m->private);
+
+	if (IS_ERR(st))
+		return PTR_ERR(st);
+	ppe_sr_ctl_print(st, &out);
+	kfree(st);
+
+	return 0;
+}
+
+/* Run one verb (WP3-DESIGN §4.2). */
+static int ppe_sr_ctl_run(struct ppe_offload_priv *priv, const struct ppe_sr_cmd *cmd)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	unsigned long deadline = jiffies + (unsigned long)cmd->secs * HZ;
+	struct ppe_sr_arm_args args;
+	enum ppe_sr_why why;
+	int ret;
+
+	switch (cmd->verb) {
+	case PPE_SR_V_ARM:
+		ret = ppe_offload_ctl_lock(priv, true);
+		if (ret)
+			return ret;
+		args = (struct ppe_sr_arm_args){ .deadline = deadline, .offers = cmd->on };
+		ret = ppe_sr_arm(priv, &args, &why);
+		ppe_offload_ctl_unlock(priv, true);
+		return ret;
+	case PPE_SR_V_OFFERS:
+	case PPE_SR_V_DEADLINE:
+		ret = ppe_offload_ctl_lock(priv, false);
+		if (ret)
+			return ret;
+		if (mutex_lock_killable(sr->lock)) {
+			ret = -EINTR;
+		} else {
+			if (cmd->verb == PPE_SR_V_OFFERS)
+				ret = ppe_sr_offers(priv, cmd->on);
+			else
+				ret = ppe_sr_deadline_set(priv, deadline);
+			mutex_unlock(sr->lock);
+		}
+		ppe_offload_ctl_unlock(priv, false);
+		return ret;
+	case PPE_SR_V_DISARM:
+		return ppe_sr_disarm_ctl(priv);
+	case PPE_SR_V_UNINHIBIT:
+		return ppe_sr_uninhibit(priv, cmd->gen);
+	}
+
+	return -EINVAL;
+}
+
+static ssize_t ppe_sr_ctl_write(struct file *file, const char __user *ubuf, size_t count,
+				loff_t *ppos)
+{
+	struct seq_file *m = file->private_data;
+	struct ppe_offload_priv *priv = m->private;
+	char buf[PPE_SR_CMD_MAX];
+	struct ppe_sr_cmd cmd;
+	int ret;
+
+	if (!count || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	ret = ppe_sr_cmd_parse(buf, count, &cmd);
+	if (ret)
+		return ret;
+	ret = ppe_sr_ctl_run(priv, &cmd);
+	/* A restarted write runs again: it is counted then. */
+	if (ret != -ERESTARTNOINTR)
+		ppe_sr_ctl_note(priv, cmd.verb, ret);
+
+	return ret ? ret : count;
+}
+
+static int ppe_sr_ctl_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, ppe_sr_ctl_show, inode->i_private);
+}
+
+static const struct file_operations ppe_sr_ctl_fops = {
+	.owner = THIS_MODULE,
+	.open = ppe_sr_ctl_open,
+	.read = seq_read,
+	.write = ppe_sr_ctl_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+/**
+ * struct ppe_sr_ctl_scope - An open offload_sr_scope file.
+ * @priv: The offload.
+ * @edit: The scope being written through it.
+ */
+struct ppe_sr_ctl_scope {
+	struct ppe_offload_priv *priv;
+	struct ppe_sr_scope_edit edit;
+};
+
+/* offload_sr_scope read: "gen G", the scope's lines, "u_uploads 0|1". */
+static int ppe_sr_ctl_scope_show(struct seq_file *m, void *v)
+{
+	const struct ppe_sr_out out = { .ctx = m, .vprintf = ppe_sr_ctl_vprintf };
+	struct ppe_sr_ctl_scope *f = m->private;
+	struct ppe_sr *sr = ppe_offload_sr(f->priv);
+	struct ppe_sr_scope *scope;
+	bool set, u_uploads;
+	u32 gen;
+
+	scope = kmalloc(sizeof(*scope), GFP_KERNEL);
+	if (!scope)
+		return -ENOMEM;
+	if (mutex_lock_killable(sr->lock)) {
+		kfree(scope);
+		return -EINTR;
+	}
+	set = ppe_sr_scope_get(f->priv, scope, &gen, &u_uploads);
+	mutex_unlock(sr->lock);
+	ppe_sr_scope_print(set ? scope : NULL, gen, u_uploads, &out);
+	kfree(scope);
+
+	return 0;
+}
+
+/* A commit: under the parameter lock and RTNL (the write's). */
+static int ppe_sr_ctl_commit(void *ctx, const struct ppe_sr_scope *scope)
+{
+	return ppe_sr_scope_set(ctx, scope);
+}
+
+static ssize_t ppe_sr_ctl_scope_write(struct file *file, const char __user *ubuf, size_t count,
+				      loff_t *ppos)
+{
+	struct seq_file *m = file->private_data;
+	struct ppe_sr_ctl_scope *f = m->private;
+	char *buf;
+	int ret;
+
+	if (!count)
+		return 0;
+	if (count > PPE_SR_CTL_SCOPE_WRITE_MAX)
+		return -EINVAL;
+	buf = memdup_user(ubuf, count);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+	/* Before the edit is touched: a restart finds it unchanged. */
+	ret = ppe_offload_ctl_lock(f->priv, true);
+	if (!ret) {
+		ret = ppe_sr_scope_edit_feed(&f->edit, buf, count, ppe_sr_ctl_commit, f->priv);
+		ppe_offload_ctl_unlock(f->priv, true);
+	}
+	kfree(buf);
+
+	return ret ? ret : count;
+}
+
+static int ppe_sr_ctl_scope_open(struct inode *inode, struct file *file)
+{
+	struct ppe_sr_ctl_scope *f;
+	int ret;
+
+	f = kzalloc(sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return -ENOMEM;
+	f->priv = inode->i_private;
+	ppe_sr_scope_edit_init(&f->edit);
+	ret = single_open(file, ppe_sr_ctl_scope_show, f);
+	if (ret)
+		kfree(f);
+
+	return ret;
+}
+
+static int ppe_sr_ctl_scope_release(struct inode *inode, struct file *file)
+{
+	struct seq_file *m = file->private_data;
+	struct ppe_sr_ctl_scope *f = m->private;
+	int ret;
+
+	ret = single_release(inode, file);
+	kfree(f);
+
+	return ret;
+}
+
+static const struct file_operations ppe_sr_ctl_scope_fops = {
+	.owner = THIS_MODULE,
+	.open = ppe_sr_ctl_scope_open,
+	.read = seq_read,
+	.write = ppe_sr_ctl_scope_write,
+	.llseek = seq_lseek,
+	.release = ppe_sr_ctl_scope_release,
+};
+
+/* offload_sr_status read: memory only, whole (WP3-DESIGN §4.6). */
+static int ppe_sr_ctl_status_show(struct seq_file *m, void *v)
+{
+	const struct ppe_sr_out out = { .ctx = m, .vprintf = ppe_sr_ctl_vprintf };
+	struct ppe_sr_status *st = ppe_sr_ctl_status(m->private);
+
+	if (IS_ERR(st))
+		return PTR_ERR(st);
+	ppe_sr_status_print(st, &out);
+	kfree(st);
+
+	return 0;
+}
+
+static int ppe_sr_ctl_status_open(struct inode *inode, struct file *file)
+{
+	return single_open_size(file, ppe_sr_ctl_status_show, inode->i_private,
+				PPE_SR_CTL_STATUS_SIZE);
+}
+
+static const struct file_operations ppe_sr_ctl_status_fops = {
+	.owner = THIS_MODULE,
+	.open = ppe_sr_ctl_status_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+/* offload_sr_hw read: reads registers, idle only (ppe_sr_hw_show()). */
+static int ppe_sr_ctl_hw_show(struct seq_file *m, void *v)
+{
+	return ppe_sr_hw_show(m->private, m);
+}
+DEFINE_SHOW_ATTRIBUTE(ppe_sr_ctl_hw);
+
+static ssize_t ppe_sr_ctl_guard_write(struct file *file, const char __user *ubuf, size_t count,
+				      loff_t *ppos)
+{
+	struct ppe_offload_priv *priv = file->private_data;
+	char buf[2];
+	int ret;
+
+	if (!count || count > sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	ret = ppe_sr_guard_parse(buf, count);
+	if (!ret)
+		ret = ppe_sr_guard(priv);
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations ppe_sr_ctl_guard_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = ppe_sr_ctl_guard_write,
+	.llseek = noop_llseek,
+};
+
+const struct ppe_sr_ctl_file ppe_sr_ctl_files[PPE_SR_CTL_FILES] = {
+	{ .name = "offload_sr", .mode = 0600, .fops = &ppe_sr_ctl_fops },
+	{ .name = "offload_sr_scope", .mode = 0600, .fops = &ppe_sr_ctl_scope_fops },
+	{ .name = "offload_sr_status", .mode = 0400, .fops = &ppe_sr_ctl_status_fops },
+	{ .name = "offload_sr_hw", .mode = 0400, .fops = &ppe_sr_ctl_hw_fops },
+	{ .name = "offload_sr_guard", .mode = 0200, .fops = &ppe_sr_ctl_guard_fops },
+};
