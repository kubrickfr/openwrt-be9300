 }
 
+/**
+ * ppe_offload_sr_flags() - The offload's flags, for the S-R status.
+ * @priv: The offload.
+ * @enabled: Set to whether flows are accepted.
+ * @degraded: Set to whether it latched degraded.
+ * @tripped: Set to whether it tripped.
+ *
+ * Under priv->lock.
+ */
+void ppe_offload_sr_flags(struct ppe_offload_priv *priv, bool *enabled, bool *degraded,
+			  bool *tripped)
+{
