+/* Take back out the entry an add just programmed at @index, in index mode,
+ * and confirm from its slot's VALID bit that it is gone. Under
+ * flow_tbl_lock.
+ *
+ * Return: true if it is gone.
+ */
+static bool ppe_flow_rollback(struct ppe_device *ppe_dev, u32 index)
+{
+	u32 word0;
+
+	if (ppe_flow_tbl_op_wait(ppe_dev, PPE_FLOW_TBL_OP_DEL, PPE_FLOW_OP_MODE_INDEX, &index))
+		return false;
+	if (regmap_read(ppe_dev->regmap, PPE_IN_FLOW_TBL_ADDR + index * PPE_IN_FLOW_TBL_INC,
+			&word0))
+		return false;
+
+	return !(word0 & PPE_FLOW_TBL_VALID);
+}
