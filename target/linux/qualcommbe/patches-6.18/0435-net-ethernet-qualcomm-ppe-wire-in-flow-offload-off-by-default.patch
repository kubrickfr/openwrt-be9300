+/**
+ * edma_port_for_each_netdev() - Call @fn on every registered EDMA port.
+ * @fn: Callback; a non-zero return stops the walk and is returned.
+ * @arg: Passed to @fn.
+ *
+ * Under RTNL, which ports are registered under.
+ *
+ * Return: 0, or the first non-zero return of @fn.
+ */
+int edma_port_for_each_netdev(int (*fn)(struct net_device *netdev, void *arg), void *arg)
+{
+	unsigned int i;
+	int ret;
+
+	ASSERT_RTNL();
+
+	if (!edma_ctx || !edma_ctx->netdev_arr)
+		return 0;
+
+	for (i = 0; i < edma_ctx->hw_info->max_ports; i++) {
+		struct net_device *netdev = edma_ctx->netdev_arr[i];
+
+		if (!netdev)
+			continue;
+		ret = fn(netdev, arg);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
