+	struct edma_port_priv *port_priv = netdev_priv(netdev);
+	u32 l3_if = port_priv->l3_if_index, port = port_priv->ppe_port->port_id;
+	struct ppe_offload_priv *priv = arg;
+	int ret;
+
+	if (!l3_if || l3_if > PPE_MY_MAC_TBL_ENTRIES || port >= PPE_L3_VP_PORT_TBL_ENTRIES)
+		return -ERANGE;
+
+	ret = ppe_offload_snap_save(priv, PPE_IN_L3_IF_TBL_ADDR + l3_if * PPE_IN_L3_IF_TBL_INC,
+				    PPE_IN_L3_IF_TBL_WORDS);
+	if (!ret)
+		ret = ppe_offload_snap_save(priv, PPE_EG_L3_IF_TBL_ADDR +
+					    l3_if * PPE_EG_L3_IF_TBL_INC,
+					    PPE_EG_L3_IF_TBL_WORDS);
+	if (!ret)
+		ret = ppe_offload_snap_save(priv, PPE_MY_MAC_TBL_ADDR +
+					    (l3_if - 1) * PPE_MY_MAC_TBL_INC,
+					    PPE_MY_MAC_TBL_WORDS);
+	if (!ret)
+		ret = ppe_offload_snap_save(priv, PPE_L3_VP_PORT_TBL_ADDR +
+					    port * PPE_L3_VP_PORT_TBL_INC,
+					    PPE_L3_VP_PORT_TBL_WORDS);
+	if (!ret)
+		ret = ppe_offload_snap_save_masked(priv, PPE_MRU_MTU_CTRL_TBL_ADDR +
+						   port * PPE_MRU_MTU_CTRL_TBL_INC,
+						   PPE_OFFLOAD_MRU_MTU_WORDS,
+						   PPE_MRU_MTU_CTRL_W0_MTU_CMD);
+
+	return ret;
+}
+
+/* While offload is on, a frame too big for its egress port goes to the CPU
+ * instead of being dropped (the PPE's setup drops it): what the PPE inserts
+ * itself (a VLAN tag, a switch's head tag) can take a full-size frame past
+ * the port's MTU at zero margin, and a drop there would come after the
+ * flow hit, out of sight of every check. Only the command is changed; the
+ * port's MTU stays the port's. Under RTNL, which MTU changes hold.
+ */
+static int ppe_offload_mtu_cmd_port(struct net_device *netdev, void *arg)
+{
+	struct edma_port_priv *port_priv = netdev_priv(netdev);
+	struct regmap *regmap = port_priv->ppe_port->ppe_dev->regmap;
+	u32 reg = PPE_MRU_MTU_CTRL_TBL_ADDR +
+		  port_priv->ppe_port->port_id * PPE_MRU_MTU_CTRL_TBL_INC;
+	u32 val[PPE_OFFLOAD_MRU_MTU_WORDS];
+	int ret;
+
+	ASSERT_RTNL();
+
+	ret = regmap_bulk_read(regmap, reg, val, ARRAY_SIZE(val));
+	if (ret)
+		return ret;
+	val[0] = (val[0] & ~PPE_MRU_MTU_CTRL_W0_MTU_CMD) |
+		 FIELD_PREP(PPE_MRU_MTU_CTRL_W0_MTU_CMD, PPE_ACTION_REDIRECT_TO_CPU);
+	ret = regmap_bulk_write(regmap, reg, val, ARRAY_SIZE(val));
+	if (!ret)
+		ret = regmap_bulk_read(regmap, reg, val, ARRAY_SIZE(val));
+	if (!ret && FIELD_GET(PPE_MRU_MTU_CTRL_W0_MTU_CMD, val[0]) != PPE_ACTION_REDIRECT_TO_CPU)
+		ret = -EIO;
+	if (ret)
+		netdev_err(netdev, "ppe_offload: port MTU command not set: %d\n", ret);
+
+	return ret;
+}
+
+static int ppe_offload_program_port(struct net_device *netdev, void *arg)
+{
+	int ret;
+
+	ret = edma_port_l3_if_program(netdev);
+	if (!ret)
+		ret = ppe_offload_mtu_cmd_port(netdev, arg);
+
+	return ret;
+}
+
+/* Delete the hardware entry at @index and check that its slot reads back
+ * invalid (the table is readable at its own address, as the vendor's
+ * IN_FLOW_TBL; measured on a GL-BE9300 by Kamil Bienkiewicz's IPv6
+ * entry self-test). Under priv->lock.
+ */
+static int ppe_offload_index_del(struct ppe_offload_priv *priv, u32 index)
+{
+	u32 word0;
+	int ret;
+
+	ret = ppe_flow_entry_del(priv->ppe_dev, index);
+	if (!ret)
+		ret = regmap_read(priv->ppe_dev->regmap, PPE_IN_FLOW_TBL_ADDR +
+				  index * PPE_IN_FLOW_TBL_INC, &word0);
+	if (!ret && (word0 & PPE_FLOW_TBL_VALID))
+		ret = -EIO;
+
+	return ret;
+}
+
+static int ppe_offload_flow_hw_del(struct ppe_offload_priv *priv,
+				   struct ppe_offload_flow_entry *entry)
+{
+	return ppe_offload_index_del(priv, entry->flow_index);
+}
+
+/* @entry's hardware entry could not be deleted and may still forward: no
+ * new flow from now on. Counted and logged once each time the entry
+ * becomes stuck; a withdraw leaves it alone while it is, while a DESTROY,
+ * an unbind, disable and a re-point retry the delete. Under priv->lock.
+ */
+static void ppe_offload_flow_stuck(struct ppe_offload_priv *priv,
+				   struct ppe_offload_flow_entry *entry, int err)
+{
+	priv->degraded = true;
+	if (entry->stuck)
+		return;
+	entry->stuck = true;
+	atomic_long_inc(&priv->counters.stuck);
+	pr_err("ppe_offload: flow entry %u could not be deleted: %d; new flows declined, disable and reboot\n",
+	       entry->flow_index, err);
+}
+
+/* Drop a tracked flow: delete its hardware entry, if it still owns one,
+ * then let go of what it points at. A flow whose entry cannot be deleted
+ * stays tracked, with everything it points at, and latches priv->degraded:
+ * hardware is not doing what it is told, so no further flow is accepted.
+ * Under priv->lock.
+ *
+ * Return: 0 if dropped, a negative error code (logged) if not.
+ */
+static int ppe_offload_flow_drop(struct ppe_offload_priv *priv,
+				 struct ppe_offload_flow_entry *entry)
+{
+	int ret;
+
+	if (entry->flow_valid) {
+		ret = ppe_offload_flow_hw_del(priv, entry);
+		if (ret)
+			ret = ppe_offload_flow_hw_del(priv, entry);
+		if (ret) {
+			ppe_offload_flow_stuck(priv, entry, ret);
+			return ret;
+		}
+	}
+
+	ppe_offload_flow_forget(priv, entry);
+
+	return 0;
+}
+
+/* Drop every tracked flow and the hardware entries it owns. A flow whose
+ * hardware entry cannot be deleted stays tracked, with the nexthop, host
+ * and public IP entries it points at. Under priv->lock.
+ *
+ * Return: the number of flows that could not be dropped, those at an
+ * unknown index (@flows_lost) included.
+ */
+static unsigned int ppe_offload_flush(struct ppe_offload_priv *priv, unsigned int *dropped)
+{
+	struct ppe_offload_flow_entry *entry, *tmp;
+	unsigned int stuck = 0;
+
+	*dropped = 0;
+	list_for_each_entry_safe(entry, tmp, &priv->flows, list) {
+		if (ppe_offload_flow_drop(priv, entry))
+			stuck++;
+		else
+			(*dropped)++;
+	}
+
+	return stuck + priv->flows_lost;
+}
+
+/* Whether the L3 routing failures flow offload relies on reach the CPU:
+ * a flow's source interface not matching (SRC_L3_IF), an MRU or MTU
+ * failure on an L3 interface, and a flow's PMTU failure. They are left as
+ * the PPE resets them (redirect); were any set otherwise, hardware would
+ * forward or drop what software has to see, so offload stays off.
+ */
+static bool ppe_offload_route_ctrl_ok(struct ppe_device *ppe_dev)
+{
+	const u32 cpu = PPE_L3_EXCEPTION_REDIRECT_TO_CPU;
+	u32 ctrl, ext;
+
+	if (regmap_read(ppe_dev->regmap, PPE_L3_ROUTE_CTRL_ADDR, &ctrl) ||
+	    regmap_read(ppe_dev->regmap, PPE_L3_ROUTE_CTRL_EXT_ADDR, &ext))
+		return false;
+
+	if (FIELD_GET(PPE_L3_ROUTE_CTRL_IP_MRU_CHECK_FAIL, ctrl) != cpu ||
+	    FIELD_GET(PPE_L3_ROUTE_CTRL_IP_MTU_FAIL, ctrl) != cpu ||
+	    FIELD_GET(PPE_L3_ROUTE_CTRL_IP_MTU_DF_FAIL, ctrl) != cpu ||
+	    FIELD_GET(PPE_L3_ROUTE_CTRL_FLOW_SRC_IF_CHECK_CMD, ctrl) != cpu ||
+	    FIELD_GET(PPE_L3_ROUTE_CTRL_EXT_FLOW_PMTU_FAIL, ext) != cpu ||
+	    FIELD_GET(PPE_L3_ROUTE_CTRL_EXT_FLOW_PMTU_DF_FAIL, ext) != cpu) {
+		pr_err("ppe_offload: L3 route control %#x/%#x does not send routing failures to the CPU\n",
+		       ctrl, ext);
+		return false;
+	}
+
+	return true;
+}
+
+/* Turn flow offload on. Under RTNL, which ports change their MAC address
+ * and MTU under, and which serializes this against disable.
+ *
+ * Return: 0 when flows are now accepted, a negative error code otherwise
+ * (everything it wrote is then written back).
+ */
+static int ppe_offload_enable(struct ppe_offload_priv *priv)
+{
+	struct ppe_device *ppe_dev = priv->ppe_dev;
+	int ret = 0;
+
+	ASSERT_RTNL();
+
+	mutex_lock(&priv->lock);
+
+	if (priv->enabled)
+		goto unlock;
+
+	if (priv->degraded) {
+		pr_err("ppe_offload: not enabled: an earlier disable left hardware state behind, reboot first\n");
+		ret = -EIO;
+		goto unlock;
+	}
+
+	if (!ppe_offload_route_ctrl_ok(ppe_dev)) {
+		ret = -EIO;
+		goto unlock;
+	}
+
+	/* Every entry enabling may save: the TCP flag parser words, four
+	 * words per exception code, and five per port.
+	 */
+	BUILD_BUG_ON(DIV_ROUND_UP(ARRAY_SIZE(ppe_offload_tcp_exception_flags), 2) +
+		     4 * (ARRAY_SIZE(ppe_offload_tcp_exception_flags) +
+			  ARRAY_SIZE(ppe_offload_hdr_exception_codes)) +
+		     5 * PPE_OFFLOAD_PORTS_MAX > PPE_OFFLOAD_SNAP_MAX);
+
+	priv->snap_num = 0;
+	ret = ppe_offload_snap_exceptions(priv);
+	if (!ret)
+		ret = edma_port_for_each_netdev(ppe_offload_snap_port, priv);
+	if (ret) {
+		/* Nothing was written yet. */
+		priv->snap_num = 0;
+		pr_err("ppe_offload: not enabled: saving the registers it changes failed: %d\n",
+		       ret);
+		goto unlock;
+	}
+
+	priv->tcp_exceptions_ok = ppe_offload_tcp_exception_init(ppe_dev);
+	priv->hdr_exceptions_ok = ppe_offload_hdr_exception_init(ppe_dev);
+
+	ret = edma_port_for_each_netdev(ppe_offload_program_port, NULL);
+	if (ret) {
+		ppe_offload_snap_restore(priv);
+		priv->tcp_exceptions_ok = false;
+		priv->hdr_exceptions_ok = false;
+		pr_err("ppe_offload: not enabled: programming the port L3 interfaces failed: %d\n",
+		       ret);
+		goto unlock;
+	}
+
+	priv->tripped = false;
+	priv->rearm_count = 0;
+	WRITE_ONCE(priv->enabled, true);
+	pr_info("ppe_offload: enabled: TCP exceptions %s, header exceptions %s\n",
+		priv->tcp_exceptions_ok ? "ok" : "FAILED (TCP declined)",
+		priv->hdr_exceptions_ok ? "ok" : "FAILED (all flows declined)");
+
+unlock:
+	mutex_unlock(&priv->lock);
+
+	return ret;
+}
+
+/* Turn flow offload off: decline from now on, delete every hardware entry
+ * this code owns and write the saved registers back. Under RTNL.
+ */
+static void ppe_offload_disable(struct ppe_offload_priv *priv)
+{
+	unsigned int flows, stuck;
+
+	ASSERT_RTNL();
+
+	mutex_lock(&priv->lock);
+
+	if (!priv->enabled) {
+		mutex_unlock(&priv->lock);
+		return;
+	}
+
+	WRITE_ONCE(priv->enabled, false);
+	stuck = ppe_offload_flush(priv, &flows);
+	if (stuck) {
+		/* Those entries may still forward: keep everything they
+		 * rely on (exceptions, port L3 interfaces) as programmed.
+		 */
+		priv->degraded = true;
+		mutex_unlock(&priv->lock);
+		pr_err("ppe_offload: disable incomplete: %u flow entr%s still in hardware, its state kept; offload stays off, reboot to recover\n",
+		       stuck, stuck == 1 ? "y" : "ies");
+		return;
+	}
+	ppe_offload_snap_restore(priv);
+	priv->tcp_exceptions_ok = false;
+	priv->hdr_exceptions_ok = false;
+
+	mutex_unlock(&priv->lock);
+
+	pr_info("ppe_offload: disabled: %u flow(s) back to the software path\n", flows);
+}
+
+/* What the driver tracks, from its own memory only: no register is read,
+ * so this is safe to look at under load. The packet and byte counts are
+ * those of the last statistics request from the flowtable.
+ */
+static int ppe_offload_flows_show(struct seq_file *m, void *v)
+{
+	struct ppe_offload_priv *priv = m->private;
+	struct ppe_offload_flow_entry *entry;
+	unsigned int n = 0;
+
+	mutex_lock(&priv->lock);
+
+	seq_printf(m, "enabled %d degraded %d tripped %d\n",
+		   priv->enabled, priv->degraded, priv->tripped);
+	seq_printf(m, "accepted %ld declined %ld rearmed_superseded %ld rearmed_invalid %ld rearmed_deacce %ld withdrawn %ld unbound %ld stuck %ld\n",
+		   atomic_long_read(&priv->counters.accepted),
+		   atomic_long_read(&priv->counters.declined),
+		   atomic_long_read(&priv->counters.rearmed_superseded),
+		   atomic_long_read(&priv->counters.rearmed_invalid),
+		   atomic_long_read(&priv->counters.rearmed_deacce),
+		   atomic_long_read(&priv->counters.withdrawn),
+		   atomic_long_read(&priv->counters.unbound),
+		   atomic_long_read(&priv->counters.stuck));
+
+	list_for_each_entry(entry, &priv->flows, list) {
+		seq_printf(m, "flow %u: valid %d nexthop %u host %u dsa_port %u packets %llu bytes %llu idle %ums\n",
+			   entry->flow_index, entry->flow_valid, entry->nexthop_index,
+			   entry->host_index,
+			   entry->dsa_fixed ? entry->dsa_index : 0,
+			   entry->stats_packets, entry->stats_bytes,
+			   jiffies_to_msecs(jiffies - entry->lastused));
+		n++;
+	}
+	seq_printf(m, "%u flow(s)\n", n);
+
+	mutex_unlock(&priv->lock);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ppe_offload_flows);
+
+/* The first two words of every tracked flow's hardware entry: VALID and
+ * DE_ACCE. This reads registers, one pair per flow: for the bench, at
+ * idle, never under load.
+ */
+static int ppe_offload_flows_hw_show(struct seq_file *m, void *v)
+{
+	struct ppe_offload_priv *priv = m->private;
+	struct ppe_offload_flow_entry *entry;
+	u32 words[2];
+
+	mutex_lock(&priv->lock);
+	list_for_each_entry(entry, &priv->flows, list) {
+		if (!entry->flow_valid) {
+			seq_printf(m, "flow %u: superseded\n", entry->flow_index);
+			continue;
+		}
+		if (regmap_bulk_read(priv->ppe_dev->regmap, PPE_IN_FLOW_TBL_ADDR +
+				     entry->flow_index * PPE_IN_FLOW_TBL_INC, words,
+				     ARRAY_SIZE(words))) {
+			seq_printf(m, "flow %u: read failed\n", entry->flow_index);
+			continue;
+		}
+		seq_printf(m, "flow %u: valid %d de_acce %d words %08x %08x\n", entry->flow_index,
+			   !!(words[0] & PPE_FLOW_TBL_VALID), !!(words[1] & PPE_FLOW_TBL_DE_ACCE),
+			   words[0], words[1]);
+	}
+	mutex_unlock(&priv->lock);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ppe_offload_flows_hw);
+
+/* The PPE whose offload the parameter switches: one per SoC. Set by
+ * ppe_offload_start() and cleared by ppe_offload_stop(), under
+ * ppe_offload_param_lock, which also orders parameter writes.
+ */
+static struct ppe_offload_priv *ppe_offload_instance;
+static bool ppe_offload_param;
+static DEFINE_MUTEX(ppe_offload_param_lock);
+
+static int ppe_offload_param_set(const char *val, const struct kernel_param *kp)
+{
+	bool on;
+	int ret;
+
+	ret = kstrtobool(val, &on);
+	if (ret)
+		return ret;
+
+	mutex_lock(&ppe_offload_param_lock);
+	if (ppe_offload_instance) {
+		rtnl_lock();
+		if (on)
+			ret = ppe_offload_enable(ppe_offload_instance);
+		else
+			ppe_offload_disable(ppe_offload_instance);
+		rtnl_unlock();
+	}
+	if (!ret)
+		WRITE_ONCE(ppe_offload_param, on);
+	mutex_unlock(&ppe_offload_param_lock);
+
+	return ret;
+}
+
+static int ppe_offload_param_get(char *buffer, const struct kernel_param *kp)
+{
+	return sysfs_emit(buffer, "%c\n", READ_ONCE(ppe_offload_param) ? 'Y' : 'N');
+}
+
+static const struct kernel_param_ops ppe_offload_param_ops = {
+	.set = ppe_offload_param_set,
+	.get = ppe_offload_param_get,
+};
+
+module_param_cb(flow_offload, &ppe_offload_param_ops, NULL, 0644);
+
+/* Offload tripped (ppe_offload_rearm_trip()): turn it off as writing 0 to
+ * the parameter would, unless it was stopped meanwhile.
+ */
+static void ppe_offload_trip_work(struct work_struct *work)
+{
+	struct ppe_offload_priv *priv = container_of(work, struct ppe_offload_priv, trip_work);
+	bool tripped;
+
+	mutex_lock(&ppe_offload_param_lock);
+	if (ppe_offload_instance == priv) {
+		rtnl_lock();
+		/* Not if offload was disabled and enabled again meanwhile:
+		 * enabling clears it, and the parameter lock and RTNL keep it
+		 * from changing again until the disable below.
+		 */
+		mutex_lock(&priv->lock);
+		tripped = priv->tripped;
+		mutex_unlock(&priv->lock);
+		if (tripped) {
+			ppe_offload_disable(priv);
+			WRITE_ONCE(ppe_offload_param, false);
+		}
+		rtnl_unlock();
+	}
+	mutex_unlock(&ppe_offload_param_lock);
+}
+MODULE_PARM_DESC(flow_offload,
+		 "Offload nftables flowtable flows to the PPE (default N; writable at runtime)");
+
+/**
+ * ppe_offload_enabled() - Whether flow offload is on.
+ * @ppe_dev: PPE device.
+ *
+ * Stable under RTNL, which enabling and disabling hold.
+ *
+ * Return: true while flows are accepted and the port L3 interfaces are
+ * programmed.
+ */
+bool ppe_offload_enabled(const struct ppe_device *ppe_dev)
+{
+	return ppe_dev->offload && READ_ONCE(ppe_dev->offload->enabled);
+}
