-				  struct dsa_port *dp, bool vlan_push_seen,
+				  struct dsa_port *dp, bool vlan_push_seen, u16 vlan_push_vid,
 				  struct ppe_offload_egress *egress)
 {
 	const struct dsa_device_ops *tag_ops = dp->cpu_dp->tag_ops;
 	struct net_device *bridge;
 	struct net_device *conduit;
 	bool vlan_aware = false;
+	bool tagged = false;
 	int ret = 0;
 
-	if (vlan_push_seen)
-		return ppe_offload_decline("odev=%s vlan push on a dsa port unsupported",
-					    netdev_name(odev));
-
 	if (dp->cpu_port_in_lag)
 		return ppe_offload_decline("odev=%s conduit is a lag", netdev_name(odev));
 
@@ -854,28 +1028,53 @@ static int ppe_offload_dsa_egress(struct ppe_offload_priv *priv, struct net_devi
 	if (bridge) {
 		vlan_aware = br_vlan_enabled(bridge);
 		egress->bridge_ifindex = bridge->ifindex;
-		/* Routed through the bridge: its MTU is the one the packets
-		 * have to fit, not only the port's.
+		/* Routed through the bridge, or its VLAN 1 upper (the only
+		 * VLAN accepted, ppe_offload_dsa_vlan_ok()): their MTU is the
+		 * one the packets have to fit, not only the port's. Taking the
+		 * upper's when the route went through the bridge itself only
+		 * punts more to the CPU.
 		 */
 		egress->mtu_cap = READ_ONCE(bridge->mtu);
-		/* The switch must bridge the port itself: one it leaves to
-		 * software bridging (it refused the join, or the port has a
-		 * VLAN upper) is a standalone port in hardware, and DSA does
-		 * not track its STP state either.
+		if (vlan_aware) {
+			struct net_device *upper;
+
+			upper = __vlan_find_dev_deep_rcu(bridge, htons(ETH_P_8021Q),
+							 PPE_OFFLOAD_RTL8372N_CPU_VID);
+			if (upper)
+				egress->mtu_cap = min(egress->mtu_cap, READ_ONCE(upper->mtu));
+		}
+		/* The switch must bridge the port itself, with the bridge's
+		 * VLAN filtering: one it leaves to software bridging (it
+		 * refused the join, or the port has a VLAN upper) is a
+		 * standalone port in hardware, and DSA does not track its STP
+		 * state either.
 		 */
 		if (dsa_port_bridge_dev_get(dp) != bridge)
 			ret = ppe_offload_decline("odev=%s bridge not offloaded by the switch",
 						   netdev_name(odev));
+		else if (dsa_port_is_vlan_filtering(dp) != vlan_aware)
+			ret = ppe_offload_decline("odev=%s switch vlan filtering differs from the bridge",
+						   netdev_name(odev));
+		else if (vlan_aware)
+			ret = ppe_offload_dsa_vlan_ok(priv, odev, dp, bridge, vlan_push_seen,
+						      vlan_push_vid, &tagged);
 	}
 	rcu_read_unlock();
 
 	if (ret)
 		return ret;
 
-	if (vlan_aware)
-		return ppe_offload_decline("odev=%s is a port of a vlan-aware bridge",
+	if (vlan_push_seen && !vlan_aware)
+		return ppe_offload_decline("odev=%s vlan push on a dsa port unsupported",
 					    netdev_name(odev));
 
+	/* A bridge port that does not forward is no destination for
