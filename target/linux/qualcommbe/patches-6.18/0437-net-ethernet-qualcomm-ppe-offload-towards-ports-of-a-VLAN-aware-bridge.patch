+/* The VLAN an untagged frame from the CPU is classified to on the
+ * RTL8372N: the rtl8372n driver keeps the CPU port VLAN-unaware with PVID 1
+ * (package/kernel/rtl8372n/src/rtl8372n_vlan.c).
+ */
+#define PPE_OFFLOAD_RTL8372N_CPU_VID	1
+
+/* Whether @dev, port @dp of a VLAN-aware bridge, has PVID 1 and egresses
+ * untagged in VLAN 1 alone: then an untagged flow towards it is in VLAN 1,
+ * where the emulated head tag delivers it and where the FDB follower
+ * looks for its client. There is no exported walk of a port's VLANs, so
+ * every other VID is looked up, and the answer is kept per port until
+ * dsa_gen moves: every change that could alter it (a port's VLANs or
+ * PVID, a bridge join or leave) bumps dsa_gen when it is notified and
+ * again once it is complete, so an answer taken in between is not kept
+ * past it.
+ * Under RCU.
+ */
+static bool ppe_offload_vlan1_untagged_only(struct ppe_offload_priv *priv,
+					    const struct dsa_port *dp,
+					    const struct net_device *dev)
+{
+	struct ppe_offload_vlan1_cache *c = NULL;
+	int gen = atomic_read(&priv->dsa_gen);
+	struct bridge_vlan_info vinfo;
+	bool hit = false, only = false;
+	u16 pvid, vid;
+
+	if (dp->index < ARRAY_SIZE(priv->vlan1_cache)) {
+		c = &priv->vlan1_cache[dp->index];
+		spin_lock_bh(&priv->vlan1_lock);
+		hit = c->ifindex == dev->ifindex && c->gen == gen;
+		only = c->only;
+		spin_unlock_bh(&priv->vlan1_lock);
+		if (hit)
+			return only;
+		only = false;
+	}
+
+	if (br_vlan_get_pvid_rcu(dev, &pvid) || pvid != PPE_OFFLOAD_RTL8372N_CPU_VID)
+		goto out;
+
+	for (vid = 1; vid < VLAN_N_VID - 1; vid++)
+		if (vid != PPE_OFFLOAD_RTL8372N_CPU_VID &&
+		    !br_vlan_get_info_rcu(dev, vid, &vinfo) &&
+		    (vinfo.flags & BRIDGE_VLAN_INFO_UNTAGGED))
+			goto out;
+	only = true;
+
+out:
+	if (c) {
+		spin_lock_bh(&priv->vlan1_lock);
+		c->ifindex = dev->ifindex;
+		c->gen = gen;
+		c->only = only;
+		spin_unlock_bh(&priv->vlan1_lock);
+	}
+
+	return only;
+}
+
+/* Whether a flow may leave through @odev, a port of the VLAN-aware bridge
+ * @bridge, behind the emulated head tag. The tag carries no VLAN and asks
+ * for none (VSEL=0, KEEP=0), and the inserts have no room for a third
+ * tag, so the switch classifies the frame to its CPU port's PVID, VLAN 1
+ * on the rtl8372n driver, and sends it out of the named port tagged or
+ * untagged as VLAN 1's entry says for that port (ORIGINAL egress mode on a
+ * VLAN-aware port, same file). That is only the flow's own VLAN on the wire
+ * when:
+ *
+ * - no VLAN is pushed, the port's PVID is 1 and VLAN 1 is the only VLAN
+ *   it egresses untagged in: the flow is in VLAN 1 (the bridge resolved
+ *   the port for it and leaves it untagged) and leaves untagged, as
+ *   software sends it;
+ * - VLAN 1 is pushed and the port is a tagged member of VLAN 1.
+ *
+ * Anything else (another VID, a second tag, an 802.1ad bridge, another
+ * switch driver) is declined. The bridge must be the one the switch
+ * offloads for the port (ppe_offload_dsa_egress()): a port the switch
+ * driver leaves to software bridging is VLAN-unaware in hardware and
+ * would send the frame untagged whatever the bridge says. The switch
+ * exempts the CPU's frames from its egress membership check, so nothing
+ * downstream would catch a wrong port: membership is checked here when
+ * the flow is accepted, and ppe_offload_switchdev_event() drops the
+ * port's flows whenever its VLANs or STP state change. Under RCU.
+ *
+ * Return: 0 if allowed, a negative error code (declined, logged) if not.
+ */
+static int ppe_offload_dsa_vlan_ok(struct ppe_offload_priv *priv, struct net_device *odev,
+				   struct dsa_port *dp, const struct net_device *bridge,
+				   bool vlan_push_seen, u16 vlan_push_vid, bool *tagged)
+{
+	struct bridge_vlan_info vinfo;
+	u16 proto;
+
+	if (!dp->ds->dev || !of_device_is_compatible(dp->ds->dev->of_node, "realtek,rtl8372n"))
+		return ppe_offload_decline("odev=%s vlan-aware bridge on a switch other than rtl8372n",
+					    netdev_name(odev));
+
+	if (br_vlan_get_proto(bridge, &proto) || proto != ETH_P_8021Q)
+		return ppe_offload_decline("odev=%s bridge vlan protocol not 802.1Q",
+					    netdev_name(odev));
+
+	if (br_vlan_get_info_rcu(odev, PPE_OFFLOAD_RTL8372N_CPU_VID, &vinfo))
+		return ppe_offload_decline("odev=%s not a member of vlan %u",
+					    netdev_name(odev), PPE_OFFLOAD_RTL8372N_CPU_VID);
+
+	if (vlan_push_seen) {
+		if (vlan_push_vid != PPE_OFFLOAD_RTL8372N_CPU_VID)
+			return ppe_offload_decline("odev=%s vlan push %u: only vlan %u can be emulated",
+						    netdev_name(odev), vlan_push_vid,
+						    PPE_OFFLOAD_RTL8372N_CPU_VID);
+		if (vinfo.flags & BRIDGE_VLAN_INFO_UNTAGGED)
+			return ppe_offload_decline("odev=%s vlan push to an untagged member",
+						    netdev_name(odev));
+		*tagged = true;
+	} else {
+		if (!(vinfo.flags & BRIDGE_VLAN_INFO_UNTAGGED))
+			return ppe_offload_decline("odev=%s untagged egress, port tagged in vlan %u",
+						    netdev_name(odev),
+						    PPE_OFFLOAD_RTL8372N_CPU_VID);
+		if (!ppe_offload_vlan1_untagged_only(priv, dp, odev))
+			return ppe_offload_decline("odev=%s untagged egress: pvid not %u or another untagged vlan",
+						    netdev_name(odev),
+						    PPE_OFFLOAD_RTL8372N_CPU_VID);
+		*tagged = false;
+	}
+
+	return 0;
+}
