+	 */
+	if (bridge && READ_ONCE(dp->stp_state) != BR_STATE_FORWARDING)
+		return ppe_offload_decline("odev=%s not forwarding", netdev_name(odev));
+
 	if (tag_ops->proto != DSA_TAG_PROTO_RTL8_4)
 		return ppe_offload_decline("odev=%s tagger %d unsupported", netdev_name(odev),
 					    tag_ops->proto);
@@ -896,11 +1095,23 @@ static int ppe_offload_dsa_egress(struct ppe_offload_priv *priv, struct net_devi
 	egress->dsa_index = dp->index;
 	egress->dsa_ifindex = odev->ifindex;
 	egress->dsa_ds = dp->ds;
+	egress->vlan_aware = vlan_aware;
