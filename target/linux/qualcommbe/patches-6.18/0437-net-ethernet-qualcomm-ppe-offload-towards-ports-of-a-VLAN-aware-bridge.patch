+/* Port-addressed flows go back to software whenever a bridge changes what
+ * it would send them through: a port's VLANs (membership, tagged or not,
+ * PVID), its STP state, or the bridge's VLAN filtering or protocol. The
+ * emulated head tag names a port outright and the switch exempts the CPU's
+ * frames from its egress membership check, so nothing else stops a stale
+ * entry. The switchdev notification arrives under RTNL, in process
+ * context, during the bridge's change: before it for a VLAN added and for
+ * the bridge's VLAN protocol, after it for the bridge's VLAN filtering and
+ * a deleted VLAN's PVID, and for a port's STP state deferred
+ * (SWITCHDEV_F_DEFER), after the bridge applied it, in the pass in which
+ * DSA programs the switch port's state (the software flowtable does not
+ * consult STP either). The second flush from fdb_wq and the generation
+ * count make the result independent of that order. The flows
+ * towards the port it concerns (all of them, for a change to a bridge
+ * itself) are dropped there and then, and again from fdb_wq once the
+ * change is complete, so
+ * that the flowtable's next refresh (within a second while software
+ * forwards them) re-offers them against the bridge as it is now. Coarse
+ * on purpose: these changes are rare, and the cost is a second of software
+ * path for that port's clients.
+ */
+/* Every port: a change to a bridge itself. */
+#define PPE_OFFLOAD_DSA_ALL		BIT(31)
+
+/* The ports a bridge change on @dev concerns, as a mask of switch port
+ * indices. Under RTNL.
+ */
+static u32 ppe_offload_dsa_ports(const struct net_device *dev)
+{
+	struct dsa_port *dp;
+
+	if (!dsa_user_dev_check(dev))
+		return PPE_OFFLOAD_DSA_ALL;
+	dp = dsa_port_from_netdev((struct net_device *)dev);
+	if (IS_ERR(dp) || dp->index >= 31)
+		return PPE_OFFLOAD_DSA_ALL;
+
+	return BIT(dp->index);
+}
+
+static void ppe_offload_dsa_flush(struct ppe_offload_priv *priv, u32 ports)
+{
+	struct ppe_offload_flow_entry *entry;
+	unsigned int dropped = 0, stuck = 0;
+	struct hlist_node *tmp;
+	int bkt;
