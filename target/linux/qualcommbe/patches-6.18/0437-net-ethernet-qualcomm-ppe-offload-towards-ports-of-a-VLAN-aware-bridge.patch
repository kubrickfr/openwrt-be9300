+	atomic_inc(&priv->dsa_gen);
+
+	mutex_unlock(&priv->lock);
+
+	if (stuck)
+		pr_err("ppe_offload: bridge change: %u port-addressed flow entr%s could not be deleted\n",
+		       stuck, stuck == 1 ? "y" : "ies");
+	if (dropped)
+		pr_info_ratelimited("ppe_offload: bridge change: %u port-addressed flow(s) back to software\n",
+				    dropped);
