+ * offer but never accepts one; ppe_sr_eng_offer_lock() decides.
+ *
+ * Return: 0, -EAGAIN while the port's topology awaits its resync (DIRTY),
+ * -EOPNOTSUPP to decline: S-R not active (SR_NOT_ACTIVE, also when the
+ * switch does not say ACTIVE), another conduit (NOT_SR_CONDUIT), a port
+ * outside the S-R port mask (PORT_NOT_ARMED), not forwarding (STP), or the
+ * resolver's reason for no class.
+ */
+int ppe_sr_eng_offer_pre(const struct ppe_sr_eng *eng, const struct ppe_sr_ticket *t,
+			 const struct ppe_sr_topo *topo, int word, struct ppe_sr_offer *o)
+{
+	u16 s_ports;
+
+	o->why = PPE_SR_W_SR_NOT_ACTIVE;
+	if (t->mode != PPE_SR_MODE_SR)
+		return -EOPNOTSUPP;
+	o->why = PPE_SR_W_DIRTY;
+	if (eng_port_dirty(READ_ONCE(eng->dirty), READ_ONCE(eng->dirty_ports), o->port))
+		return -EAGAIN;
+	o->why = PPE_SR_W_NOT_SR_CONDUIT;
+	if (!o->conduit_ok)
+		return -EOPNOTSUPP;
+	o->why = PPE_SR_W_SR_NOT_ACTIVE;
+	if (word < 0 || rtl8_4s_word_state(word) != RTL8_4S_ST_ACTIVE)
+		return -EOPNOTSUPP;
+	o->why = PPE_SR_W_PORT_NOT_ARMED;
+	s_ports = READ_ONCE(eng->s_ports);
+	if (o->port >= PPE_SR_PORTS || !(s_ports & BIT(o->port)))
+		return -EOPNOTSUPP;
+	o->why = PPE_SR_W_STP;
+	if (!o->stp_fwd)
+		return -EOPNOTSUPP;
+	o->why = eng_offer_class(topo, o, &o->cls, &o->mtu_cap);
