+#define PPE_OFFLOAD_SMAC_MAX		4
+#define PPE_OFFLOAD_SMAC_L3_IF_BASE	24
+
+/**
+ * struct ppe_offload_smac - An egress L3 interface for a source MAC address.
+ * @mac: The address.
+ * @mtu: MRU and MTU of its ingress entry, the EDMA port's MTU.
+ * @refs: Flows using it.
+ * @broken: Setting it up or clearing it did not read back; not used again
+ * until offload is enabled again.
+ *
+ * Slot n uses L3 interface PPE_OFFLOAD_SMAC_L3_IF_BASE + n. Under priv->lock.
+ */
+struct ppe_offload_smac {
+	u8 mac[ETH_ALEN];
+	unsigned int mtu;
+	unsigned int refs;
+	bool broken;
+};
