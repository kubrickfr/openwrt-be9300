+/* Write slot @slot's egress and ingress entries empty and read them back.
+ * A slot that does not read back empty is not used again until offload is
+ * enabled again; nothing more is needed: no flow points at it any longer,
+ * its ingress entry routes nothing, and disabling writes the saved entries
+ * back. Under priv->lock.
+ */
+static void ppe_offload_smac_clear(struct ppe_offload_priv *priv, unsigned int slot)
+{
+	const struct ppe_l3_if_eg_entry eg = {};
+	const struct ppe_l3_if_in_entry in = {};
+	u32 l3_if = PPE_OFFLOAD_SMAC_L3_IF_BASE + slot;
+	struct ppe_l3_if_eg_entry eg_back;
+	struct ppe_l3_if_in_entry in_back;
+
+	if (!ppe_l3_if_eg_entry_set(priv->ppe_dev, l3_if, &eg) &&
+	    !ppe_l3_if_in_entry_set(priv->ppe_dev, l3_if, &in) &&
+	    !ppe_l3_if_eg_entry_get(priv->ppe_dev, l3_if, &eg_back) &&
+	    !ppe_l3_if_in_entry_get(priv->ppe_dev, l3_if, &in_back) &&
+	    is_zero_ether_addr(eg_back.mac_addr) && !eg_back.pppoe_en &&
+	    !in_back.mru && !in_back.mtu && !in_back.ipv4_uc_route_en)
+		return;
+
+	priv->smac[slot].broken = true;
+	pr_err("ppe_offload: egress L3 interface %u not cleared; not used again\n", l3_if);
+}
+
+/* The egress L3 interface for flows leaving with source MAC @mac (and an
+ * ingress entry with the port's MTU, unrouted, since no frame arrives on
+ * it), programmed on first use and read back. Under priv->lock.
+ *
+ * Return: 0 with @slot set and a reference taken, a negative error code
+ * otherwise.
+ */
+static int ppe_offload_smac_get(struct ppe_offload_priv *priv, const u8 *mac, unsigned int mtu,
+				unsigned int *slot)
+{
+	struct ppe_l3_if_eg_entry eg = {}, eg_back;
+	struct ppe_l3_if_in_entry in = {}, in_back;
+	struct ppe_offload_smac *p;
+	int i, free = -1;
+	u32 l3_if;
+	int ret;
+
+	mtu = min_t(u32, mtu, FIELD_MAX(PPE_IN_L3_IF_TBL_MTU));
+
+	for (i = 0; i < PPE_OFFLOAD_SMAC_MAX; i++) {
+		p = &priv->smac[i];
+		if (!p->refs) {
+			if (free < 0 && !p->broken)
+				free = i;
+			continue;
+		}
+		if (ether_addr_equal(p->mac, mac) && p->mtu == mtu) {
+			p->refs++;
+			*slot = i;
+			return 0;
+		}
+	}
+
+	if (free < 0)
+		return -ENOSPC;
+
+	l3_if = PPE_OFFLOAD_SMAC_L3_IF_BASE + free;
+	ether_addr_copy(eg.mac_addr, mac);
+	in.mru = mtu;
+	in.mtu = mtu;
+	in.mru_ipv6 = mtu;
+	in.mtu_ipv6 = mtu;
+
+	ret = ppe_l3_if_eg_entry_set(priv->ppe_dev, l3_if, &eg);
+	if (!ret)
+		ret = ppe_l3_if_in_entry_set(priv->ppe_dev, l3_if, &in);
+	if (!ret)
+		ret = ppe_l3_if_eg_entry_get(priv->ppe_dev, l3_if, &eg_back);
+	if (!ret)
+		ret = ppe_l3_if_in_entry_get(priv->ppe_dev, l3_if, &in_back);
+	if (!ret && (!ether_addr_equal(eg_back.mac_addr, mac) || eg_back.pppoe_en ||
+		     in_back.mru != mtu || in_back.mtu != mtu || in_back.ipv4_uc_route_en))
+		ret = -EIO;
+	if (ret) {
+		/* Retired, or every later offer would try it again. */
+		pr_err("ppe_offload: egress L3 interface %u for %pM not set up: %d; not used until offload is enabled again\n",
+		       l3_if, mac, ret);
+		ppe_offload_smac_clear(priv, free);
+		priv->smac[free].broken = true;
+		return ret;
+	}
+
+	p = &priv->smac[free];
+	ether_addr_copy(p->mac, mac);
+	p->mtu = mtu;
+	p->refs = 1;
+	*slot = free;
+	pr_info("ppe_offload: egress L3 interface %u rewrites the source MAC to %pM\n", l3_if, mac);
+
+	return 0;
+}
+
+static void ppe_offload_smac_put(struct ppe_offload_priv *priv, unsigned int slot)
+{
+	struct ppe_offload_smac *p = &priv->smac[slot];
+
+	if (WARN_ON_ONCE(slot >= PPE_OFFLOAD_SMAC_MAX || !p->refs))
+		return;
+
+	if (--p->refs)
+		return;
+
+	memset(p, 0, sizeof(*p));
+	ppe_offload_smac_clear(priv, slot);
+}
