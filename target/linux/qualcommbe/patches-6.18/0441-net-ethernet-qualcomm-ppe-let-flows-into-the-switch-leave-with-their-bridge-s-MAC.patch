@@ -3026,8 +3195,12 @@ static int ppe_offload_flow_replace(struct net_device *netdev,
 	/* A PPPoE upload leaves through the session's L3 interface, which
 	 * adds the PPPoE header with the session ID and the port's MAC.
 	 */
-	nexthop.post_l3_if = pppoe_out ? PPE_OFFLOAD_PPPOE_L3_IF_BASE + pppoe_slot :
-					 port_priv->l3_if_index;
