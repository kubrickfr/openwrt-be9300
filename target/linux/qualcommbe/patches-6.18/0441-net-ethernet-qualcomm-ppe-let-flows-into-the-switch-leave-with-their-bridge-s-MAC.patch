+/* Save the L3 interfaces the source MAC pool may use. */
+static int ppe_offload_snap_smac(struct ppe_offload_priv *priv)
+{
+	unsigned int slot;
+	u32 l3_if;
+	int ret;
+
+	for (slot = 0; slot < PPE_OFFLOAD_SMAC_MAX; slot++) {
+		l3_if = PPE_OFFLOAD_SMAC_L3_IF_BASE + slot;
+		ret = ppe_offload_snap_save(priv, PPE_IN_L3_IF_TBL_ADDR +
+					    l3_if * PPE_IN_L3_IF_TBL_INC,
+					    PPE_IN_L3_IF_TBL_WORDS);
+		if (!ret)
+			ret = ppe_offload_snap_save(priv, PPE_EG_L3_IF_TBL_ADDR +
+						    l3_if * PPE_EG_L3_IF_TBL_INC,
+						    PPE_EG_L3_IF_TBL_WORDS);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
