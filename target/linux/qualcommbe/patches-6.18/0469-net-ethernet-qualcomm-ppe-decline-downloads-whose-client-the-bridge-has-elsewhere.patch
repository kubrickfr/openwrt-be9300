+}
+
+/* Profile E's flows to @move->addr, after its learn on @move->dev, taken to
+ * the port their bridge has the client on when this runs, if not theirs.
+ * Each is re-pointed there if
+ * ppe_offload_fdb_e_target() says the port can take it, and dropped
+ * otherwise: its emulated head tag names the old port, where hardware
+ * would keep sending it (a client gone to the router's Wi-Fi, to a port
+ * of another VLAN form, to a port not forwarding). Software then forwards
+ * it, and the flowtable re-offers it on its original route, which
+ * ppe_offload_fdb_elsewhere() declines, until a gc pass (708) tears it
+ * down for the port the bridge has then. Under RTNL.
+ */
+static void ppe_offload_fdb_move_e(struct ppe_offload_priv *priv,
+				   const struct ppe_offload_fdb_move *move)
+{
+	struct ppe_offload_flow_entry *entry;
+	unsigned int moved = 0, failed = 0, dropped = 0, gone = 0;
+	struct edma_port_priv *port_priv = NULL;
+	struct ppe_nexthop_entry nexthop;
+	struct dsa_port *dp = NULL;
+	struct net_device *bridge, *to;
+	bool vlan_aware, tagged = false;
+	struct hlist_node *tmp;
+	u32 nexthop_index;
+	bool follow;
+
+	ASSERT_RTNL();
+
+	/* The port may have left its bridge while this was queued: that is
+	 * a bridge change, which drops the port's flows by itself.
+	 */
+	bridge = netdev_master_upper_dev_get(move->dev);
+	if (!bridge || !netif_is_bridge_master(bridge) ||
+	    bridge->ifindex != move->bridge_ifindex)
+		return;
+
+	/* A learn in another VLAN is not this client's move: in a
+	 * VLAN-aware bridge, profile E's flows are all in VLAN 1.
+	 */
+	vlan_aware = br_vlan_enabled(bridge);
+	if (move->vid != (vlan_aware ? PPE_OFFLOAD_RTL8372N_CPU_VID : 0))
+		return;
+
+	/* Where the bridge has the client now, not where the learn that
+	 * queued this said: a learn back on the flow's own port while this
+	 * waited queued nothing, and must not see the flow dropped. An
+	 * address the bridge no longer has (aged out, flushed) says nothing.
+	 */
+	to = ppe_offload_fdb_port(dev_net(move->dev), bridge->ifindex, move->addr, move->vid);
+	if (!to)
 		return;
-	port_priv = netdev_priv(conduit);
+
+	follow = ppe_offload_fdb_e_target(priv, to, bridge, vlan_aware, &dp, &tagged, &port_priv);
 
 	mutex_lock(&priv->lock);
 
 	/* Disabled meanwhile: the flows and the egress profile are gone. */
-	if (!priv->enabled || priv->egress_port != port_priv->ppe_port->port_id) {
+	if (!priv->enabled) {
 		mutex_unlock(&priv->lock);
 		return;
 	}
+	if (follow && priv->egress_port != port_priv->ppe_port->port_id)
+		follow = false;
 
 	/* @lock keeps the entries alive; a failed re-point drops its entry. */
 	hash_for_each_possible_safe(priv->dsa_fixed_ht, entry, tmp, dsa_fixed_hnode,
 				    ether_addr_to_u64(move->addr)) {
-		if (entry->sr_mode != PPE_SR_FLOW_NONE ||
-		    !entry->flow_valid || entry->dsa_ds != dp->ds ||
-		    entry->nexthop.port != port_priv->ppe_port->port_id ||
+		if (entry->sr_mode != PPE_SR_FLOW_NONE || !entry->flow_valid ||
 		    entry->dsa_bridge_ifindex != bridge->ifindex ||
 		    entry->dsa_vlan_aware != vlan_aware ||
-		    (vlan_aware && entry->dsa_vlan_tagged != tagged) ||
-		    entry->dsa_ifindex == move->dev->ifindex ||
+		    entry->dsa_ifindex == to->ifindex ||
