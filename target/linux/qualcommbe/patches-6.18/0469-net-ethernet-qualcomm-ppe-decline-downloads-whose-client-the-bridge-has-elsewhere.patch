 		 * or any host on the bridge sending frames with that source)
@@ -4061,7 +4257,7 @@ static void ppe_offload_fdb_move_e(struct ppe_offload_priv *priv,
 		if (ppe_nexthop_pool_get_and_ref(priv->ppe_dev, &priv->nexthop_pool, &nexthop,
