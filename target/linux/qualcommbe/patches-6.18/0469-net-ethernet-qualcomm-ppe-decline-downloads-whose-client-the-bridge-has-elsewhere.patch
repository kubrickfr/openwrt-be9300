 			continue;
 
+		/* Nowhere hardware can take it: back to software. */
+		if (!follow || entry->dsa_ds != dp->ds ||
+		    entry->nexthop.port != port_priv->ppe_port->port_id ||
+		    (vlan_aware && entry->dsa_vlan_tagged != tagged)) {
+			if (ppe_offload_flow_drop(priv, entry))
+				failed++;
