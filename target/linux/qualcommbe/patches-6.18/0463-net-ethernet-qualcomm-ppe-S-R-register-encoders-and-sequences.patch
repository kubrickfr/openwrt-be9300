+/* Ingress VLAN translation: rules matched on a frame's tags as the parser
+ * classified them, each with its action at the same index (vendor
+ * XLT_RULE_TBL and XLT_ACTION_TBL, APPE layouts struct xlt_rule_tbl and
+ * struct xlt_action_tbl, at INGRESS_VLAN_BASE_ADDR 0xf000 + 0x2000 and
+ * + 0x4000). An entry latches when its last word is written. Fields not
+ * defined here (the PCP, DEI and frame type keys, VNI) are left 0.
+ */
+#define PPE_XLT_RULE_TBL_ADDR			0x11000
+#define PPE_XLT_RULE_TBL_ENTRIES		128
+#define PPE_XLT_RULE_TBL_INC			0x10
+#define PPE_XLT_RULE_TBL_WORDS			4
+
+/* Word 0. */
+#define PPE_XLT_RULE_W0_VALID			BIT(0)
+#define PPE_XLT_RULE_W0_PORT_BITMAP		GENMASK(8, 1)
+#define PPE_XLT_RULE_W0_SKEY_FMT		GENMASK(11, 9)
+#define PPE_XLT_RULE_W0_SKEY_VID_INCL		BIT(12)
+#define PPE_XLT_RULE_W0_SKEY_VID		GENMASK(24, 13)
+#define PPE_XLT_RULE_W0_CKEY_FMT_0		BIT(31)
