+/**
+ * ppe_nexthop_entry_decode() - Decode a PPE nexthop table entry.
+ * @val: Its words.
+ * @entry: Filled in; of @port and @vsi only the one @port_valid selects,
+ * the other 0.
+ */
+void ppe_nexthop_entry_decode(const u32 val[PPE_IN_NEXTHOP_TBL_WORDS],
+			      struct ppe_nexthop_entry *entry)
+{
+	u64 mac;
+
+	memset(entry, 0, sizeof(*entry));
+	entry->port_valid = FIELD_GET(PPE_IN_NEXTHOP_TBL_TYPE, val[0]);
+	if (entry->port_valid)
+		entry->port = FIELD_GET(PPE_IN_NEXTHOP_TBL_PORT, val[0]);
+	else
+		entry->vsi = FIELD_GET(PPE_IN_NEXTHOP_TBL_VSI, val[0]);
+	entry->post_l3_if = FIELD_GET(PPE_IN_NEXTHOP_TBL_POST_L3_IF, val[0]);
+	entry->ip_to_me = !!(val[0] & PPE_IN_NEXTHOP_TBL_IP_TO_ME);
+	entry->stag_fmt = !!(val[0] & PPE_IN_NEXTHOP_TBL_STAG_FMT);
+	entry->svid = FIELD_GET(PPE_IN_NEXTHOP_TBL_SVID, val[0]);
+	entry->ctag_fmt = !!(val[0] & PPE_IN_NEXTHOP_TBL_CTAG_FMT);
+
+	entry->cvid = FIELD_GET(PPE_IN_NEXTHOP_TBL_CVID, val[1]);
+	entry->pub_addr_index = FIELD_GET(PPE_IN_NEXTHOP_TBL_PUB_ADDR_INDEX, val[1]);
+
+	mac = (u64)val[2] << 16 | FIELD_GET(PPE_IN_NEXTHOP_TBL_MAC_ADDR_0, val[1]);
+	u64_to_ether_addr(mac, entry->dmac);
+
+	entry->dnat_ip = cpu_to_be32(val[3]);
+}
