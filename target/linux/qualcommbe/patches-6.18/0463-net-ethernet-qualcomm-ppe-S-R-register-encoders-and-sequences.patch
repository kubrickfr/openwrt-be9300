-	for (i = 0; i < 4; i++) {
+	for (i = 0; i < PPE_IN_NEXTHOP_TBL_WORDS; i++) {
 		ret = regmap_write(ppe_dev->regmap, base + i * 4, val[i]);
 		if (ret)
 			return ret;
@@ -96,8 +140,7 @@ int ppe_nexthop_entry_set(struct ppe_device *ppe_dev, u32 index,
