--- /dev/null
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_sr_hw.c
@@ -0,0 +1,413 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * S-R register encoders, see ppe_sr_hw.h. The XLT layouts are the vendor
+ * SDK's APPE struct xlt_rule_tbl and struct xlt_action_tbl
+ * (hppe_portvlan_reg.h); the static asserts below hold them against the
+ * words the PPE gate's probes counted and forwarded with on a GL-BE9300
+ * (P1b: rules R_A, R_B, R_D; P2.1: the L3 interface 32 action).
+ */
+#ifndef RTL8_4S_PURE
+#define RTL8_4S_PURE
+#endif
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/build_bug.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/dsa/rtl8_4s.h>
+
+#include "ppe_regs.h"
+#include "ppe_sr_hw.h"
+
+static_assert(PPE_SR_XLT_LAST < PPE_XLT_RULE_TBL_ENTRIES);
+static_assert(PPE_SR_XLT_LAST < PPE_VLAN_DEV_CNT_TBL_ENTRIES);
+static_assert(PPE_SR_XLT_LAST - PPE_SR_XLT_FIRST + 1 >= PPE_SR_ID_MAX);
+static_assert(PPE_SR_L3IF_LAST < PPE_IN_L3_IF_TBL_ENTRIES);
+static_assert(PPE_SR_L3IF_LAST - PPE_SR_L3IF_FIRST + 1 >= PPE_SR_ID_MAX);
+/* Every identity's L3 interface fits an XLT action's source information
+ * and a flow entry's SRC_L3_IF, and the U EtherType PROT_VALUE: an overflow
+ * fails FIELD_PREP_CONST() at build time.
+ */
+static_assert(FIELD_PREP_CONST(PPE_XLT_ACTION_W1_SRC_INFO, PPE_SR_L3IF_LAST));
+static_assert(FIELD_PREP_CONST(PPE_FLOW_TBL_SRC_L3_IF, PPE_SR_L3IF_LAST));
+static_assert(FIELD_PREP_CONST(PPE_XLT_RULE_W2_PROT_VALUE_1, PPE_SR_U_PROT >> 7));
+
+/* The CPU port fields, against the words read on the GL-BE9300 under E and
+ * written by bench profile S (P1b, P2.1).
+ */
+static_assert(((0x134 & ~PPE_SR_CPU_EG_MASK) | PPE_SR_CPU_EG_SR) == 0x11f);
+static_assert((0x134 & PPE_SR_CPU_EG_MASK) == PPE_SR_CPU_EG_E);
+static_assert(((0x11f & ~PPE_SR_CPU_EG_MASK) | PPE_SR_CPU_EG_E) == 0x134);
+static_assert(PPE_SR_PARSER_TPIDS == (FIELD_PREP_CONST(PPE_VLAN_TPID_STAG, 0x88a8) |
+				      FIELD_PREP_CONST(PPE_VLAN_TPID_CTAG, 0x8100)));
+static_assert((PPE_L3_VP_PORT_TBL_L3_IF_VALID |
+	       FIELD_PREP_CONST(PPE_L3_VP_PORT_TBL_L3_IF_INDEX, 1)) == 0x3);
+
+/* The rule fields that depend on neither the port, the S-VID nor the class:
+ * S-tagged with its VID keyed. P1b's R_A (PPE port 1, S-VID 3906, C
+ * untagged, no EtherType key), which counted lan2's frames, is that with
+ * the C format's low bit set; R_B (C 3901) and R_D (S 3907, C 1) are T
+ * rules.
+ */
+#define PPE_SR_RULE_W0	(PPE_XLT_RULE_W0_VALID |						\
+			 FIELD_PREP_CONST(PPE_XLT_RULE_W0_SKEY_FMT, PPE_XLT_FMT_TAGGED) |	\
+			 PPE_XLT_RULE_W0_SKEY_VID_INCL)
+static_assert((PPE_SR_RULE_W0 | FIELD_PREP_CONST(PPE_XLT_RULE_W0_PORT_BITMAP, BIT(1)) |
+	       FIELD_PREP_CONST(PPE_XLT_RULE_W0_SKEY_VID, 3906) |
+	       FIELD_PREP_CONST(PPE_XLT_RULE_W0_CKEY_FMT_0, PPE_XLT_FMT_UNTAGGED & 1)) ==
+	      0x81e85805);
+static_assert((FIELD_PREP_CONST(PPE_XLT_RULE_W1_CKEY_FMT_1, PPE_XLT_FMT_TAGGED >> 1) |
+	       PPE_XLT_RULE_W1_CKEY_VID_INCL | FIELD_PREP_CONST(PPE_XLT_RULE_W1_CKEY_VID, 3901)) ==
+	      0x79ee);
+static_assert((PPE_SR_RULE_W0 | FIELD_PREP_CONST(PPE_XLT_RULE_W0_PORT_BITMAP, BIT(1)) |
+	       FIELD_PREP_CONST(PPE_XLT_RULE_W0_SKEY_VID, 3907)) == 0x01e87805);
+
+/* The action: source information L3 interface 32, counter 5 (P2.1). */
+static_assert((PPE_XLT_ACTION_W1_SRC_INFO_VALID |
+	       FIELD_PREP_CONST(PPE_XLT_ACTION_W1_SRC_INFO_TYPE, PPE_XLT_SRC_INFO_TYPE_L3_IF) |
+	       FIELD_PREP_CONST(PPE_XLT_ACTION_W1_SRC_INFO, 32) | PPE_XLT_ACTION_W1_COUNTER_EN |
+	       FIELD_PREP_CONST(PPE_XLT_ACTION_W1_COUNTER_ID_0, 5)) == 0xb20c0000);
+
+/* What puts an ingress L3 interface to use: routing IPv4 or IPv6 unicast, a
+ * MAC_BITMAP that makes MY_MAC entries its own, PPPoE termination. With none
+ * of them an entry is inert, whatever its other fields hold (the GL-BE9300
+ * boots with MRU and MTU 1500 and TTL_EXCEED_CMD 1 in each unused entry).
+ */
+#define PPE_SR_L3IF_USE_W0	(PPE_IN_L3_IF_TBL_IPV4_UC_ROUTE_EN |			\
+				 PPE_IN_L3_IF_TBL_IPV6_UC_ROUTE_EN)
+#define PPE_SR_L3IF_USE_W1	(PPE_IN_L3_IF_TBL_MAC_BITMAP | PPE_IN_L3_IF_TBL_PPPOE_EN)
+/* What an identity's copy of the conduit's interface leaves out: IPv6
+ * routing, PPPoE termination, the DMAC check bypass and the VPN.
+ */
+#define PPE_SR_L3IF_CLR_W0	PPE_IN_L3_IF_TBL_IPV6_UC_ROUTE_EN
+#define PPE_SR_L3IF_CLR_W1	(PPE_IN_L3_IF_TBL_PPPOE_EN | PPE_IN_L3_IF_TBL_DMAC_CHECK_DIS |	\
+				 PPE_IN_L3_IF_TBL_VPN_ID)
+
+/* Against the live words: an unused entry and the conduit's (L3 interface
+ * 1, PPE port 1) and the PPPoE session's.
+ */
+static_assert(!(0x017705dc & PPE_SR_L3IF_USE_W0) && !(0x17700001 & PPE_SR_L3IF_USE_W1));
+static_assert((0x217905e4 & PPE_SR_L3IF_USE_W0) && (0x1790000b & PPE_SR_L3IF_USE_W1));
+static_assert(0x17700813 & PPE_SR_L3IF_USE_W1);
+
+/**
+ * ppe_sr_xlt_key_of() - The XLT key of a class.
+ * @cls: The class.
+ * @ppe_port: The conduit's PPE port.
+ * @k: Filled in.
+ */
+void ppe_sr_xlt_key_of(const struct ppe_sr_class *cls, u8 ppe_port, struct ppe_sr_xlt_key *k)
+{
+	k->ppe_port = ppe_port;
+	k->svid = rtl8_4s_svid_up(cls->port);
+	k->form = cls->form;
+	k->cvid = cls->form == PPE_SR_T ? cls->vid : 0;
+	k->prot = cls->form == PPE_SR_U;
+}
+
+/**
+ * ppe_sr_xlt_rule_enc() - Encode an identity's XLT rule.
+ * @k: What it matches.
+ * @w: Its words.
+ *
+ * Only the exact keys S-R uses are encoded: S-tagged with an upload S-VID,
+ * and either C-untagged with the EtherType key (U) or C-tagged with a C-VID
+ * that a class may have (T). Every field not named is 0: no PCP, DEI or
+ * frame type key, PORT_TYPE 0 (a bitmap of physical ports).
+ *
+ * Return: 0, or -EINVAL for any other key (@w then untouched).
+ */
+int ppe_sr_xlt_rule_enc(const struct ppe_sr_xlt_key *k, u32 w[PPE_XLT_RULE_TBL_WORDS])
+{
+	u8 cfmt;
+
+	if (k->ppe_port >= PPE_PORT_PARSING_ENTRIES || rtl8_4s_up_port(k->svid) < 0)
+		return -EINVAL;
+	switch (k->form) {
+	case PPE_SR_U:
+		if (!k->prot || k->cvid)
+			return -EINVAL;
+		cfmt = PPE_XLT_FMT_UNTAGGED;
+		break;
+	case PPE_SR_T:
+		if (k->prot || !k->cvid || k->cvid >= 4095 || rtl8_4s_vid_reserved(k->cvid))
+			return -EINVAL;
+		cfmt = PPE_XLT_FMT_TAGGED;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	w[0] = PPE_SR_RULE_W0 | FIELD_PREP(PPE_XLT_RULE_W0_PORT_BITMAP, BIT(k->ppe_port)) |
+	       FIELD_PREP(PPE_XLT_RULE_W0_SKEY_VID, k->svid) |
+	       FIELD_PREP(PPE_XLT_RULE_W0_CKEY_FMT_0, cfmt & 1);
+	w[1] = FIELD_PREP(PPE_XLT_RULE_W1_CKEY_FMT_1, cfmt >> 1);
+	w[2] = 0;
+	w[3] = 0;
+	if (k->form == PPE_SR_T) {
+		w[1] |= PPE_XLT_RULE_W1_CKEY_VID_INCL |
+			FIELD_PREP(PPE_XLT_RULE_W1_CKEY_VID, k->cvid);
+	} else {
+		w[1] |= PPE_XLT_RULE_W1_PROT_INCL |
+			FIELD_PREP(PPE_XLT_RULE_W1_PROT_VALUE_0, PPE_SR_U_PROT & 0x7f);
+		w[2] |= FIELD_PREP(PPE_XLT_RULE_W2_PROT_VALUE_1, PPE_SR_U_PROT >> 7);
+	}
+
+	return 0;
+}
+
+/**
+ * ppe_sr_xlt_rule_dec() - Decode an XLT rule.
+ * @w: Its words.
+ * @k: Filled in from the fields S-R uses: the lowest port of the bitmap
+ * (0xff for none), the S-VID and C-VID keys (0 when not keyed), @form
+ * PPE_SR_U for a C-untagged key, PPE_SR_T for a C-tagged one, else 0xff, and
+ * @prot whether an EtherType is keyed.
+ * @exact: Set when the rule is exactly one S-R encodes: ppe_sr_xlt_rule_enc()
+ * of @k gives @w, every word and bit.
+ *
+ * Return: 0 for a valid rule, -ENOENT for one whose VALID bit is clear
+ * (@k then undefined, @exact false).
+ */
+int ppe_sr_xlt_rule_dec(const u32 w[PPE_XLT_RULE_TBL_WORDS], struct ppe_sr_xlt_key *k,
+			bool *exact)
+{
+	u32 re[PPE_XLT_RULE_TBL_WORDS];
+	unsigned int bitmap, i;
+	u8 cfmt;
+
+	*exact = false;
+	if (!(w[0] & PPE_XLT_RULE_W0_VALID))
+		return -ENOENT;
+
+	bitmap = FIELD_GET(PPE_XLT_RULE_W0_PORT_BITMAP, w[0]);
+	k->ppe_port = 0xff;
+	for (i = 0; i < PPE_PORT_PARSING_ENTRIES; i++) {
+		if (bitmap & BIT(i)) {
+			k->ppe_port = i;
+			break;
+		}
+	}
+	k->svid = 0;
+	if (w[0] & PPE_XLT_RULE_W0_SKEY_VID_INCL)
+		k->svid = FIELD_GET(PPE_XLT_RULE_W0_SKEY_VID, w[0]);
+	cfmt = FIELD_GET(PPE_XLT_RULE_W0_CKEY_FMT_0, w[0]) |
+	       FIELD_GET(PPE_XLT_RULE_W1_CKEY_FMT_1, w[1]) << 1;
+	if (cfmt == PPE_XLT_FMT_UNTAGGED)
+		k->form = PPE_SR_U;
+	else if (cfmt == PPE_XLT_FMT_TAGGED)
+		k->form = PPE_SR_T;
+	else
+		k->form = 0xff;
+	k->cvid = 0;
+	if (w[1] & PPE_XLT_RULE_W1_CKEY_VID_INCL)
+		k->cvid = FIELD_GET(PPE_XLT_RULE_W1_CKEY_VID, w[1]);
+	k->prot = !!(w[1] & PPE_XLT_RULE_W1_PROT_INCL);
+
+	*exact = !ppe_sr_xlt_rule_enc(k, re) && !memcmp(re, w, sizeof(re));
+
+	return 0;
+}
+
+/**
+ * ppe_sr_xlt_rule_on_port() - Whether an XLT rule may match a PPE port's
+ * frames.
+ * @w: Its words.
+ * @ppe_port: The port.
+ *
+ * Return: true for a valid rule whose port bitmap names @ppe_port, and for
+ * a valid rule whose PORT_TYPE makes the bitmap a VP profile or a VP ID
+ * (which ports those name is not known here).
+ */
+bool ppe_sr_xlt_rule_on_port(const u32 w[PPE_XLT_RULE_TBL_WORDS], u8 ppe_port)
+{
+	if (!(w[0] & PPE_XLT_RULE_W0_VALID))
+		return false;
+
+	return FIELD_GET(PPE_XLT_RULE_W2_PORT_TYPE, w[2]) ||
+	       (ppe_port < PPE_PORT_PARSING_ENTRIES &&
+		(FIELD_GET(PPE_XLT_RULE_W0_PORT_BITMAP, w[0]) & BIT(ppe_port)));
+}
+
+/**
+ * ppe_sr_xlt_act_enc() - Encode an identity's XLT action.
+ * @l3_if: The ingress L3 interface it gives the frame (source information
+ * of type L3 interface).
+ * @counter: The VLAN_DEV_CNT entry it counts the frame in.
+ * @w: Its words: no VID, PCP, DEI or VSI command, so the frame's tags stay
+ * as they are.
+ *
+ * Return: 0, or -EINVAL for a counter past the table (@w then untouched).
+ */
+int ppe_sr_xlt_act_enc(u8 l3_if, u8 counter, u32 w[PPE_XLT_ACTION_TBL_WORDS])
+{
+	if (counter >= PPE_VLAN_DEV_CNT_TBL_ENTRIES)
+		return -EINVAL;
+
+	w[0] = 0;
+	w[1] = PPE_XLT_ACTION_W1_SRC_INFO_VALID |
+	       FIELD_PREP(PPE_XLT_ACTION_W1_SRC_INFO_TYPE, PPE_XLT_SRC_INFO_TYPE_L3_IF) |
+	       FIELD_PREP(PPE_XLT_ACTION_W1_SRC_INFO, l3_if) | PPE_XLT_ACTION_W1_COUNTER_EN |
+	       FIELD_PREP(PPE_XLT_ACTION_W1_COUNTER_ID_0, counter & 7);
+	w[2] = FIELD_PREP(PPE_XLT_ACTION_W2_COUNTER_ID_1, counter >> 3);
+
+	return 0;
+}
+
+/**
+ * ppe_sr_xlt_act_counter() - The counter an XLT action counts in.
+ * @w: Its words.
+ *
+ * Return: the VLAN_DEV_CNT index, or -ENOENT if the action counts nothing.
+ */
+int ppe_sr_xlt_act_counter(const u32 w[PPE_XLT_ACTION_TBL_WORDS])
+{
+	if (!(w[1] & PPE_XLT_ACTION_W1_COUNTER_EN))
+		return -ENOENT;
+
+	return FIELD_GET(PPE_XLT_ACTION_W2_COUNTER_ID_1, w[2]) << 3 |
+	       FIELD_GET(PPE_XLT_ACTION_W1_COUNTER_ID_0, w[1]);
+}
+
+/**
+ * ppe_sr_l3if_inert() - Whether an ingress L3 interface is out of use.
+ * @w: Its words.
+ *
+ * Return: true when it routes neither IPv4 nor IPv6, selects no MY_MAC entry
+ * and terminates no PPPoE, whatever else it holds.
+ */
+bool ppe_sr_l3if_inert(const u32 w[PPE_IN_L3_IF_TBL_WORDS])
+{
+	return !(w[0] & PPE_SR_L3IF_USE_W0) && !(w[1] & PPE_SR_L3IF_USE_W1);
+}
+
+/**
+ * ppe_sr_l3if_copy() - An identity's ingress L3 interface.
+ * @tmpl: The conduit's ingress L3 interface.
+ * @copy: Set to @tmpl without IPv6 routing, PPPoE termination, the DMAC
+ * check bypass and the VPN; MRU and MTU are the conduit's, so that a frame
+ * too large for the conduit goes to the CPU.
+ *
+ * Return: 0, or -EINVAL if the copy would not route IPv4 to the conduit's
+ * MAC address (no IPv4 routing or an empty MAC_BITMAP in @tmpl).
+ */
+int ppe_sr_l3if_copy(const u32 tmpl[PPE_IN_L3_IF_TBL_WORDS], u32 copy[PPE_IN_L3_IF_TBL_WORDS])
+{
+	if (!(tmpl[0] & PPE_IN_L3_IF_TBL_IPV4_UC_ROUTE_EN) ||
+	    !FIELD_GET(PPE_IN_L3_IF_TBL_MAC_BITMAP, tmpl[1]))
+		return -EINVAL;
+
+	copy[0] = tmpl[0] & ~PPE_SR_L3IF_CLR_W0;
+	copy[1] = tmpl[1] & ~PPE_SR_L3IF_CLR_W1;
+	copy[2] = tmpl[2];
+
+	return 0;
+}
+
+/**
+ * ppe_sr_stpid() - The egress TPID register with E's or S-R's S-TPID.
+ * @val: The register.
+ * @sr: S-R's (0x88a8) rather than E's (0x8899).
+ *
+ * Return: @val with its S-TPID field set, the C-TPID as it is.
+ */
+u32 ppe_sr_stpid(u32 val, bool sr)
+{
+	return (val & ~PPE_SR_STPID_MASK) |
+	       FIELD_PREP(PPE_SR_STPID_MASK, sr ? PPE_SR_STPID_SR : PPE_SR_STPID_E);
+}
+
+/**
+ * ppe_sr_cpu_eg() - The CPU port's egress VLAN register under E or S-R.
+ * @val: The register.
+ * @sr: S-R's fields rather than E's.
+ *
+ * Return: @val with the PPE_SR_CPU_EG_MASK fields set, TX counting and PCP
+ * and DEI propagation as they are.
+ */
+u32 ppe_sr_cpu_eg(u32 val, bool sr)
+{
+	return (val & ~PPE_SR_CPU_EG_MASK) | (sr ? PPE_SR_CPU_EG_SR : PPE_SR_CPU_EG_E);
+}
+
+/**
+ * ppe_sr_conduit_eg_ok() - Whether the conduit's egress VLAN register is as
+ * profile E sets it: S-type, no PCP or DEI propagation (0x135 on the
+ * GL-BE9300). S-R does not change it.
+ * @val: The register.
+ *
+ * Return: true if so.
+ */
+bool ppe_sr_conduit_eg_ok(u32 val)
+{
+	return (val & PPE_PORT_EG_VLAN_TBL_VLAN_TYPE) &&
+	       !(val & (PPE_PORT_EG_VLAN_TBL_PCP_PROP_CMD | PPE_PORT_EG_VLAN_TBL_DEI_PROP_CMD));
+}
+
+/**
+ * ppe_sr_ctype_eg_ok() - Whether another port's egress VLAN register is
+ * C-type, so that its tags do not follow the S-TPID S-R moves.
+ * @val: The register.
+ *
+ * Return: true if so.
+ */
+bool ppe_sr_ctype_eg_ok(u32 val)
+{
+	return !(val & PPE_PORT_EG_VLAN_TBL_VLAN_TYPE);
+}
+
+/**
+ * ppe_sr_bind() - An L3_VP_PORT_TBL word 0 with a binding.
+ * @w0: The word.
+ * @l3_if: The L3 interface it binds to.
+ * @valid: Whether the binding is valid.
+ *
+ * Return: @w0 with its PPE_SR_BIND_MASK fields set, the source guard fields
+ * as they are.
+ */
+u32 ppe_sr_bind(u32 w0, u8 l3_if, bool valid)
+{
+	return (w0 & ~PPE_SR_BIND_MASK) | FIELD_PREP(PPE_L3_VP_PORT_TBL_L3_IF_INDEX, l3_if) |
+	       (valid ? PPE_L3_VP_PORT_TBL_L3_IF_VALID : 0);
+}
+
+/**
+ * ppe_sr_role() - A PORT_PARSING register with a parser role.
+ * @val: The register.
+ * @core: Core (S-R) rather than edge.
+ *
+ * Return: @val with its role set, the other bits as they are.
+ */
+u32 ppe_sr_role(u32 val, bool core)
+{
+	return core ? val | PPE_PORT_PARSING_PORT_ROLE : val & ~PPE_PORT_PARSING_PORT_ROLE;
+}
+
+/**
+ * ppe_sr_vlan_cnt_dec() - Decode a VLAN_DEV_CNT entry (an XLT counter).
+ * @w: Its words.
+ * @c: Filled in; no drop counts.
+ */
+void ppe_sr_vlan_cnt_dec(const u32 w[PPE_VLAN_DEV_CNT_TBL_WORDS], struct ppe_sr_cnt *c)
+{
+	c->packets = w[0];
+	c->bytes = (u64)FIELD_GET(PPE_VLAN_DEV_CNT_W2_BYTE_HI, w[2]) << 32 | w[1];
+	c->drop_packets = 0;
+	c->drop_bytes = 0;
+}
+
+/**
+ * ppe_sr_rt_cnt_dec() - Decode an RT_INTERFACE_CNT entry.
+ * @w: Its words.
+ * @c: Filled in.
+ */
+void ppe_sr_rt_cnt_dec(const u32 w[PPE_RT_INTERFACE_CNT_TBL_WORDS], struct ppe_sr_cnt *c)
+{
+	c->packets = w[0];
+	c->bytes = (u64)FIELD_GET(PPE_RT_INTERFACE_CNT_W2_BYTE_HI, w[2]) << 32 | w[1];
+	c->drop_packets = (u64)FIELD_GET(PPE_RT_INTERFACE_CNT_W3_DROP_PKT_HI, w[3]) << 24 |
+			  FIELD_GET(PPE_RT_INTERFACE_CNT_W2_DROP_PKT_LO, w[2]);
+	c->drop_bytes = (u64)FIELD_GET(PPE_RT_INTERFACE_CNT_W4_DROP_BYTE_HI, w[4]) << 24 |
+			FIELD_GET(PPE_RT_INTERFACE_CNT_W3_DROP_BYTE_LO, w[3]);
+}
