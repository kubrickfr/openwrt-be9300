+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * S-R register sequences (WP2-DESIGN §3.3, §3.5, §4.3-§4.6, §5.2, §8.4):
+ * the arm (A3-A11), offers on and off, the disarm (D0-D9), the identity
+ * diff planner and its executor (resync), the FAULT latch, the boot check
+ * (S9) and the verifies (S1, S3, S5, S8). Pure: registers, the flows, the
+ * rtl8_4s state word's ppe byte and logging all go through struct
+ * ppe_sr_io, so that a desk harness drives these on a mock. The caller holds
+ * the offload lock (priv->lock) around every call taking a struct
+ * ppe_sr_seq, and RTNL around the arm and the resync.
+ *
+ * Every register write is read back (whole entry, or the word holding the
+ * field). A field is moved only from the value it is expected to hold:
+ * "already there" is success, anything else -EBUSY, and nothing is written.
+ * Each step marks its record before it writes, so that a rollback or a
+ * disarm puts back exactly what may have changed, in the reverse order,
+ * again only from S-R's own value.
+ */
+
+#ifndef __PPE_SR_SEQ_H__
+#define __PPE_SR_SEQ_H__
+
+#include <linux/compiler.h>
+#include <linux/stdarg.h>
+#include <linux/types.h>
+
+#include "ppe_regs.h"
+#include "ppe_sr.h"
+#include "ppe_sr_hw.h"
+#include "ppe_sr_topo.h"
+
+/* Diff operations at most: a removal and an addition of five each per
+ * identity, a recopy per identity, one port flush.
+ */
+#define PPE_SR_OPS_MAX		(PPE_SR_ID_MAX * 11 + 1)
+
+/* struct ppe_sr_seq::rec: the global writes that may be in place. */
+#define PPE_SR_REC_STPID	BIT(0)
+#define PPE_SR_REC_CPU		BIT(1)
+#define PPE_SR_REC_BIND		BIT(2)
+#define PPE_SR_REC_ROLE		BIT(3)
+
+/* struct ppe_sr_id::set: an identity's entries that may be S-R's. */
+#define PPE_SR_ID_L3IF		BIT(0)
+#define PPE_SR_ID_CNT		BIT(1)
+#define PPE_SR_ID_ACT		BIT(2)
+#define PPE_SR_ID_RULE		BIT(3)
+
+/* Where a sequence is, for the FAULT record and the logs. */
+enum ppe_sr_step {
+	PPE_SR_STEP_NONE,
+	PPE_SR_STEP_A3,
+	PPE_SR_STEP_A4,
+	PPE_SR_STEP_A5,
+	PPE_SR_STEP_A6,
+	PPE_SR_STEP_A7,
+	PPE_SR_STEP_A8,
+	PPE_SR_STEP_A9,
+	PPE_SR_STEP_A10,
+	PPE_SR_STEP_A11,
+	PPE_SR_STEP_OFFERS_ON,
+	PPE_SR_STEP_OFFERS_OFF,
+	PPE_SR_STEP_D1,
+	PPE_SR_STEP_D2,
+	PPE_SR_STEP_D3,
+	PPE_SR_STEP_D4,
+	PPE_SR_STEP_D5,
+	PPE_SR_STEP_D6,
+	PPE_SR_STEP_D7,
+	PPE_SR_STEP_D8,
+	PPE_SR_STEP_FLUSH_ID,
+	PPE_SR_STEP_REMOVE,
+	PPE_SR_STEP_RECOPY,
+	PPE_SR_STEP_ADD,
+	PPE_SR_STEP_FLUSH_PORT,
+	PPE_SR_STEP_HOOK,
+	PPE_SR_STEP_NUM
+};
+
+/* What struct ppe_sr_io::flush drops: every flow; the upload flows of the
+ * identity in slot @arg; the flows of the switch ports in mask @arg, both
+ * directions.
+ */
+enum ppe_sr_flush {
+	PPE_SR_FLUSH_ALL,
+	PPE_SR_FLUSH_ID,
+	PPE_SR_FLUSH_PORTS
+};
+
+/* Diff operations (ppe_sr_diff()), see ppe_sr_seq_exec(). */
+enum ppe_sr_op_code {
+	PPE_SR_OP_FLUSH_ID,
+	PPE_SR_OP_RULE_OFF,
+	PPE_SR_OP_ACT_OFF,
+	PPE_SR_OP_CNT_OFF,
+	PPE_SR_OP_L3IF_RESTORE,
+	PPE_SR_OP_RECOPY,
+	PPE_SR_OP_ALLOC,
+	PPE_SR_OP_L3IF_COPY,
+	PPE_SR_OP_CNT_ZERO,
+	PPE_SR_OP_ACT_ON,
+	PPE_SR_OP_RULE_ON,
+	PPE_SR_OP_FLUSH_PORT
+};
+
+/* What ppe_sr_seq_verify() checks. */
+enum ppe_sr_verify {
+	PPE_SR_VERIFY_ARM,	/* S3: everything written, and S1 but its scans */
+	PPE_SR_VERIFY_RESYNC,	/* S5: the binding, the template, own entries */
+	PPE_SR_VERIFY_IDLE	/* S8: S3 and the foreign-rule scan */
+};
+
+enum ppe_sr_log_level {
+	PPE_SR_LOG_ERR,
+	PPE_SR_LOG_WARN,
+	PPE_SR_LOG_INFO
+};
+
+/**
+ * struct ppe_sr_io - What the sequences act through.
+ * @ctx: Passed to every callback.
+ * @rd: Read @words registers from @addr on.
+ * @wr: Write @words registers from @addr on, the last one last (a table
+ * entry latches on it).
+ * @flush: Drop the flows enum ppe_sr_flush names, with their hardware
+ * entries; return how many could not be dropped, those at an unknown index
+ * included (0: none is left).
+ * @claim: rtl8_4s_ppe_claim() on the conduit's switch; on success fill in
+ * its sw_gen and s_ports as read after the claim. Return 0, -EBUSY if the
+ * switch is not (READY, OFF), -ENODEV if it is gone.
+ * @move: rtl8_4s_ppe_move() between the enum rtl8_4s_ppe_state values @from
+ * and @to; false if refused or the switch is gone.
+ * @release: rtl8_4s_ppe_release(), nothing if the switch is gone.
+ * @state: Told every change of struct ppe_sr_seq::state, after it is
+ * stored: the caller bumps its generation here.
+ * @log: Log a line (enum ppe_sr_log_level, a format and its arguments);
+ * the caller prefixes it "sr: " (WP2-DESIGN §6.5: "sr: FAULT", "sr: verify
+ * MISMATCH" and "sr: switch left READY" are what a bench stops on).
+ *
+ * No callback may call back into the sequences: a degraded latch inside
+ * @flush is the caller's to report afterwards (ppe_sr_seq_fault()).
+ */
+struct ppe_sr_io {
+	void *ctx;
+	int (*rd)(void *ctx, u32 addr, u32 *val, unsigned int words);
+	int (*wr)(void *ctx, u32 addr, const u32 *val, unsigned int words);
+	unsigned int (*flush)(void *ctx, enum ppe_sr_flush what, u32 arg);
+	int (*claim)(void *ctx, u32 *sw_gen, u16 *s_ports);
+	bool (*move)(void *ctx, u8 from, u8 to);
+	void (*release)(void *ctx);
+	void (*state)(void *ctx, u8 from, u8 to);
+	void (*log)(void *ctx, int level, const char *fmt, va_list ap) __printf(3, 0);
+};
+
+/**
+ * struct ppe_sr_cfg - What an arm is for, fixed until the disarm.
+ * @ppe_port: The conduit's PPE port.
+ * @l3_if: Its L3 interface (its MY_MAC entry is @l3_if - 1).
+ * @ctype_ports: The other PPE ports whose egress must stay C-type.
+ * @mac: The conduit's MAC address.
+ * @sw_gen: rtl8_4s_tagger_data::sw_gen when the plan was built (A2).
+ * @s_ports: rtl8_4s_tagger_data::s_ports then.
+ */
+struct ppe_sr_cfg {
+	u8 ppe_port;
+	u8 l3_if;
+	u8 ctype_ports;
+	u8 mac[6];
+	u32 sw_gen;
+	u16 s_ports;
+};
+
+/**
+ * struct ppe_sr_id - An identity: a class's XLT entry and L3 interface.
+ * @cls: Its class.
+ * @used: The slot holds an identity.
+ * @live: Installed (and, at arm, verified): offers may key flows on it.
+ * @set: PPE_SR_ID_* entries that may be S-R's.
+ * @xlt: Its XLT entry and counter.
+ * @l3_if: Its ingress L3 interface.
+ * @l3if_old: What @l3_if held before (inert), written back at removal.
+ * @l3if_new: The copy written to @l3_if.
+ */
+struct ppe_sr_id {
+	struct ppe_sr_class cls;
+	u8 used;
+	u8 live;
+	u8 set;
+	u8 xlt;
+	u8 l3_if;
+	u32 l3if_old[PPE_IN_L3_IF_TBL_WORDS];
+	u32 l3if_new[PPE_IN_L3_IF_TBL_WORDS];
+};
+
+/**
+ * struct ppe_sr_op - A diff operation.
+ * @code: enum ppe_sr_op_code.
+ * @slot: The identity slot it acts on.
+ * @ports: PPE_SR_OP_FLUSH_PORT's switch ports.
+ * @cls: PPE_SR_OP_ALLOC's class.
+ */
+struct ppe_sr_op {
+	u8 code;
+	u8 slot;
+	u16 ports;
+	struct ppe_sr_class cls;
+};
+
+/**
+ * struct ppe_sr_id_cnt - An identity's hardware counters.
+ * @xlt: Its XLT counter: frames its rule gave the identity.
+ * @rt_in: Its L3 interface's ingress counters.
+ * @rt_eg: Its L3 interface's egress counters.
+ */
+struct ppe_sr_id_cnt {
+	struct ppe_sr_cnt xlt;
+	struct ppe_sr_cnt rt_in;
+	struct ppe_sr_cnt rt_eg;
+};
+
+/**
+ * struct ppe_sr_seq - The S-R mode's memory state and write records.
+ * @cfg: What the arm is for.
+ * @state: enum ppe_sr_state; stored with WRITE_ONCE() for lockless readers.
+ * @step: enum ppe_sr_step of the last failure.
+ * @err: Its error.
+ * @fault: enum ppe_sr_fault, latched until reboot.
+ * @fault_step: The step that latched it.
+ * @fault_err: Its error.
+ * @degrade: Set when the caller must latch priv->degraded; the caller
+ * clears it.
+ * @rec: PPE_SR_REC_* writes that may be in place.
+ * @stpid_pre: The egress TPID register before the arm.
+ * @cpu_pre: The CPU port's egress VLAN register before the arm.
+ * @role_pre: The conduit's PORT_PARSING register before the arm.
+ * @bind_pre: Its L3_VP_PORT_TBL entry before the arm.
+ * @tmpl: The conduit's ingress L3 interface the identities copy.
+ * @xlt_busy: XLT entries 0..63 that are not S-R's to take (found at the
+ * arm: a valid rule, words left in the rule or action, or a counter a valid
+ * rule's action names).
+ * @l3if_inert: L3 interfaces found inert at the arm, PPE_SR_L3IF_FIRST on.
+ * @nid: Slots in use.
+ * @id: The identities, by slot; a flow names its identity by slot.
+ */
+struct ppe_sr_seq {
+	struct ppe_sr_cfg cfg;
+	u8 state;
+	u8 step;
+	int err;
+	u8 fault;
+	u8 fault_step;
+	int fault_err;
+	bool degrade;
+	u8 rec;
+	u32 stpid_pre;
+	u32 cpu_pre;
+	u32 role_pre;
+	u32 bind_pre[PPE_L3_VP_PORT_TBL_WORDS];
+	u32 tmpl[PPE_IN_L3_IF_TBL_WORDS];
+	u64 xlt_busy;
+	u64 l3if_inert[PPE_IN_L3_IF_TBL_ENTRIES / 64];
+	unsigned int nid;
+	struct ppe_sr_id id[PPE_SR_ID_MAX];
+};
+
+const char *ppe_sr_state_name(unsigned int state);
+const char *ppe_sr_fault_name(unsigned int fault);
+const char *ppe_sr_step_name(unsigned int step);
+
+int ppe_sr_seq_precheck(struct ppe_sr_seq *seq, const struct ppe_sr_io *io);
+int ppe_sr_seq_alloc(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+		     const struct ppe_sr_class *plan, unsigned int n);
+int ppe_sr_seq_apply(struct ppe_sr_seq *seq, const struct ppe_sr_io *io);
+int ppe_sr_seq_verify(struct ppe_sr_seq *seq, const struct ppe_sr_io *io, enum ppe_sr_verify how);
+int ppe_sr_seq_revert(struct ppe_sr_seq *seq, const struct ppe_sr_io *io);
+unsigned int ppe_sr_diff(const struct ppe_sr_id *old, const struct ppe_sr_class *plan,
+			 unsigned int n, bool recopy, u16 flush_ports, struct ppe_sr_op *ops,
+			 unsigned int *declined);
+int ppe_sr_seq_exec(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+		    const struct ppe_sr_op *ops, unsigned int n,
+		    const u32 tmpl[PPE_IN_L3_IF_TBL_WORDS], unsigned int *failed);
+
+int ppe_sr_seq_arm(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+		   const struct ppe_sr_cfg *cfg, const struct ppe_sr_class *plan, unsigned int n,
+		   enum ppe_sr_why *why);
+int ppe_sr_seq_offers(struct ppe_sr_seq *seq, const struct ppe_sr_io *io, bool on);
+int ppe_sr_seq_disarm(struct ppe_sr_seq *seq, const struct ppe_sr_io *io);
+int ppe_sr_seq_resync(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+		      const struct ppe_sr_class *plan, unsigned int n, bool recopy,
+		      u16 flush_ports, struct ppe_sr_op *ops, unsigned int *declined);
+void ppe_sr_seq_fault(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+		      enum ppe_sr_fault why, enum ppe_sr_step step, int err);
+
+int ppe_sr_seq_boot_check(const struct ppe_sr_io *io, u8 ppe_port);
+int ppe_sr_seq_id_find(const struct ppe_sr_seq *seq, const struct ppe_sr_class *cls);
+int ppe_sr_seq_id_counters(const struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+			   unsigned int slot, struct ppe_sr_id_cnt *c);
+
+#endif /* __PPE_SR_SEQ_H__ */
