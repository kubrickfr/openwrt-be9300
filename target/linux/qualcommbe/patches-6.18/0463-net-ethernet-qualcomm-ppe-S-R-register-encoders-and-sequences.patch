 /* Refcounted, deduplicating allocator on top of the nexthop table
  * primitive (ppe_nexthop.c). See ppe_nexthop_pool.h for why this
  * needs its own software dedup, unlike the host table pool.
+ *
+ * Index PPE_NEXTHOP_POOL_SINK is never handed out: a host table entry
+ * carries DST_INFO 0, and should hardware ever take that for a nexthop
+ * index on a frame no flow matched, it must reach the CPU rather than some
+ * flow's client. ppe_nexthop_pool_sink_set() programs it so (a zeroed entry
+ * would egress into VSI 0).
  */
 
 #include <linux/errno.h>
@@ -36,9 +42,40 @@ static bool ppe_nexthop_entry_equal(const struct ppe_nexthop_entry *a,
 	       !memcmp(a->dmac, b->dmac, ETH_ALEN);
 }
 
+/* The CPU sink: out through the CPU port, terminated locally. */
+static const struct ppe_nexthop_entry ppe_nexthop_sink = {
+	.port_valid = true,
+	.port = 0,
+	.ip_to_me = true,
+};
+
+/* Write @key at @index and read it back; on any failure zero the entry
+ * (best effort), which no flow uses yet.
+ *
+ * Return: 0, -EIO if it reads back otherwise, or the access error.
+ */
+static int ppe_nexthop_pool_write(struct ppe_device *ppe_dev, u32 index,
+				  const struct ppe_nexthop_entry *key)
+{
+	struct ppe_nexthop_entry back, zero = {};
+	int ret;
+
+	ret = ppe_nexthop_entry_set(ppe_dev, index, key);
+	if (!ret)
+		ret = ppe_nexthop_entry_get(ppe_dev, index, &back);
+	if (!ret && !ppe_nexthop_entry_equal(&back, key))
+		ret = -EIO;
+	if (ret)
+		ppe_nexthop_entry_set(ppe_dev, index, &zero);
+
+	return ret;
+}
+
 /**
  * ppe_nexthop_pool_init() - Initialize a nexthop table pool.
