+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * S-R register encoders (WP2-DESIGN §3.2, §3.3, §4.4): an identity's XLT
+ * rule and action, the inert test and the copy of an ingress L3 interface,
+ * the fields S-R moves (egress S-TPID, the CPU port's egress tag modes, the
+ * conduit's L3 binding and parser role) and the counters an identity has.
+ * Pure: no kernel call, so that a desk harness compiles ppe_sr_hw.c in user
+ * space.
+ *
+ * An identity is one XLT entry x (0..63) on the conduit's PPE port and one
+ * ingress L3 interface n (32..255). The rule matches the switch's S-tag of
+ * the class's port (3900 + p, rtl8_4s) and, for T(p, v), C-VID v, or, for
+ * U(p), no C-tag and EtherType 0x0800: a nested 802.1ad tag must not take
+ * U(p)'s identity. The action gives the frame L3 interface n and counts it
+ * at counter x; nothing else of the frame changes.
+ */
+
+#ifndef __PPE_SR_HW_H__
+#define __PPE_SR_HW_H__
+
+#include <linux/types.h>
+
+#include "ppe_regs.h"
+#include "ppe_sr_topo.h"
+
+/* XLT entries (and counters) identities take, lowest first. */
+#define PPE_SR_XLT_FIRST	0
+#define PPE_SR_XLT_LAST		63
+/* Ingress L3 interfaces identities take: past the ports' own (1..7), the
+ * PPPoE sessions' (16..19) and the source MAC ones (24..27).
+ */
+#define PPE_SR_L3IF_FIRST	32
+#define PPE_SR_L3IF_LAST	255
+
+/* The EtherType a U(p) rule keys on. */
+#define PPE_SR_U_PROT		0x0800
+
+/* Egress TPIDs (PPE_EG_VLAN_TPID_ADDR): the S-TPID profile E inserts (the
+ * rtl8_4 head tag's EtherType), the one S-R inserts, and the C-TPID both
+ * keep.
+ */
+#define PPE_SR_STPID_E		0x8899
+#define PPE_SR_STPID_SR		0x88a8
+#define PPE_SR_CTPID		0x8100
+#define PPE_SR_STPID_MASK	PPE_EG_VLAN_TPID_STPID
+
+/* The parser TPIDs S-R needs and never moves, IPR and TPR: S 0x88a8, C
+ * 0x8100 (their reset values).
+ */
+#define PPE_SR_PARSER_TPIDS	0x88a88100
+
+/* The CPU port's egress fields: under E C-type, both tags UNMODIFIED, VSI
+ * tag mode on (0x134 with TX counting); under S-R S-type, both tags
+ * UNTOUCHED, VSI tag mode off (0x11f), so that a frame flooded to the CPU
+ * keeps the switch's S-tag.
+ */
+#define PPE_SR_CPU_PORT		0
+#define PPE_SR_CPU_EG_MASK	(PPE_PORT_EG_VLAN_TBL_VLAN_TYPE |			\
+				 PPE_PORT_EG_VLAN_TBL_CTAG_MODE |			\
+				 PPE_PORT_EG_VLAN_TBL_STAG_MODE |			\
+				 PPE_PORT_EG_VLAN_TBL_VSI_TAG_MODE_EN)
+#define PPE_SR_CPU_EG_E		(FIELD_PREP_CONST(PPE_PORT_EG_VLAN_TBL_CTAG_MODE,	\
+						  PPE_EG_VLAN_TAG_MODE_UNMODIFIED) |	\
+				 FIELD_PREP_CONST(PPE_PORT_EG_VLAN_TBL_STAG_MODE,	\
+						  PPE_EG_VLAN_TAG_MODE_UNMODIFIED) |	\
+				 PPE_PORT_EG_VLAN_TBL_VSI_TAG_MODE_EN)
+#define PPE_SR_CPU_EG_SR	(PPE_PORT_EG_VLAN_TBL_VLAN_TYPE |			\
+				 FIELD_PREP_CONST(PPE_PORT_EG_VLAN_TBL_CTAG_MODE,	\
+						  PPE_EG_VLAN_TAG_MODE_UNTOUCHED) |	\
+				 FIELD_PREP_CONST(PPE_PORT_EG_VLAN_TBL_STAG_MODE,	\
+						  PPE_EG_VLAN_TAG_MODE_UNTOUCHED))
+
+/* The conduit's binding to its L3 interface (L3_VP_PORT_TBL word 0): S-R
+ * clears the valid bit and keeps the index, as the vendor's
+ * ppe_drv_port_l3_if_detach() does, so that its frames get an L3 interface
+ * from XLT rules only.
+ */
+#define PPE_SR_BIND_MASK	(PPE_L3_VP_PORT_TBL_L3_IF_VALID | PPE_L3_VP_PORT_TBL_L3_IF_INDEX)
+
+/**
+ * struct ppe_sr_xlt_key - What an identity's XLT rule matches.
+ * @ppe_port: The conduit's PPE port (0..7), the rule's one port.
+ * @svid: The switch's upload S-VID of the class's port, 3900..3909.
+ * @form: enum ppe_sr_form: PPE_SR_U, no C-tag; PPE_SR_T, C-tagged.
+ * @cvid: The C-VID of a T rule; 0 for a U rule.
+ * @prot: The rule keys on EtherType PPE_SR_U_PROT: every U rule, no T rule.
+ */
+struct ppe_sr_xlt_key {
+	u8 ppe_port;
+	u16 svid;
+	u8 form;
+	u16 cvid;
+	bool prot;
+};
+
+/**
+ * struct ppe_sr_cnt - A counter entry, decoded.
+ * @packets: Frames counted.
+ * @bytes: Their bytes (40 bits).
+ * @drop_packets: Frames dropped (L3 interface counters only).
+ * @drop_bytes: Their bytes.
+ */
+struct ppe_sr_cnt {
+	u64 packets;
+	u64 bytes;
+	u64 drop_packets;
+	u64 drop_bytes;
+};
+
+void ppe_sr_xlt_key_of(const struct ppe_sr_class *cls, u8 ppe_port, struct ppe_sr_xlt_key *k);
+int ppe_sr_xlt_rule_enc(const struct ppe_sr_xlt_key *k, u32 w[PPE_XLT_RULE_TBL_WORDS]);
+int ppe_sr_xlt_rule_dec(const u32 w[PPE_XLT_RULE_TBL_WORDS], struct ppe_sr_xlt_key *k,
+			bool *exact);
+bool ppe_sr_xlt_rule_on_port(const u32 w[PPE_XLT_RULE_TBL_WORDS], u8 ppe_port);
+int ppe_sr_xlt_act_enc(u8 l3_if, u8 counter, u32 w[PPE_XLT_ACTION_TBL_WORDS]);
+int ppe_sr_xlt_act_counter(const u32 w[PPE_XLT_ACTION_TBL_WORDS]);
+
+bool ppe_sr_l3if_inert(const u32 w[PPE_IN_L3_IF_TBL_WORDS]);
+int ppe_sr_l3if_copy(const u32 tmpl[PPE_IN_L3_IF_TBL_WORDS], u32 copy[PPE_IN_L3_IF_TBL_WORDS]);
+
+u32 ppe_sr_stpid(u32 val, bool sr);
+u32 ppe_sr_cpu_eg(u32 val, bool sr);
+bool ppe_sr_conduit_eg_ok(u32 val);
+bool ppe_sr_ctype_eg_ok(u32 val);
+u32 ppe_sr_bind(u32 w0, u8 l3_if, bool valid);
+u32 ppe_sr_role(u32 val, bool core);
+
+void ppe_sr_vlan_cnt_dec(const u32 w[PPE_VLAN_DEV_CNT_TBL_WORDS], struct ppe_sr_cnt *c);
+void ppe_sr_rt_cnt_dec(const u32 w[PPE_RT_INTERFACE_CNT_TBL_WORDS], struct ppe_sr_cnt *c);
+
+#endif /* __PPE_SR_HW_H__ */
