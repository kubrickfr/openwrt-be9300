+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_sr_seq.c
@@ -0,0 +1,1792 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * S-R register sequences, see ppe_sr_seq.h. The write helpers are bench
+ * profile S's (0443: s_write, s_field_set, s_entry_set), re-implemented on
+ * struct ppe_sr_io; the restore order keeps the conduit's parser role edge
+ * whenever the CPU port is not S-R's (0x11f): the role is set last and put
+ * back first, and nothing else is put back unless it read back edge.
+ *
+ * Arm (WP2-DESIGN §4.4), under RTNL and the lock:
+ *   A3  read-only prechecks (S1) and the identities' entries;
+ *   A4  claim the switch (READY, OFF) -> (READY, SR_READY); ARMING;
+ *   A5  drop every flow;
+ *   A6  egress S-TPID 0x8899 -> 0x88a8;
+ *   A7  CPU port egress fields 0x134 -> 0x11f;
+ *   A8  each identity: L3 interface copy, counter zero, action, rule last;
+ *   A9  the conduit's L3 binding invalid (index kept);
+ *   A10 the conduit's parser role core, last;
+ *   A11 verify (S3); READY.
+ * A failure from A6 on rolls back with the disarm's D3-D8 over what was
+ * recorded; a failed rollback is FAULT.
+ *
+ * Disarm (§4.6), under the lock: D1 offers off, DISARMING; D2 drop every
+ * flow; D3 role edge (a failure stops here); D4 the CPU port back; D5 the
+ * binding valid; D6 each identity's rule, action and counter; D7 its L3
+ * interface back; D8 the S-TPID back; D9 release, OFF. Any failure from D2
+ * on is FAULT: the claim stays, nothing more is written until reboot.
+ */
+#ifndef RTL8_4S_PURE
+#define RTL8_4S_PURE
+#endif
+#include <linux/array_size.h>
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/build_bug.h>
+#include <linux/compiler.h>
+#include <linux/errno.h>
+#include <linux/stdarg.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/dsa/rtl8_4s.h>
+
+#include "ppe_regs.h"
+#include "ppe_sr.h"
+#include "ppe_sr_hw.h"
+#include "ppe_sr_seq.h"
+#include "ppe_sr_topo.h"
+
+/* The longest entry written or compared whole. */
+#define PPE_SR_WORDS_MAX	4
+
+static_assert(PPE_XLT_RULE_TBL_WORDS <= PPE_SR_WORDS_MAX);
+static_assert(PPE_XLT_ACTION_TBL_WORDS <= PPE_SR_WORDS_MAX);
+static_assert(PPE_VLAN_DEV_CNT_TBL_WORDS <= PPE_SR_WORDS_MAX);
+static_assert(PPE_IN_L3_IF_TBL_WORDS <= PPE_SR_WORDS_MAX);
+static_assert(PPE_L3_VP_PORT_TBL_WORDS <= PPE_SR_WORDS_MAX);
+static_assert(PPE_SR_ID_MAX <= 64);	/* u64 slot masks */
+static_assert(PPE_SR_XLT_LAST < 64);	/* u64 XLT masks */
+static_assert(PPE_SR_ID_MAX <= 255);	/* u8 slots */
+static_assert(PPE_SR_PORTS <= 16);	/* u16 port masks */
+
+static const char * const ppe_sr_state_names[PPE_SR_S_NUM] = {
+	[PPE_SR_S_OFF] = "off",
+	[PPE_SR_S_ARMING] = "arming",
+	[PPE_SR_S_READY] = "ready",
+	[PPE_SR_S_ACTIVE] = "active",
+	[PPE_SR_S_DISARMING] = "disarming",
+	[PPE_SR_S_FAULT] = "FAULT",
+};
+
+static const char * const ppe_sr_fault_names[PPE_SR_F_NUM] = {
+	[PPE_SR_F_NONE] = "none",
+	[PPE_SR_F_STUCK_FLOW] = "stuck_flow",
+	[PPE_SR_F_REVERT_MISMATCH] = "revert_mismatch",
+	[PPE_SR_F_ROLLBACK_FAILED] = "rollback_failed",
+	[PPE_SR_F_NOT_INERT_AT_BOOT] = "not_inert_at_boot",
+};
+
+static const char * const ppe_sr_step_names[PPE_SR_STEP_NUM] = {
+	[PPE_SR_STEP_NONE] = "none",
+	[PPE_SR_STEP_A3] = "A3",
+	[PPE_SR_STEP_A4] = "A4",
+	[PPE_SR_STEP_A5] = "A5",
+	[PPE_SR_STEP_A6] = "A6",
+	[PPE_SR_STEP_A7] = "A7",
+	[PPE_SR_STEP_A8] = "A8",
+	[PPE_SR_STEP_A9] = "A9",
+	[PPE_SR_STEP_A10] = "A10",
+	[PPE_SR_STEP_A11] = "A11",
+	[PPE_SR_STEP_OFFERS_ON] = "offers_on",
+	[PPE_SR_STEP_OFFERS_OFF] = "offers_off",
+	[PPE_SR_STEP_D1] = "D1",
+	[PPE_SR_STEP_D2] = "D2",
+	[PPE_SR_STEP_D3] = "D3",
+	[PPE_SR_STEP_D4] = "D4",
+	[PPE_SR_STEP_D5] = "D5",
+	[PPE_SR_STEP_D6] = "D6",
+	[PPE_SR_STEP_D7] = "D7",
+	[PPE_SR_STEP_D8] = "D8",
+	[PPE_SR_STEP_FLUSH_ID] = "flush_id",
+	[PPE_SR_STEP_REMOVE] = "remove",
+	[PPE_SR_STEP_RECOPY] = "recopy",
+	[PPE_SR_STEP_ADD] = "add",
+	[PPE_SR_STEP_FLUSH_PORT] = "flush_port",
+	[PPE_SR_STEP_HOOK] = "hook",
+};
+
+/**
+ * ppe_sr_state_name() - Name of an S-R state.
+ * @state: enum ppe_sr_state.
+ *
+ * Return: its name, "?" if out of range.
+ */
+const char *ppe_sr_state_name(unsigned int state)
+{
+	return state < PPE_SR_S_NUM ? ppe_sr_state_names[state] : "?";
+}
+
+/**
+ * ppe_sr_fault_name() - Name of a FAULT reason.
+ * @fault: enum ppe_sr_fault.
+ *
+ * Return: its name, "?" if out of range.
+ */
+const char *ppe_sr_fault_name(unsigned int fault)
+{
+	return fault < PPE_SR_F_NUM ? ppe_sr_fault_names[fault] : "?";
+}
+
+/**
+ * ppe_sr_step_name() - Name of a sequence step.
+ * @step: enum ppe_sr_step.
+ *
+ * Return: its name, "?" if out of range.
+ */
+const char *ppe_sr_step_name(unsigned int step)
+{
+	return step < PPE_SR_STEP_NUM ? ppe_sr_step_names[step] : "?";
+}
+
+static u32 sr_rule_addr(unsigned int x)
+{
+	return PPE_XLT_RULE_TBL_ADDR + x * PPE_XLT_RULE_TBL_INC;
+}
+
+static u32 sr_act_addr(unsigned int x)
+{
+	return PPE_XLT_ACTION_TBL_ADDR + x * PPE_XLT_ACTION_TBL_INC;
+}
+
+static u32 sr_cnt_addr(unsigned int x)
+{
+	return PPE_VLAN_DEV_CNT_TBL_ADDR + x * PPE_VLAN_DEV_CNT_TBL_INC;
+}
+
+static u32 sr_l3if_addr(unsigned int n)
+{
+	return PPE_IN_L3_IF_TBL_ADDR + n * PPE_IN_L3_IF_TBL_INC;
+}
+
+static u32 sr_rt_cnt_addr(unsigned int i)
+{
+	return PPE_RT_INTERFACE_CNT_TBL_ADDR + i * PPE_RT_INTERFACE_CNT_TBL_INC;
+}
+
+static u32 sr_bind_addr(unsigned int port)
+{
+	return PPE_L3_VP_PORT_TBL_ADDR + port * PPE_L3_VP_PORT_TBL_INC;
+}
+
+static u32 sr_role_addr(unsigned int port)
+{
+	return PPE_PORT_PARSING_ADDR + port * PPE_PORT_PARSING_INC;
+}
+
+static u32 sr_tpr_role_addr(unsigned int port)
+{
+	return PPE_TPR_PORT_PARSING_ADDR + port * PPE_TPR_PORT_PARSING_INC;
+}
+
+static u32 sr_eg_vlan_addr(unsigned int port)
+{
+	return PPE_PORT_EG_VLAN_TBL_ADDR + port * PPE_PORT_EG_VLAN_TBL_INC;
+}
+
+static u32 sr_my_mac_addr(unsigned int i)
+{
+	return PPE_MY_MAC_TBL_ADDR + i * PPE_MY_MAC_TBL_INC;
+}
+
+/* The rtl8_4s ppe byte that goes with a PPE state. */
+static u8 sr_td_ppe(u8 state)
+{
+	switch (state) {
+	case PPE_SR_S_OFF:
+		return RTL8_4S_PPE_OFF;
+	case PPE_SR_S_ACTIVE:
+		return RTL8_4S_PPE_ACTIVE;
+	case PPE_SR_S_FAULT:
+		return RTL8_4S_PPE_FAULT;
+	default:
+		return RTL8_4S_PPE_SR_READY;
+	}
+}
+
+static __printf(3, 4) void sr_log(const struct ppe_sr_io *io, int level, const char *fmt, ...)
+{
+	va_list ap;
+
+	va_start(ap, fmt);
+	io->log(io->ctx, level, fmt, ap);
+	va_end(ap);
+}
+
+static void sr_set_state(struct ppe_sr_seq *seq, const struct ppe_sr_io *io, u8 to)
+{
+	u8 from = seq->state;
+
+	WRITE_ONCE(seq->state, to);
+	io->state(io->ctx, from, to);
+}
+
+static int sr_rd(const struct ppe_sr_io *io, u32 addr, u32 *val, unsigned int words)
+{
+	int ret = io->rd(io->ctx, addr, val, words);
+
+	if (ret)
+		sr_log(io, PPE_SR_LOG_ERR, "read %#x failed (%d)", addr, ret);
+
+	return ret;
+}
+
+/* Write @words words at @addr and read them back. */
+static int sr_write(const struct ppe_sr_io *io, u32 addr, const u32 *val, unsigned int words)
+{
+	u32 back[PPE_SR_WORDS_MAX];
+	unsigned int i;
+	int ret;
+
+	ret = io->wr(io->ctx, addr, val, words);
+	if (ret) {
+		sr_log(io, PPE_SR_LOG_ERR, "write %#x failed (%d)", addr, ret);
+		return ret;
+	}
+	ret = sr_rd(io, addr, back, words);
+	if (ret)
+		return ret;
+	for (i = 0; i < words; i++) {
+		if (back[i] != val[i]) {
+			sr_log(io, PPE_SR_LOG_ERR, "write %#x: word %u reads back %08x, not %08x",
+			       addr, i, back[i], val[i]);
+			return -EIO;
+		}
+	}
+
+	return 0;
+}
+
+/* Set the @mask bits of the first of the @words words at @addr to @to if
+ * they hold @from, every other bit as it is, writing every word (the last
+ * one last) and reading them back.
+ *
+ * Return: 0 if set or holding @to already, -EBUSY if they hold neither
+ * (nothing written), another negative error code if an access or the read
+ * back failed.
+ */
+static int sr_field_set(const struct ppe_sr_io *io, u32 addr, unsigned int words, u32 mask,
+			u32 from, u32 to)
+{
+	u32 val[PPE_SR_WORDS_MAX];
+	int ret;
+
+	ret = sr_rd(io, addr, val, words);
+	if (ret)
+		return ret;
+	if ((val[0] & mask) == (to & mask))
+		return 0;
+	if ((val[0] & mask) != (from & mask)) {
+		sr_log(io, PPE_SR_LOG_ERR, "%#x holds %08x: neither %08x nor %08x under %08x",
+		       addr, val[0], from & mask, to & mask, mask);
+		return -EBUSY;
+	}
+	val[0] = (val[0] & ~mask) | (to & mask);
+
+	return sr_write(io, addr, val, words);
+}
+
+/* Put the @words words at @addr back to @pre, the words read before S-R
+ * moved the @mask bits of the first to @from: only if those bits still hold
+ * @from, and then whole, so that whatever else S-R's own write may have
+ * changed goes back too (nothing but S-R writes these while it is armed).
+ *
+ * Return: 0 if put back or holding @pre already, -EBUSY if the field holds
+ * something else (nothing written), another negative error code if an
+ * access or the read back failed.
+ */
+static int sr_field_restore(const struct ppe_sr_io *io, u32 addr, unsigned int words, u32 mask,
+			    u32 from, const u32 *pre)
+{
+	u32 val[PPE_SR_WORDS_MAX];
+	int ret;
+
+	ret = sr_rd(io, addr, val, words);
+	if (ret)
+		return ret;
+	if (!memcmp(val, pre, words * sizeof(*val)))
+		return 0;
+	if ((val[0] & mask) != (from & mask)) {
+		sr_log(io, PPE_SR_LOG_ERR, "%#x holds %08x: not S-R's %08x under %08x", addr,
+		       val[0], from & mask, mask);
+		return -EBUSY;
+	}
+
+	return sr_write(io, addr, pre, words);
+}
+
+/* Set the @words words at @addr to @to if they hold @from, as
+ * sr_field_set() does for a field.
+ */
+static int sr_entry_set(const struct ppe_sr_io *io, u32 addr, unsigned int words,
+			const u32 *from, const u32 *to)
+{
+	u32 val[PPE_SR_WORDS_MAX];
+	int ret;
+
+	ret = sr_rd(io, addr, val, words);
+	if (ret)
+		return ret;
+	if (!memcmp(val, to, words * sizeof(*val)))
+		return 0;
+	if (memcmp(val, from, words * sizeof(*val))) {
+		sr_log(io, PPE_SR_LOG_ERR, "%#x holds %08x %08x ...: neither S-R's nor the old",
+		       addr, val[0], val[1]);
+		return -EBUSY;
+	}
+
+	return sr_write(io, addr, to, words);
+}
+
+static bool sr_bit(const u64 *map, unsigned int i)
+{
+	return map[i / 64] & BIT_ULL(i % 64);
+}
+
+static void sr_bit_set(u64 *map, unsigned int i, bool on)
+{
+	if (on)
+		map[i / 64] |= BIT_ULL(i % 64);
+	else
+		map[i / 64] &= ~BIT_ULL(i % 64);
+}
+
+static void sr_mac_words(const u8 *mac, u32 *lo, u32 *hi)
+{
+	*lo = (u32)mac[2] << 24 | (u32)mac[3] << 16 | (u32)mac[4] << 8 | mac[5];
+	*hi = (u32)mac[0] << 8 | mac[1];
+}
+
+/* Whether a plan is sorted, without duplicates, and every class one the
+ * resolver can make.
+ */
+static bool sr_plan_ok(const struct ppe_sr_class *plan, unsigned int n)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++) {
+		const struct ppe_sr_class *c = &plan[i];
+
+		if (c->port >= PPE_SR_PORTS || (c->form != PPE_SR_U && c->form != PPE_SR_T) ||
+		    !c->vid || c->vid >= 4095 || rtl8_4s_vid_reserved(c->vid))
+			return false;
+		if (i && ppe_sr_class_cmp(&plan[i - 1], c) >= 0)
+			return false;
+	}
+
+	return true;
+}
+
+static bool sr_plan_has(const struct ppe_sr_class *plan, unsigned int n,
+			const struct ppe_sr_class *cls)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++)
+		if (ppe_sr_class_eq(&plan[i], cls))
+			return true;
+
+	return false;
+}
+
+/* Whether one of the slots in @mask of @ids holds @cls. */
+static bool sr_ids_have(const struct ppe_sr_id *ids, u64 mask, const struct ppe_sr_class *cls)
+{
+	unsigned int s;
+
+	for (s = 0; s < PPE_SR_ID_MAX; s++)
+		if ((mask & BIT_ULL(s)) && ppe_sr_class_eq(&ids[s].cls, cls))
+			return true;
+
+	return false;
+}
+
+/* A refusal of a precheck, said: nothing written. */
+static __printf(4, 5) int sr_refuse_one(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+					int err, const char *fmt, ...)
+{
+	va_list ap;
+
+	seq->err = err;
+	va_start(ap, fmt);
+	io->log(io->ctx, PPE_SR_LOG_WARN, fmt, ap);
+	va_end(ap);
+
+	return err;
+}
+
+#define sr_refuse(seq, io, err, fmt, ...) \
+	sr_refuse_one(seq, io, err, "precheck: " fmt, ##__VA_ARGS__)
+
+/**
+ * ppe_sr_seq_precheck() - The arm's read-only prechecks (A3, S1).
+ * @seq: The sequence state; @seq->cfg set, nothing recorded.
+ * @io: Register access.
+ *
+ * Checks that the registers S-R relies on and moves are as E leaves them,
+ * records the values the disarm puts back, the conduit's L3 interface (the
+ * identities' template), the XLT entries that are not S-R's to take and the
+ * inert L3 interfaces. No valid XLT rule may match the conduit's frames.
+ * The L3 route control and the PPPoE sessions are the caller's (memory).
+ *
+ * Return: 0, -EINVAL for a configuration S-R cannot take, -EBUSY for a
+ * register not as expected, or a read error.
+ */
+int ppe_sr_seq_precheck(struct ppe_sr_seq *seq, const struct ppe_sr_io *io)
+{
+	const struct ppe_sr_cfg *cfg = &seq->cfg;
+	u32 port = cfg->ppe_port, v, lo, hi, w[PPE_SR_WORDS_MAX];
+	u32 act[PPE_XLT_ACTION_TBL_WORDS];
+	unsigned int i, q;
+	int ret, cnt;
+
+	seq->step = PPE_SR_STEP_A3;
+	if (!port || port >= PPE_PORT_PARSING_ENTRIES || !cfg->l3_if ||
+	    cfg->l3_if > PPE_MY_MAC_TBL_ENTRIES || cfg->l3_if >= PPE_SR_L3IF_FIRST ||
+	    (cfg->ctype_ports & (BIT(port) | BIT(PPE_SR_CPU_PORT))))
+		return sr_refuse(seq, io, -EINVAL,
+				 "conduit PPE port %u, L3 interface %u, C-type ports %#x",
+				 port, cfg->l3_if, cfg->ctype_ports);
+
+	ret = sr_rd(io, PPE_IPR_VLAN_TPID_ADDR, &v, 1);
+	if (ret)
+		return ret;
+	if (v != PPE_SR_PARSER_TPIDS)
+		return sr_refuse(seq, io, -EBUSY, "parser TPIDs %08x", v);
+	ret = sr_rd(io, PPE_TPR_VLAN_TPID_ADDR, &v, 1);
+	if (ret)
+		return ret;
+	if (v != PPE_SR_PARSER_TPIDS)
+		return sr_refuse(seq, io, -EBUSY, "tunnel parser TPIDs %08x", v);
+	ret = sr_rd(io, PPE_BRIDGE_CONFIG_ADDR, &v, 1);
+	if (ret)
+		return ret;
+	if (v & PPE_BRIDGE_CONFIG_BRIDGE_TYPE)
+		return sr_refuse(seq, io, -EBUSY, "ingress bridge type S (%08x)", v);
+
+	ret = sr_rd(io, PPE_EG_VLAN_TPID_ADDR, &v, 1);
+	if (ret)
+		return ret;
+	if (FIELD_GET(PPE_EG_VLAN_TPID_CTPID, v) != PPE_SR_CTPID ||
+	    FIELD_GET(PPE_EG_VLAN_TPID_STPID, v) != PPE_SR_STPID_E)
+		return sr_refuse(seq, io, -EBUSY, "egress TPIDs %08x", v);
+	seq->stpid_pre = v;
+
+	ret = sr_rd(io, sr_eg_vlan_addr(PPE_SR_CPU_PORT), &v, 1);
+	if (ret)
+		return ret;
+	if ((v & PPE_SR_CPU_EG_MASK) != PPE_SR_CPU_EG_E)
+		return sr_refuse(seq, io, -EBUSY, "CPU port egress VLAN %08x", v);
+	seq->cpu_pre = v;
+	ret = sr_rd(io, sr_eg_vlan_addr(port), &v, 1);
+	if (ret)
+		return ret;
+	if (!ppe_sr_conduit_eg_ok(v))
+		return sr_refuse(seq, io, -EBUSY, "PPE port %u egress VLAN %08x is not E's", port,
+				 v);
+	for (q = 1; q < PPE_PORT_EG_VLAN_TBL_ENTRIES; q++) {
+		if (!(cfg->ctype_ports & BIT(q)))
+			continue;
+		ret = sr_rd(io, sr_eg_vlan_addr(q), &v, 1);
+		if (ret)
+			return ret;
+		if (!ppe_sr_ctype_eg_ok(v))
+			return sr_refuse(seq, io, -EBUSY, "PPE port %u egress VLAN %08x is S-type",
+					 q, v);
+	}
+
+	ret = sr_rd(io, sr_role_addr(port), &v, 1);
+	if (ret)
+		return ret;
+	if (v & PPE_PORT_PARSING_PORT_ROLE)
+		return sr_refuse(seq, io, -EBUSY, "PPE port %u parser role core (%08x)", port, v);
+	seq->role_pre = v;
+	ret = sr_rd(io, sr_tpr_role_addr(port), &v, 1);
+	if (ret)
+		return ret;
+	if (v & PPE_TPR_PORT_PARSING_PORT_ROLE)
+		return sr_refuse(seq, io, -EBUSY, "PPE port %u tunnel parser role core", port);
+	ret = sr_rd(io, PPE_PORT_VLAN_CONFIG_ADDR + port * PPE_PORT_VLAN_CONFIG_INC, &v, 1);
+	if (ret)
+		return ret;
+	if (v)
+		return sr_refuse(seq, io, -EBUSY, "PPE port %u VLAN config %08x", port, v);
+	ret = sr_rd(io, PPE_PORT_DEF_VID_ADDR + port * PPE_PORT_DEF_VID_INC, &v, 1);
+	if (ret)
+		return ret;
+	if (v)
+		return sr_refuse(seq, io, -EBUSY, "PPE port %u default VID %08x", port, v);
+
+	ret = sr_rd(io, sr_bind_addr(port), w, PPE_L3_VP_PORT_TBL_WORDS);
+	if (ret)
+		return ret;
+	if ((w[0] & PPE_SR_BIND_MASK) != ppe_sr_bind(0, cfg->l3_if, true) ||
+	    (w[1] & PPE_L3_VP_PORT_TBL_VSI_VALID))
+		return sr_refuse(seq, io, -EBUSY,
+				 "PPE port %u L3 binding %08x %08x is not to L3 interface %u alone",
+				 port, w[0], w[1], cfg->l3_if);
+	memcpy(seq->bind_pre, w, sizeof(seq->bind_pre));
+
+	ret = sr_rd(io, sr_my_mac_addr(cfg->l3_if - 1), w, PPE_MY_MAC_TBL_WORDS);
+	if (ret)
+		return ret;
+	sr_mac_words(cfg->mac, &lo, &hi);
+	if (!(w[1] & PPE_MY_MAC_TBL_VALID) || w[0] != lo ||
+	    FIELD_GET(PPE_MY_MAC_TBL_MAC_DA_1, w[1]) != hi)
+		return sr_refuse(seq, io, -EBUSY, "MY_MAC %u is not the conduit's address",
+				 cfg->l3_if - 1);
+	ret = sr_rd(io, sr_l3if_addr(cfg->l3_if), seq->tmpl, PPE_IN_L3_IF_TBL_WORDS);
+	if (ret)
+		return ret;
+	if (!(FIELD_GET(PPE_IN_L3_IF_TBL_MAC_BITMAP, seq->tmpl[1]) & BIT(cfg->l3_if - 1)) ||
+	    ppe_sr_l3if_copy(seq->tmpl, w))
+		return sr_refuse(seq, io, -EBUSY,
+				 "L3 interface %u (%08x %08x %08x) does not route the conduit's address",
+				 cfg->l3_if, seq->tmpl[0], seq->tmpl[1], seq->tmpl[2]);
+
+	/* XLT: no rule for the conduit's frames but S-R's, and S-R's entries
+	 * only where rule and action hold nothing and no counter is shared.
+	 */
+	seq->xlt_busy = 0;
+	for (i = 0; i < PPE_XLT_RULE_TBL_ENTRIES; i++) {
+		bool valid;
+
+		ret = sr_rd(io, sr_rule_addr(i), w, PPE_XLT_RULE_TBL_WORDS);
+		if (ret)
+			return ret;
+		valid = w[0] & PPE_XLT_RULE_W0_VALID;
+		if (ppe_sr_xlt_rule_on_port(w, port))
+			return sr_refuse(seq, io, -EBUSY, "XLT rule %u may match PPE port %u", i,
+					 port);
+		if (!valid && i > PPE_SR_XLT_LAST)
+			continue;
+		if (i <= PPE_SR_XLT_LAST && (w[0] | w[1] | w[2] | w[3]))
+			seq->xlt_busy |= BIT_ULL(i);
+		ret = sr_rd(io, sr_act_addr(i), act, PPE_XLT_ACTION_TBL_WORDS);
+		if (ret)
+			return ret;
+		if (i <= PPE_SR_XLT_LAST && (act[0] | act[1] | act[2]))
+			seq->xlt_busy |= BIT_ULL(i);
+		cnt = ppe_sr_xlt_act_counter(act);
+		if (valid && cnt >= 0 && cnt <= PPE_SR_XLT_LAST)
+			seq->xlt_busy |= BIT_ULL(cnt);
+	}
+
+	memset(seq->l3if_inert, 0, sizeof(seq->l3if_inert));
+	for (i = PPE_SR_L3IF_FIRST; i <= PPE_SR_L3IF_LAST; i++) {
+		ret = sr_rd(io, sr_l3if_addr(i), w, PPE_IN_L3_IF_TBL_WORDS);
+		if (ret)
+			return ret;
+		sr_bit_set(seq->l3if_inert, i, ppe_sr_l3if_inert(w));
+	}
+
+	return 0;
+}
+
+/* Take an XLT entry and an L3 interface for @cls into free slot @slot: the
+ * lowest XLT entry not busy and not S-R's, the lowest L3 interface found
+ * inert and not S-R's that still reads inert (read: its words are what the
+ * removal puts back).
+ */
+static int sr_alloc_one(struct ppe_sr_seq *seq, const struct ppe_sr_io *io, unsigned int slot,
+			const struct ppe_sr_class *cls, const u32 *tmpl)
+{
+	u64 own_l3[PPE_IN_L3_IF_TBL_ENTRIES / 64] = {};
+	struct ppe_sr_id *id = &seq->id[slot];
+	u32 w[PPE_IN_L3_IF_TBL_WORDS];
+	unsigned int s, x, n;
+	u64 own = 0;
+	int ret;
+
+	if (id->used)
+		return -EINVAL;
+	for (s = 0; s < PPE_SR_ID_MAX; s++) {
+		if (!seq->id[s].used)
+			continue;
+		own |= BIT_ULL(seq->id[s].xlt);
+		sr_bit_set(own_l3, seq->id[s].l3_if, true);
+	}
+
+	for (x = PPE_SR_XLT_FIRST; x <= PPE_SR_XLT_LAST; x++)
+		if (!((seq->xlt_busy | own) & BIT_ULL(x)))
+			break;
+	if (x > PPE_SR_XLT_LAST)
+		return -ENOSPC;
+
+	for (n = PPE_SR_L3IF_FIRST; n <= PPE_SR_L3IF_LAST; n++) {
+		if (!sr_bit(seq->l3if_inert, n) || sr_bit(own_l3, n))
+			continue;
+		ret = sr_rd(io, sr_l3if_addr(n), w, PPE_IN_L3_IF_TBL_WORDS);
+		if (ret)
+			return ret;
+		if (ppe_sr_l3if_inert(w))
+			break;
+		sr_log(io, PPE_SR_LOG_INFO, "L3 interface %u no longer inert", n);
+		sr_bit_set(seq->l3if_inert, n, false);
+	}
+	if (n > PPE_SR_L3IF_LAST)
+		return -ENOSPC;
+
+	memset(id, 0, sizeof(*id));
+	ret = ppe_sr_l3if_copy(tmpl, id->l3if_new);
+	if (ret)
+		return ret;
+	memcpy(id->l3if_old, w, sizeof(id->l3if_old));
+	id->cls = *cls;
+	id->xlt = x;
+	id->l3_if = n;
+	id->used = 1;
+	seq->nid++;
+
+	return 0;
+}
+
+static void sr_ids_clear(struct ppe_sr_seq *seq)
+{
+	memset(seq->id, 0, sizeof(seq->id));
+	seq->nid = 0;
+}
+
+/**
+ * ppe_sr_seq_alloc() - Take every class's identity (A3).
+ * @seq: The sequence state, after ppe_sr_seq_precheck(), no identity yet.
+ * @io: Register access (reads the L3 interfaces taken).
+ * @plan: The classes, sorted; slot i gets @plan[i], with XLT entries
+ * ascending.
+ * @n: Their number.
+ *
+ * Return: 0, -ENOSPC if they do not all fit, -EINVAL, or a read error;
+ * nothing is taken then.
+ */
+int ppe_sr_seq_alloc(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+		     const struct ppe_sr_class *plan, unsigned int n)
+{
+	unsigned int i;
+	int ret;
+
+	seq->step = PPE_SR_STEP_A3;
+	if (seq->nid || n > PPE_SR_ID_MAX)
+		return -EINVAL;
+	for (i = 0; i < n; i++) {
+		ret = sr_alloc_one(seq, io, i, &plan[i], seq->tmpl);
+		if (ret) {
+			sr_ids_clear(seq);
+			seq->err = ret;
+			sr_log(io, PPE_SR_LOG_WARN, "precheck: no identity for class %u of %u (%d)",
+			       i + 1, n, ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+/* One install step of identity @id (enum ppe_sr_op_code). */
+static int sr_id_install(struct ppe_sr_seq *seq, const struct ppe_sr_io *io, struct ppe_sr_id *id,
+			 u8 code)
+{
+	static const u32 zero[PPE_SR_WORDS_MAX];
+	struct ppe_sr_xlt_key k;
+	u32 w[PPE_SR_WORDS_MAX];
+	int ret;
+
+	switch (code) {
+	case PPE_SR_OP_L3IF_COPY:
+		id->set |= PPE_SR_ID_L3IF;
+		return sr_entry_set(io, sr_l3if_addr(id->l3_if), PPE_IN_L3_IF_TBL_WORDS,
+				    id->l3if_old, id->l3if_new);
+	case PPE_SR_OP_CNT_ZERO:
+		id->set |= PPE_SR_ID_CNT;
+		return sr_write(io, sr_cnt_addr(id->xlt), zero, PPE_VLAN_DEV_CNT_TBL_WORDS);
+	case PPE_SR_OP_ACT_ON:
+		ret = ppe_sr_xlt_act_enc(id->l3_if, id->xlt, w);
+		if (ret)
+			return ret;
+		id->set |= PPE_SR_ID_ACT;
+		return sr_entry_set(io, sr_act_addr(id->xlt), PPE_XLT_ACTION_TBL_WORDS, zero, w);
+	case PPE_SR_OP_RULE_ON:
+		ppe_sr_xlt_key_of(&id->cls, seq->cfg.ppe_port, &k);
+		ret = ppe_sr_xlt_rule_enc(&k, w);
+		if (ret)
+			return ret;
+		id->set |= PPE_SR_ID_RULE;
+		return sr_entry_set(io, sr_rule_addr(id->xlt), PPE_XLT_RULE_TBL_WORDS, zero, w);
+	default:
+		return -EINVAL;
+	}
+}
+
+/* One removal step of identity @id (enum ppe_sr_op_code): each entry only
+ * from S-R's own words. The counter is a statistic: a failure to clear it
+ * is said and ignored.
+ */
+static int sr_id_remove(struct ppe_sr_seq *seq, const struct ppe_sr_io *io, struct ppe_sr_id *id,
+			u8 code)
+{
+	static const u32 zero[PPE_SR_WORDS_MAX];
+	struct ppe_sr_xlt_key k;
+	u32 w[PPE_SR_WORDS_MAX], back[PPE_SR_WORDS_MAX];
+	u32 addr;
+	int ret;
+
+	switch (code) {
+	case PPE_SR_OP_RULE_OFF:
+		if (!(id->set & PPE_SR_ID_RULE))
+			return 0;
+		ppe_sr_xlt_key_of(&id->cls, seq->cfg.ppe_port, &k);
+		ret = ppe_sr_xlt_rule_enc(&k, w);
+		if (!ret)
+			ret = sr_entry_set(io, sr_rule_addr(id->xlt), PPE_XLT_RULE_TBL_WORDS, w,
+					   zero);
+		if (!ret)
+			id->set &= ~PPE_SR_ID_RULE;
+		return ret;
+	case PPE_SR_OP_ACT_OFF:
+		if (!(id->set & PPE_SR_ID_ACT))
+			return 0;
+		ret = ppe_sr_xlt_act_enc(id->l3_if, id->xlt, w);
+		if (!ret)
+			ret = sr_entry_set(io, sr_act_addr(id->xlt), PPE_XLT_ACTION_TBL_WORDS, w,
+					   zero);
+		if (!ret)
+			id->set &= ~PPE_SR_ID_ACT;
+		return ret;
+	case PPE_SR_OP_CNT_OFF:
+		if (!(id->set & PPE_SR_ID_CNT))
+			return 0;
+		addr = sr_cnt_addr(id->xlt);
+		ret = io->wr(io->ctx, addr, zero, PPE_VLAN_DEV_CNT_TBL_WORDS);
+		if (!ret)
+			ret = io->rd(io->ctx, addr, back, PPE_VLAN_DEV_CNT_TBL_WORDS);
+		if (ret || memcmp(back, zero, PPE_VLAN_DEV_CNT_TBL_WORDS * sizeof(*back)))
+			sr_log(io, PPE_SR_LOG_INFO, "XLT counter %u not cleared (%d)", id->xlt,
+			       ret);
+		id->set &= ~PPE_SR_ID_CNT;
+		return 0;
+	case PPE_SR_OP_L3IF_RESTORE:
+		if (!(id->set & PPE_SR_ID_L3IF))
+			return 0;
+		ret = sr_entry_set(io, sr_l3if_addr(id->l3_if), PPE_IN_L3_IF_TBL_WORDS,
+				   id->l3if_new, id->l3if_old);
+		if (!ret)
+			id->set &= ~PPE_SR_ID_L3IF;
+		return ret;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const u8 sr_install_ops[] = {
+	PPE_SR_OP_L3IF_COPY, PPE_SR_OP_CNT_ZERO, PPE_SR_OP_ACT_ON, PPE_SR_OP_RULE_ON,
+};
+
+static const u8 sr_remove_ops[] = {
+	PPE_SR_OP_RULE_OFF, PPE_SR_OP_ACT_OFF, PPE_SR_OP_CNT_OFF, PPE_SR_OP_L3IF_RESTORE,
+};
+
+/* Take identity @id's entries back after its own install failed: rule,
+ * action, counter, L3 interface, each only where S-R's words still are.
+ */
+static int sr_id_takeback(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+			  struct ppe_sr_id *id)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(sr_remove_ops); i++) {
+		ret = sr_id_remove(seq, io, id, sr_remove_ops[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * ppe_sr_seq_apply() - The arm's writes (A6-A10).
+ * @seq: The sequence state, prechecked and allocated (ARMING).
+ * @io: Register access.
+ *
+ * Each step marks its record before it writes, so that
+ * ppe_sr_seq_revert() takes back whatever may have changed.
+ *
+ * Return: 0, or the first error (the rest not attempted).
+ */
+int ppe_sr_seq_apply(struct ppe_sr_seq *seq, const struct ppe_sr_io *io)
+{
+	const u8 port = seq->cfg.ppe_port;
+	unsigned int s, i;
+	int ret;
+
+	seq->step = PPE_SR_STEP_A6;
+	seq->rec |= PPE_SR_REC_STPID;
+	ret = sr_field_set(io, PPE_EG_VLAN_TPID_ADDR, 1, PPE_SR_STPID_MASK, ppe_sr_stpid(0, false),
+			   ppe_sr_stpid(0, true));
+	if (ret)
+		return ret;
+
+	seq->step = PPE_SR_STEP_A7;
+	seq->rec |= PPE_SR_REC_CPU;
+	ret = sr_field_set(io, sr_eg_vlan_addr(PPE_SR_CPU_PORT), 1, PPE_SR_CPU_EG_MASK,
+			   PPE_SR_CPU_EG_E, PPE_SR_CPU_EG_SR);
+	if (ret)
+		return ret;
+
+	/* Slots were filled in plan order with XLT entries ascending. */
+	seq->step = PPE_SR_STEP_A8;
+	for (s = 0; s < PPE_SR_ID_MAX; s++) {
+		if (!seq->id[s].used)
+			continue;
+		for (i = 0; i < ARRAY_SIZE(sr_install_ops); i++) {
+			ret = sr_id_install(seq, io, &seq->id[s], sr_install_ops[i]);
+			if (ret)
+				return ret;
+		}
+	}
+
+	seq->step = PPE_SR_STEP_A9;
+	seq->rec |= PPE_SR_REC_BIND;
+	ret = sr_field_set(io, sr_bind_addr(port), PPE_L3_VP_PORT_TBL_WORDS, PPE_SR_BIND_MASK,
+			   ppe_sr_bind(0, seq->cfg.l3_if, true),
+			   ppe_sr_bind(0, seq->cfg.l3_if, false));
+	if (ret)
+		return ret;
+
+	seq->step = PPE_SR_STEP_A10;
+	seq->rec |= PPE_SR_REC_ROLE;
+	return sr_field_set(io, sr_role_addr(port), 1, PPE_PORT_PARSING_PORT_ROLE,
+			    ppe_sr_role(0, false), ppe_sr_role(0, true));
+}
+
+/* Note the first failure of a revert that goes on. */
+static void sr_note(struct ppe_sr_seq *seq, int *first, u8 step, int ret)
+{
+	if (!ret || *first)
+		return;
+	*first = ret;
+	seq->step = step;
+	seq->err = ret;
+}
+
+/**
+ * ppe_sr_seq_revert() - Put back what the records say S-R may have written
+ * (D3-D8; the arm's rollback).
+ * @seq: The sequence state; every flow is out of hardware.
+ * @io: Register access.
+ *
+ * D3 first: the parser role edge, read back; if that fails nothing else is
+ * written (the CPU port stays S-R's, which a core role needs). Then each of
+ * D4-D8 is attempted whatever failed before, except that an identity whose
+ * rule could not be removed keeps its action, counter and L3 interface (a
+ * valid rule still names them). Every entry is put back only from S-R's own
+ * words; a moved field only while it holds S-R's value, and then with the
+ * whole register as it was before the arm. On success the records and
+ * identities are cleared.
+ *
+ * Return: 0, or the first error (@seq->step names its step).
+ */
+int ppe_sr_seq_revert(struct ppe_sr_seq *seq, const struct ppe_sr_io *io)
+{
+	const u8 port = seq->cfg.ppe_port;
+	u64 keep = 0;
+	unsigned int s;
+	int ret, first = 0;
+
+	if (seq->rec & PPE_SR_REC_ROLE) {
+		ret = sr_field_restore(io, sr_role_addr(port), 1, PPE_PORT_PARSING_PORT_ROLE,
+				       ppe_sr_role(0, true), &seq->role_pre);
+		if (ret) {
+			sr_note(seq, &first, PPE_SR_STEP_D3, ret);
+			return ret;
+		}
+		seq->rec &= ~PPE_SR_REC_ROLE;
+	}
+
+	if (seq->rec & PPE_SR_REC_CPU) {
+		ret = sr_field_restore(io, sr_eg_vlan_addr(PPE_SR_CPU_PORT), 1, PPE_SR_CPU_EG_MASK,
+				       PPE_SR_CPU_EG_SR, &seq->cpu_pre);
+		sr_note(seq, &first, PPE_SR_STEP_D4, ret);
+		if (!ret)
+			seq->rec &= ~PPE_SR_REC_CPU;
+	}
+
+	if (seq->rec & PPE_SR_REC_BIND) {
+		ret = sr_field_restore(io, sr_bind_addr(port), PPE_L3_VP_PORT_TBL_WORDS,
+				       PPE_SR_BIND_MASK, ppe_sr_bind(0, seq->cfg.l3_if, false),
+				       seq->bind_pre);
+		sr_note(seq, &first, PPE_SR_STEP_D5, ret);
+		if (!ret)
+			seq->rec &= ~PPE_SR_REC_BIND;
+	}
+
+	for (s = 0; s < PPE_SR_ID_MAX; s++) {
+		struct ppe_sr_id *id = &seq->id[s];
+
+		if (!id->used)
+			continue;
+		id->live = 0;
+		ret = sr_id_remove(seq, io, id, PPE_SR_OP_RULE_OFF);
+		if (!ret)
+			ret = sr_id_remove(seq, io, id, PPE_SR_OP_ACT_OFF);
+		if (!ret)
+			ret = sr_id_remove(seq, io, id, PPE_SR_OP_CNT_OFF);
+		if (ret)
+			keep |= BIT_ULL(s);
+		sr_note(seq, &first, PPE_SR_STEP_D6, ret);
+	}
+
+	for (s = 0; s < PPE_SR_ID_MAX; s++) {
+		if (!seq->id[s].used || (keep & BIT_ULL(s)))
+			continue;
+		ret = sr_id_remove(seq, io, &seq->id[s], PPE_SR_OP_L3IF_RESTORE);
+		sr_note(seq, &first, PPE_SR_STEP_D7, ret);
+	}
+
+	if (seq->rec & PPE_SR_REC_STPID) {
+		ret = sr_field_restore(io, PPE_EG_VLAN_TPID_ADDR, 1, PPE_SR_STPID_MASK,
+				       ppe_sr_stpid(0, true), &seq->stpid_pre);
+		sr_note(seq, &first, PPE_SR_STEP_D8, ret);
+		if (!ret)
+			seq->rec &= ~PPE_SR_REC_STPID;
+	}
+
+	if (!first)
+		sr_ids_clear(seq);
+
+	return first;
+}
+
+/* Read @words registers at @addr and compare them with @want under @mask
+ * (NULL: every bit), counting and saying a mismatch.
+ */
+static int sr_check(const struct ppe_sr_io *io, const char *what, u32 addr, const u32 *want,
+		    const u32 *mask, unsigned int words, unsigned int *bad)
+{
+	u32 val[PPE_SR_WORDS_MAX];
+	unsigned int i;
+	int ret;
+
+	ret = sr_rd(io, addr, val, words);
+	if (ret)
+		return ret;
+	for (i = 0; i < words; i++) {
+		u32 m = mask ? mask[i] : ~0U;
+
+		if ((val[i] & m) != (want[i] & m)) {
+			sr_log(io, PPE_SR_LOG_ERR,
+			       "verify MISMATCH %s %#x word %u: %08x, want %08x under %08x", what,
+			       addr, i, val[i], want[i], m);
+			(*bad)++;
+		}
+	}
+
+	return 0;
+}
+
+/* Compare one register with a predicate's verdict. */
+static int sr_check_ok(const struct ppe_sr_io *io, const char *what, u32 addr,
+		       bool (*ok)(u32 val), unsigned int *bad)
+{
+	u32 v;
+	int ret;
+
+	ret = sr_rd(io, addr, &v, 1);
+	if (ret)
+		return ret;
+	if (!ok(v)) {
+		sr_log(io, PPE_SR_LOG_ERR, "verify MISMATCH %s %#x: %08x", what, addr, v);
+		(*bad)++;
+	}
+
+	return 0;
+}
+
+static bool sr_zero_ok(u32 val)
+{
+	return !val;
+}
+
+/* S1's registers that S-R does not write, and S-R's globals. */
+static int sr_verify_globals(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+			     unsigned int *bad)
+{
+	const struct ppe_sr_cfg *cfg = &seq->cfg;
+	const u32 tpids = PPE_SR_PARSER_TPIDS, role_mask = PPE_PORT_PARSING_PORT_ROLE;
+	const u32 my_mask[PPE_MY_MAC_TBL_WORDS] = {
+		~0U, PPE_MY_MAC_TBL_MAC_DA_1 | PPE_MY_MAC_TBL_VALID
+	};
+	const u32 bt_mask = PPE_BRIDGE_CONFIG_BRIDGE_TYPE, zero = 0;
+	u32 my[PPE_MY_MAC_TBL_WORDS], want;
+	unsigned int q;
+	int ret;
+
+	ret = sr_check(io, "parser TPIDs", PPE_IPR_VLAN_TPID_ADDR, &tpids, NULL, 1, bad);
+	if (!ret)
+		ret = sr_check(io, "tunnel parser TPIDs", PPE_TPR_VLAN_TPID_ADDR, &tpids, NULL, 1,
+			       bad);
+	if (!ret)
+		ret = sr_check(io, "bridge type", PPE_BRIDGE_CONFIG_ADDR, &zero, &bt_mask, 1, bad);
+	want = ppe_sr_stpid(seq->stpid_pre, true);
+	if (!ret)
+		ret = sr_check(io, "egress TPIDs", PPE_EG_VLAN_TPID_ADDR, &want, NULL, 1, bad);
+	want = ppe_sr_cpu_eg(seq->cpu_pre, true);
+	if (!ret)
+		ret = sr_check(io, "CPU port egress", sr_eg_vlan_addr(PPE_SR_CPU_PORT), &want, NULL,
+			       1, bad);
+	if (!ret)
+		ret = sr_check_ok(io, "conduit egress", sr_eg_vlan_addr(cfg->ppe_port),
+				  ppe_sr_conduit_eg_ok, bad);
+	for (q = 1; !ret && q < PPE_PORT_EG_VLAN_TBL_ENTRIES; q++)
+		if (cfg->ctype_ports & BIT(q))
+			ret = sr_check_ok(io, "C-type port egress", sr_eg_vlan_addr(q),
+					  ppe_sr_ctype_eg_ok, bad);
+	want = ppe_sr_role(seq->role_pre, true);
+	if (!ret)
+		ret = sr_check(io, "parser role", sr_role_addr(cfg->ppe_port), &want, NULL, 1, bad);
+	if (!ret)
+		ret = sr_check(io, "tunnel parser role", sr_tpr_role_addr(cfg->ppe_port), &zero,
+			       &role_mask, 1, bad);
+	if (!ret)
+		ret = sr_check_ok(io, "port VLAN config",
+				  PPE_PORT_VLAN_CONFIG_ADDR +
+				  cfg->ppe_port * PPE_PORT_VLAN_CONFIG_INC, sr_zero_ok, bad);
+	if (!ret)
+		ret = sr_check_ok(io, "port default VID",
+				  PPE_PORT_DEF_VID_ADDR + cfg->ppe_port * PPE_PORT_DEF_VID_INC,
+				  sr_zero_ok, bad);
+	sr_mac_words(cfg->mac, &my[0], &my[1]);
+	my[1] = FIELD_PREP(PPE_MY_MAC_TBL_MAC_DA_1, my[1]) | PPE_MY_MAC_TBL_VALID;
+	if (!ret)
+		ret = sr_check(io, "MY_MAC", sr_my_mac_addr(cfg->l3_if - 1), my, my_mask,
+			       PPE_MY_MAC_TBL_WORDS, bad);
+
+	return ret;
+}
+
+/**
+ * ppe_sr_seq_verify() - Read back what S-R relies on.
+ * @seq: The sequence state, READY, ACTIVE or ARMING after A10.
+ * @io: Register access.
+ * @how: PPE_SR_VERIFY_ARM (S3, A11): S-R's globals, the binding, each
+ * identity's entries and S1's other registers; PPE_SR_VERIFY_RESYNC (S5):
+ * the binding, the template and each identity's entries only (no foreign
+ * entry is read); PPE_SR_VERIFY_IDLE (S8): ARM's and no valid XLT rule but
+ * S-R's matching the conduit (a full scan: never under load).
+ *
+ * Every mismatch is said ("verify MISMATCH").
+ *
+ * Return: 0, -EBADMSG on a mismatch, or a read error.
+ */
+int ppe_sr_seq_verify(struct ppe_sr_seq *seq, const struct ppe_sr_io *io, enum ppe_sr_verify how)
+{
+	u32 w[PPE_SR_WORDS_MAX], copy[PPE_IN_L3_IF_TBL_WORDS] = {};
+	const u8 port = seq->cfg.ppe_port;
+	unsigned int bad = 0, s, i;
+	struct ppe_sr_xlt_key k;
+	u64 own = 0;
+	int ret;
+
+	memcpy(w, seq->bind_pre, sizeof(seq->bind_pre));
+	w[0] = ppe_sr_bind(w[0], seq->cfg.l3_if, false);
+	ret = sr_check(io, "L3 binding", sr_bind_addr(port), w, NULL, PPE_L3_VP_PORT_TBL_WORDS,
+		       &bad);
+	if (!ret)
+		ret = sr_check(io, "template", sr_l3if_addr(seq->cfg.l3_if), seq->tmpl, NULL,
+			       PPE_IN_L3_IF_TBL_WORDS, &bad);
+	if (!ret && ppe_sr_l3if_copy(seq->tmpl, copy)) {
+		sr_log(io, PPE_SR_LOG_ERR, "verify MISMATCH template routes nothing");
+		bad++;
+	}
+
+	for (s = 0; !ret && s < PPE_SR_ID_MAX; s++) {
+		const struct ppe_sr_id *id = &seq->id[s];
+
+		if (!id->used)
+			continue;
+		own |= BIT_ULL(id->xlt);
+		if (memcmp(id->l3if_new, copy, sizeof(copy))) {
+			sr_log(io, PPE_SR_LOG_ERR,
+			       "verify MISMATCH identity %u: L3 interface %u is not the template's copy",
+			       s, id->l3_if);
+			bad++;
+		}
+		ret = sr_check(io, "identity L3 interface", sr_l3if_addr(id->l3_if), id->l3if_new,
+			       NULL, PPE_IN_L3_IF_TBL_WORDS, &bad);
+		if (ret)
+			break;
+		ppe_sr_xlt_act_enc(id->l3_if, id->xlt, w);
+		ret = sr_check(io, "identity XLT action", sr_act_addr(id->xlt), w, NULL,
+			       PPE_XLT_ACTION_TBL_WORDS, &bad);
+		if (ret)
+			break;
+		ppe_sr_xlt_key_of(&id->cls, port, &k);
+		if (ppe_sr_xlt_rule_enc(&k, w)) {
+			bad++;
+			continue;
+		}
+		ret = sr_check(io, "identity XLT rule", sr_rule_addr(id->xlt), w, NULL,
+			       PPE_XLT_RULE_TBL_WORDS, &bad);
+	}
+
+	if (!ret && how != PPE_SR_VERIFY_RESYNC)
+		ret = sr_verify_globals(seq, io, &bad);
+
+	for (i = 0; !ret && how == PPE_SR_VERIFY_IDLE && i < PPE_XLT_RULE_TBL_ENTRIES; i++) {
+		ret = sr_rd(io, sr_rule_addr(i), w, PPE_XLT_RULE_TBL_WORDS);
+		if (!ret && ppe_sr_xlt_rule_on_port(w, port) &&
+		    (i > PPE_SR_XLT_LAST || !(own & BIT_ULL(i)))) {
+			sr_log(io, PPE_SR_LOG_ERR, "verify MISMATCH XLT rule %u (%08x) not S-R's",
+			       i, w[0]);
+			bad++;
+		}
+	}
+
+	if (ret)
+		return ret;
+
+	return bad ? -EBADMSG : 0;
+}
+
+/**
+ * ppe_sr_seq_fault() - Latch FAULT (WP2-DESIGN D13).
+ * @seq: The sequence state.
+ * @io: For the ppe byte and the log.
+ * @why: enum ppe_sr_fault.
+ * @step: Where.
+ * @err: The error.
+ *
+ * Asks the caller to latch priv->degraded. Outside OFF and FAULT, moves the
+ * ppe byte to FAULT (best effort: a switch that left READY keeps it) and
+ * the state to FAULT; the claim and every register stay as they are.
+ */
+void ppe_sr_seq_fault(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+		      enum ppe_sr_fault why, enum ppe_sr_step step, int err)
+{
+	u8 from;
+
+	seq->degrade = true;
+	if (seq->state == PPE_SR_S_OFF || seq->state == PPE_SR_S_FAULT)
+		return;
+
+	from = sr_td_ppe(seq->state);
+	if (!io->move(io->ctx, from, RTL8_4S_PPE_FAULT))
+		sr_log(io, PPE_SR_LOG_WARN, "switch left READY: ppe byte %u not moved to FAULT",
+		       from);
+	seq->fault = why;
+	seq->fault_step = step;
+	seq->fault_err = err;
+	sr_set_state(seq, io, PPE_SR_S_FAULT);
+	sr_log(io, PPE_SR_LOG_ERR,
+	       "FAULT %s at %s (%d): claim and registers kept, reboot to recover",
+	       ppe_sr_fault_name(why), ppe_sr_step_name(step), err);
+}
+
+static int sr_arm_rollback(struct ppe_sr_seq *seq, const struct ppe_sr_io *io, int err)
+{
+	u8 step = seq->step;
+	int ret;
+
+	sr_log(io, PPE_SR_LOG_ERR, "arm failed at %s (%d), rolling back", ppe_sr_step_name(step),
+	       err);
+	ret = ppe_sr_seq_revert(seq, io);
+	if (ret) {
+		ppe_sr_seq_fault(seq, io, PPE_SR_F_ROLLBACK_FAILED, seq->step, ret);
+		return -EIO;
+	}
+
+	io->release(io->ctx);
+	seq->step = step;
+	seq->err = err;
+	sr_set_state(seq, io, PPE_SR_S_OFF);
+
+	return err;
+}
+
+/**
+ * ppe_sr_seq_arm() - Arm S-R (A3-A11), offers off.
+ * @seq: The sequence state, OFF.
+ * @io: Register access, flows and the switch's state word.
+ * @cfg: What the arm is for.
+ * @plan: The classes to give identities, sorted (ppe_sr_topo_plan()).
+ * @n: Their number.
+ * @why: Set to the refusal's reason (enum ppe_sr_why).
+ *
+ * Under RTNL and the lock. Refusals (A3, A4) write nothing and leave the
+ * switch unclaimed. Every flow is dropped after the claim; one that cannot
+ * be means release and OFF with @seq->degrade set. A failure from A6 on is
+ * rolled back (release, OFF, the error returned) or, if that fails, FAULT.
+ *
+ * Return: 0 (READY), -EALREADY unless OFF, -EIO in FAULT or after a stuck
+ * flow or a failed rollback, -EINVAL (@why NOTHING for an empty plan),
+ * -ENOSPC (BUDGET), -EBUSY (PRECHECK or SWITCH_NOT_READY), -ENODEV (no
+ * switch), or a rolled-back failure's error (HW).
+ */
+int ppe_sr_seq_arm(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+		   const struct ppe_sr_cfg *cfg, const struct ppe_sr_class *plan, unsigned int n,
+		   enum ppe_sr_why *why)
+{
+	unsigned int stuck, s;
+	u32 sw_gen;
+	u16 s_ports;
+	int ret;
+
+	*why = PPE_SR_W_PRECHECK;
+	if (seq->state == PPE_SR_S_FAULT)
+		return -EIO;
+	if (seq->state != PPE_SR_S_OFF)
+		return -EALREADY;
+	if (!n) {
+		*why = PPE_SR_W_NOTHING;
+		return -EINVAL;
+	}
+	if (n > PPE_SR_ID_MAX) {
+		*why = PPE_SR_W_BUDGET;
+		return -ENOSPC;
+	}
+	if (!sr_plan_ok(plan, n))
+		return -EINVAL;
+
+	seq->cfg = *cfg;
+	seq->step = PPE_SR_STEP_NONE;
+	seq->err = 0;
+	seq->rec = 0;
+	sr_ids_clear(seq);
+
+	ret = ppe_sr_seq_precheck(seq, io);
+	if (!ret)
+		ret = ppe_sr_seq_alloc(seq, io, plan, n);
+	if (ret) {
+		if (ret == -ENOSPC)
+			*why = PPE_SR_W_BUDGET;
+		return ret;
+	}
+
+	seq->step = PPE_SR_STEP_A4;
+	ret = io->claim(io->ctx, &sw_gen, &s_ports);
+	if (!ret && (sw_gen != cfg->sw_gen || s_ports != cfg->s_ports)) {
+		io->release(io->ctx);
+		ret = -EBUSY;
+	}
+	if (ret) {
+		sr_ids_clear(seq);
+		seq->err = ret;
+		*why = PPE_SR_W_SWITCH_NOT_READY;
+		sr_log(io, PPE_SR_LOG_WARN, "arm refused: switch not READY or re-armed (%d)", ret);
+		return ret;
+	}
+	sr_set_state(seq, io, PPE_SR_S_ARMING);
+
+	seq->step = PPE_SR_STEP_A5;
+	stuck = io->flush(io->ctx, PPE_SR_FLUSH_ALL, 0);
+	if (stuck) {
+		io->release(io->ctx);
+		sr_ids_clear(seq);
+		seq->err = -EBUSY;
+		seq->degrade = true;
+		sr_set_state(seq, io, PPE_SR_S_OFF);
+		*why = PPE_SR_W_HW;
+		sr_log(io, PPE_SR_LOG_ERR,
+		       "arm stopped: %u flow(s) stuck in hardware, claim released, nothing written",
+		       stuck);
+		return -EIO;
+	}
+
+	ret = ppe_sr_seq_apply(seq, io);
+	if (!ret) {
+		seq->step = PPE_SR_STEP_A11;
+		ret = ppe_sr_seq_verify(seq, io, PPE_SR_VERIFY_ARM);
+	}
+	if (ret) {
+		*why = PPE_SR_W_HW;
+		return sr_arm_rollback(seq, io, ret);
+	}
+
+	for (s = 0; s < PPE_SR_ID_MAX; s++)
+		seq->id[s].live = seq->id[s].used;
+	seq->step = PPE_SR_STEP_NONE;
+	*why = PPE_SR_W_OK;
+	sr_set_state(seq, io, PPE_SR_S_READY);
+
+	return 0;
+}
+
+/**
+ * ppe_sr_seq_offers() - Turn S-R offers on or off (WP2-DESIGN §4.5).
+ * @seq: The sequence state.
+ * @io: The switch's state word and the flows.
+ * @on: On (READY -> ACTIVE) or off (ACTIVE -> READY, every flow dropped).
+ *
+ * Under the lock. Off with a flow stuck in hardware is FAULT.
+ *
+ * Return: 0 (also when already so), -EINVAL unless READY or ACTIVE, -EBUSY
+ * if the switch refuses ACTIVE, -EIO on FAULT.
+ */
+int ppe_sr_seq_offers(struct ppe_sr_seq *seq, const struct ppe_sr_io *io, bool on)
+{
+	unsigned int stuck;
+
+	if (on) {
+		if (seq->state == PPE_SR_S_ACTIVE)
+			return 0;
+		if (seq->state != PPE_SR_S_READY)
+			return -EINVAL;
+		seq->step = PPE_SR_STEP_OFFERS_ON;
+		if (!io->move(io->ctx, RTL8_4S_PPE_SR_READY, RTL8_4S_PPE_ACTIVE)) {
+			sr_log(io, PPE_SR_LOG_WARN, "switch left READY: offers stay off");
+			return -EBUSY;
+		}
+		sr_set_state(seq, io, PPE_SR_S_ACTIVE);
+		return 0;
+	}
+
+	if (seq->state == PPE_SR_S_READY)
+		return 0;
+	if (seq->state != PPE_SR_S_ACTIVE)
+		return -EINVAL;
+	seq->step = PPE_SR_STEP_OFFERS_OFF;
+	if (!io->move(io->ctx, RTL8_4S_PPE_ACTIVE, RTL8_4S_PPE_SR_READY))
+		sr_log(io, PPE_SR_LOG_WARN, "switch left READY: ppe byte not moved back");
+	sr_set_state(seq, io, PPE_SR_S_READY);
+	stuck = io->flush(io->ctx, PPE_SR_FLUSH_ALL, 0);
+	if (stuck) {
+		ppe_sr_seq_fault(seq, io, PPE_SR_F_STUCK_FLOW, PPE_SR_STEP_OFFERS_OFF, -EBUSY);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+/**
+ * ppe_sr_seq_disarm() - Disarm S-R (D0-D9).
+ * @seq: The sequence state.
+ * @io: Register access, flows and the switch's state word.
+ *
+ * Under the lock. A flow stuck in hardware (D2) or any failed revert
+ * (D3-D8) is FAULT: the claim is kept and nothing more is written.
+ *
+ * Return: 0 (OFF; also when already OFF), -EIO in or into FAULT, -EBUSY
+ * while an arm or a disarm is under way.
+ */
+int ppe_sr_seq_disarm(struct ppe_sr_seq *seq, const struct ppe_sr_io *io)
+{
+	unsigned int stuck;
+	int ret;
+
+	switch (seq->state) {
+	case PPE_SR_S_OFF:
+		return 0;
+	case PPE_SR_S_FAULT:
+		return -EIO;
+	case PPE_SR_S_READY:
+	case PPE_SR_S_ACTIVE:
+		break;
+	default:
+		return -EBUSY;
+	}
+
+	seq->step = PPE_SR_STEP_D1;
+	if (seq->state == PPE_SR_S_ACTIVE &&
+	    !io->move(io->ctx, RTL8_4S_PPE_ACTIVE, RTL8_4S_PPE_SR_READY))
+		sr_log(io, PPE_SR_LOG_WARN, "switch left READY: ppe byte not moved back");
+	sr_set_state(seq, io, PPE_SR_S_DISARMING);
+
+	seq->step = PPE_SR_STEP_D2;
+	stuck = io->flush(io->ctx, PPE_SR_FLUSH_ALL, 0);
+	if (stuck) {
+		ppe_sr_seq_fault(seq, io, PPE_SR_F_STUCK_FLOW, PPE_SR_STEP_D2, -EBUSY);
+		return -EIO;
+	}
+
+	ret = ppe_sr_seq_revert(seq, io);
+	if (ret) {
+		ppe_sr_seq_fault(seq, io, PPE_SR_F_REVERT_MISMATCH, seq->step, ret);
+		return -EIO;
+	}
+
+	io->release(io->ctx);
+	seq->step = PPE_SR_STEP_NONE;
+	sr_set_state(seq, io, PPE_SR_S_OFF);
+
+	return 0;
+}
+
+/**
+ * ppe_sr_diff() - Plan the identity changes of a resync (WP2-DESIGN §5.2).
+ * @old: The identities now, PPE_SR_ID_MAX slots.
+ * @plan: Every class that should have an identity, sorted, no duplicate.
+ * @n: Their number.
+ * @recopy: The conduit's L3 interface changed: rewrite every kept copy.
+ * @flush_ports: Switch ports whose flows to drop at the end, 0 for none.
+ * @ops: Filled in, at most PPE_SR_OPS_MAX.
+ * @declined: Set to the classes of @plan left without an identity because
+ * PPE_SR_ID_MAX are taken.
+ *
+ * Identities of classes no longer planned go first, each FLUSH_ID,
+ * RULE_OFF, ACT_OFF, CNT_OFF, L3IF_RESTORE; then RECOPY of every kept one;
+ * then each new class in @plan order, ALLOC, L3IF_COPY, CNT_ZERO, ACT_ON,
+ * RULE_ON, into the lowest free slot; FLUSH_PORT last. A kept identity is
+ * never displaced by a new class: over budget, new classes decline.
+ *
+ * Return: the number of operations.
+ */
+unsigned int ppe_sr_diff(const struct ppe_sr_id *old, const struct ppe_sr_class *plan,
+			 unsigned int n, bool recopy, u16 flush_ports, struct ppe_sr_op *ops,
+			 unsigned int *declined)
+{
+	static const u8 rm[] = {
+		PPE_SR_OP_FLUSH_ID, PPE_SR_OP_RULE_OFF, PPE_SR_OP_ACT_OFF, PPE_SR_OP_CNT_OFF,
+		PPE_SR_OP_L3IF_RESTORE,
+	};
+	static const u8 add[] = {
+		PPE_SR_OP_ALLOC, PPE_SR_OP_L3IF_COPY, PPE_SR_OP_CNT_ZERO, PPE_SR_OP_ACT_ON,
+		PPE_SR_OP_RULE_ON,
+	};
+	unsigned int nops = 0, held = 0, s, i, k;
+	u64 kept = 0, taken;
+
+	*declined = 0;
+	for (s = 0; s < PPE_SR_ID_MAX; s++) {
+		if (!old[s].used)
+			continue;
+		if (sr_plan_has(plan, n, &old[s].cls)) {
+			kept |= BIT_ULL(s);
+			held++;
+			continue;
+		}
+		for (k = 0; k < ARRAY_SIZE(rm); k++)
+			ops[nops++] = (struct ppe_sr_op){ .code = rm[k], .slot = s };
+	}
+
+	for (s = 0; recopy && s < PPE_SR_ID_MAX; s++)
+		if (kept & BIT_ULL(s))
+			ops[nops++] = (struct ppe_sr_op){ .code = PPE_SR_OP_RECOPY, .slot = s };
+
+	taken = kept;
+	for (i = 0; i < n; i++) {
+		if (sr_ids_have(old, kept, &plan[i]))
+			continue;
+		if (held >= PPE_SR_ID_MAX) {
+			(*declined)++;
+			continue;
+		}
+		for (s = 0; s < PPE_SR_ID_MAX; s++)
+			if (!(taken & BIT_ULL(s)))
+				break;
+		taken |= BIT_ULL(s);
+		held++;
+		for (k = 0; k < ARRAY_SIZE(add); k++)
+			ops[nops++] = (struct ppe_sr_op){ .code = add[k], .slot = s,
+							  .cls = plan[i] };
+	}
+
+	if (flush_ports)
+		ops[nops++] = (struct ppe_sr_op){ .code = PPE_SR_OP_FLUSH_PORT,
+						  .ports = flush_ports };
+
+	return nops;
+}
+
+static int sr_exec_fault(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+			 enum ppe_sr_fault why, int err)
+{
+	seq->err = err;
+	ppe_sr_seq_fault(seq, io, why, seq->step, err);
+	return -EIO;
+}
+
+/**
+ * ppe_sr_seq_exec() - Carry out a resync's diff (WP2-DESIGN §5.2).
+ * @seq: The sequence state, READY or ACTIVE.
+ * @io: Register access and flows.
+ * @ops: From ppe_sr_diff() on @seq->id.
+ * @n: Their number.
+ * @tmpl: The conduit's L3 interface as read now: RECOPY and new identities
+ * copy it; it becomes @seq->tmpl.
+ * @failed: Set to the additions that failed: each was taken back alone and
+ * its class has no identity.
+ *
+ * Reads no foreign entry: new identities are allocated from the arm's
+ * record (struct ppe_sr_seq::xlt_busy, l3if_inert) and S-R's own entries,
+ * reading only the L3 interface they take. A flow left after FLUSH_ID or
+ * FLUSH_PORT, a failed removal or recopy, or a failed take-back of an
+ * addition is FAULT, and the rest is not done.
+ *
+ * Return: 0, -EIO on FAULT, -EINVAL for a bad operation.
+ */
+int ppe_sr_seq_exec(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+		    const struct ppe_sr_op *ops, unsigned int n,
+		    const u32 tmpl[PPE_IN_L3_IF_TBL_WORDS], unsigned int *failed)
+{
+	u32 copy[PPE_IN_L3_IF_TBL_WORDS];
+	unsigned int i, stuck;
+	struct ppe_sr_id *id;
+	u64 skip = 0;
+	int ret;
+
+	*failed = 0;
+	for (i = 0; i < n; i++) {
+		const struct ppe_sr_op *op = &ops[i];
+
+		if (op->slot >= PPE_SR_ID_MAX)
+			return -EINVAL;
+		id = &seq->id[op->slot];
+
+		switch (op->code) {
+		case PPE_SR_OP_FLUSH_ID:
+			seq->step = PPE_SR_STEP_FLUSH_ID;
+			id->live = 0;
+			stuck = io->flush(io->ctx, PPE_SR_FLUSH_ID, op->slot);
+			if (stuck)
+				return sr_exec_fault(seq, io, PPE_SR_F_STUCK_FLOW, -EBUSY);
+			break;
+		case PPE_SR_OP_RULE_OFF:
+		case PPE_SR_OP_ACT_OFF:
+		case PPE_SR_OP_CNT_OFF:
+		case PPE_SR_OP_L3IF_RESTORE:
+			seq->step = PPE_SR_STEP_REMOVE;
+			if (!id->used)
+				return -EINVAL;
+			ret = sr_id_remove(seq, io, id, op->code);
+			if (ret)
+				return sr_exec_fault(seq, io, PPE_SR_F_REVERT_MISMATCH, ret);
+			if (op->code == PPE_SR_OP_L3IF_RESTORE && !id->set) {
+				memset(id, 0, sizeof(*id));
+				seq->nid--;
+			}
+			break;
+		case PPE_SR_OP_RECOPY:
+			seq->step = PPE_SR_STEP_RECOPY;
+			if (!id->used)
+				return -EINVAL;
+			ret = ppe_sr_l3if_copy(tmpl, copy);
+			if (!ret)
+				ret = sr_entry_set(io, sr_l3if_addr(id->l3_if),
+						   PPE_IN_L3_IF_TBL_WORDS, id->l3if_new, copy);
+			if (ret)
+				return sr_exec_fault(seq, io, PPE_SR_F_REVERT_MISMATCH, ret);
+			memcpy(id->l3if_new, copy, sizeof(copy));
+			break;
+		case PPE_SR_OP_ALLOC:
+			seq->step = PPE_SR_STEP_ADD;
+			skip &= ~BIT_ULL(op->slot);
+			ret = sr_alloc_one(seq, io, op->slot, &op->cls, tmpl);
+			if (ret) {
+				skip |= BIT_ULL(op->slot);
+				(*failed)++;
+				sr_log(io, PPE_SR_LOG_WARN,
+				       "no identity for port %u %s VLAN %u (%d)", op->cls.port,
+				       op->cls.form == PPE_SR_U ? "U" : "T", op->cls.vid, ret);
+			}
+			break;
+		case PPE_SR_OP_L3IF_COPY:
+		case PPE_SR_OP_CNT_ZERO:
+		case PPE_SR_OP_ACT_ON:
+		case PPE_SR_OP_RULE_ON:
+			if (skip & BIT_ULL(op->slot))
+				break;
+			seq->step = PPE_SR_STEP_ADD;
+			if (!id->used)
+				return -EINVAL;
+			ret = sr_id_install(seq, io, id, op->code);
+			if (!ret) {
+				if (op->code == PPE_SR_OP_RULE_ON)
+					id->live = 1;
+				break;
+			}
+			skip |= BIT_ULL(op->slot);
+			(*failed)++;
+			sr_log(io, PPE_SR_LOG_WARN, "identity %u not installed (%d), taken back",
+			       op->slot, ret);
+			ret = sr_id_takeback(seq, io, id);
+			if (ret)
+				return sr_exec_fault(seq, io, PPE_SR_F_ROLLBACK_FAILED, ret);
+			memset(id, 0, sizeof(*id));
+			seq->nid--;
+			break;
+		case PPE_SR_OP_FLUSH_PORT:
+			seq->step = PPE_SR_STEP_FLUSH_PORT;
+			stuck = io->flush(io->ctx, PPE_SR_FLUSH_PORTS, op->ports);
+			if (stuck)
+				return sr_exec_fault(seq, io, PPE_SR_F_STUCK_FLOW, -EBUSY);
+			break;
+		default:
+			return -EINVAL;
+		}
+	}
+
+	memcpy(seq->tmpl, tmpl, sizeof(seq->tmpl));
+	seq->step = PPE_SR_STEP_NONE;
+
+	return 0;
+}
+
+/**
+ * ppe_sr_seq_resync() - Bring the identities in line with a new plan.
+ * @seq: The sequence state.
+ * @io: Register access and flows.
+ * @plan: Every class that should have an identity, sorted (classes ∩
+ * scope, not truncated: ppe_sr_diff() keeps live identities first).
+ * @n: Their number.
+ * @recopy: Rewrite every copy even if the conduit's L3 interface reads as
+ * before.
+ * @flush_ports: Switch ports whose flows to drop at the end.
+ * @ops: Scratch room for PPE_SR_OPS_MAX operations.
+ * @declined: Set to the classes left without an identity.
+ *
+ * Under RTNL and the lock; nothing unless READY or ACTIVE (never in FAULT).
+ * Reads the conduit's L3 interface, plans, executes. The caller verifies
+ * after (ppe_sr_seq_verify(), PPE_SR_VERIFY_RESYNC) and disarms on a
+ * mismatch.
+ *
+ * Return: 0, -EIO on FAULT, -EBADMSG if the conduit's L3 interface can no
+ * longer be copied, -EINVAL for a bad plan, or a read error.
+ */
+int ppe_sr_seq_resync(struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+		      const struct ppe_sr_class *plan, unsigned int n, bool recopy,
+		      u16 flush_ports, struct ppe_sr_op *ops, unsigned int *declined)
+{
+	u32 tmpl[PPE_IN_L3_IF_TBL_WORDS], copy[PPE_IN_L3_IF_TBL_WORDS];
+	unsigned int nops, failed;
+	bool changed;
+	int ret;
+
+	*declined = 0;
+	if (seq->state != PPE_SR_S_READY && seq->state != PPE_SR_S_ACTIVE)
+		return 0;
+	if (!sr_plan_ok(plan, n))
+		return -EINVAL;
+
+	seq->step = PPE_SR_STEP_RECOPY;
+	ret = sr_rd(io, sr_l3if_addr(seq->cfg.l3_if), tmpl, PPE_IN_L3_IF_TBL_WORDS);
+	if (ret)
+		return ret;
+	changed = memcmp(tmpl, seq->tmpl, sizeof(tmpl));
+	if (ppe_sr_l3if_copy(tmpl, copy)) {
+		sr_log(io, PPE_SR_LOG_ERR,
+		       "verify MISMATCH template %08x %08x %08x routes nothing", tmpl[0], tmpl[1],
+		       tmpl[2]);
+		return -EBADMSG;
+	}
+
+	nops = ppe_sr_diff(seq->id, plan, n, changed || recopy, flush_ports, ops, declined);
+	ret = ppe_sr_seq_exec(seq, io, ops, nops, tmpl, &failed);
+	*declined += failed;
+
+	return ret;
+}
+
+/**
+ * ppe_sr_seq_boot_check() - S-R's registers at their base (S9).
+ * @io: Register access.
+ * @ppe_port: The conduit's PPE port.
+ *
+ * At enable: the conduit's parser role edge, the CPU port's egress fields
+ * E's, the conduit's L3 binding valid and no valid XLT rule matching the
+ * conduit. Anything else may be left from an S-R mode that did not
+ * disarm, and S-R stays refused until reboot.
+ *
+ * Return: 0, -EBUSY if not at base (said), -EINVAL, or a read error.
+ */
+int ppe_sr_seq_boot_check(const struct ppe_sr_io *io, u8 ppe_port)
+{
+	u32 v, w[PPE_XLT_RULE_TBL_WORDS];
+	unsigned int i;
+	int ret;
+
+	if (!ppe_port || ppe_port >= PPE_PORT_PARSING_ENTRIES)
+		return -EINVAL;
+
+	ret = sr_rd(io, sr_role_addr(ppe_port), &v, 1);
+	if (ret)
+		return ret;
+	if (v & PPE_PORT_PARSING_PORT_ROLE)
+		goto busy;
+	ret = sr_rd(io, sr_tpr_role_addr(ppe_port), &v, 1);
+	if (ret)
+		return ret;
+	if (v & PPE_TPR_PORT_PARSING_PORT_ROLE)
+		goto busy;
+	ret = sr_rd(io, sr_eg_vlan_addr(PPE_SR_CPU_PORT), &v, 1);
+	if (ret)
+		return ret;
+	if ((v & PPE_SR_CPU_EG_MASK) != PPE_SR_CPU_EG_E)
+		goto busy;
+	ret = sr_rd(io, sr_bind_addr(ppe_port), &v, 1);
+	if (ret)
+		return ret;
+	if (!(v & PPE_L3_VP_PORT_TBL_L3_IF_VALID))
+		goto busy;
+	for (i = 0; i < PPE_XLT_RULE_TBL_ENTRIES; i++) {
+		ret = sr_rd(io, sr_rule_addr(i), w, PPE_XLT_RULE_TBL_WORDS);
+		if (ret)
+			return ret;
+		if (ppe_sr_xlt_rule_on_port(w, ppe_port)) {
+			v = w[0];
+			goto busy;
+		}
+	}
+
+	return 0;
+
+busy:
+	sr_log(io, PPE_SR_LOG_ERR, "not inert at boot (PPE port %u, %08x): refused until reboot",
+	       ppe_port, v);
+	return -EBUSY;
+}
+
+/**
+ * ppe_sr_seq_id_find() - The live identity of a class.
+ * @seq: The sequence state.
+ * @cls: The class.
+ *
+ * Under the lock; memory only.
+ *
+ * Return: its slot, or -ENOENT.
+ */
+int ppe_sr_seq_id_find(const struct ppe_sr_seq *seq, const struct ppe_sr_class *cls)
+{
+	unsigned int s;
+
+	for (s = 0; s < PPE_SR_ID_MAX; s++)
+		if (seq->id[s].used && seq->id[s].live && ppe_sr_class_eq(&seq->id[s].cls, cls))
+			return s;
+
+	return -ENOENT;
+}
+
+/**
+ * ppe_sr_seq_id_counters() - Read an identity's hardware counters.
+ * @seq: The sequence state.
+ * @io: Register access.
+ * @slot: The identity's slot.
+ * @c: Filled in.
+ *
+ * Reads registers: idle only.
+ *
+ * Return: 0, -ENOENT for an empty slot, or a read error.
+ */
+int ppe_sr_seq_id_counters(const struct ppe_sr_seq *seq, const struct ppe_sr_io *io,
+			   unsigned int slot, struct ppe_sr_id_cnt *c)
+{
+	u32 w[PPE_RT_INTERFACE_CNT_TBL_WORDS];
+	const struct ppe_sr_id *id;
+	int ret;
+
+	if (slot >= PPE_SR_ID_MAX || !seq->id[slot].used)
+		return -ENOENT;
+	id = &seq->id[slot];
+
+	ret = sr_rd(io, sr_cnt_addr(id->xlt), w, PPE_VLAN_DEV_CNT_TBL_WORDS);
+	if (ret)
+		return ret;
+	ppe_sr_vlan_cnt_dec(w, &c->xlt);
+	ret = sr_rd(io, sr_rt_cnt_addr(id->l3_if), w, PPE_RT_INTERFACE_CNT_TBL_WORDS);
+	if (ret)
+		return ret;
+	ppe_sr_rt_cnt_dec(w, &c->rt_in);
+	ret = sr_rd(io, sr_rt_cnt_addr(id->l3_if + PPE_IN_L3_IF_TBL_ENTRIES), w,
+		    PPE_RT_INTERFACE_CNT_TBL_WORDS);
+	if (ret)
+		return ret;
+	ppe_sr_rt_cnt_dec(w, &c->rt_eg);
+
+	return 0;
+}
