+/* Word 1: the C key format's upper bits, the C-VID key and the EtherType
+ * key (PROT_VALUE's low 7 bits here, the upper 9 in word 2; vendor
+ * _insert_vlan_trans_adv_rule_action()).
+ */
+#define PPE_XLT_RULE_W1_CKEY_FMT_1		GENMASK(1, 0)
+#define PPE_XLT_RULE_W1_CKEY_VID_INCL		BIT(2)
+#define PPE_XLT_RULE_W1_CKEY_VID		GENMASK(14, 3)
+#define PPE_XLT_RULE_W1_PROT_INCL		BIT(24)
+#define PPE_XLT_RULE_W1_PROT_VALUE_0		GENMASK(31, 25)
+
+/* Word 2: PORT_TYPE 0, PORT_BITMAP holds physical ports (vendor
+ * adpt_port_type_convert()); 1 and 2 make it a VP profile or VP ID.
+ */
+#define PPE_XLT_RULE_W2_PROT_VALUE_1		GENMASK(8, 0)
+#define PPE_XLT_RULE_W2_PORT_TYPE		GENMASK(10, 9)
+
+/* Key formats, a bitmap (vendor FAL_PORT_VLAN_XLT_MATCH_*). */
+#define PPE_XLT_FMT_UNTAGGED			BIT(0)
+#define PPE_XLT_FMT_PRIORITY			BIT(1)
+#define PPE_XLT_FMT_TAGGED			BIT(2)
+
+#define PPE_XLT_ACTION_TBL_ADDR			0x13000
+#define PPE_XLT_ACTION_TBL_ENTRIES		128
+#define PPE_XLT_ACTION_TBL_INC			0x10
+#define PPE_XLT_ACTION_TBL_WORDS		3
+
+/* Word 1; word 0 holds the VID and PCP commands. */
+#define PPE_XLT_ACTION_W1_VSI_CMD		BIT(11)
+#define PPE_XLT_ACTION_W1_SRC_INFO_VALID	BIT(18)
+#define PPE_XLT_ACTION_W1_SRC_INFO_TYPE		BIT(19)
+#define PPE_XLT_ACTION_W1_SRC_INFO		GENMASK(27, 20)
+#define PPE_XLT_ACTION_W1_COUNTER_EN		BIT(28)
+#define PPE_XLT_ACTION_W1_COUNTER_ID_0		GENMASK(31, 29)
+
+/* Word 2: the counter ID's upper bits. */
+#define PPE_XLT_ACTION_W2_COUNTER_ID_1		GENMASK(3, 0)
+
+/* SRC_INFO_TYPE: SRC_INFO is an L3 interface (0: a virtual port). */
+#define PPE_XLT_SRC_INFO_TYPE_L3_IF		1
+
+/* The frames an XLT action counted, at its COUNTER_ID (vendor
+ * VLAN_DEV_CNT_TBL, INGRESS_POLICER_BASE_ADDR 0x100000 + 0x7f000): packets,
+ * then 40 bits of bytes.
+ */
+#define PPE_VLAN_DEV_CNT_TBL_ADDR		0x17f000
+#define PPE_VLAN_DEV_CNT_TBL_ENTRIES		128
+#define PPE_VLAN_DEV_CNT_TBL_INC		0x10
+#define PPE_VLAN_DEV_CNT_TBL_WORDS		3
+#define PPE_VLAN_DEV_CNT_W2_BYTE_HI		GENMASK(7, 0)
+
+/* Routed frames per L3 interface, ingress at its index and egress 256 above
