+		else
+			list_add_tail(&pool->entry[i].list, &pool->free);
 	}
 }
 
+/**
+ * ppe_nexthop_pool_sink_set() - Program the CPU sink entry.
+ * @ppe_dev: PPE device.
+ * @pool: The pool.
+ *
+ * Index PPE_NEXTHOP_POOL_SINK, which the pool never hands out, egresses to
+ * the CPU port with IP_TO_ME. Written and read back; nothing uses it as a
+ * flow's nexthop, so it may be written at any time.
+ *
+ * Return: 0, or a negative error code (the entry then zeroed if it was
+ * written).
+ */
+int ppe_nexthop_pool_sink_set(struct ppe_device *ppe_dev, struct ppe_nexthop_pool *pool)
+{
+	int ret;
+
+	mutex_lock(&pool->lock);
+	ret = ppe_nexthop_pool_write(ppe_dev, PPE_NEXTHOP_POOL_SINK, &ppe_nexthop_sink);
+	mutex_unlock(&pool->lock);
+
+	return ret;
+}
+
