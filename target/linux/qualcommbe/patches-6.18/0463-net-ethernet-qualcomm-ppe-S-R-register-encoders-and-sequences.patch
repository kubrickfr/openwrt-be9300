+ * bytes, then 32 bits of dropped packets and 40 of dropped bytes spread over
+ * words 2 to 4.
+ */
+#define PPE_RT_INTERFACE_CNT_TBL_ADDR		0x140000
+#define PPE_RT_INTERFACE_CNT_TBL_ENTRIES	512
+#define PPE_RT_INTERFACE_CNT_TBL_INC		0x20
+#define PPE_RT_INTERFACE_CNT_TBL_WORDS		5
+#define PPE_RT_INTERFACE_CNT_W2_BYTE_HI		GENMASK(7, 0)
+#define PPE_RT_INTERFACE_CNT_W2_DROP_PKT_LO	GENMASK(31, 8)
+#define PPE_RT_INTERFACE_CNT_W3_DROP_PKT_HI	GENMASK(7, 0)
+#define PPE_RT_INTERFACE_CNT_W3_DROP_BYTE_LO	GENMASK(31, 8)
+#define PPE_RT_INTERFACE_CNT_W4_DROP_BYTE_HI	GENMASK(15, 0)
+
