+	.proto = DSA_TAG_PROTO_RTL8_4S,
+	.xmit = rtl8_4_tag_xmit,
+	.rcv = rtl8_4s_tag_rcv,
+	.flow_dissect = rtl8_4s_flow_dissect,
+	.connect = rtl8_4s_connect,
+	.disconnect = rtl8_4s_disconnect,
+	.needed_headroom = RTL8_4_TAG_LEN,
+};
+
