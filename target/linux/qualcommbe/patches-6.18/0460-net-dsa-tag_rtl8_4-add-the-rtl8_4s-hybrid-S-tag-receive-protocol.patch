+++ b/net/dsa/tag_rtl8_4s.h
@@ -0,0 +1,229 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Receive classifier of the rtl8_4s tagger in tag_rtl8_4.c.
+ *
+ * This file is pure: it needs only part 1 of <linux/dsa/rtl8_4s.h> and touches
+ * no kernel object, so that a user-space harness can compile it, with
+ * RTL8_4S_PURE defined, against the same table the kernel uses.
+ */
+
+#ifndef __DSA_TAG_RTL8_4S_H
+#define __DSA_TAG_RTL8_4S_H
+
+#include <linux/dsa/rtl8_4s.h>
+
+/* EtherTypes, equal to ETH_P_REALTEK, ETH_P_8021AD and ETH_P_8021Q */
+#define RTL8_4S_ET_RTL		0x8899
+#define RTL8_4S_ET_S		0x88a8
+#define RTL8_4S_ET_C		0x8100
+
+/* Frame offsets from the DA */
+#define RTL8_4S_OFF_ET		12	/* outer EtherType */
+#define RTL8_4S_OFF_REASON	15	/* rtl8_4: REASON, after the protocol */
+#define RTL8_4S_OFF_TCI		14	/* S-tag TCI */
+#define RTL8_4S_OFF_IET		16	/* type after the S-tag */
+#define RTL8_4S_OFF_RT_IET	20	/* type after the 8 byte tag */
+
+/*
+ * Linear bytes the classifier needs: the MACs, the 8 byte tag and the TCI of
+ * a C-tag behind it
+ */
+#define RTL8_4S_CLS_LEN		24
+
+#define RTL8_4S_S_TAG_LEN	4
+#define RTL8_4S_VID_MASK	0xfff
+
+enum rtl8_4s_verdict {
+	RTL8_4S_V_DROP,		/* drop and count rtl8_4s_cls.drop */
+	RTL8_4S_V_RT,		/* outer rtl8_4 tag: rtl8_4_tag_rcv() */
+	RTL8_4S_V_S,		/* S-tag of an armed port: strip it */
+};
+
+struct rtl8_4s_cls {
+	u8 verdict;		/* enum rtl8_4s_verdict */
+	u8 drop;		/* RTL8_4S_V_DROP: enum rtl8_4s_drop */
+	u8 port;		/* RTL8_4S_V_S: the ingress switch port */
+	bool mark;		/* RTL8_4S_V_S: the DA is not link-local */
+	bool warn;		/* RTL8_4S_V_DROP: warn, rate limited */
+	bool nested;		/* RTL8_4S_V_S: the inner type is 0x88a8 */
+	u16 val;		/* the EtherType or VID the drop is about */
+};
+
+static inline u16 rtl8_4s_get_be16(const u8 *p)
+{
+	return p[0] << 8 | p[1];
+}
+
+/* 01:80:c2:00:00:0X, as is_link_local_ether_addr() */
+static inline bool rtl8_4s_link_local(const u8 *da)
+{
+	return da[0] == 0x01 && da[1] == 0x80 && da[2] == 0xc2 &&
+	       !da[3] && !da[4] && !(da[5] & 0xf0);
+}
+
+/* A C-tag at @t with a VID in 3900-3919, the switch's steering VLANs */
+static inline bool rtl8_4s_inner_rsv(const u8 *t, u16 *vid)
+{
+	*vid = rtl8_4s_get_be16(t + 2) & RTL8_4S_VID_MASK;
+	return rtl8_4s_get_be16(t) == RTL8_4S_ET_C && rtl8_4s_vid_reserved(*vid);
+}
+
+static inline void rtl8_4s_drop_as(struct rtl8_4s_cls *c, u8 drop, bool warn,
+				   u16 val)
+{
+	c->drop = drop;
+	c->warn = warn;
+	c->val = val;
+}
+
+/**
+ * rtl8_4s_classify() - decide what to do with a frame the conduit received
+ * @f: the frame, from its DA
+ * @len: linear bytes at @f; 0 when they could not be pulled
+ * @accept: enum rtl8_4s_accept, as the switch driver published it
+ * @s_ports: the armed user ports, read after @accept
+ * @hwaccel: the frame carries a hardware-accelerated VLAN tag
+ * @c: the decision
+ *
+ * The outermost tag decides, and the first matching rule wins:
+ *
+ *  1. a hwaccel tag: drop (HWACCEL);
+ *  2. accept NONE: drop (NOT_READY), silently, since every arm and disarm
+ *     crosses it;
+ *  3. fewer than RTL8_4S_CLS_LEN bytes: drop (TRUNC);
+ *  4. rtl8_4 with REASON 0 under accept S: drop (RT_REASON0) and warn. Armed,
+ *     the switch tags only trapped frames, with a non-zero REASON, so this
+ *     is a frame left from before the arm, or a forgery;
+ *  5. any other rtl8_4 frame: rtl8_4_tag_rcv(), unchanged, unless a C-tag
+ *     with a VID in 3900-3919 follows the 8 byte tag: drop that (INNER_RSV),
+ *     silently, as in rule 11. The switch driver's entries for those VIDs
+ *     are C-VLANs too, and while they exist (an arm in progress, a FAULT
+ *     that left them) a port can reach the CPU with one under the 8 byte
+ *     tag;
+ *  6. neither 0x8899 nor 0x88a8 outside: drop (ETYPE) and warn;
+ *  7. 0x88a8 unless accept is S: drop (S_OFF), silently;
+ *  8. S-VID 3910-3919: drop (SVID_DN) and warn; the switch never sends it;
+ *  9. S-VID outside 3900-3919: drop (SVID_OTHER) and warn;
+ * 10. S-VID 3900 + p, p not armed (the CPU port included): drop (SVID_PORT)
+ *     and warn;
+ * 11. inner 0x8100 with a VID in 3900-3919: drop (INNER_RSV), silently,
+ *     since clients choose it;
+ * 12. otherwise deliver on port p, stripping only the S-tag. Whatever
+ *     follows is payload, a client's own 0x88a8 (@c->nested) included.
+ */
+static inline void rtl8_4s_classify(const u8 *f, unsigned int len, u8 accept,
+				    u16 s_ports, bool hwaccel,
+				    struct rtl8_4s_cls *c)
+{
+	u16 et, vid, ivid;
+	int p;
+
+	*c = (struct rtl8_4s_cls){ .verdict = RTL8_4S_V_DROP };
+
+	if (hwaccel) {
+		rtl8_4s_drop_as(c, RTL8_4S_DROP_HWACCEL, false, 0);
+		return;
+	}
+	if (accept == RTL8_4S_ACCEPT_NONE) {
+		rtl8_4s_drop_as(c, RTL8_4S_DROP_NOT_READY, false, 0);
+		return;
+	}
+	if (len < RTL8_4S_CLS_LEN) {
+		rtl8_4s_drop_as(c, RTL8_4S_DROP_TRUNC, false, 0);
+		return;
+	}
+
+	et = rtl8_4s_get_be16(f + RTL8_4S_OFF_ET);
+	if (et == RTL8_4S_ET_RTL) {
+		if (accept == RTL8_4S_ACCEPT_S && !f[RTL8_4S_OFF_REASON]) {
+			rtl8_4s_drop_as(c, RTL8_4S_DROP_RT_REASON0, true, et);
+			return;
+		}
+		if (rtl8_4s_inner_rsv(f + RTL8_4S_OFF_RT_IET, &ivid)) {
+			rtl8_4s_drop_as(c, RTL8_4S_DROP_INNER_RSV, false, ivid);
+			return;
+		}
+		c->verdict = RTL8_4S_V_RT;
+		return;
+	}
+	if (et != RTL8_4S_ET_S) {
+		rtl8_4s_drop_as(c, RTL8_4S_DROP_ETYPE, true, et);
+		return;
+	}
+	if (accept != RTL8_4S_ACCEPT_S) {
+		rtl8_4s_drop_as(c, RTL8_4S_DROP_S_OFF, false, 0);
+		return;
+	}
+
+	vid = rtl8_4s_get_be16(f + RTL8_4S_OFF_TCI) & RTL8_4S_VID_MASK;
+	if (vid >= RTL8_4S_SVID_DN_BASE && vid <= RTL8_4S_VID_RSV_LAST) {
+		rtl8_4s_drop_as(c, RTL8_4S_DROP_SVID_DN, true, vid);
+		return;
+	}
+	p = rtl8_4s_up_port(vid);
+	if (p < 0) {
+		rtl8_4s_drop_as(c, RTL8_4S_DROP_SVID_OTHER, true, vid);
+		return;
+	}
+	if (!(s_ports & BIT(p))) {
+		rtl8_4s_drop_as(c, RTL8_4S_DROP_SVID_PORT, true, vid);
+		return;
+	}
+
+	if (rtl8_4s_inner_rsv(f + RTL8_4S_OFF_IET, &ivid)) {
+		rtl8_4s_drop_as(c, RTL8_4S_DROP_INNER_RSV, false, ivid);
+		return;
+	}
+
+	c->verdict = RTL8_4S_V_S;
+	c->port = p;
+	c->val = vid;
+	c->nested = rtl8_4s_get_be16(f + RTL8_4S_OFF_IET) == RTL8_4S_ET_S;
+	c->mark = !rtl8_4s_link_local(f);
+}
+
+/**
+ * rtl8_4s_dissect() - where the flow dissector finds the real EtherType
+ * @t: the outer EtherType (skb->data - 2 on the conduit)
+ * @len: bytes available at @t
+ * @off: set to the bytes to skip after skb->data
+ * @proto: set to the real EtherType, host order (0 if it is not there)
+ *
+ * After an S-tag the real type follows the 4 byte tag; anything else is
+ * taken as the 8 byte rtl8_4 tag, which is what dsa_tag_generic_flow_dissect()
+ * assumes for a headroom of 8.
+ */
+static inline void rtl8_4s_dissect(const u8 *t, unsigned int len, int *off,
+				   u16 *proto)
+{
+	if (len >= 6 && rtl8_4s_get_be16(t) == RTL8_4S_ET_S) {
+		*off = RTL8_4S_S_TAG_LEN;
+		*proto = rtl8_4s_get_be16(t + 4);
+		return;
+	}
+	*off = 8;
+	*proto = len >= 10 ? rtl8_4s_get_be16(t + 8) : 0;
+}
+
+/* The drop_<name> keys of the switch driver's svlan_counters */
+static inline const char *rtl8_4s_drop_name(unsigned int drop)
+{
+	static const char * const names[RTL8_4S_DROP_NUM] = {
+		[RTL8_4S_DROP_NOT_READY]	= "not_ready",
+		[RTL8_4S_DROP_S_OFF]		= "s_off",
+		[RTL8_4S_DROP_HWACCEL]		= "hwaccel",
+		[RTL8_4S_DROP_TRUNC]		= "trunc",
+		[RTL8_4S_DROP_ETYPE]		= "etype",
+		[RTL8_4S_DROP_RT]		= "rt",
+		[RTL8_4S_DROP_RT_REASON0]	= "rt_reason0",
+		[RTL8_4S_DROP_SVID_DN]		= "svid_dn",
+		[RTL8_4S_DROP_SVID_OTHER]	= "svid_other",
+		[RTL8_4S_DROP_SVID_PORT]	= "svid_port",
+		[RTL8_4S_DROP_NO_USER]		= "no_user",
+		[RTL8_4S_DROP_INNER_RSV]	= "inner_rsv",
+	};
+
+	return drop < RTL8_4S_DROP_NUM && names[drop] ? names[drop] : "?";
+}
+
+#endif /* __DSA_TAG_RTL8_4S_H */
