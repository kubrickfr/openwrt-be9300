@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+/* IPv4 5-tuple flow entry field encoding, SNAT variant.
+ *
+ * This packs/unpacks struct ppe_flow_ipv4_nat_entry to/from the
+ * PPE_FLOW_TBL_IPV4_ENTRY_WORDS-word format ppe_flow_entry_add()/whatever
+ * read-back path is eventually built expects. Field layout is cross-word:
+ * PRI_PROFILE splits 1+4 bits across words 1/2, the 32-bit IP address
+ * splits 20+12 bits across words 2/3, and L4_DPORT splits 4+12 bits
+ * across words 3/4, and the APPE-only PMTU splits 11+3 bits across
+ * words 4/5 -- all confirmed against the vendor SDK's own packed
+ * bitfield struct (struct in_flow_tbl_0, include/hsl/hppe/hppe_flow_reg.h)
+ * and its actual field-assignment code (adpt_hppe_flow_entry_add(),
+ * src/adpt/hppe/adpt_hppe_flow.c), not derived from the field-offset
+ * table alone.
+ *
+ * IP address representation matches ppe_nexthop.c's dnat_ip: a plain
+ * 32-bit register value equal to be32_to_cpu() of the address, confirmed
+ * via fal_ip4_addr_t's definition (a bare a_uint32_t assigned with no
+ * byte manipulation in vendor code).
+ */
+
+#include <linux/bitfield.h>
+#include <linux/types.h>
+
+#include "ppe_flow.h"
+#include "ppe_flow_ipv4.h"
+#include "ppe_regs.h"
+
+/**
+ * ppe_flow_ipv4_nat_entry_encode() - Pack an IPv4 SNAT or DNAT flow entry.
+ * @entry: The entry to pack.
+ * @words: Where to write the packed PPE_FLOW_TBL_IPV4_ENTRY_WORDS words.
+ */
+void ppe_flow_ipv4_nat_entry_encode(const struct ppe_flow_ipv4_nat_entry *entry,
+				    u32 words[PPE_FLOW_TBL_IPV4_ENTRY_WORDS])
+{
+	u32 ip = be32_to_cpu(entry->match_ip);
+
+	words[0] = entry->valid ? PPE_FLOW_TBL_VALID : 0;
+	/* ENTRY_TYPE is always 0 (IPv4) in this file. */
+	words[0] |= entry->host_addr_is_dst ? PPE_FLOW_TBL_HOST_ADDR_INDEX_TYPE : 0;
+	words[0] |= FIELD_PREP(PPE_FLOW_TBL_HOST_ADDR_INDEX, entry->host_addr_index);
+	words[0] |= FIELD_PREP(PPE_FLOW_TBL_PROTOCOL_TYPE, entry->protocol);
+	words[0] |= FIELD_PREP(PPE_FLOW_TBL_AGE, entry->age);
+	words[0] |= entry->src_l3_if_valid ? PPE_FLOW_TBL_SRC_L3_IF_VALID : 0;
+	words[0] |= FIELD_PREP(PPE_FLOW_TBL_SRC_L3_IF, entry->src_l3_if);
+	words[0] |= FIELD_PREP(PPE_FLOW_TBL_FWD_TYPE, entry->fwd_type);
+
+	words[1] = FIELD_PREP(PPE_FLOW_TBL_SNAT_NEXT_HOP, entry->nat_nexthop);
+	words[1] |= FIELD_PREP(PPE_FLOW_TBL_SNAT_L4_PORT, entry->nat_l4_port);
+	words[1] |= entry->deacclr_en ? PPE_FLOW_TBL_DE_ACCE : 0;
+	words[1] |= entry->copy_to_cpu ? PPE_FLOW_TBL_COPY_TO_CPU_EN : 0;
+	words[1] |= entry->syn_toggle ? PPE_FLOW_TBL_SYN_TOGGLE : 0;
+	words[1] |= FIELD_PREP(PPE_FLOW_TBL_PRI_PROFILE_0, entry->pri_profile & 0x1);
+
+	words[2] = FIELD_PREP(PPE_FLOW_TBL_PRI_PROFILE_1, entry->pri_profile >> 1);
+	words[2] |= FIELD_PREP(PPE_FLOW_TBL_SERVICE_CODE, entry->service_code);
+	words[2] |= FIELD_PREP(PPE_FLOW_TBL_IP_ADDR_0, ip);
+
+	words[3] = FIELD_PREP(PPE_FLOW_TBL_IP_ADDR_1, ip >> 20);
+	words[3] |= FIELD_PREP(PPE_FLOW_TBL_L4_SPORT, entry->match_sport);
+	words[3] |= FIELD_PREP(PPE_FLOW_TBL_L4_DPORT_0, entry->match_dport);
+
+	words[4] = FIELD_PREP(PPE_FLOW_TBL_L4_DPORT_1, entry->match_dport >> 4);
+	words[4] |= entry->pmtu_check_l3 ? PPE_FLOW_TBL_PMTU_CHECK_TYPE : 0;
+	words[4] |= FIELD_PREP(PPE_FLOW_TBL_PMTU_0, entry->pmtu);
+	words[5] = FIELD_PREP(PPE_FLOW_TBL_PMTU_1, entry->pmtu >> 11);
+}
+
+/**
+ * ppe_flow_ipv4_nat_entry_decode() - Unpack an IPv4 SNAT or DNAT flow entry.
+ * @words: The packed PPE_FLOW_TBL_IPV4_ENTRY_WORDS words to unpack.
+ * @entry: Where to store the unpacked entry.
+ *
+ * Recovers FWD_TYPE into entry->fwd_type, but does not validate it:
+ * callers are expected to only decode entries they know use one of the
+ * two NAT layouts (e.g. ones they wrote themselves).
+ */
+void ppe_flow_ipv4_nat_entry_decode(const u32 words[PPE_FLOW_TBL_IPV4_ENTRY_WORDS],
+				    struct ppe_flow_ipv4_nat_entry *entry)
+{
+	u32 ip;
+
+	entry->valid = !!(words[0] & PPE_FLOW_TBL_VALID);
+	entry->fwd_type = FIELD_GET(PPE_FLOW_TBL_FWD_TYPE, words[0]);
+	entry->host_addr_is_dst = !!(words[0] & PPE_FLOW_TBL_HOST_ADDR_INDEX_TYPE);
+	entry->host_addr_index = FIELD_GET(PPE_FLOW_TBL_HOST_ADDR_INDEX, words[0]);
+	entry->protocol = FIELD_GET(PPE_FLOW_TBL_PROTOCOL_TYPE, words[0]);
+	entry->age = FIELD_GET(PPE_FLOW_TBL_AGE, words[0]);
+	entry->src_l3_if_valid = !!(words[0] & PPE_FLOW_TBL_SRC_L3_IF_VALID);
+	entry->src_l3_if = FIELD_GET(PPE_FLOW_TBL_SRC_L3_IF, words[0]);
+
+	entry->nat_nexthop = FIELD_GET(PPE_FLOW_TBL_SNAT_NEXT_HOP, words[1]);
+	entry->nat_l4_port = FIELD_GET(PPE_FLOW_TBL_SNAT_L4_PORT, words[1]);
+	entry->deacclr_en = !!(words[1] & PPE_FLOW_TBL_DE_ACCE);
+	entry->copy_to_cpu = !!(words[1] & PPE_FLOW_TBL_COPY_TO_CPU_EN);
+	entry->syn_toggle = !!(words[1] & PPE_FLOW_TBL_SYN_TOGGLE);
+
+	entry->pri_profile = FIELD_GET(PPE_FLOW_TBL_PRI_PROFILE_0, words[1]) |
+			      (FIELD_GET(PPE_FLOW_TBL_PRI_PROFILE_1, words[2]) << 1);
+	entry->service_code = FIELD_GET(PPE_FLOW_TBL_SERVICE_CODE, words[2]);
+
+	ip = FIELD_GET(PPE_FLOW_TBL_IP_ADDR_0, words[2]) |
+	     (FIELD_GET(PPE_FLOW_TBL_IP_ADDR_1, words[3]) << 20);
+	entry->match_ip = cpu_to_be32(ip);
+
+	entry->match_sport = FIELD_GET(PPE_FLOW_TBL_L4_SPORT, words[3]);
+	entry->match_dport = FIELD_GET(PPE_FLOW_TBL_L4_DPORT_0, words[3]) |
+			      (FIELD_GET(PPE_FLOW_TBL_L4_DPORT_1, words[4]) << 4);
+	entry->pmtu_check_l3 = !!(words[4] & PPE_FLOW_TBL_PMTU_CHECK_TYPE);
+	entry->pmtu = FIELD_GET(PPE_FLOW_TBL_PMTU_0, words[4]) |
+		      (FIELD_GET(PPE_FLOW_TBL_PMTU_1, words[5]) << 11);
+}
