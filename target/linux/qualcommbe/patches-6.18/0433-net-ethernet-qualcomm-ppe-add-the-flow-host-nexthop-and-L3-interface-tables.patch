--- /dev/null
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
@@ -0,0 +1,266 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+/* PPE flow table -- hardware NAT/routing flow entries. Unlike the rest of
+ * the PPE's tables, which are addressed directly (one MMIO offset per
+ * entry), the flow table is accessed indirectly through a fixed
+ * command/data/result register triplet: write the entry's data words,
+ * write a command describing the operation and target index, then poll
+ * the result register until hardware reports the operation done.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/mutex.h>
+#include <linux/regmap.h>
+
+#include "ppe.h"
+#include "ppe_flow.h"
+#include "ppe_regs.h"
+
+/* Values for PPE_IN_FLOW_TBL_OP's OP_TYPE field. */
+enum ppe_flow_tbl_op_type {
+	PPE_FLOW_TBL_OP_ADD = 0,
+	PPE_FLOW_TBL_OP_DEL,
+	PPE_FLOW_TBL_OP_GET,
+	PPE_FLOW_TBL_OP_FLUSH,
+};
+
+/* Per-table command tag, mirroring the vendor SDK's hppe_flow.c
+ * flow_cmd_id -- see ppe_host_cmd_id in ppe_host.c.
+ */
+static u32 ppe_flow_cmd_id;
+
+/* Trigger the given flow table operation and wait for hardware to
+ * complete it. *index is the entry index to operate on for
+ * PPE_FLOW_OP_MODE_INDEX (input); for PPE_FLOW_OP_MODE_HASH it is
+ * ignored on input and set to the hardware-assigned index on success.
+ */
+static int ppe_flow_tbl_op_wait(struct ppe_device *ppe_dev,
+				 enum ppe_flow_tbl_op_type op_type,
+				 enum ppe_flow_op_mode mode, u32 *index)
+{
+	u32 val, rslt, cmd_id;
+	int ret;
+
+	cmd_id = ppe_flow_cmd_id++ & FIELD_MAX(PPE_IN_FLOW_TBL_OP_CMD_ID);
+
+	val = FIELD_PREP(PPE_IN_FLOW_TBL_OP_CMD_ID, cmd_id);
+	val |= FIELD_PREP(PPE_IN_FLOW_TBL_OP_OP_TYPE, op_type);
+	val |= FIELD_PREP(PPE_IN_FLOW_TBL_OP_HASH_BLOCK_BITMAP, 3);
+	val |= FIELD_PREP(PPE_IN_FLOW_TBL_OP_OP_MODE, mode);
+	val |= FIELD_PREP(PPE_IN_FLOW_TBL_OP_ENTRY_INDEX, *index);
+
+	ret = regmap_write(ppe_dev->regmap, PPE_IN_FLOW_TBL_OP_ADDR, val);
+	if (ret)
+		return ret;
+
+	/* VALID_CNT is a counter, not a one-shot valid bit, and nothing clears
+	 * it between operations -- a stale result left by a previous op would
+	 * otherwise satisfy the poll immediately and we would adopt ITS entry
+	 * index. Match the command tag we just issued, which is what the tag is
+	 * for, so an add cannot return a foreign index (leaving the entry we
+	 * actually programmed untracked and never deleted) and a delete cannot
+	 * remove an unrelated live flow.
+	 */
+	ret = regmap_read_poll_timeout(ppe_dev->regmap, PPE_IN_FLOW_TBL_OP_RSLT_ADDR,
+					rslt,
+					FIELD_GET(PPE_IN_FLOW_TBL_OP_RSLT_VALID_CNT, rslt) &&
+					FIELD_GET(PPE_IN_FLOW_TBL_OP_RSLT_CMD_ID, rslt) == cmd_id,
+					10, 2000);
+	if (ret)
+		return ret;
+
+	/* A hash-mode add is refused when no way of the key's bucket is free:
+	 * the only refusal seen on the GL-BE9300, and what callers need to
+	 * tell from a fault. Any other refusal stays -EIO.
+	 */
+	if (FIELD_GET(PPE_IN_FLOW_TBL_OP_RSLT_OP_RSLT, rslt))
+		return op_type == PPE_FLOW_TBL_OP_ADD && mode == PPE_FLOW_OP_MODE_HASH ?
+		       -ENOSPC : -EIO;
+
+	*index = FIELD_GET(PPE_IN_FLOW_TBL_OP_RSLT_ENTRY_INDEX, rslt);
+
+	/* The result field is 12 bits wide but the MPPE table only has
+	 * PPE_IN_FLOW_TBL_ENTRIES slots. Report it rather than fail: the
+	 * op has already taken effect, and callers size their per-index
+	 * state by the field width, so the index stays usable.
+	 */
+	if (*index >= PPE_IN_FLOW_TBL_ENTRIES)
+		dev_warn_once(ppe_dev->dev, "flow table op returned index %u beyond table size %u\n",
+			      *index, PPE_IN_FLOW_TBL_ENTRIES);
+
+	return 0;
+}
+
+/**
+ * ppe_flow_counter_get() - Read a flow entry's cumulative hit counters.
+ * @ppe_dev: PPE device.
+ * @index: Flow table entry index.
+ * @packets: Out: packets matched by this entry since it was programmed.
+ * @bytes: Out: bytes matched by this entry since it was programmed.
+ *
+ * The counters live in a separate table from the flow entries themselves and are
+ * addressed directly (no command/result handshake). They are cumulative, are not
+ * clear-on-read, and are only zeroed when ppe_flow_entry_add() clears them for a
+ * freshly programmed index -- so the caller keeps the previous reading and
+ * reports a delta.
+ *
+ * The byte counter is 40 bits split across two words, and hardware keeps
+ * counting between the two reads, so a naive read can combine a pre-carry low
+ * word with a post-carry high byte and be wrong by 4GiB. Re-read the high byte
+ * and retry if it moved.
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_flow_counter_get(struct ppe_device *ppe_dev, u32 index,
+			 u64 *packets, u64 *bytes)
+{
+	u32 addr, pkt, lo, hi, hi_again;
+	int ret, tries;
+
+	if (index >= PPE_IN_FLOW_CNT_TBL_ENTRIES)
+		return -EINVAL;
+
+	addr = PPE_IN_FLOW_CNT_TBL_ADDR + index * PPE_IN_FLOW_CNT_TBL_INC;
+
+	ret = regmap_read(ppe_dev->regmap, addr, &pkt);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(ppe_dev->regmap, addr + 2 * sizeof(u32), &hi);
+	if (ret)
+		return ret;
+
+	/* Bounded: each retry needs another 32-bit carry to race us again. */
+	for (tries = 0; tries < 3; tries++) {
+		ret = regmap_read(ppe_dev->regmap, addr + sizeof(u32), &lo);
+		if (ret)
+			return ret;
+
+		ret = regmap_read(ppe_dev->regmap, addr + 2 * sizeof(u32), &hi_again);
+		if (ret)
+			return ret;
+
+		if (hi_again == hi)
+			break;
+
+		hi = hi_again;
+	}
+
+	*packets = pkt;
+	*bytes = (u64)FIELD_GET(PPE_IN_FLOW_CNT_TBL_BYTE_HI, hi) << 32 | lo;
+
+	return 0;
+}
+
+/**
+ * ppe_flow_counter_clear() - Zero a flow entry's hit counters.
+ * @ppe_dev: PPE device.
+ * @index: Flow table entry index.
+ *
+ * The counter table is separate RAM from the flow table and hardware does NOT
+ * reset it when a flow entry is programmed -- the vendor SDK exposes a distinct
+ * "counter cleanup" operation for exactly this and never calls it itself. Without
+ * an explicit clear, a reused index (a hash collision, or the same 5-tuple
+ * reconnecting) would report the previous occupant's entire lifetime as one
+ * instantaneous delta.
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_flow_counter_clear(struct ppe_device *ppe_dev, u32 index)
+{
+	u32 addr;
+	int ret, i;
+
+	if (index >= PPE_IN_FLOW_CNT_TBL_ENTRIES)
+		return -EINVAL;
+
+	addr = PPE_IN_FLOW_CNT_TBL_ADDR + index * PPE_IN_FLOW_CNT_TBL_INC;
+
+	for (i = 0; i < PPE_IN_FLOW_CNT_TBL_WORDS; i++) {
+		ret = regmap_write(ppe_dev->regmap, addr + i * sizeof(u32), 0);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * ppe_flow_entry_add() - Add (or overwrite) a PPE flow table entry.
+ * @ppe_dev: PPE device.
+ * @mode: Hash-based or caller-indexed entry placement.
+ * @entry: The flow entry to write, as @num_words 32-bit words.
+ * @num_words: Number of words in @entry: PPE_FLOW_TBL_IPV4_ENTRY_WORDS or
+ * PPE_FLOW_TBL_IPV6_ENTRY_WORDS.
+ * @index: In PPE_FLOW_OP_MODE_INDEX, the entry index to write to (input).
+ * On success, always holds the entry's final hardware index: unchanged
+ * for PPE_FLOW_OP_MODE_INDEX, hardware-assigned for PPE_FLOW_OP_MODE_HASH.
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_flow_entry_add(struct ppe_device *ppe_dev, enum ppe_flow_op_mode mode,
+			const u32 *entry, unsigned int num_words, u32 *index)
+{
+	unsigned int i;
+	int ret;
+
+	if (num_words > PPE_IN_FLOW_TBL_OP_DATA_ENTRIES)
+		return -EINVAL;
+
+	mutex_lock(&ppe_dev->flow_tbl_lock);
+
+	for (i = 0; i < num_words; i++) {
+		ret = regmap_write(ppe_dev->regmap,
+				    PPE_IN_FLOW_TBL_OP_DATA_ADDR + i * PPE_IN_FLOW_TBL_OP_DATA_INC,
+				    entry[i]);
+		if (ret)
+			goto out;
+	}
+
+	ret = ppe_flow_tbl_op_wait(ppe_dev, PPE_FLOW_TBL_OP_ADD, mode, index);
+	if (ret)
+		goto out;
+
+	/* Zero the hit counters for the index we just programmed, while still
+	 * holding the table lock and before the caller can publish the entry.
+	 * Hardware keeps them in separate RAM that survives a flow entry being
+	 * overwritten, so a reused index would otherwise attribute the previous
+	 * occupant's lifetime totals to this flow on its first stats poll.
+	 */
+	ret = ppe_flow_counter_clear(ppe_dev, *index);
+	if (ret) {
+		/* The add has landed; callers treat an error as "nothing
+		 * programmed" and release the entries it points at, so take
+		 * it back out rather than leave a live entry nobody tracks.
+		 */
+		if (ppe_flow_tbl_op_wait(ppe_dev, PPE_FLOW_TBL_OP_DEL,
+					 PPE_FLOW_OP_MODE_INDEX, index))
+			dev_warn(ppe_dev->dev,
+				 "flow entry %u left programmed after a counter clear failure\n",
+				 *index);
+	}
+out:
+	mutex_unlock(&ppe_dev->flow_tbl_lock);
+	return ret;
+}
+
+/**
+ * ppe_flow_entry_del() - Delete a PPE flow table entry by index.
+ * @ppe_dev: PPE device.
+ * @index: The entry index to delete.
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_flow_entry_del(struct ppe_device *ppe_dev, u32 index)
+{
+	int ret;
+
+	mutex_lock(&ppe_dev->flow_tbl_lock);
+	ret = ppe_flow_tbl_op_wait(ppe_dev, PPE_FLOW_TBL_OP_DEL, PPE_FLOW_OP_MODE_INDEX, &index);
+	mutex_unlock(&ppe_dev->flow_tbl_lock);
+
+	return ret;
+}
