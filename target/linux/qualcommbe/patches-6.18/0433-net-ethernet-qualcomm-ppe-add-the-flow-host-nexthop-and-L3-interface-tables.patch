+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_host.c
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+/* PPE host table -- IP address to nexthop bindings. Accessed indirectly
+ * with the same command/data/result register sequence as the flow table
+ * (see ppe_flow.c), but through its own register set and with entries
+ * of varying width (3 words for IPv4, 5 for IPv6).
+ */
+
+#include <linux/bitfield.h>
+#include <linux/mutex.h>
+#include <linux/regmap.h>
+
+#include "ppe.h"
+#include "ppe_flow.h"
+#include "ppe_host.h"
+#include "ppe_regs.h"
+
+/* Values for PPE_HOST_TBL_OP's OP_TYPE field. */
+enum ppe_host_tbl_op_type {
+	PPE_HOST_TBL_OP_ADD = 0,
+	PPE_HOST_TBL_OP_DEL,
+	PPE_HOST_TBL_OP_GET,
+	PPE_HOST_TBL_OP_FLUSH,
+};
+
+/* Per-table command tag, mirroring the vendor SDK's hppe_ip.c
+ * host_cmd_id: incremented on every operation and stamped into the OP
+ * command word's CMD_ID field.
+ */
+static u32 ppe_host_cmd_id;
+
+/* Trigger the given host table operation and wait for hardware to
+ * complete it. *index is the entry index to operate on for
+ * PPE_FLOW_OP_MODE_INDEX (input); for PPE_FLOW_OP_MODE_HASH it is
+ * ignored on input and set to the hardware-assigned index on success.
+ */
+static int ppe_host_tbl_op_wait(struct ppe_device *ppe_dev,
+				 enum ppe_host_tbl_op_type op_type,
+				 enum ppe_flow_op_mode mode, u32 *index)
+{
+	u32 val, rslt, cmd_id;
+	int ret;
+
+	cmd_id = ppe_host_cmd_id++ & FIELD_MAX(PPE_HOST_TBL_OP_CMD_ID);
+
+	val = FIELD_PREP(PPE_HOST_TBL_OP_CMD_ID, cmd_id);
+	val |= FIELD_PREP(PPE_HOST_TBL_OP_OP_TYPE, op_type);
+	val |= FIELD_PREP(PPE_HOST_TBL_OP_HASH_BLOCK_BITMAP, 3);
+	val |= FIELD_PREP(PPE_HOST_TBL_OP_OP_MODE, mode);
+	val |= FIELD_PREP(PPE_HOST_TBL_OP_ENTRY_INDEX, *index);
+
+	ret = regmap_write(ppe_dev->regmap, PPE_HOST_TBL_OP_ADDR, val);
+	if (ret)
+		return ret;
+
+	/* Match the command tag we issued -- see the comment in ppe_flow.c. */
+	ret = regmap_read_poll_timeout(ppe_dev->regmap, PPE_HOST_TBL_OP_RSLT_ADDR,
+					rslt,
+					FIELD_GET(PPE_HOST_TBL_OP_RSLT_VALID_CNT, rslt) &&
+					FIELD_GET(PPE_HOST_TBL_OP_RSLT_CMD_ID, rslt) == cmd_id,
+					10, 2000);
+	if (ret)
+		return ret;
+
+	if (FIELD_GET(PPE_HOST_TBL_OP_RSLT_OP_RSLT, rslt))
+		return -EIO;
+
+	*index = FIELD_GET(PPE_HOST_TBL_OP_RSLT_ENTRY_INDEX, rslt);
+
+	return 0;
+}
+
+/**
+ * ppe_host_entry_add() - Add (or overwrite) a PPE host table entry.
+ * @ppe_dev: PPE device.
+ * @mode: Hash-based or caller-indexed entry placement.
+ * @entry: The host entry to write, as PPE_HOST_TBL_IPV4_ENTRY_WORDS (IPv4)
+ * or PPE_HOST_TBL_IPV6_ENTRY_WORDS (IPv6) 32-bit words.
+ * @num_words: Number of words in @entry.
+ * @index: In PPE_FLOW_OP_MODE_INDEX, the entry index to write to (input).
+ * On success, always holds the entry's final hardware index: unchanged
+ * for PPE_FLOW_OP_MODE_INDEX, hardware-assigned for PPE_FLOW_OP_MODE_HASH.
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_host_entry_add(struct ppe_device *ppe_dev, enum ppe_flow_op_mode mode,
+			const u32 *entry, unsigned int num_words, u32 *index)
+{
+	unsigned int i;
+	int ret;
+
+	if (num_words > PPE_HOST_TBL_OP_DATA_ENTRIES)
+		return -EINVAL;
+
+	mutex_lock(&ppe_dev->host_tbl_lock);
+
+	for (i = 0; i < num_words; i++) {
+		ret = regmap_write(ppe_dev->regmap,
+				    PPE_HOST_TBL_OP_DATA_ADDR + i * PPE_HOST_TBL_OP_DATA_INC,
+				    entry[i]);
+		if (ret)
+			goto out;
+	}
+
+	ret = ppe_host_tbl_op_wait(ppe_dev, PPE_HOST_TBL_OP_ADD, mode, index);
+out:
+	mutex_unlock(&ppe_dev->host_tbl_lock);
+	return ret;
+}
+
+/**
+ * ppe_host_entry_del() - Delete a PPE host table entry by index.
+ * @ppe_dev: PPE device.
+ * @index: The entry index to delete.
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_host_entry_del(struct ppe_device *ppe_dev, u32 index)
+{
+	int ret;
+
+	mutex_lock(&ppe_dev->host_tbl_lock);
+	ret = ppe_host_tbl_op_wait(ppe_dev, PPE_HOST_TBL_OP_DEL, PPE_FLOW_OP_MODE_INDEX, &index);
+	mutex_unlock(&ppe_dev->host_tbl_lock);
+
+	return ret;
+}
