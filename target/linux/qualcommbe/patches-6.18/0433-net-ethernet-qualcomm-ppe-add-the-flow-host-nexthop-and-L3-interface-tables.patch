+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_host_pool.c
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+/* Refcounted allocator on top of the host table primitive (ppe_host.c).
+ *
+ * Multiple flows commonly share one host table entry -- every
+ * connection through the same LAN client or the same public WAN IP
+ * references the same entry. The host table's own hardware add
+ * operation already deduplicates by key (see ppe_host_pool.h), so this
+ * layer's only job is counting callers per hardware index and freeing
+ * the entry once the last one is gone.
+ */
+
+#include <linux/errno.h>
+#include <linux/gfp.h>
+#include <linux/refcount.h>
+#include <linux/slab.h>
+#include <linux/xarray.h>
+
+#include "ppe.h"
+#include "ppe_host.h"
+#include "ppe_host_pool.h"
+
+struct ppe_host_pool_entry {
+	refcount_t ref;
+	u32 index;
+};
+
+/**
+ * ppe_host_pool_init() - Initialize a host table pool.
+ * @pool: The pool to initialize.
+ */
+void ppe_host_pool_init(struct ppe_host_pool *pool)
+{
+	xa_init(&pool->entries);
+	mutex_init(&pool->lock);
+}
+
+/**
+ * ppe_host_pool_destroy() - Tear down a host table pool.
+ * @ppe_dev: PPE device.
+ * @pool: The pool to tear down.
+ *
+ * Releases every hardware entry the pool is still tracking. Callers
+ * are expected to have already stopped issuing get/deref calls
+ * against this pool.
+ */
+void ppe_host_pool_destroy(struct ppe_device *ppe_dev, struct ppe_host_pool *pool)
+{
+	struct ppe_host_pool_entry *e;
+	unsigned long index;
+
+	xa_for_each(&pool->entries, index, e) {
+		ppe_host_entry_del(ppe_dev, e->index);
+		kfree(e);
+	}
+
+	xa_destroy(&pool->entries);
+}
+
+/**
+ * ppe_host_pool_get_and_ref() - Add a host table entry, or ref an existing one.
+ * @ppe_dev: PPE device.
+ * @pool: The pool to allocate from.
+ * @mode: Hash-based or caller-indexed entry placement -- see
+ * ppe_host_entry_add(). Dedup only applies for %PPE_FLOW_OP_MODE_HASH,
+ * matching hardware's own behavior.
+ * @entry: The host entry to write -- see ppe_host_entry_add().
+ * @num_words: Number of words in @entry.
+ * @index: On success, the entry's hardware index (new or reused).
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_host_pool_get_and_ref(struct ppe_device *ppe_dev, struct ppe_host_pool *pool,
+			       enum ppe_flow_op_mode mode, const u32 *entry,
+			       unsigned int num_words, u32 *index)
+{
+	struct ppe_host_pool_entry *e;
+	u32 idx = 0;
+	int ret;
+
+	ret = ppe_host_entry_add(ppe_dev, mode, entry, num_words, &idx);
+	if (ret)
+		return ret;
+
+	mutex_lock(&pool->lock);
+
+	e = xa_load(&pool->entries, idx);
+	if (e) {
+		refcount_inc(&e->ref);
+		mutex_unlock(&pool->lock);
+		*index = idx;
+		return 0;
+	}
+
+	e = kzalloc(sizeof(*e), GFP_KERNEL);
+	if (!e) {
+		mutex_unlock(&pool->lock);
+		ppe_host_entry_del(ppe_dev, idx);
+		return -ENOMEM;
+	}
+
+	refcount_set(&e->ref, 1);
+	e->index = idx;
+
+	ret = xa_err(xa_store(&pool->entries, idx, e, GFP_KERNEL));
+	if (ret) {
+		mutex_unlock(&pool->lock);
+		kfree(e);
+		ppe_host_entry_del(ppe_dev, idx);
+		return ret;
+	}
+
+	mutex_unlock(&pool->lock);
+	*index = idx;
+
+	return 0;
+}
+
+/**
+ * ppe_host_pool_deref() - Drop a reference on a pooled host table entry.
+ * @ppe_dev: PPE device.
+ * @pool: The pool @index was allocated from.
+ * @index: The entry index, as returned by ppe_host_pool_get_and_ref().
+ *
+ * Deletes the underlying hardware entry once its last reference is
+ * dropped.
+ */
+void ppe_host_pool_deref(struct ppe_device *ppe_dev, struct ppe_host_pool *pool, u32 index)
+{
+	struct ppe_host_pool_entry *e;
+
+	mutex_lock(&pool->lock);
+
+	e = xa_load(&pool->entries, index);
+	if (!e) {
+		mutex_unlock(&pool->lock);
+		return;
+	}
+
+	if (!refcount_dec_and_test(&e->ref)) {
+		mutex_unlock(&pool->lock);
+		return;
+	}
+
+	xa_erase(&pool->entries, index);
+	mutex_unlock(&pool->lock);
+
+	ppe_host_entry_del(ppe_dev, index);
+	kfree(e);
+}
