+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+#ifndef __PPE_HOST_POOL_H__
+#define __PPE_HOST_POOL_H__
+
+#include <linux/mutex.h>
+#include <linux/types.h>
+#include <linux/xarray.h>
+
+#include "ppe.h"
+#include "ppe_host.h"
+
+/**
+ * struct ppe_host_pool - Refcounted host table entry allocator.
+ * @entries: Live host table entries, keyed by hardware index.
+ * @lock: Serializes get/deref against concurrent callers.
+ *
+ * The host table is hash-addressed: hardware itself returns the same
+ * index for two adds with the same key (confirmed against the vendor
+ * SDK's ppe_drv_host_v4_add(), which calls fal_ip_host_add()
+ * unconditionally on every request and only checks *after the fact*
+ * whether the returned index was already tracked in software). This
+ * pool exists purely to count how many callers reference each
+ * already-deduplicated hardware entry, releasing it only once the
+ * last one is done -- unlike the nexthop pool, it does not need to
+ * search for a matching entry itself, since hardware already
+ * guarantees that.
+ */
+struct ppe_host_pool {
+	struct xarray entries;
+	struct mutex lock;
+};
+
+void ppe_host_pool_init(struct ppe_host_pool *pool);
+void ppe_host_pool_destroy(struct ppe_device *ppe_dev, struct ppe_host_pool *pool);
+
+int ppe_host_pool_get_and_ref(struct ppe_device *ppe_dev, struct ppe_host_pool *pool,
+			       enum ppe_flow_op_mode mode, const u32 *entry,
+			       unsigned int num_words, u32 *index);
+void ppe_host_pool_deref(struct ppe_device *ppe_dev, struct ppe_host_pool *pool, u32 index);
+
+#endif
