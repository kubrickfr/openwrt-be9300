+/* The deadline work (WP3-DESIGN D7, §4.5): the lock only. Each step checks
+ * the switch is in step, then the deadline (ppe_sr_eng_tick()), and comes
+ * back after the time left, PPE_SR_DEADLINE_STEP_S at most, while READY or
+ * ACTIVE.
+ */
+static void ppe_sr_deadline_work(struct work_struct *work)
+{
+	struct ppe_sr *sr = container_of(to_delayed_work(work), struct ppe_sr, deadline_work);
+	unsigned long disarm_at, delay = 0;
+	int word, stop;
+
+	mutex_lock(sr->lock);
+	word = ppe_sr_word(sr, &disarm_at);
+	stop = ppe_sr_eng_tick(&sr->eng, &sr->io, word, jiffies, disarm_at, HZ, &delay);
+	ppe_sr_settle(sr);
+	if (!stop)
+		mod_delayed_work(system_dfl_wq, &sr->deadline_work, delay);
+	mutex_unlock(sr->lock);
+}
+
