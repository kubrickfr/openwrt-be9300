+/**
+ * ppe_sr_disarm_ctl() - The control file's disarm (WP3-DESIGN §4.2).
+ * @priv: The offload.
+ *
+ * Inhibits arms first, without any lock, so that an arm that has not taken
+ * the lock yet is refused (D8); then takes the lock, killably, and disarms
+ * (CONTROL). The inhibit stays until ppe_sr_uninhibit().
+ *
+ * Return: 0 (off), -EIO (FAULT), -EINTR if killed while waiting.
+ */
+int ppe_sr_disarm_ctl(struct ppe_offload_priv *priv)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	int ret;
+
+	ppe_sr_inhibit(sr);
