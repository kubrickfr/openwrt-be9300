+/**
+ * ppe_sr_eng_tick() - One step of the deadline work (WP3-DESIGN D7, §4.5).
+ * @eng: The engine.
+ * @io: Register access, flows and the state word.
+ * @word: The rtl8_4s state word read now, -1 for no switch.
+ * @now: Jiffies now.
+ * @disarm_at: The switch's own deadline, read with @word (0 for none).
+ * @hz: Jiffies per second.
+ * @delay: Set to the jiffies to wait for the next step when 0 is returned:
+ * the time left, at most PPE_SR_DEADLINE_STEP_S.
+ *
+ * Under the lock. Only READY and ACTIVE have a deadline to keep. A switch
+ * out of step with the state (it left READY, or is gone) disarms
+ * (SWITCH_NOT_READY, ppe_sr_eng_lost_work()). A deadline past the switch's
+ * own less PPE_SR_DEADLINE_MARGIN_S is clamped to it (said once): the PPE
+ * releases before the switch's deadline comes, so that the switch need not
+ * yield. A deadline reached disarms (DEADLINE). Every comparison holds
+ * across a jiffies wrap.
+ *
+ * Return: 1 when the work is to stop (not armed, or a disarm ran, whatever
+ * its result), 0 to step again after @delay.
+ */
+int ppe_sr_eng_tick(struct ppe_sr_eng *eng, const struct ppe_sr_io *io, int word,
+		    unsigned long now, unsigned long disarm_at, unsigned long hz,
+		    unsigned long *delay)
+{
+	unsigned long cap, left;
+
+	if (!eng_armed(eng->seq.state))
+		return 1;
+	if (!ppe_sr_eng_td_fits(eng->seq.state, word)) {
+		ppe_sr_eng_lost_work(eng, io, word);
+		return 1;
+	}
+
+	cap = disarm_at - PPE_SR_DEADLINE_MARGIN_S * hz;
+	if (!cap)
+		cap--;
+	if (disarm_at && eng_before(cap, eng->deadline)) {
+		eng->deadline = cap;
+		if (!eng->deadline_clamped) {
+			eng->deadline_clamped = 1;
+			eng_log(io, PPE_SR_LOG_WARN,
+				"deadline clamped to %u s before the switch's own",
+				PPE_SR_DEADLINE_MARGIN_S);
+		}
+	}
+
+	if (!eng->deadline || !eng_before(now, eng->deadline)) {
+		eng_log(io, PPE_SR_LOG_INFO, "deadline reached, disarming");
+		ppe_sr_eng_disarm(eng, io, PPE_SR_T_DEADLINE);
+		return 1;
+	}
+
+	left = eng->deadline - now;
+	*delay = left < PPE_SR_DEADLINE_STEP_S * hz ? left : PPE_SR_DEADLINE_STEP_S * hz;
+
+	return 0;
+}
