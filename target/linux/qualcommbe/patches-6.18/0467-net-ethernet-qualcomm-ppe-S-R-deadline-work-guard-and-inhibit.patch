+
+/* D16: a reference on the module of the driver bound to @conduit's switch.
+ * Under RTNL and the lock, at the arm, with the conduit's dsa_ptr valid in
+ * this RTNL section (the switch is bound: its teardown takes RTNL).
+ */
+static int ppe_sr_sw_hold(struct ppe_sr *sr, struct net_device *conduit)
+{
+	struct dsa_port *cpu_dp = conduit->dsa_ptr;
+	struct device_driver *drv;
+
+	if (sr->sw_ref)
+		return 0;
+	if (!cpu_dp || !cpu_dp->ds || !cpu_dp->ds->dev)
+		return -ENODEV;
+	drv = READ_ONCE(cpu_dp->ds->dev->driver);
+	if (!drv || !try_module_get(drv->owner))
+		return -ENODEV;
+	sr->sw_mod = drv->owner;
+	sr->sw_ref = true;
+
+	return 0;
+}
 #else
 struct rtl8_4s_tagger_data;
 
@@ -354,8 +389,60 @@ static struct rtl8_4s_tagger_data *ppe_sr_td(struct ppe_sr *sr)
 {
 	return NULL;
 }
+
+static int ppe_sr_sw_hold(struct ppe_sr *sr, struct net_device *conduit)
+{
+	return -ENODEV;
+}
 #endif
 
+/* Drop the switch driver's module reference, if held. Under the lock, or
+ * with nothing else left (ppe_sr_destroy()).
+ */
+static void ppe_sr_sw_put(struct ppe_sr *sr)
+{
+	if (!sr->sw_ref)
+		return;
+	module_put(sr->sw_mod);
+	sr->sw_mod = NULL;
+	sr->sw_ref = false;
+}
+
+/* Inhibit arms (WP3-DESIGN D8): set bit 0 and bump the generation above it,
+ * in one fully ordered step. Lockless: a control disarm and the guard do
+ * this before they take the lock, so that an arm taking it after them is
+ * refused (ppe_sr_arm() reads the word after a barrier, under the lock).
+ */
+static void ppe_sr_inhibit(struct ppe_sr *sr)
+{
+	int old = atomic_read(&sr->inhibit);
+
+	while (!atomic_try_cmpxchg(&sr->inhibit, &old,
+				   (int)(((((u32)old >> 1) + 1) << 1) | 1)))
+		;
+	/* The inhibit before whatever the caller does next (the lock it
+	 * waits for); pairs with the barrier in ppe_sr_arm()'s lock section.
+	 */
+	smp_mb();
+}
+
+/* Whether arms are inhibited, and the generation in force. Lockless. */
+static bool ppe_sr_inhibited(struct ppe_sr *sr, u32 *gen)
+{
+	u32 w = (u32)atomic_read(&sr->inhibit);
+
+	if (gen)
+		*gen = w >> 1;
+
+	return w & 1;
+}
+
+/* Run the deadline work now: it computes its own next wake. */
+static void ppe_sr_deadline_kick(struct ppe_sr *sr)
+{
+	mod_delayed_work(system_dfl_wq, &sr->deadline_work, 0);
+}
