 drivers/net/ethernet/qualcomm/ppe/Makefile      |    2 
 drivers/net/ethernet/qualcomm/ppe/ppe_offload.c |   21 +
 drivers/net/ethernet/qualcomm/ppe/ppe_sr.c      |  214 ++++++++++
 drivers/net/ethernet/qualcomm/ppe/ppe_sr.h      |  123 ++++++
 drivers/net/ethernet/qualcomm/ppe/ppe_sr_topo.c |  505 +++++++++++++++++++++++
 drivers/net/ethernet/qualcomm/ppe/ppe_sr_topo.h |  203 +++++++++
 6 files changed, 1062 insertions(+), 6 deletions(-)

