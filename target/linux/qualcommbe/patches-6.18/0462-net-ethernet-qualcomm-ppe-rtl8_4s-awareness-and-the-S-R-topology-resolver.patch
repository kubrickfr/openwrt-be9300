+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_offload.c
@@ -64,8 +64,8 @@
  *   switch does not offload for it, a VLAN-aware bridge port outside
  *   VLAN 1 (ppe_offload_dsa_vlan_ok()), a port behind a LAG conduit, a
  *   VLAN push on top of an unbridged or VLAN-unaware port, a tagger other
- *   than rtl8_4, and a conduit whose egress TPIDs are not set up for the
- *   emulated head tag are all declined.
+ *   than rtl8_4 or rtl8_4s, and a conduit whose egress TPIDs are not set
+ *   up for the emulated head tag are all declined.
  *   Where the inserts name the port outright (rtl8_4), a client that
  *   its own bridge later learns on another of its ports
  *   has its flows re-pointed there, see ppe_offload_fdb_event().
@@ -192,6 +192,9 @@
 #include <linux/regmap.h>
 #include <linux/rtnetlink.h>
 #include <net/dsa.h>
+#if IS_ENABLED(CONFIG_NET_DSA)
+#include <linux/dsa/rtl8_4s.h>
+#endif
 #include <linux/rhashtable.h>
 #include <linux/slab.h>
 #include <linux/spinlock.h>
@@ -1252,7 +1255,12 @@ static int ppe_offload_dsa_egress(struct ppe_offload_priv *priv, struct net_devi
 	if (bridge && READ_ONCE(dp->stp_state) != BR_STATE_FORWARDING)
 		return ppe_offload_decline("odev=%s not forwarding", netdev_name(odev));
 
-	if (tag_ops->proto != DSA_TAG_PROTO_RTL8_4)
+	/* rtl8_4s transmits with rtl8_4's head tag (net/dsa/tag_rtl8_4.c),
+	 * armed switch or not, so profile E emulates it the same way. The S-R
+	 * mode will own the egress S-TPID while it is not off: E only while
+	 * it is off (WP2-DESIGN D10), which is always so far.
+	 */
+	if (tag_ops->proto != DSA_TAG_PROTO_RTL8_4 && tag_ops->proto != DSA_TAG_PROTO_RTL8_4S)
 		return ppe_offload_decline("odev=%s tagger %d unsupported", netdev_name(odev),
 					    tag_ops->proto);
 	if (!ppe_offload_rtl8_4_egress_ready(priv, conduit))
@@ -5099,14 +5107,17 @@ static int ppe_offload_program_port(struct net_device *netdev, void *arg)
 }
 
 #if IS_ENABLED(CONFIG_NET_DSA)
-/* Note the PPE port of an EDMA port that is an rtl8_4 conduit. Under RTNL. */
+/* Note the PPE port of an EDMA port that is an rtl8_4 or rtl8_4s conduit
+ * (both transmit with the rtl8_4 head tag). Under RTNL.
+ */
 static int ppe_offload_find_rtl8_4_conduit(struct net_device *netdev, void *arg)
 {
 	struct edma_port_priv *port_priv = netdev_priv(netdev);
 	u32 *port = arg;
 
 	if (!*port && netdev_uses_dsa(netdev) && netdev->dsa_ptr->tag_ops &&
-	    netdev->dsa_ptr->tag_ops->proto == DSA_TAG_PROTO_RTL8_4)
+	    (netdev->dsa_ptr->tag_ops->proto == DSA_TAG_PROTO_RTL8_4 ||
