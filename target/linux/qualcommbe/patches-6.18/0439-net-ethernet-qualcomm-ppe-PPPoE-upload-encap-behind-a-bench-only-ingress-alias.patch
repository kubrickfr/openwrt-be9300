+static int ppe_offload_pppoe_clear(struct ppe_offload_priv *priv, unsigned int slot)
+{
+	int ret = ppe_offload_pppoe_session_clear(priv, slot);
+
+	if (!ret)
+		ppe_offload_pppoe_l3_if_clear(priv, slot);
+
+	return ret;
+}
