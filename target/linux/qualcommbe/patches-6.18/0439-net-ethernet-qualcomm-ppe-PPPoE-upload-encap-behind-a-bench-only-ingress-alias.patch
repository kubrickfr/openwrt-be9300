+static ssize_t ppe_offload_profile_read(struct file *file, char __user *ubuf, size_t count,
+					loff_t *ppos)
+{
+	struct ppe_offload_priv *priv = file->private_data;
+	char buf[96];
+	int len;
+
+	mutex_lock(&priv->lock);
+	len = scnprintf(buf, sizeof(buf), "%s egress_port=%u%s\n",
+			!priv->enabled ? "off" : priv->profile_a ? "A" :
+			priv->egress_port ? "E" : "plain",
+			priv->egress_port, priv->egress_failed ? " egress_failed" : "");
+	mutex_unlock(&priv->lock);
+
+	return simple_read_from_buffer(ubuf, count, ppos, buf, len);
+}
+
+/* "A <seconds>" applies profile A for that long, "E" puts it back now. */
+static ssize_t ppe_offload_profile_write(struct file *file, const char __user *ubuf,
+					 size_t count, loff_t *ppos)
+{
+	struct ppe_offload_priv *priv = file->private_data;
+	unsigned int seconds;
+	char buf[32] = {};
+	int ret = 0;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	mutex_lock(&priv->lock);
+	if (sscanf(buf, "A %u", &seconds) == 1) {
+		if (!priv->enabled) {
+			ret = -ENODEV;
+		} else if (!seconds || seconds > PPE_OFFLOAD_A_SECONDS_MAX) {
+			ret = -ERANGE;
+		} else {
