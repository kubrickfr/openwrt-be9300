+				ret = ppe_offload_profile_a_apply(priv);
+			if (!ret)
+				mod_delayed_work(system_wq, &priv->a_revert, seconds * HZ);
+		}
+	} else if (buf[0] == 'E') {
+		ppe_offload_profile_a_revert(priv, "debugfs");
+	} else {
+		ret = -EINVAL;
+	}
+	mutex_unlock(&priv->lock);
+
+	return ret ?: count;
