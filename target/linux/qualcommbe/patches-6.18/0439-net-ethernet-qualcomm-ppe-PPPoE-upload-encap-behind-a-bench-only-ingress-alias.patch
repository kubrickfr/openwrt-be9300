+/* Bench profile A: Kamil Bienkiewicz's ingress parser alias for rtl8_4 (his
+ * 0445), on top of profile E. The chip-wide ingress S-TPID becomes the head
+ * tag's EtherType and the C-TPID 0x0000, the head tag's second word, and
+ * the conduit's parser role core, so the parser walks over the tag as over
+ * a QinQ pair and flows from the switch can hit (measured by him: upload
+ * at 98.1% CPU idle instead of 74.6%). The CPU port becomes an S-VLAN
+ * egress port re-emitting both tags unmodified, so that frames the PPE
+ * floods to the CPU keep a head tag the tagger accepts (also his, measured:
+ * with the CPU port left as it is, the LAN is dead).
+ *
+ * Not for service: with the ingress C-TPID at 0x0000 the WAN's 802.1Q tag
+ * is not parsed (his measurement: tagged-WAN flows never hit), so the
+ * WAN's downloads go back to software and lose RSS and receive checksum.
+ * It exists to confirm that on this WAN (H0) and to exercise the PPPoE
+ * upload encapsulation. It is applied for a number of seconds through
+ * debugfs, never by itself; every flow is dropped when it comes and goes,
+ * as the entries that hit change; disabling offload or unloading puts it
+ * back, as does the timer.
+ */
+#define PPE_OFFLOAD_A_SECONDS_MAX	600
+/* The PPE port EDMA hands the CPU's frames to and takes them from. */
+#define PPE_OFFLOAD_CPU_PORT		0
+
+/* Drop every tracked flow (back to software; the flowtable re-offers
+ * them). Under priv->lock.
+ *
+ * Return: the number of flows whose entry could not be deleted.
+ */
+static unsigned int ppe_offload_flush_all(struct ppe_offload_priv *priv, const char *why)
+{
+	unsigned int dropped, stuck;
+
+	stuck = ppe_offload_flush(priv, &dropped);
+	if (stuck)
+		pr_err("ppe_offload: %s: %u flow entr%s could not be deleted\n", why, stuck,
+		       stuck == 1 ? "y" : "ies");
+	pr_info("ppe_offload: %s: %u flow(s) back to software\n", why, dropped);
+
+	return stuck;
+}
+
+static void ppe_offload_profile_a_revert(struct ppe_offload_priv *priv, const char *why)
+{
+	lockdep_assert_held(&priv->lock);
+
+	if (!priv->profile_a)
+		return;
+
+	/* An entry left in hardware was programmed for A's parsing: A
+	 * stays, with priv->degraded latched, until a reboot.
+	 */
+	if (ppe_offload_flush_all(priv, why)) {
+		pr_err("ppe_offload: profile A kept (%s): flow entries stuck in hardware, reboot to recover\n",
+		       why);
+		return;
+	}
+	if (!ppe_offload_snaps_restore(priv, priv->a_snap, &priv->a_snap_num, 0))
+		WRITE_ONCE(priv->tpids_moved, false);
+	WRITE_ONCE(priv->profile_a, false);
+	atomic_inc(&priv->a_gen);
+	pr_info("ppe_offload: profile A off (%s)\n", why);
+}
+
+static int ppe_offload_profile_a_apply(struct ppe_offload_priv *priv)
+{
+	struct regmap *regmap = priv->ppe_dev->regmap;
+	u32 port = priv->egress_port, cpu_mask, cpu_want;
+	u32 in_tpid, got[4], want[4], addr[4];
+	unsigned int i;
+	int ret;
+
+	lockdep_assert_held(&priv->lock);
+
+	/* A failed restore may have left A's values in place: a new
+	 * snapshot would take them as the ones to go back to.
+	 */
+	if (priv->degraded || READ_ONCE(priv->tpids_moved))
+		return -EIO;
+
+	/* E carries the egress half; it is applied with the first flow
+	 * towards the switch.
+	 */
+	if (!port || port >= PPE_PORT_PARSING_ENTRIES)
+		return -ENODEV;
+
+	in_tpid = FIELD_PREP(PPE_VLAN_TPID_STAG, ETH_P_REALTEK) | FIELD_PREP(PPE_VLAN_TPID_CTAG, 0);
+	cpu_mask = PPE_PORT_EG_VLAN_TBL_VLAN_TYPE | PPE_PORT_EG_VLAN_TBL_CTAG_MODE |
+		   PPE_PORT_EG_VLAN_TBL_STAG_MODE | PPE_PORT_EG_VLAN_TBL_VSI_TAG_MODE_EN;
+	cpu_want = PPE_PORT_EG_VLAN_TBL_VLAN_TYPE |
+		   FIELD_PREP(PPE_PORT_EG_VLAN_TBL_CTAG_MODE, PPE_EG_VLAN_TAG_MODE_UNMODIFIED) |
+		   FIELD_PREP(PPE_PORT_EG_VLAN_TBL_STAG_MODE, PPE_EG_VLAN_TAG_MODE_UNMODIFIED);
+
+	/* Written in this order, the role last; restored the other way. */
+	addr[0] = PPE_IPR_VLAN_TPID_ADDR;
+	addr[1] = PPE_TPR_VLAN_TPID_ADDR;
+	addr[2] = PPE_PORT_EG_VLAN_TBL_ADDR + PPE_PORT_EG_VLAN_TBL_INC * PPE_OFFLOAD_CPU_PORT;
+	addr[3] = PPE_PORT_PARSING_ADDR + PPE_PORT_PARSING_INC * port;
+
+	priv->a_snap_num = 0;
+	for (i = 0; i < ARRAY_SIZE(addr); i++) {
+		ret = ppe_offload_snaps_save(priv, priv->a_snap, &priv->a_snap_num,
+					     PPE_OFFLOAD_A_SNAP_MAX, addr[i], 1);
+		if (ret)
+			goto fail;
+	}
+
+	want[0] = in_tpid;
+	want[1] = in_tpid;
+	want[2] = (priv->a_snap[2].val[0] & ~cpu_mask) | cpu_want;
+	want[3] = priv->a_snap[3].val[0] | PPE_PORT_PARSING_PORT_ROLE;
+
+	/* Nothing programmed for E's parsing may live on under A's. */
+	if (ppe_offload_flush_all(priv, "profile A on")) {
+		ret = -EBUSY;
+		goto fail;
+	}
+
+	/* The transmit path stops counting on the parser to follow an
+	 * 802.1Q tag (edma_port_feature_check()) before it stops doing so;
+	 * transmits that passed the check already finish queueing first.
+	 * Frames already in an EDMA Tx ring, or held back by the qdisc after
+	 * a full ring (not checked again), may still be parsed under A's
+	 * TPIDs and leave with a bad checksum or unsegmented: a window of
+	 * the bench profile's switch-over, which TCP recovers from.
+	 */
+	WRITE_ONCE(priv->tpids_moved, true);
+	synchronize_net();
+
+	for (i = 0; i < ARRAY_SIZE(addr); i++) {
+		ret = regmap_write(regmap, addr[i], want[i]);
+		if (ret)
+			goto fail;
+	}
+	for (i = 0; i < ARRAY_SIZE(addr); i++) {
+		ret = regmap_read(regmap, addr[i], &got[i]);
+		if (!ret && got[i] != want[i])
+			ret = -EIO;
+		if (ret) {
+			pr_err("ppe_offload: profile A register %#x read back %#x, wrote %#x\n",
+			       addr[i], got[i], want[i]);
+			goto fail;
+		}
+	}
+
+	WRITE_ONCE(priv->profile_a, true);
+	atomic_inc(&priv->a_gen);
+	pr_info("ppe_offload: profile A on for PPE port %u: ingress TPIDs %#x, CPU port egress VLAN %#x, port parsing %#x\n",
+		port, got[0], got[2], got[3]);
+
+	return 0;
+
+fail:
+	if (!ppe_offload_snaps_restore(priv, priv->a_snap, &priv->a_snap_num, 0))
+		WRITE_ONCE(priv->tpids_moved, false);
+	return ret ?: -EIO;
+}
+
+static void ppe_offload_profile_a_timeout(struct work_struct *work)
+{
+	struct ppe_offload_priv *priv = container_of(to_delayed_work(work),
+						     struct ppe_offload_priv, a_revert);
+
+	mutex_lock(&priv->lock);
+	ppe_offload_profile_a_revert(priv, "timer");
+	mutex_unlock(&priv->lock);
+}
