-	u32 l3_if = PPE_OFFLOAD_PPPOE_L3_IF_BASE + slot;
 	u32 ext = ~0;
 	int ret;
 
@@ -1669,12 +1724,23 @@ static int ppe_offload_pppoe_clear(struct ppe_offload_priv *priv, unsigned int s
 	regmap_write(regmap, PPE_PPPOE_SESSION_EXT2_ADDR + slot * PPE_PPPOE_SESSION_EXT2_INC, 0);
 	regmap_write(regmap, PPE_PPPOE_SESSION_EXT1_ADDR + slot * PPE_PPPOE_SESSION_EXT1_INC, 0);
 	regmap_write(regmap, PPE_PPPOE_SESSION_ADDR + slot * PPE_PPPOE_SESSION_INC, 0);
-	ppe_l3_if_in_entry_set(priv->ppe_dev, l3_if, &in);
-	ppe_l3_if_eg_entry_set(priv->ppe_dev, l3_if, &eg);
 
 	return 0;
 }
 
+/* Take session slot @slot out of use, its session entry and then its L3
+ * interface. Under priv->lock.
