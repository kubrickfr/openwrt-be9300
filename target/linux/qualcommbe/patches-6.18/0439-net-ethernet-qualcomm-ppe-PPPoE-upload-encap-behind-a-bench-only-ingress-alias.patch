+/* Write session slot @slot's L3 interface empty and read it back: MTU 0,
+ * no routing, no PPPoE encapsulation. An entry that does not read back
+ * latches priv->degraded. Under priv->lock.
+ */
+static void ppe_offload_pppoe_l3_if_clear(struct ppe_offload_priv *priv, unsigned int slot)
+{
+	const struct ppe_l3_if_eg_entry eg = {};
+	const struct ppe_l3_if_in_entry in = {};
+	u32 l3_if = PPE_OFFLOAD_PPPOE_L3_IF_BASE + slot;
+	struct ppe_l3_if_eg_entry eg_back;
+	struct ppe_l3_if_in_entry in_back;
+
+	if (!ppe_l3_if_in_entry_set(priv->ppe_dev, l3_if, &in) &&
+	    !ppe_l3_if_eg_entry_set(priv->ppe_dev, l3_if, &eg) &&
+	    !ppe_l3_if_in_entry_get(priv->ppe_dev, l3_if, &in_back) &&
+	    !ppe_l3_if_eg_entry_get(priv->ppe_dev, l3_if, &eg_back) &&
+	    !in_back.mru && !in_back.mtu && !in_back.ipv4_uc_route_en && !in_back.pppoe_en &&
+	    !eg_back.pppoe_en && is_zero_ether_addr(eg_back.mac_addr))
+		return;
+
+	priv->degraded = true;
+	pr_err("ppe_offload: PPPoE L3 interface %u not cleared; new flows declined, disable and reboot\n",
+	       l3_if);
+}
