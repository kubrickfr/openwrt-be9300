+int ppe_sr_dn_egress(const struct ppe_sr_offer *o, struct ppe_sr_dn *dn)
+{
+	if (o->dir != PPE_SR_DN || o->why != PPE_SR_W_OK || o->cls.port != o->port ||
+	    o->cls.form != (o->tagged ? PPE_SR_T : PPE_SR_U) ||
+	    (o->tagged && o->cls.vid != o->vid) || !o->mtu_cap)
+		return -EINVAL;
