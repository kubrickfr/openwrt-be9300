+/* An S-R download (WP2-DESIGN §4.1): towards @odev, a user port, judged
+ * lockless into @sr_offer on the topology published to offers (and decided
+ * under the lock by ppe_offload_flow_replace()). Its class gives the tag
+ * inserts (ppe_sr_dn_tags()): an S-tag with the port's download S-VID,
+ * which the switch steers to that port alone, and a C-tag with the class's
+ * VLAN, which it delivers the frame in and strips at a port untagged in it.
+ * The resolver alone chooses that VLAN: no VLAN push is U(p), a push of v
+ * is T(p, v), and the switch does not check it against the port's
+ * membership. The class caps the PMTU (the port's, the bridge's and the
+ * VLAN's L3 device's MTU, and the conduit's less the two tags). Takes RCU.
+ *
+ * Return: 0 with @egress's inserts, @tagged and MTU cap set, -EAGAIN while
+ * the port awaits its resync, a negative error code to decline (counted).
+ */
+static int ppe_offload_dsa_egress_sr(struct ppe_offload_priv *priv, struct net_device *odev,
+				     bool vlan_push_seen, u16 vlan_push_vid,
+				     const struct ppe_sr_ticket *ticket,
+				     struct ppe_sr_offer *sr_offer,
+				     struct ppe_offload_egress *egress, bool *tagged)
+{
+	struct ppe_sr_dn dn;
+	int ret;
+
+	sr_offer->dir = PPE_SR_DN;
+	sr_offer->tagged = vlan_push_seen;
+	sr_offer->vid = vlan_push_seen ? vlan_push_vid : 0;
+	rcu_read_lock();
+	ret = ppe_sr_offer_pre(priv, ticket, odev, sr_offer);
+	rcu_read_unlock();
+	if (ret == -EAGAIN)
+		return -EAGAIN;
+	if (ret)
+		return ppe_offload_decline("odev=%s: S-R download: %s", netdev_name(odev),
+					    ppe_sr_why_name(sr_offer->why));
+	if (ppe_sr_dn_egress(sr_offer, &dn)) {
+		ppe_sr_count_decline(&priv->sr, PPE_SR_W_HW);
+		return ppe_offload_decline("odev=%s: S-R download: no inserts for its class",
+					    netdev_name(odev));
+	}
+
+	egress->sr = true;
+	egress->stag = true;
+	egress->svid = dn.svid;
+	egress->ctag = true;
+	egress->cvid = dn.cvid;
+	egress->mtu_cap = dn.mtu_cap;
+	*tagged = dn.tagged;
+
+	return 0;
+}
