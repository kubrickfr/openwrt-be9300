+ * that port alone, and C = the class's VLAN, which the switch delivers the
+ * frame in and strips at a port untagged in it (RESULT-ARCH §4.1). The
+ * switch does not check that VLAN against the port's membership (§4.2), so
+ * only a class the resolver made may come here.
+ *
+ * Return: 0, or -EINVAL for a class no resolver makes (port, form, VID 0,
+ * 4095 or reserved).
+ */
+int ppe_sr_dn_tags(const struct ppe_sr_class *cls, struct ppe_sr_dn *dn)
+{
+	if (!eng_class_ok(cls))
+		return -EINVAL;
+	dn->svid = rtl8_4s_svid_dn(cls->port);
+	dn->cvid = cls->vid;
