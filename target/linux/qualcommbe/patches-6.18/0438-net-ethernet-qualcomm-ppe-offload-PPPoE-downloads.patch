+/**
+ * struct ppe_offload_pppoe_info - A PPPoE session as the kernel has it.
+ * @sid: Session ID.
+ * @ac_mac: The access concentrator's MAC address (the session's peer).
+ * @local_mac: The source MAC address of the session, the EDMA port's.
+ * @ppp_ifindex: The PPP device.
+ * @lower_ifindex: The device the session runs on: a VLAN device on
+ * @port_ifindex, or that EDMA port itself.
+ * @port_ifindex: The EDMA port.
+ * @port: Its PPE port.
+ * @port_l3_if: Its own L3 interface, whose MY_MAC entry is @port_l3_if - 1.
+ * @vid: The VLAN of @lower_ifindex, 0 for none.
+ * @mtu: The PPP device's MTU.
+ *
+ * Compared whole (memcmp()), so always built zeroed.
+ */
+struct ppe_offload_pppoe_info {
+	u16 sid;
+	u8 ac_mac[ETH_ALEN];
+	u8 local_mac[ETH_ALEN];
+	int ppp_ifindex;
+	int lower_ifindex;
+	int port_ifindex;
+	u32 port;
+	u32 port_l3_if;
+	u16 vid;
+	unsigned int mtu;
+};
+
+/**
+ * struct ppe_offload_pppoe - One PPPoE session programmed in hardware.
+ * @info: The session.
+ * @refs: Flows using it; it is torn down when the last one goes.
+ * @live: Its hardware session entry is valid. Cleared, with the entry,
+ * when the kernel's session changes under it (ppe_offload_netdev_event()),
+ * and its flows are dropped then; a flow whose entry could not be deleted
+ * keeps the slot and L3 interface reserved.
+ * @since: When it went into hardware.
+ * @owner: The offload state it belongs to, for @strip_pt.
+ * @strip_pt: Watch for IPv4 and IPv6 frames from the access concentrator
+ * received on the session's lower device while it is live, see
+ * ppe_offload_strip_rcv().
+ * @strip_dev: That device, held while hooked.
+ * @strip_tracker: Its reference tracker.
+ * @stripped: Such a frame was seen.
+ * @broken: Its hardware session entry could not be cleared: the slot is
+ * never used again (until a reboot).
+ *
+ * Slot n of priv->pppoe uses hardware session entry n and L3 interface
+ * PPE_OFFLOAD_PPPOE_L3_IF_BASE + n. Under priv->lock, but @stripped.
+ */
+struct ppe_offload_pppoe {
+	struct ppe_offload_pppoe_info info;
+	unsigned int refs;
+	bool live;
+	unsigned long since;
+	struct ppe_offload_priv *owner;
+	struct packet_type strip_pt[2];
+	struct net_device *strip_dev;
+	netdevice_tracker strip_tracker;
+	bool stripped;
+	bool broken;
+};
