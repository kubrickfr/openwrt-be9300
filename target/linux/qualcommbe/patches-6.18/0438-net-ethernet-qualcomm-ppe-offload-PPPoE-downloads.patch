+/* Find the PPPoE session a flow is received in, as the kernel has it.
+ * @addr is the address the flow is translated from, which must be the
+ * PPP device's own; that device's forward path, as the flowtable resolved
+ * the flow from it (dev_fill_forward_path()), must be exactly the rule's:
+ * PPPoE session @sid on @lower (with VLAN @vid on @port_dev, or @port_dev
+ * itself when @vid is 0). The session's own MAC address must be the
+ * port's, which is the MY_MAC entry its L3 interface can point at.
+ * Under RCU.
+ *
+ * Return: true with @info filled in, false if any of it does not hold.
+ */
+static bool ppe_offload_pppoe_resolve(struct net *net, __be32 addr,
+				      struct net_device *port_dev, struct net_device *lower,
+				      u16 vid, u16 sid, struct ppe_offload_pppoe_info *info)
+{
+	static const u8 zero_mac[ETH_ALEN];
+	struct net_device_path_stack stack;
+	const struct net_device_path *path;
+	struct edma_port_priv *port_priv;
+	int paths = vid ? 3 : 2;
+	struct net_device *ppp;
+
+	/* Its private data is read below as an EDMA port's. */
+	if (!edma_port_is_edma_netdev(port_dev))
+		return false;
+
+	ppp = __ip_dev_find(net, addr, false);
+	if (!ppp || ppp->type != ARPHRD_PPP || !netif_running(ppp))
+		return false;
+
+	if (dev_fill_forward_path(ppp, zero_mac, &stack) < 0 || stack.num_paths != paths)
+		return false;
+
+	path = &stack.path[0];
+	if (path->type != DEV_PATH_PPPOE || path->dev != ppp ||
+	    path->encap.proto != htons(ETH_P_PPP_SES) || path->encap.id != sid ||
+	    !is_valid_ether_addr(path->encap.h_dest))
+		return false;
+
+	if (vid) {
+		path = &stack.path[1];
+		if (path->type != DEV_PATH_VLAN || path->dev != lower ||
+		    path->encap.proto != htons(ETH_P_8021Q) || path->encap.id != vid)
+			return false;
+	} else if (lower != port_dev) {
+		return false;
+	}
+
+	path = &stack.path[paths - 1];
+	if (path->type != DEV_PATH_ETHERNET || path->dev != port_dev)
+		return false;
+
+	if (!ether_addr_equal(lower->dev_addr, port_dev->dev_addr))
+		return false;
+
+	/* Nor while its link is down: the next offer would otherwise undo
+	 * the no-carrier teardown (ppe_offload_netdev_event()).
+	 */
+	if (!netif_carrier_ok(port_dev) || !netif_carrier_ok(lower))
+		return false;
+
+	port_priv = netdev_priv(port_dev);
+	memset(info, 0, sizeof(*info));
+	info->sid = sid;
+	ether_addr_copy(info->ac_mac, stack.path[0].encap.h_dest);
+	ether_addr_copy(info->local_mac, lower->dev_addr);
+	info->ppp_ifindex = ppp->ifindex;
+	info->lower_ifindex = lower->ifindex;
+	info->port_ifindex = port_dev->ifindex;
+	info->port = port_priv->ppe_port->port_id;
+	info->port_l3_if = port_priv->l3_if_index;
+	info->vid = vid;
+	info->mtu = READ_ONCE(ppp->mtu);
+
+	return true;
+}
+
+/* Take hardware session entry @slot out of use: its valid bits first, so
+ * that no frame matches a half-cleared entry, then the rest of it and the
+ * L3 interface. Under priv->lock.
+ */
+static int ppe_offload_pppoe_clear(struct ppe_offload_priv *priv, unsigned int slot)
+{
+	struct regmap *regmap = priv->ppe_dev->regmap;
+	struct ppe_l3_if_eg_entry eg = {};
+	struct ppe_l3_if_in_entry in = {};
+	u32 ext_addr = PPE_PPPOE_SESSION_EXT_ADDR + slot * PPE_PPPOE_SESSION_EXT_INC;
+	u32 l3_if = PPE_OFFLOAD_PPPOE_L3_IF_BASE + slot;
+	u32 ext = ~0;
+	int ret;
+
+	ret = regmap_write(regmap, ext_addr, 0);
+	if (!ret)
+		ret = regmap_read(regmap, ext_addr, &ext);
+	if (ret || ext) {
+		/* Still terminating the session: leave the rest as it is,
+		 * for the caller to keep the slot out of use.
+		 */
+		pr_err("ppe_offload: PPPoE session entry %u not cleared (%d, %#x); new flows declined, disable and reboot\n",
+		       slot, ret, ext);
+		priv->degraded = true;
+		return ret ?: -EIO;
+	}
+
+	regmap_write(regmap, PPE_PPPOE_SESSION_EXT2_ADDR + slot * PPE_PPPOE_SESSION_EXT2_INC, 0);
+	regmap_write(regmap, PPE_PPPOE_SESSION_EXT1_ADDR + slot * PPE_PPPOE_SESSION_EXT1_INC, 0);
+	regmap_write(regmap, PPE_PPPOE_SESSION_ADDR + slot * PPE_PPPOE_SESSION_INC, 0);
+	ppe_l3_if_in_entry_set(priv->ppe_dev, l3_if, &in);
+	ppe_l3_if_eg_entry_set(priv->ppe_dev, l3_if, &eg);
+
+	return 0;
+}
+
+/* Program session @info in slot @slot: the L3 interface a frame of the
+ * session is given (ingress: PPPoE terminated, IPv4 routed, the port's
+ * MY_MAC, the PPP device's MTU as MRU and MTU; egress: the session ID and
+ * PPPoE encapsulation, the port's MAC), then the session entry, its valid
+ * word last, matching the session ID on the port only and the access
+ * concentrator's MAC as source. Everything is read back. Under priv->lock.
+ *
+ * Return: 0 on success, a negative error code with the slot cleared (or,
+ * when even that fails, marked broken).
+ */
+static int ppe_offload_pppoe_program(struct ppe_offload_priv *priv, unsigned int slot,
+				     const struct ppe_offload_pppoe_info *info)
+{
+	struct regmap *regmap = priv->ppe_dev->regmap;
+	u32 l3_if = PPE_OFFLOAD_PPPOE_L3_IF_BASE + slot;
+	struct ppe_l3_if_eg_entry eg = {}, eg_back;
+	struct ppe_l3_if_in_entry in = {}, in_back;
+	const u8 *mac = info->ac_mac;
+	u32 want[4], got[4];
+	unsigned int i, mtu;
+	int ret;
+
+	mtu = min_t(u32, info->mtu, FIELD_MAX(PPE_IN_L3_IF_TBL_MTU));
+	in.mru = mtu;
+	in.mtu = mtu;
+	in.mru_ipv6 = mtu;
+	in.mtu_ipv6 = mtu;
+	in.ipv4_uc_route_en = true;
+	/* As on the ports' own (edma_port_l3_if_program()). */
+	in.ttl_exceed_cmd = PPE_L3_IF_ACTION_REDIRECT_TO_CPU;
+	in.ttl_exceed_de_acce = false;
+	in.mac_bitmap = BIT(info->port_l3_if - 1);
+	in.pppoe_en = true;
+
+	ether_addr_copy(eg.mac_addr, info->local_mac);
+	eg.session_id = info->sid;
+	eg.pppoe_en = true;
+
+	want[0] = FIELD_PREP(PPE_PPPOE_SESSION_SESSION_ID, info->sid) |
+		  FIELD_PREP(PPE_PPPOE_SESSION_PORT_BITMAP, BIT(info->port)) |
+		  FIELD_PREP(PPE_PPPOE_SESSION_TYPE, PPE_PPPOE_SESSION_TYPE_PORT_BITMAP);
+	want[1] = (u32)mac[0] << 24 | (u32)mac[1] << 16 | (u32)mac[2] << 8 | mac[3];
+	want[2] = FIELD_PREP(PPE_PPPOE_SESSION_EXT2_L3_IF_INDEX, l3_if) |
+		  PPE_PPPOE_SESSION_EXT2_L3_IF_VALID;
+	want[3] = PPE_PPPOE_SESSION_EXT_UC_VALID | PPE_PPPOE_SESSION_EXT_SMAC_VALID |
+		  FIELD_PREP(PPE_PPPOE_SESSION_EXT_SMAC, (u32)mac[4] << 8 | mac[5]);
+
+	ret = ppe_l3_if_in_entry_set(priv->ppe_dev, l3_if, &in);
+	if (!ret)
+		ret = ppe_l3_if_eg_entry_set(priv->ppe_dev, l3_if, &eg);
+	if (!ret)
+		ret = ppe_l3_if_in_entry_get(priv->ppe_dev, l3_if, &in_back);
+	if (!ret)
+		ret = ppe_l3_if_eg_entry_get(priv->ppe_dev, l3_if, &eg_back);
+	if (!ret && (in_back.mru != in.mru || in_back.mtu != in.mtu ||
+		     in_back.mac_bitmap != in.mac_bitmap || !in_back.pppoe_en ||
+		     !in_back.ipv4_uc_route_en || in_back.ipv6_uc_route_en ||
+		     in_back.ttl_exceed_cmd != in.ttl_exceed_cmd ||
+		     in_back.ttl_exceed_de_acce != in.ttl_exceed_de_acce ||
+		     !ether_addr_equal(eg_back.mac_addr, eg.mac_addr) ||
+		     eg_back.session_id != eg.session_id || !eg_back.pppoe_en))
+		ret = -EIO;
+	if (ret)
+		goto fail;
+
+	ret = regmap_write(regmap, PPE_PPPOE_SESSION_ADDR + slot * PPE_PPPOE_SESSION_INC, want[0]);
+	if (!ret)
+		ret = regmap_write(regmap, PPE_PPPOE_SESSION_EXT1_ADDR +
+				   slot * PPE_PPPOE_SESSION_EXT1_INC, want[1]);
+	if (!ret)
+		ret = regmap_write(regmap, PPE_PPPOE_SESSION_EXT2_ADDR +
+				   slot * PPE_PPPOE_SESSION_EXT2_INC, want[2]);
+	if (!ret)
+		ret = regmap_write(regmap, PPE_PPPOE_SESSION_EXT_ADDR +
+				   slot * PPE_PPPOE_SESSION_EXT_INC, want[3]);
+	if (!ret)
+		ret = regmap_read(regmap, PPE_PPPOE_SESSION_ADDR + slot * PPE_PPPOE_SESSION_INC,
+				  &got[0]);
+	if (!ret)
+		ret = regmap_read(regmap, PPE_PPPOE_SESSION_EXT1_ADDR +
+				  slot * PPE_PPPOE_SESSION_EXT1_INC, &got[1]);
+	if (!ret)
+		ret = regmap_read(regmap, PPE_PPPOE_SESSION_EXT2_ADDR +
+				  slot * PPE_PPPOE_SESSION_EXT2_INC, &got[2]);
+	if (!ret)
+		ret = regmap_read(regmap, PPE_PPPOE_SESSION_EXT_ADDR +
+				  slot * PPE_PPPOE_SESSION_EXT_INC, &got[3]);
+	if (ret)
+		goto fail;
+
+	for (i = 0; i < ARRAY_SIZE(want); i++) {
+		if (got[i] != want[i]) {
+			pr_err("ppe_offload: PPPoE session entry %u word %u read back %#x, wrote %#x\n",
+			       slot, i, got[i], want[i]);
+			ret = -EIO;
+			goto fail;
+		}
+	}
+
+	return 0;
+
+fail:
+	if (ppe_offload_pppoe_clear(priv, slot))
+		priv->pppoe[slot].broken = true;
+	return ret ?: -EIO;
+}
+
+/* What a session entry in hardware does to its frames is not known for
+ * those that miss every flow: LCP, the router's own traffic, the first
+ * packets of every connection not yet offloaded. If hardware strips their
+ * PPPoE header before handing them to the CPU, they arrive on the
+ * session's lower device as plain IPv4 or IPv6 from the access
+ * concentrator, which software drops, while LCP may keep the session up.
+ * The bench checks this before a session goes into hardware on a live
+ * line; this watch is the backstop: one such frame takes the session out
+ * of hardware and keeps PPPoE in software until offload is enabled again.
+ * Only a frame from the concentrator addressed to this host counts, as a
+ * session frame would be: the concentrator's own multicast (router
+ * solicitations, MLD, mDNS) and anyone else's frames pass, as do the
+ * frames the core also hands over for an upper of the device (a VLAN or
+ * macvlan on an untagged session's port), which are on that upper by
+ * then. Runs in softirq.
+ */
+static int ppe_offload_strip_rcv(struct sk_buff *skb, struct net_device *dev,
+				 struct packet_type *pt, struct net_device *orig_dev)
+{
+	struct ppe_offload_pppoe *p = pt->af_packet_priv;
+
+	if (dev == pt->dev && skb->pkt_type == PACKET_HOST && skb_mac_header_was_set(skb) &&
+	    ether_addr_equal(eth_hdr(skb)->h_source, p->info.ac_mac) &&
+	    !READ_ONCE(p->stripped)) {
+		WRITE_ONCE(p->stripped, true);
+		schedule_work(&p->owner->strip_work);
+	}
+
+	consume_skb(skb);
+
+	return NET_RX_SUCCESS;
+}
+
+/* Hook ppe_offload_strip_rcv() on the session's lower device; a session
+ * is not used without it. Under priv->lock.
+ */
+static int ppe_offload_strip_hook(struct ppe_offload_priv *priv, struct net *net,
+				  struct ppe_offload_pppoe *p)
+{
+	static const __be16 types[] = { htons(ETH_P_IP), htons(ETH_P_IPV6) };
+	unsigned int i;
+
+	/* Gone already: the session is about to go too. */
+	p->strip_dev = netdev_get_by_index(net, p->info.lower_ifindex, &p->strip_tracker,
+					   GFP_KERNEL);
+	if (!p->strip_dev)
+		return -ENODEV;
+
+	p->owner = priv;
+	WRITE_ONCE(p->stripped, false);
+	for (i = 0; i < ARRAY_SIZE(p->strip_pt); i++) {
+		p->strip_pt[i].type = types[i];
+		p->strip_pt[i].dev = p->strip_dev;
+		p->strip_pt[i].func = ppe_offload_strip_rcv;
+		p->strip_pt[i].af_packet_priv = p;
+		dev_add_pack(&p->strip_pt[i]);
+	}
+
+	return 0;
+}
+
+/* Remove the hook again; dev_remove_pack() waits for its readers. */
+static void ppe_offload_strip_unhook(struct ppe_offload_pppoe *p)
+{
+	unsigned int i;
+
+	if (!p->strip_dev)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(p->strip_pt); i++)
+		dev_remove_pack(&p->strip_pt[i]);
+	netdev_put(p->strip_dev, &p->strip_tracker);
+	p->strip_dev = NULL;
+}
+
+/* Get the hardware session for @info, programming it on first use. Under
+ * priv->lock.
+ *
+ * Return: 0 with @slot set and a reference taken, a negative error code
+ * otherwise.
+ */
+static int ppe_offload_pppoe_get(struct ppe_offload_priv *priv, struct net *net,
+				 const struct ppe_offload_pppoe_info *info, unsigned int *slot)
+{
+	struct ppe_offload_pppoe *p;
+	int i, free = -1;
+	int ret;
+
+	for (i = 0; i < PPE_OFFLOAD_PPPOE_MAX; i++) {
+		p = &priv->pppoe[i];
+		if (p->broken)
+			continue;
+		if (!p->refs) {
+			if (free < 0)
+				free = i;
+			continue;
+		}
+		if (p->live && !memcmp(&p->info, info, sizeof(*info))) {
+			p->refs++;
+			*slot = i;
+			return 0;
+		}
+		/* The session entry matches on the session ID, port and
+		 * source MAC only, not on the VLAN: a second session that
+		 * differs in nothing else could not be told apart.
+		 */
+		if (p->live && p->info.sid == info->sid && p->info.port == info->port &&
+		    ether_addr_equal(p->info.ac_mac, info->ac_mac)) {
+			pr_info_once("ppe_offload: PPPoE session %u from %pM already in hardware on another device, declined\n",
+				     info->sid, info->ac_mac);
+			return -EBUSY;
+		}
+	}
+
+	if (free < 0)
+		return -ENOSPC;
+
+	ret = ppe_offload_pppoe_program(priv, free, info);
+	if (ret)
+		return ret;
+
+	p = &priv->pppoe[free];
+	p->info = *info;
+	ret = ppe_offload_strip_hook(priv, net, p);
+	if (ret) {
+		if (ppe_offload_pppoe_clear(priv, free))
+			p->broken = true;
+		else
+			memset(p, 0, sizeof(*p));
+		return ret;
+	}
+	p->refs = 1;
+	p->live = true;
+	p->since = jiffies;
+	*slot = free;
+
+	pr_info("ppe_offload: PPPoE session %u from %pM (port %u, VLAN %u, MTU %u) in hardware: session entry %d, L3 interface %u\n",
+		info->sid, info->ac_mac, info->port, info->vid, info->mtu, free,
+		PPE_OFFLOAD_PPPOE_L3_IF_BASE + free);
+
+	return 0;
+}
+
+/* A session that dies within this long of going into hardware, twice in a
+ * row, keeps PPPoE in software until offload is enabled again: the kernel's
+ * session going down so soon is what a hardware session entry that breaks
+ * the session's slow path (LCP, new connections) would look like. Only the
+ * PPP device going down or away counts: a carrier blip, an address or MTU
+ * change or the parameter being cleared also take the session out of
+ * hardware, but say nothing about it. A session that is out of hardware
+ * when its PPP device dies is not counted; one programmed again after such
+ * a change, once its link is back, counts if it then dies: the breaker
+ * errs towards keeping PPPoE in software.
+ */
+#define PPE_OFFLOAD_PPPOE_FLAP_WINDOW	(60 * HZ)
+#define PPE_OFFLOAD_PPPOE_FLAP_MAX	2
+
+/* A session in hardware since @since died: its PPP device went down or
+ * away. Count it towards the breaker when it was that young. Under
+ * priv->lock.
+ */
+static void ppe_offload_pppoe_died(struct ppe_offload_priv *priv, unsigned long since)
+{
+	if (time_before(jiffies, since + PPE_OFFLOAD_PPPOE_FLAP_WINDOW))
+		priv->pppoe_short++;
+	else
+		priv->pppoe_short = 0;
+	if (priv->pppoe_short >= PPE_OFFLOAD_PPPOE_FLAP_MAX && !priv->pppoe_blocked) {
+		priv->pppoe_blocked = true;
+		pr_err("ppe_offload: %u PPPoE sessions in a row died within %us of going into hardware; PPPoE stays in software until offload is enabled again\n",
+		       priv->pppoe_short, (unsigned int)(PPE_OFFLOAD_PPPOE_FLAP_WINDOW / HZ));
+	}
+}
+
+static void ppe_offload_pin_release(struct ppe_offload_priv *priv);
+
+/* Take a session out of hardware and drop its flows, and the bench pin
+ * if it holds the session. A flow whose entry cannot be deleted keeps the
+ * slot and L3 interface reserved until it is. Under priv->lock.
+ */
+static void ppe_offload_pppoe_kill(struct ppe_offload_priv *priv, unsigned int slot,
+				   const char *why)
+{
+	struct ppe_offload_pppoe *p = &priv->pppoe[slot];
+	struct ppe_offload_flow_entry *entry, *tmp;
+	unsigned int dropped = 0, stuck = 0;
+	u16 sid = p->info.sid;
+
+	if (!p->live)
+		return;
+
+	/* The session entry first: from then on no frame is given the
+	 * session's L3 interface, so its flows cannot hit; the slot stays
+	 * reserved until they are deleted. If it cannot be cleared, the
+	 * slot is never used again.
+	 */
+	if (ppe_offload_pppoe_clear(priv, slot))
+		p->broken = true;
+	ppe_offload_strip_unhook(p);
+	p->live = false;
+
+	/* The last put frees the slot (p is cleared then). */
+	list_for_each_entry_safe(entry, tmp, &priv->flows, list) {
+		if (!entry->pppoe || entry->pppoe_slot != slot)
+			continue;
+		if (ppe_offload_flow_drop(priv, entry))
+			stuck++;
+		else
+			dropped++;
+	}
+
+	pr_info("ppe_offload: PPPoE session %u out of hardware (%s): %u flow(s) back to software, %u stuck\n",
+		sid, why, dropped, stuck);
+
+	/* Not _sync: ppe_offload_pin_timeout() takes priv->lock, and finds
+	 * no pin if it runs now.
+	 */
+	if (priv->pin_slot == (int)slot) {
+		cancel_delayed_work(&priv->pin_work);
+		ppe_offload_pin_release(priv);
+	}
+}
+
+static void ppe_offload_pppoe_put(struct ppe_offload_priv *priv, unsigned int slot)
+{
+	struct ppe_offload_pppoe *p = &priv->pppoe[slot];
+
+	if (WARN_ON_ONCE(slot >= PPE_OFFLOAD_PPPOE_MAX || !p->refs))
+		return;
+
+	if (--p->refs)
+		return;
+
+	if (p->live) {
+		if (ppe_offload_pppoe_clear(priv, slot))
+			p->broken = true;
+		ppe_offload_strip_unhook(p);
+		p->live = false;
+		pr_info("ppe_offload: PPPoE session %u out of hardware (no flows left)\n",
+			p->info.sid);
+	}
+	if (!p->broken)
+		memset(p, 0, sizeof(*p));
+}
+
+/* ppe_offload_strip_rcv() saw a decapsulated frame: that session goes out
+ * of hardware and PPPoE stays in software until offload is enabled again.
+ */
+static void ppe_offload_strip_work(struct work_struct *work)
+{
+	struct ppe_offload_priv *priv = container_of(work, struct ppe_offload_priv, strip_work);
+	unsigned int i;
+
+	mutex_lock(&priv->lock);
+	for (i = 0; i < PPE_OFFLOAD_PPPOE_MAX; i++) {
+		struct ppe_offload_pppoe *p = &priv->pppoe[i];
+
+		if (!p->live || !READ_ONCE(p->stripped))
+			continue;
+		if (!priv->pppoe_blocked)
+			pr_err("ppe_offload: IP frame from %pM on the lower device of PPPoE session %u: hardware hands session frames to the CPU decapsulated; PPPoE stays in software until offload is enabled again\n",
+			       p->info.ac_mac, p->info.sid);
+		priv->pppoe_blocked = true;
+		ppe_offload_pppoe_kill(priv, i, "decapsulated frames");
+	}
+	mutex_unlock(&priv->lock);
+}
+
+/* Take every session out of hardware. Under priv->lock. */
+static void ppe_offload_pppoe_kill_all(struct ppe_offload_priv *priv, const char *why)
+{
+	unsigned int i;
+
+	for (i = 0; i < PPE_OFFLOAD_PPPOE_MAX; i++)
+		ppe_offload_pppoe_kill(priv, i, why);
+}
+
+/* Let go of the bench pin, if any. Under priv->lock. */
+static void ppe_offload_pin_release(struct ppe_offload_priv *priv)
+{
+	if (priv->pin_slot < 0)
+		return;
+
+	ppe_offload_pppoe_put(priv, priv->pin_slot);
+	priv->pin_slot = -1;
+	pr_info("ppe_offload: PPPoE session pin released\n");
+}
+
+static void ppe_offload_pin_timeout(struct work_struct *work)
+{
+	struct ppe_offload_priv *priv = container_of(to_delayed_work(work),
+						     struct ppe_offload_priv, pin_work);
+
+	mutex_lock(&priv->lock);
+	ppe_offload_pin_release(priv);
+	mutex_unlock(&priv->lock);
+}
+
+/* The session of PPP device @name as ppe_offload_pppoe_resolve() checks a
+ * flow's, its own address standing in for the flow's. Under RCU.
+ */
+static bool ppe_offload_pppoe_from_dev(struct net *net, const char *name,
+				       struct ppe_offload_pppoe_info *info)
+{
+	static const u8 zero_mac[ETH_ALEN];
+	struct net_device_path_stack stack;
+	struct net_device *ppp, *lower, *port_dev;
+	const struct in_ifaddr *ifa;
+	struct in_device *in_dev;
+	u16 vid = 0;
+
+	ppp = dev_get_by_name_rcu(net, name);
+	if (!ppp || ppp->type != ARPHRD_PPP)
+		return false;
+	in_dev = __in_dev_get_rcu(ppp);
+	ifa = in_dev ? rcu_dereference(in_dev->ifa_list) : NULL;
+	if (!ifa)
+		return false;
+
+	if (dev_fill_forward_path(ppp, zero_mac, &stack) < 0 || stack.num_paths < 2 ||
+	    stack.num_paths > 3 || stack.path[0].type != DEV_PATH_PPPOE)
+		return false;
+	port_dev = (struct net_device *)stack.path[stack.num_paths - 1].dev;
+	lower = port_dev;
+	if (stack.num_paths == 3) {
+		lower = (struct net_device *)stack.path[1].dev;
+		vid = stack.path[1].encap.id;
+	}
+	if (!edma_port_is_edma_netdev(port_dev))
+		return false;
+
+	return ppe_offload_pppoe_resolve(net, ifa->ifa_local, port_dev, lower, vid,
+					 stack.path[0].encap.id, info);
+}
+
+/* Bench only: "<ppp device> <seconds>" programs that device's session into
+ * hardware with no flow for at most PPE_OFFLOAD_PIN_SECONDS_MAX, to check
+ * what a session entry alone does to the session's frames; "-" lets go of
+ * it. Needs offload and PPPoE offload on.
+ */
+#define PPE_OFFLOAD_PIN_SECONDS_MAX	600
+
+static ssize_t ppe_offload_pin_write(struct file *file, const char __user *ubuf,
+				     size_t count, loff_t *ppos)
+{
+	struct ppe_offload_priv *priv = file->private_data;
+	struct ppe_offload_pppoe_info info;
+	char buf[IFNAMSIZ + 16] = {};
+	char name[IFNAMSIZ] = {};
+	unsigned int seconds, slot;
+	bool ok;
+	int ret = 0;
+	int gen;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+
+	if (buf[0] == '-') {
+		cancel_delayed_work(&priv->pin_work);
+		mutex_lock(&priv->lock);
+		ppe_offload_pin_release(priv);
+		mutex_unlock(&priv->lock);
+		return count;
+	}
+
+	if (sscanf(buf, "%15s %u", name, &seconds) != 2 || !seconds ||
+	    seconds > PPE_OFFLOAD_PIN_SECONDS_MAX)
+		return -EINVAL;
+
+	/* As for an offer: a device change after the resolve is noticed. */
+	gen = atomic_read(&priv->pppoe_gen);
+	rcu_read_lock();
+	ok = ppe_offload_pppoe_from_dev(&init_net, name, &info);
+	rcu_read_unlock();
+	if (!ok)
+		return -ENODEV;
+
+	mutex_lock(&priv->lock);
+	if (!priv->enabled || priv->degraded || !priv->pppoe_exceptions_ok ||
+	    priv->pppoe_blocked || !READ_ONCE(ppe_offload_pppoe_param))
+		ret = -EPERM;
+	else if (priv->pin_slot >= 0)
+		ret = -EBUSY;
+	else if (atomic_read(&priv->pppoe_gen) != gen)
+		ret = -EAGAIN;
+	else
+		ret = ppe_offload_pppoe_get(priv, &init_net, &info, &slot);
+	if (!ret) {
+		priv->pin_slot = slot;
+		mod_delayed_work(system_wq, &priv->pin_work, seconds * HZ);
+		pr_info("ppe_offload: PPPoE session %u pinned in hardware for %us\n", info.sid,
+			seconds);
+	}
+	mutex_unlock(&priv->lock);
+
+	return ret ?: count;
+}
+
+static ssize_t ppe_offload_pin_read(struct file *file, char __user *ubuf, size_t count,
+				    loff_t *ppos)
+{
+	struct ppe_offload_priv *priv = file->private_data;
+	char buf[32];
+	int len;
+
+	mutex_lock(&priv->lock);
+	len = priv->pin_slot < 0 ? scnprintf(buf, sizeof(buf), "-\n") :
+	      scnprintf(buf, sizeof(buf), "%u\n", priv->pppoe[priv->pin_slot].info.sid);
+	mutex_unlock(&priv->lock);
+
+	return simple_read_from_buffer(ubuf, count, ppos, buf, len);
+}
+
+static const struct file_operations ppe_offload_pin_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = ppe_offload_pin_read,
+	.write = ppe_offload_pin_write,
+	.llseek = default_llseek,
+};
 
