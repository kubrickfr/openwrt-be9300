 #define PPE_OFFLOAD_REARM_WINDOW	(10 * HZ)
 #define PPE_OFFLOAD_REARM_MAX		256
@@ -1432,7 +1559,651 @@ static bool ppe_offload_rearm_trip(struct ppe_offload_priv *priv)
 				 BIT_ULL(FLOW_DISSECTOR_KEY_TCP) |		\
 				 BIT_ULL(FLOW_DISSECTOR_KEY_PORTS) |		\
 				 BIT_ULL(FLOW_DISSECTOR_KEY_VLAN) |		\
