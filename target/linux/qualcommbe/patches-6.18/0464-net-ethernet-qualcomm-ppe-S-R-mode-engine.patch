+/* After every engine call, under the lock: a degraded latch from the
+ * sequences is the offload's; once the mode is off again the conduit is let
+ * go and the topology withdrawn (D9).
+ */
+static void ppe_sr_settle(struct ppe_sr *sr)
+{
+	lockdep_assert_held(sr->lock);
+
+	if (sr->eng.seq.degrade) {
+		sr->eng.seq.degrade = false;
+		ppe_offload_set_degraded(sr->priv);
+	}
+	if (sr->eng.seq.state != PPE_SR_S_OFF)
+		return;
+	if (sr->conduit) {
+		netdev_put(sr->conduit, &sr->conduit_tracker);
+		sr->conduit = NULL;
+	}
+	if (rcu_access_pointer(sr->topo))
+		ppe_sr_publish(sr, NULL);
+}
+
+/**
+ * ppe_sr_count_decline() - Count a declined offer.
+ * @sr: The S-R mode.
+ * @why: enum ppe_sr_why.
+ *
+ * Lockless.
+ */
+void ppe_sr_count_decline(struct ppe_sr *sr, enum ppe_sr_why why)
+{
+	if ((unsigned int)why < PPE_SR_W_NUM)
+		atomic_long_inc(&sr->decline[why]);
+}
+
+static void ppe_sr_queue_resync(struct ppe_sr *sr)
+{
+	queue_work(sr->wq, &sr->resync_work);
+}
+
+/**
+ * ppe_sr_degraded() - The D13 hook (WP2-DESIGN): ppe_offload_set_degraded()
+ * latched degraded.
+ * @sr: The S-R mode.
+ *
+ * Under the lock. While S-R is not off that is FAULT (once any sequence
+ * running returns).
+ */
+void ppe_sr_degraded(struct ppe_sr *sr)
+{
+	lockdep_assert_held(sr->lock);
+
+	ppe_sr_eng_degraded(&sr->eng, &sr->io);
+	/* The offload has latched it already. */
+	sr->eng.seq.degrade = false;
+}
+
+#if IS_ENABLED(CONFIG_NET_DSA)
+struct ppe_sr_find {
+	struct net_device *conduit;
+	unsigned int n;
+};
+
+static int ppe_sr_find_one(struct net_device *netdev, void *arg)
+{
+	struct ppe_sr_find *f = arg;
+
+	if (netdev_uses_dsa(netdev) && netdev->dsa_ptr->tag_ops &&
+	    netdev->dsa_ptr->tag_ops->proto == DSA_TAG_PROTO_RTL8_4S) {
+		f->conduit = netdev;
+		f->n++;
+	}
+
+	return 0;
+}
+
+/* The EDMA ports other than the conduit: their egress stays C-type. */
+static int ppe_sr_ctype_one(struct net_device *netdev, void *arg)
+{
+	struct edma_port_priv *port_priv = netdev_priv(netdev);
+	struct ppe_sr_cfg *cfg = arg;
+	int port = port_priv->ppe_port->port_id;
+
+	if (port > 0 && port < BITS_PER_TYPE(cfg->ctype_ports) && port != cfg->ppe_port)
+		cfg->ctype_ports |= BIT(port);
+
+	return 0;
+}
+
+/* The switch port mask of @dev if it is a user port of the S-R conduit in
+ * the S-R port mask, else 0. Under the lock and RTNL.
+ */
+static u16 ppe_sr_user_ports(struct ppe_sr *sr, struct net_device *dev)
+{
+	struct dsa_port *dp;
+
+	if (!sr->conduit || !dsa_user_dev_check(dev))
+		return 0;
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR(dp) || dp->index >= PPE_SR_PORTS || !dp->cpu_dp ||
+	    dp->cpu_dp->conduit != sr->conduit)
+		return 0;
+
+	return sr->eng.s_ports & BIT(dp->index);
+}
+
+/* A0-A2 of the arm (WP2-DESIGN §4.4) but the engine's prechecks: the one
+ * rtl8_4s conduit, up; the offload ready for S-R and profile E applied on
+ * the conduit (A1); the switch READY and unclaimed, its generation, port
+ * mask and deadline; the topology and the plan. Under RTNL and the lock.
+ */
+static int ppe_sr_arm_prepare(struct ppe_sr *sr, const struct ppe_sr_arm_args *args,
+			      struct ppe_sr_eng_arm *a, struct ppe_sr_buf *b,
+			      struct ppe_sr_topo_pub *pub, struct net_device **conduitp,
+			      enum ppe_sr_why *why)
+{
+	const struct ppe_sr_vops vops = { .ctx = &b->ctx, .vinfo = ppe_sr_topo_vinfo };
+	struct ppe_sr_scope_pub *scope;
+	struct rtl8_4s_tagger_data *td;
+	struct edma_port_priv *port_priv;
+	struct ppe_sr_find f = {};
+	struct net_device *conduit;
+	unsigned long disarm_at;
+	const char *what;
+	int ret, word;
+
+	*why = PPE_SR_W_PRECHECK;
+	edma_port_for_each_netdev(ppe_sr_find_one, &f);
+	if (f.n != 1)
+		return ppe_sr_eng_refuse(&sr->eng, &sr->io, *why, -ENODEV,
+					 f.n ? "more than one rtl8_4s conduit" :
+					 "no rtl8_4s conduit");
+	conduit = f.conduit;
+	if (!(conduit->flags & IFF_UP) || !netif_running(conduit))
+		return ppe_sr_eng_refuse(&sr->eng, &sr->io, *why, -ENODEV, "conduit down");
+
+	port_priv = netdev_priv(conduit);
+	a->cfg.ppe_port = port_priv->ppe_port->port_id;
+	a->cfg.l3_if = port_priv->l3_if_index;
+	ether_addr_copy(a->cfg.mac, conduit->dev_addr);
+	edma_port_for_each_netdev(ppe_sr_ctype_one, &a->cfg);
+
+	ret = ppe_offload_sr_precheck(sr->priv, a->cfg.ppe_port, &what);
+	if (ret)
+		return ppe_sr_eng_refuse(&sr->eng, &sr->io, *why, ret, what);
+
+	/* A2: the switch data is valid for this RTNL section. */
+	*why = PPE_SR_W_SWITCH_NOT_READY;
+	td = rtl8_4s_conduit_td(conduit);
+	if (!td)
+		return ppe_sr_eng_refuse(&sr->eng, &sr->io, *why, -ENODEV, "no rtl8_4s switch");
+	word = ppe_sr_td_word(td, &disarm_at);
+	if (rtl8_4s_word_state(word) != RTL8_4S_ST_SWITCH_READY)
+		return ppe_sr_eng_refuse(&sr->eng, &sr->io, *why, -EBUSY,
+					 "switch not armed, or not READY and unclaimed");
+	a->cfg.sw_gen = READ_ONCE(td->sw_gen);
+	a->cfg.s_ports = READ_ONCE(td->s_ports);
+
+	*why = PPE_SR_W_PRECHECK;
+	ret = ppe_sr_deadline_cap(jiffies, args->deadline, disarm_at,
+				  PPE_SR_DEADLINE_MARGIN_S * HZ, PPE_SR_DEADLINE_MIN_S * HZ,
+				  &a->deadline);
+	if (ret)
+		return ppe_sr_eng_refuse(&sr->eng, &sr->io, *why, -EINVAL,
+					 "deadline: less than 60 s left before the switch's own less 30 s");
+
+	ret = ppe_sr_topo_collect(conduit, a->cfg.s_ports, 0, &b->in, &b->ctx);
+	if (!ret)
+		ret = ppe_sr_topo_build(&b->in, &vops, &pub->topo);
+	if (ret)
+		return ppe_sr_eng_refuse(&sr->eng, &sr->io, *why, ret, "topology not resolved");
+
+	scope = rcu_dereference_protected(sr->scope, lockdep_is_held(sr->lock));
+	a->n = ppe_sr_eng_plan(&pub->topo, scope ? &scope->scope : NULL,
+			       READ_ONCE(ppe_sr_u_uploads), b->plan, PPE_SR_ID_MAX, &a->wanted);
+	a->plan = b->plan;
+	a->l3_truncated = b->in.l3_truncated;
+	a->bridge_ifindex = b->ctx.bridge ? b->ctx.bridge->ifindex : 0;
+	a->offers = args->offers;
+	*conduitp = conduit;
+
+	return 0;
+}
+#else
+static u16 ppe_sr_user_ports(struct ppe_sr *sr, struct net_device *dev)
+{
+	return 0;
+}
+
+static int ppe_sr_arm_prepare(struct ppe_sr *sr, const struct ppe_sr_arm_args *args,
+			      struct ppe_sr_eng_arm *a, struct ppe_sr_buf *b,
+			      struct ppe_sr_topo_pub *pub, struct net_device **conduitp,
+			      enum ppe_sr_why *why)
+{
+	*why = PPE_SR_W_PRECHECK;
+
+	return ppe_sr_eng_refuse(&sr->eng, &sr->io, *why, -ENODEV, "no DSA");
+}
+#endif
+
+/**
+ * ppe_sr_arm() - Arm the S-R mode (WP2-DESIGN §4.4).
+ * @priv: The offload.
+ * @args: The deadline (required; capped at the switch's own less
+ * PPE_SR_DEADLINE_MARGIN_S, refused with less than PPE_SR_DEADLINE_MIN_S
+ * left) and whether to turn offers on.
+ * @why: Set to the refusal's reason (enum ppe_sr_why), PPE_SR_W_OK on
+ * success.
+ *
+ * Under RTNL; takes the lock. Never claims on its own initiative: only this
+ * (WP3's control) starts S-R (D16). Every refusal is counted and logged
+ * ("ppe_offload: sr: refused ...").
+ *
+ * Return: 0 (READY, or ACTIVE with offers), -EBUSY (PRECHECK or
+ * SWITCH_NOT_READY), -EIO (FAULT, a stuck flow, a failed rollback),
+ * -ENOSPC (BUDGET), -ENODEV (no conduit or switch), -EALREADY (not off),
+ * -EINVAL (NOTHING, or no or too short a deadline), -ENOMEM.
+ */
+int ppe_sr_arm(struct ppe_offload_priv *priv, const struct ppe_sr_arm_args *args,
+	       enum ppe_sr_why *why)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	struct ppe_sr_eng_arm a = {};
+	struct net_device *conduit = NULL;
+	struct ppe_sr_topo_pub *pub;
+	struct ppe_sr_buf *b;
+	int ret;
+
+	ASSERT_RTNL();
+	*why = PPE_SR_W_PRECHECK;
+	if (!args)
+		return -EINVAL;
+
+	b = kzalloc(sizeof(*b), GFP_KERNEL);
+	pub = kzalloc(sizeof(*pub), GFP_KERNEL);
+	if (!b || !pub) {
+		ret = -ENOMEM;
+		goto free;
+	}
+
+	mutex_lock(sr->lock);
+	ret = ppe_sr_eng_arm_check(&sr->eng, &sr->io, args->deadline, why);
+	if (!ret)
+		ret = ppe_sr_arm_prepare(sr, args, &a, b, pub, &conduit, why);
+	if (!ret) {
+		/* Held for the claim (A4); let go by the settle if it ends off. */
+		sr->conduit = conduit;
+		netdev_hold(conduit, &sr->conduit_tracker, GFP_KERNEL);
+		strscpy(sr->conduit_name, conduit->name, sizeof(sr->conduit_name));
+		ret = ppe_sr_eng_arm(&sr->eng, &sr->io, &a, why);
+		if (!ret) {
+			ppe_sr_publish(sr, pub);
+			pub = NULL;
+		}
+	}
+	ppe_sr_settle(sr);
+	mutex_unlock(sr->lock);
+
+free:
+	kfree(b);
+	kfree(pub);
+
+	return ret;
+}
+
+/**
+ * ppe_sr_offers() - Turn S-R offers on or off (WP2-DESIGN §4.5).
+ * @priv: The offload.
+ * @on: READY to ACTIVE, or ACTIVE to READY with every flow dropped.
+ *
+ * Under the lock (RTNL not needed).
+ *
+ * Return: 0 (also when already so), -EINVAL unless READY or ACTIVE, -EBUSY
+ * if the switch refuses ACTIVE, -EIO in or into FAULT.
+ */
+int ppe_sr_offers(struct ppe_offload_priv *priv, bool on)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	int ret;
+
+	lockdep_assert_held(sr->lock);
+
+	ret = ppe_sr_eng_offers(&sr->eng, &sr->io, on);
+	ppe_sr_settle(sr);
+
+	return ret;
+}
+
+/**
+ * ppe_sr_disarm() - Disarm the S-R mode (WP2-DESIGN §4.6).
+ * @priv: The offload.
+ * @trigger: Why (enum ppe_sr_trigger).
+ *
+ * Under the lock; RTNL is not needed. Idempotent. Once off, E may accept
+ * again, and only then may the switch disarm.
+ *
+ * Return: 0 (off, also when it already was), -EIO in or into FAULT.
+ */
+int ppe_sr_disarm(struct ppe_offload_priv *priv, enum ppe_sr_trigger trigger)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	int ret;
+
+	lockdep_assert_held(sr->lock);
+
+	ret = ppe_sr_eng_disarm(&sr->eng, &sr->io, trigger);
+	ppe_sr_settle(sr);
+
+	return ret;
+}
+
+/**
+ * ppe_sr_disarm_locked_by() - ppe_sr_disarm(), taking the lock.
+ * @priv: The offload.
+ * @trigger: Why.
+ *
+ * For notifiers and works, which do not hold it.
+ *
+ * Return: as ppe_sr_disarm().
+ */
+int ppe_sr_disarm_locked_by(struct ppe_offload_priv *priv, enum ppe_sr_trigger trigger)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	int ret;
+
+	mutex_lock(sr->lock);
+	ret = ppe_sr_disarm(priv, trigger);
+	mutex_unlock(sr->lock);
+
+	return ret;
+}
+
+/**
+ * ppe_sr_topo_event() - Something the S-R topology depends on changed
+ * (WP2-DESIGN D14, §2.4).
+ * @priv: The offload.
+ * @ports: The switch ports concerned (PPE_SR_PORTS_ALL for every one).
+ *
+ * Under RTNL, from the notifier of the change; takes the lock. The ports'
+ * flows are dropped and offers wait for the resync, which runs once the
+ * change is complete (RTNL, then the lock).
+ */
+void ppe_sr_topo_event(struct ppe_offload_priv *priv, u32 ports)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	bool queue;
+
+	ASSERT_RTNL();
+
+	mutex_lock(sr->lock);
+	queue = ppe_sr_eng_topo_event(&sr->eng, &sr->io, ports & PPE_SR_PORTS_ALL, false);
+	ppe_sr_settle(sr);
+	mutex_unlock(sr->lock);
+	if (queue)
+		ppe_sr_queue_resync(sr);
+}
+
+/* What a netdevice event on @dev means to S-R (WP2-DESIGN §2.4): a disarm
+ * trigger, or a topology change of some ports. Under RTNL and the lock.
+ */
+static int ppe_sr_dev_change(struct ppe_sr *sr, unsigned long event, struct net_device *dev,
+			     u16 *ports, bool *recopy)
+{
+	int bridge = sr->eng.bridge_ifindex;
+	u16 user;
+
+	if (dev == sr->conduit) {
+		switch (event) {
+		case NETDEV_GOING_DOWN:
+		case NETDEV_DOWN:
+			return PPE_SR_T_CONDUIT_DOWN;
+		case NETDEV_UNREGISTER:
+			return PPE_SR_T_CONDUIT_GONE;
+		case NETDEV_CHANGEMTU:
+		case NETDEV_CHANGEADDR:
+			*recopy = true;
+			break;
+		}
+		return -1;
+	}
+
+	user = ppe_sr_user_ports(sr, dev);
+	if (user) {
+		switch (event) {
+		case NETDEV_UNREGISTER:
+			return PPE_SR_T_USER_GONE;
+		case NETDEV_PRECHANGEUPPER:
+		case NETDEV_CHANGEUPPER:
+		case NETDEV_CHANGEMTU:
+			*ports = user;
+			break;
+		}
+		return -1;
+	}
+
+	if (bridge && dev->ifindex == bridge && netif_is_bridge_master(dev)) {
+		switch (event) {
+		case NETDEV_UNREGISTER:
+			return PPE_SR_T_BRIDGE_GONE;
+		case NETDEV_CHANGEUPPER:
+		case NETDEV_CHANGEMTU:
+		case NETDEV_CHANGEADDR:
+		case NETDEV_UP:
+		case NETDEV_DOWN:
+			*ports = PPE_SR_PORTS_ALL;
+			break;
+		}
+		return -1;
+	}
+
+	/* An L3 device of the bridge (its 802.1Q upper). */
+	if (bridge && is_vlan_dev(dev) && vlan_dev_real_dev(dev)->ifindex == bridge) {
+		switch (event) {
+		case NETDEV_CHANGEMTU:
+		case NETDEV_CHANGEADDR:
+		case NETDEV_UP:
+		case NETDEV_DOWN:
+			*ports = PPE_SR_PORTS_ALL;
+			break;
+		}
+	}
+
+	return -1;
+}
+
+/**
+ * ppe_sr_netdev_event() - The S-R side of the offload's netdevice notifier.
+ * @priv: The offload.
+ * @event: The event.
+ * @dev: Its device.
+ *
+ * Under RTNL. The conduit going down or away, an S-R user port or the S-R
+ * bridge going away disarm; in FAULT the conduit's reference is let go
+ * when it is unregistered (D13). Changes of the ports, the bridge, its L3
+ * devices and the conduit's MTU or address are topology events.
+ */
+void ppe_sr_netdev_event(struct ppe_offload_priv *priv, unsigned long event,
+			 struct net_device *dev)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	bool recopy = false, queue = false;
+	u16 ports = 0;
+	int trigger;
+
+	ASSERT_RTNL();
+
+	/* Only the arm, which holds RTNL, leaves OFF. */
+	if (ppe_sr_eng_state(&sr->eng) == PPE_SR_S_OFF)
+		return;
+
+	mutex_lock(sr->lock);
+	if (!sr->conduit)
+		goto unlock;
+	trigger = ppe_sr_dev_change(sr, event, dev, &ports, &recopy);
+	if (trigger == PPE_SR_T_CONDUIT_GONE) {
+		if (ppe_sr_eng_conduit_gone(&sr->eng, &sr->io) && sr->conduit) {
+			netdev_put(sr->conduit, &sr->conduit_tracker);
+			sr->conduit = NULL;
+		}
+	} else if (trigger >= 0) {
+		ppe_sr_disarm(priv, trigger);
+	} else if (ports || recopy) {
+		queue = ppe_sr_eng_topo_event(&sr->eng, &sr->io, ports, recopy);
+	}
+	ppe_sr_settle(sr);
+unlock:
+	mutex_unlock(sr->lock);
+	if (queue)
+		ppe_sr_queue_resync(sr);
+}
+
+/**
+ * ppe_sr_switchdev_event() - A bridge VLAN, STP, filtering or protocol
+ * change on @dev (WP2-DESIGN §2.4).
+ * @priv: The offload.
+ * @dev: A switch user port or a bridge.
+ *
+ * Under RTNL. A topology event for an S-R user port, or for every port if
+ * @dev is the S-R bridge.
+ */
+void ppe_sr_switchdev_event(struct ppe_offload_priv *priv, struct net_device *dev)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	bool queue = false;
+	u16 ports;
+
+	ASSERT_RTNL();
+
+	if (ppe_sr_eng_state(&sr->eng) == PPE_SR_S_OFF)
+		return;
+
+	mutex_lock(sr->lock);
+	ports = ppe_sr_user_ports(sr, dev);
+	if (!ports && sr->conduit && sr->eng.bridge_ifindex &&
+	    dev->ifindex == sr->eng.bridge_ifindex && netif_is_bridge_master(dev))
+		ports = PPE_SR_PORTS_ALL;
+	if (ports)
+		queue = ppe_sr_eng_topo_event(&sr->eng, &sr->io, ports, false);
+	ppe_sr_settle(sr);
+	mutex_unlock(sr->lock);
+	if (queue)
+		ppe_sr_queue_resync(sr);
+}
+
+/* Apply topology and scope changes once complete (WP2-DESIGN §5.2): RTNL,
+ * then the lock; on the FDB workqueue, after the change that queued it.
+ */
+static void ppe_sr_resync_work(struct work_struct *work)
+{
+	struct ppe_sr *sr = container_of(work, struct ppe_sr, resync_work);
+	struct ppe_sr_topo_pub *pub;
+	struct ppe_sr_scope_pub *scope;
+	struct ppe_sr_vops vops;
+	unsigned int n, wanted, declined;
+	struct ppe_sr_buf *b;
+	int ret;
+
+	b = kzalloc(sizeof(*b), GFP_KERNEL);
+	pub = kzalloc(sizeof(*pub), GFP_KERNEL);
+
+	rtnl_lock();
+	mutex_lock(sr->lock);
+	if (sr->eng.seq.state != PPE_SR_S_READY && sr->eng.seq.state != PPE_SR_S_ACTIVE) {
+		/* Off: the marks go; FAULT: nothing moves. */
+		ppe_sr_eng_resync(&sr->eng, &sr->io, NULL, 0, NULL, &declined);
+		goto unlock;
+	}
+	if (!b || !pub || !sr->conduit) {
+		pr_err("ppe_offload: sr: resync not run (no memory): offers wait for the next change\n");
+		goto unlock;
+	}
+
+	/* The conduit's address may have changed (CHANGEADDR): S8 follows. */
+	ether_addr_copy(sr->eng.seq.cfg.mac, sr->conduit->dev_addr);
+	ret = ppe_sr_topo_collect(sr->conduit, sr->eng.s_ports, sr->eng.bridge_ifindex, &b->in,
+				  &b->ctx);
+	if (!ret) {
+		vops = (struct ppe_sr_vops){ .ctx = &b->ctx, .vinfo = ppe_sr_topo_vinfo };
+		ret = ppe_sr_topo_build(&b->in, &vops, &pub->topo);
+	}
+	if (ret) {
+		/* Under RTNL this is a bug: the old topology stays, offers wait. */
+		pr_err("ppe_offload: sr: resync: topology not resolved (%d): offers wait for the next change\n",
+		       ret);
+		goto unlock;
+	}
+
+	scope = rcu_dereference_protected(sr->scope, lockdep_is_held(sr->lock));
+	n = ppe_sr_eng_plan(&pub->topo, scope ? &scope->scope : NULL, READ_ONCE(ppe_sr_u_uploads),
+			    b->plan, PPE_SR_CLS_MAX, &wanted);
+	ret = ppe_sr_eng_resync(&sr->eng, &sr->io, b->plan, n, b->ops, &declined);
+	if (!ret && (sr->eng.seq.state == PPE_SR_S_READY ||
+		     sr->eng.seq.state == PPE_SR_S_ACTIVE)) {
+		ppe_sr_publish(sr, pub);
+		pub = NULL;
+	}
+
+unlock:
+	ppe_sr_settle(sr);
+	mutex_unlock(sr->lock);
+	rtnl_unlock();
+	kfree(b);
+	kfree(pub);
+}
+
+/* The disarm a statistics request queued (D17). The lock only. */
+static void ppe_sr_lost_work(struct work_struct *work)
+{
+	struct ppe_sr *sr = container_of(work, struct ppe_sr, lost_work);
+
+	mutex_lock(sr->lock);
+	ppe_sr_eng_lost_work(&sr->eng, &sr->io, ppe_sr_word(sr, NULL));
+	ppe_sr_settle(sr);
+	mutex_unlock(sr->lock);
+}
+
+/**
+ * ppe_sr_stats_check() - The statistics-time switch check (WP2-DESIGN D17).
+ * @sr: The S-R mode.
+ *
+ * Under the lock, for each statistics request while ACTIVE (every tracked
+ * flow is then S-R's). Memory only: a switch not ACTIVE queues one disarm
+ * (SWITCH_NOT_READY).
+ */
+void ppe_sr_stats_check(struct ppe_sr *sr)
+{
+	lockdep_assert_held(sr->lock);
+
+	if (sr->eng.seq.state != PPE_SR_S_ACTIVE)
+		return;
+	if (ppe_sr_eng_lost(&sr->eng, ppe_sr_word(sr, NULL)))
+		schedule_work(&sr->lost_work);
+}
+
+/* mutex_trylock() every PPE_SR_REBOOT_WAIT_MS, PPE_SR_REBOOT_TRIES times at
+ * most. The harness sr/wp2/harness/mode compiles this verbatim.
+ */
+static bool ppe_sr_lock_bounded(struct mutex *lock)
+{
+	unsigned int i;
+
+	for (i = 0; ; i++) {
+		if (mutex_trylock(lock))
+			return true;
+		if (i == PPE_SR_REBOOT_TRIES)
+			return false;
+		msleep(PPE_SR_REBOOT_WAIT_MS);
+	}
+}
+
+/* Before device_shutdown(): the switch's SHUTDOWN then finds the PPE off.
+ * The wait for the lock is bounded; when it is busy the disarm is skipped
+ * and said, and the switch's SHUTDOWN sees the PPE not off.
+ */
+static int ppe_sr_reboot(struct notifier_block *nb, unsigned long action, void *data)
+{
+	struct ppe_sr *sr = container_of(nb, struct ppe_sr, reboot_nb);
+
+	if (ppe_sr_eng_state(&sr->eng) == PPE_SR_S_OFF)
+		return NOTIFY_DONE;
+	if (!ppe_sr_lock_bounded(sr->lock)) {
+		pr_warn("ppe_offload: sr: reboot disarm skipped (lock busy)\n");
+		return NOTIFY_DONE;
+	}
+	ppe_sr_disarm(sr->priv, PPE_SR_T_REBOOT);
+	mutex_unlock(sr->lock);
+
+	return NOTIFY_DONE;
+}
+
+/**
+ * ppe_sr_init() - Set up the S-R mode, off.
+ * @sr: The S-R mode, in zeroed memory.
+ * @priv: The offload it belongs to.
+ * @ppe_dev: The PPE.
+ * @lock: The offload lock.
+ * @wq: The ordered FDB workqueue, for the resync; NULL without switchdev.
+ */
+void ppe_sr_init(struct ppe_sr *sr, struct ppe_offload_priv *priv, struct ppe_device *ppe_dev,
+		 struct mutex *lock, struct workqueue_struct *wq)
+{
+	unsigned int i;
+
+	ppe_sr_eng_init(&sr->eng);
+	sr->priv = priv;
+	sr->ppe_dev = ppe_dev;
+	sr->lock = lock;
+	sr->wq = wq ? wq : system_dfl_wq;
+	sr->io = (struct ppe_sr_io){
+		.ctx = sr,
+		.rd = ppe_sr_io_rd,
+		.wr = ppe_sr_io_wr,
+		.flush = ppe_sr_io_flush,
+		.claim = ppe_sr_io_claim,
+		.move = ppe_sr_io_move,
+		.release = ppe_sr_io_release,
+		.state = ppe_sr_io_state,
+		.log = ppe_sr_io_log,
+		.ms = ppe_sr_io_ms,
+	};
+	RCU_INIT_POINTER(sr->topo, NULL);
+	RCU_INIT_POINTER(sr->scope, NULL);
+	INIT_WORK(&sr->resync_work, ppe_sr_resync_work);
+	INIT_WORK(&sr->lost_work, ppe_sr_lost_work);
+	sr->reboot_nb.notifier_call = ppe_sr_reboot;
+	for (i = 0; i < PPE_SR_W_NUM; i++)
+		atomic_long_set(&sr->decline[i], 0);
+}
+
+/**
+ * ppe_sr_start() - Watch for reboots.
+ * @sr: The S-R mode.
+ */
+void ppe_sr_start(struct ppe_sr *sr)
+{
+	if (register_reboot_notifier(&sr->reboot_nb))
+		pr_warn("ppe_offload: sr: no reboot notifier: a reboot will not disarm S-R first\n");
+}
+
+/**
+ * ppe_sr_stop() - Stop watching and wait for the works.
+ * @sr: The S-R mode, off or in FAULT (offload disabled).
+ *
+ * Without RTNL or the lock, which the works take.
+ */
+void ppe_sr_stop(struct ppe_sr *sr)
+{
+	unregister_reboot_notifier(&sr->reboot_nb);
+	cancel_work_sync(&sr->resync_work);
+	cancel_work_sync(&sr->lost_work);
+}
+
+/**
+ * ppe_sr_destroy() - Free what the S-R mode holds.
+ * @sr: The S-R mode, with no offer, work or notifier left.
+ *
+ * In FAULT the claim stays until reboot; the conduit's reference has gone
+ * with its unregister (ppe_sr_netdev_event()), else it goes here.
+ */
+void ppe_sr_destroy(struct ppe_sr *sr)
+{
+	struct ppe_sr_topo_pub *topo;
+	struct ppe_sr_scope_pub *scope;
+
+	cancel_work_sync(&sr->resync_work);
+	cancel_work_sync(&sr->lost_work);
+	if (sr->conduit) {
+		netdev_put(sr->conduit, &sr->conduit_tracker);
+		sr->conduit = NULL;
+	}
+	topo = rcu_replace_pointer(sr->topo, NULL, true);
+	if (topo)
+		kfree_rcu(topo, rcu);
+	scope = rcu_replace_pointer(sr->scope, NULL, true);
+	if (scope)
+		kfree_rcu(scope, rcu);
+}
+
+/**
+ * ppe_sr_boot_check() - S9 for one PPE port at enable.
+ * @sr: The S-R mode, off.
+ * @ppe_port: A PPE port a conduit could be on.
+ *
+ * Under RTNL and the lock. Registers not at base refuse S-R until reboot.
+ */
+void ppe_sr_boot_check(struct ppe_sr *sr, u8 ppe_port)
+{
+	lockdep_assert_held(sr->lock);
+
+	ppe_sr_eng_boot_check(&sr->eng, &sr->io, ppe_port);
+}
+
+/**
+ * ppe_sr_scope_set() - Swap the scope (WP2-DESIGN §6.2, D2).
+ * @priv: The offload.
+ * @scope: The new scope, copied; NULL for none (nothing in scope).
+ *
+ * Under RTNL; takes the lock. While armed every flow goes (0465/0466 drop
+ * only those the new scope excludes), offers wait, and the resync makes
+ * the identities follow.
+ *
+ * Return: 0, -EINVAL for a malformed scope, -ENOMEM.
+ */
+int ppe_sr_scope_set(struct ppe_offload_priv *priv, const struct ppe_sr_scope *scope)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	struct ppe_sr_scope_pub *pub = NULL, *old;
+	bool queue;
+
+	ASSERT_RTNL();
+
+	if (scope) {
+		if (ppe_sr_scope_check(scope))
+			return -EINVAL;
+		pub = kmalloc(sizeof(*pub), GFP_KERNEL);
+		if (!pub)
+			return -ENOMEM;
+		pub->scope = *scope;
+	}
+
+	mutex_lock(sr->lock);
+	old = rcu_replace_pointer(sr->scope, pub, lockdep_is_held(sr->lock));
+	queue = ppe_sr_eng_topo_event(&sr->eng, &sr->io, PPE_SR_PORTS_ALL, false);
+	ppe_sr_eng_bump(&sr->eng);
+	ppe_sr_settle(sr);
+	mutex_unlock(sr->lock);
+
+	if (old)
+		kfree_rcu(old, rcu);
+	if (queue)
+		ppe_sr_queue_resync(sr);
+	pr_info("ppe_offload: sr: scope %u class(es), %s\n", scope ? scope->ncls : 0,
+		!scope ? "no client" : scope->any_client ? "any client" : "listed clients");
+
+	return 0;
+}
+
+/**
+ * ppe_sr_scope_ok() - Whether a class and client are in scope.
+ * @priv: The offload.
+ * @cls: The flow's class.
+ * @client: The LAN host: an upload's source, a download's translated
+ * destination.
+ * @dir: enum ppe_sr_dir.
+ *
+ * Lockless (RCU). No scope denies.
+ *
+ * Return: true if in scope.
+ */
+bool ppe_sr_scope_ok(struct ppe_offload_priv *priv, const struct ppe_sr_class *cls,
+		     __be32 client, int dir)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	const struct ppe_sr_scope_pub *pub;
+	bool ok;
+
+	if (dir == PPE_SR_UP && cls->form == PPE_SR_U && !READ_ONCE(ppe_sr_u_uploads))
+		return false;
+
+	rcu_read_lock();
+	pub = rcu_dereference(sr->scope);
+	ok = pub && ppe_sr_scope_has(&pub->scope, cls) && ppe_sr_scope_client(&pub->scope, client);
+	rcu_read_unlock();
+
+	return ok;
+}
+
+/**
+ * ppe_sr_deadline_set() - Move the S-R deadline later (WP2-DESIGN §6.2).
+ * @priv: The offload.
+ * @deadline: The new deadline, in jiffies.
+ *
+ * Under the lock. Capped at the switch's own deadline (as the switch has it
+ * now, read under RCU on the held conduit) less PPE_SR_DEADLINE_MARGIN_S.
+ *
+ * Return: 0, -EINVAL unless READY or ACTIVE, -ENODEV without a switch,
+ * -ERANGE if the capped deadline would not be later than the current one.
+ */
+int ppe_sr_deadline_set(struct ppe_offload_priv *priv, unsigned long deadline)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	unsigned long disarm_at, dl;
+	int ret;
+
+	lockdep_assert_held(sr->lock);
+
+	if (sr->eng.seq.state != PPE_SR_S_READY && sr->eng.seq.state != PPE_SR_S_ACTIVE)
+		return -EINVAL;
+	if (ppe_sr_word(sr, &disarm_at) < 0)
+		return -ENODEV;
+	ret = ppe_sr_deadline_fwd(jiffies, sr->eng.deadline, deadline, disarm_at,
+				  PPE_SR_DEADLINE_MARGIN_S * HZ, &dl);
+	if (ret)
+		return ret;
+	sr->eng.deadline = dl;
+
+	return 0;
+}
+
+/**
+ * ppe_sr_status_fill() - The S-R mode from memory (WP2-DESIGN §6.5).
+ * @priv: The offload.
+ * @st: Filled in.
+ *
+ * Under the lock. Reads no register: safe under load.
+ */
+void ppe_sr_status_fill(struct ppe_offload_priv *priv, struct ppe_sr_status *st)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	const struct ppe_sr_eng *eng = &sr->eng;
+	unsigned int s, i;
+
+	lockdep_assert_held(sr->lock);
+
+	memset(st, 0, sizeof(*st));
+	st->state = eng->seq.state;
+	st->td_word = ppe_sr_word(sr, NULL);
+	strscpy(st->conduit, sr->conduit_name, sizeof(st->conduit));
+	st->held = !!sr->conduit;
+	st->ppe_port = eng->seq.cfg.ppe_port;
+	st->l3_if = eng->seq.cfg.l3_if;
+	st->bridge_ifindex = eng->bridge_ifindex;
+	st->s_ports = eng->s_ports;
+	st->gen = eng->gen;
+	st->dirty = eng->dirty;
+	st->dirty_ports = eng->dirty_ports;
+	st->inert_fail = eng->inert_fail;
+	st->u_uploads = READ_ONCE(ppe_sr_u_uploads);
+	st->scoped = !!rcu_access_pointer(sr->scope);
+	if (eng->deadline && eng->seq.state != PPE_SR_S_OFF)
+		st->deadline_in_s = (long)(eng->deadline - jiffies) / HZ;
+	for (s = 0; s < PPE_SR_ID_MAX; s++) {
+		const struct ppe_sr_id *id = &eng->seq.id[s];
+
+		if (!id->used)
+			continue;
+		st->id[st->nid++] = (struct ppe_sr_status_id){ .cls = id->cls, .live = id->live,
+							       .xlt = id->xlt,
+							       .l3_if = id->l3_if };
+	}
+	for (i = 0; i < PPE_SR_W_NUM; i++)
+		st->decline[i] = atomic_long_read(&sr->decline[i]);
+	memcpy(st->trig, eng->trig, sizeof(st->trig));
+	st->arm_ok = eng->arm_ok;
+	memcpy(st->arm_refused, eng->arm_refused, sizeof(st->arm_refused));
+	st->last = eng->last;
+	st->fault = eng->seq.fault;
+	st->fault_step = eng->seq.fault_step;
+	st->fault_err = eng->seq.fault_err;
+	st->rebind_skipped = eng->rebind_skipped;
+	st->resyncs = eng->resyncs;
+	st->resync_declined = eng->resync_declined;
+}
+
+/**
+ * ppe_sr_hw_show() - Verify the S-R registers and show the identities'
+ * counters (S8, WP2-DESIGN §6.4's offload_sr_hw).
+ * @priv: The offload.
+ * @m: Where to.
+ *
+ * Takes the lock. Reads registers, every XLT rule among them: idle only,
+ * never under load. Each mismatch is shown and logged ("sr: verify
+ * MISMATCH"), and disarms (VERIFY) while ACTIVE.
+ *
+ * Return: 0.
+ */
+int ppe_sr_hw_show(struct ppe_offload_priv *priv, struct seq_file *m)
+{
+	struct ppe_sr *sr = ppe_offload_sr(priv);
+	struct ppe_sr_id_cnt c;
+	unsigned int s;
+	int ret;
+
+	mutex_lock(sr->lock);
+	seq_printf(m, "state %s\n", ppe_sr_state_name(sr->eng.seq.state));
+	sr->show = m;
+	ret = ppe_sr_eng_verify_idle(&sr->eng, &sr->io);
+	sr->show = NULL;
+	if (ret == -ENOENT)
+		seq_puts(m, "verify none (not armed)\n");
+	else if (ret == -EBADMSG)
+		seq_puts(m, "verify MISMATCH\n");
+	else
+		seq_printf(m, "verify %s\n", ret ? "error" : "match");
+
+	for (s = 0; s < PPE_SR_ID_MAX; s++) {
+		const struct ppe_sr_id *id = &sr->eng.seq.id[s];
+
+		if (!id->used)
+			continue;
+		if (ppe_sr_seq_id_counters(&sr->eng.seq, &sr->io, s, &c)) {
+			seq_printf(m, "id %u: counters not read\n", s);
+			continue;
+		}
+		seq_printf(m, "id %u p %u form %c vid %u xlt %u l3_if %u live %u xlt_pkts %llu xlt_bytes %llu rt_in_pkts %llu rt_in_bytes %llu rt_eg_pkts %llu rt_eg_bytes %llu\n",
+			   s, id->cls.port, id->cls.form == PPE_SR_U ? 'U' : 'T', id->cls.vid,
+			   id->xlt, id->l3_if, id->live, c.xlt.packets, c.xlt.bytes,
+			   c.rt_in.packets, c.rt_in.bytes, c.rt_eg.packets, c.rt_eg.bytes);
+	}
+	ppe_sr_settle(sr);
+	mutex_unlock(sr->lock);
+
+	return 0;
+}
