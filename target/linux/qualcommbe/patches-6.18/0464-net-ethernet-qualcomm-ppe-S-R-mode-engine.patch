+/**
+ * struct ppe_sr_status - The S-R mode from memory alone (WP2-DESIGN §6.5).
+ * @state: enum ppe_sr_state.
+ * @td_word: The rtl8_4s state word, one read; -1 without a switch.
+ * @conduit: The conduit's name, empty if none was ever armed on.
+ * @held: The conduit is held.
+ * @ppe_port: Its PPE port.
+ * @l3_if: Its L3 interface.
+ * @bridge_ifindex: The S-R bridge.
+ * @s_ports: The switch's S-R port mask, fixed at arm.
+ * @gen: The S-R generation.
+ * @dirty: A topology change of every port awaits its resync.
+ * @dirty_ports: The ports whose change awaits it.
+ * @inert_fail: S-R registers were not at base at enable: refused.
+ * @u_uploads: U classes get identities (qcom_ppe.sr_u_uploads).
+ * @scoped: A scope is set.
+ * @deadline_in_s: Seconds to the deadline while armed, else 0.
+ * @nid: Entries of @id.
+ * @id: The identities.
+ * @decline: Offers declined, by enum ppe_sr_why.
+ * @trig: Disarms, by enum ppe_sr_trigger.
+ * @arm_ok: Arms that reached READY.
+ * @arm_refused: Arms refused or failed, by enum ppe_sr_why.
+ * @last: The last arm or disarm.
+ * @fault: enum ppe_sr_fault.
+ * @fault_step: enum ppe_sr_step it latched at.
+ * @fault_err: Its error.
+ * @rebind_skipped: Conduit L3 bindings S-R kept from being written.
+ * @resyncs: Resyncs applied.
+ * @resync_declined: Classes resyncs left without an identity.
+ */
+struct ppe_sr_status {
+	u8 state;
+	int td_word;
+	char conduit[IFNAMSIZ];
+	bool held;
+	u8 ppe_port;
+	u8 l3_if;
+	int bridge_ifindex;
+	u16 s_ports;
+	u32 gen;
+	bool dirty;
+	u16 dirty_ports;
+	bool inert_fail;
+	bool u_uploads;
+	bool scoped;
+	long deadline_in_s;
+	unsigned int nid;
+	struct ppe_sr_status_id id[PPE_SR_ID_MAX];
+	u64 decline[PPE_SR_W_NUM];
+	u32 trig[PPE_SR_T_NUM];
+	u32 arm_ok;
+	u32 arm_refused[PPE_SR_W_NUM];
+	struct ppe_sr_last last;
+	u8 fault;
+	u8 fault_step;
+	int fault_err;
+	u32 rebind_skipped;
+	u32 resyncs;
+	u32 resync_declined;
+};
