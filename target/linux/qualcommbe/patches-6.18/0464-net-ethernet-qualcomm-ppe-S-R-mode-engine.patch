 		return ppe_offload_decline("odev=%s tagger %d unsupported", netdev_name(odev),
 					    tag_ops->proto);
+	if (mode != PPE_SR_MODE_E) {
+		ppe_sr_count_decline(&priv->sr, PPE_SR_W_SR_NOT_ACTIVE);
