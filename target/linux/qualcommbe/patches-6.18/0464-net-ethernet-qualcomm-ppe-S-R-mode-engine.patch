+
+/**
+ * ppe_sr_eng_gen() - The S-R generation, lockless.
+ * @eng: The engine.
+ *
+ * Return: the generation, read with acquire: what was stored before its
+ * bump is seen after.
+ */
+u32 ppe_sr_eng_gen(const struct ppe_sr_eng *eng)
+{
+	/* Pairs with ppe_sr_eng_bump()'s release. */
+	return smp_load_acquire(&eng->gen);
+}
+
+/**
+ * ppe_sr_eng_state() - The S-R state, lockless (a hint only).
+ * @eng: The engine.
+ *
+ * Return: enum ppe_sr_state.
+ */
+u8 ppe_sr_eng_state(const struct ppe_sr_eng *eng)
+{
+	return READ_ONCE(eng->seq.state);
+}
+
+/**
+ * ppe_sr_eng_bump() - Bump the S-R generation.
+ * @eng: The engine.
+ *
+ * Under the lock, after whatever offers must not overlap is stored.
+ */
+void ppe_sr_eng_bump(struct ppe_sr_eng *eng)
+{
+	/* What was stored before is seen by ppe_sr_eng_gen()'s acquire. */
+	smp_store_release(&eng->gen, eng->gen + 1);
+}
+
+/**
+ * ppe_sr_eng_on_state() - What struct ppe_sr_io::state does: a state change
+ * bumps the generation.
+ * @eng: The engine.
+ * @from: The old enum ppe_sr_state.
+ * @to: The new one, already stored.
+ */
+void ppe_sr_eng_on_state(struct ppe_sr_eng *eng, u8 from, u8 to)
+{
+	if (from != to)
+		ppe_sr_eng_bump(eng);
+}
+
+/**
+ * ppe_sr_eng_ticket() - Judge an offer's mode (WP2-DESIGN §3.4 step 0).
+ * @eng: The engine.
+ * @t: Filled in: the generation, then the mode.
+ *
+ * Lockless, first thing in every offer: E downloads while S-R is off, S-R
+ * offers while it is active, nothing in between.
+ *
+ * Return: PPE_SR_W_OK, or PPE_SR_W_SR_TRANSITION to decline.
+ */
+enum ppe_sr_why ppe_sr_eng_ticket(const struct ppe_sr_eng *eng, struct ppe_sr_ticket *t)
+{
+	u8 state;
+
+	t->gen = ppe_sr_eng_gen(eng);
+	state = ppe_sr_eng_state(eng);
+	if (state == PPE_SR_S_OFF)
+		t->mode = PPE_SR_MODE_E;
+	else if (state == PPE_SR_S_ACTIVE)
+		t->mode = PPE_SR_MODE_SR;
+	else
+		return PPE_SR_W_SR_TRANSITION;
+
+	return PPE_SR_W_OK;
+}
+
+/**
+ * ppe_sr_eng_ticket_ok() - Whether an offer's ticket still holds.
+ * @eng: The engine.
+ * @t: From ppe_sr_eng_ticket().
+ *
+ * Under the lock, before the offer writes hardware.
+ *
+ * Return: true if nothing an offer depends on changed since @t was taken
+ * and the state still gives its mode; false: -EAGAIN, re-offered later.
+ */
+bool ppe_sr_eng_ticket_ok(const struct ppe_sr_eng *eng, const struct ppe_sr_ticket *t)
+{
+	u8 want = t->mode == PPE_SR_MODE_E ? PPE_SR_S_OFF : PPE_SR_S_ACTIVE;
+
+	return READ_ONCE(eng->gen) == t->gen && eng->seq.state == want;
+}
+
+static void eng_enter(struct ppe_sr_eng *eng)
+{
+	eng->in_seq++;
+}
+
+/* A sequence returned: a degraded latch it caused, if S-R is still on, is
+ * FAULT now.
+ */
+static void eng_leave(struct ppe_sr_eng *eng, const struct ppe_sr_io *io)
+{
+	u8 state;
+
+	if (--eng->in_seq || !eng->degraded_in_seq)
+		return;
+	eng->degraded_in_seq = 0;
+	state = eng->seq.state;
+	if (state != PPE_SR_S_OFF && state != PPE_SR_S_FAULT)
+		ppe_sr_seq_fault(&eng->seq, io, PPE_SR_F_STUCK_FLOW, PPE_SR_STEP_HOOK, -EIO);
+}
+
+/**
+ * ppe_sr_eng_degraded() - The offload latched degraded (WP2-DESIGN D13).
+ * @eng: The engine.
+ * @io: For the state word and the log.
+ *
+ * Under the lock, from ppe_offload_set_degraded(): every site that latches
+ * degraded or loses a flow entry goes through it. While S-R is not off,
+ * that is FAULT: the claim, the registers and the identities stay as they
+ * are until reboot (a stuck or lost upload's L3 interface is never put
+ * back or used again). From inside a sequence, FAULT waits for it to
+ * return.
+ */
+void ppe_sr_eng_degraded(struct ppe_sr_eng *eng, const struct ppe_sr_io *io)
+{
+	u8 state = eng->seq.state;
+
+	eng->latched++;
+	if (eng->in_seq) {
+		eng->degraded_in_seq = 1;
+		return;
+	}
+	if (state == PPE_SR_S_OFF || state == PPE_SR_S_FAULT)
+		return;
+	ppe_sr_seq_fault(&eng->seq, io, PPE_SR_F_STUCK_FLOW, PPE_SR_STEP_HOOK, -EIO);
+}
+
+/**
+ * ppe_sr_eng_flush_stuck() - What the io's flush reports to a sequence.
+ * @eng: The engine.
+ * @latched: @eng->latched before the flush.
+ * @stuck: The flows the flush could not drop.
+ *
+ * Under the lock. A degraded latch during the flush counts as a flow left
+ * behind (D13), so that the sequence stops as for a stuck flow.
+ *
+ * Return: the count to report.
+ */
+unsigned int ppe_sr_eng_flush_stuck(const struct ppe_sr_eng *eng, u32 latched,
+				    unsigned int stuck)
+{
+	return stuck + (eng->latched != latched);
+}
+
+/**
+ * ppe_sr_eng_refuse() - Count and say an arm refusal.
+ * @eng: The engine.
+ * @io: For the log.
+ * @why: enum ppe_sr_why.
+ * @err: The error returned.
+ * @what: What was found.
+ *
+ * Return: @err.
+ */
+int ppe_sr_eng_refuse(struct ppe_sr_eng *eng, const struct ppe_sr_io *io, enum ppe_sr_why why,
+		      int err, const char *what)
+{
+	if ((unsigned int)why < PPE_SR_W_NUM)
+		eng->arm_refused[why]++;
+	eng->last = (struct ppe_sr_last){ .arm = 1, .why = why, .err = err };
+	eng_log(io, PPE_SR_LOG_WARN, "refused: arm %s (%d): %s", ppe_sr_why_name(why), err, what);
+
+	return err;
+}
+
+/**
+ * ppe_sr_eng_arm_check() - The arm's memory prechecks that are the
+ * engine's (A0).
+ * @eng: The engine.
+ * @io: For the log.
+ * @deadline: The arm's deadline.
+ * @why: Set to PPE_SR_W_PRECHECK.
+ *
+ * Return: 0, -EIO in FAULT, -EALREADY unless off, -EBUSY after a failed
+ * boot check, -EINVAL without a deadline; each refusal counted and said.
+ */
+int ppe_sr_eng_arm_check(struct ppe_sr_eng *eng, const struct ppe_sr_io *io,
+			 unsigned long deadline, enum ppe_sr_why *why)
+{
+	*why = PPE_SR_W_PRECHECK;
+	if (eng->seq.state == PPE_SR_S_FAULT)
+		return ppe_sr_eng_refuse(eng, io, *why, -EIO, "FAULT latched, reboot to recover");
+	if (eng->seq.state != PPE_SR_S_OFF)
+		return ppe_sr_eng_refuse(eng, io, *why, -EALREADY, "not off");
+	if (eng->inert_fail)
+		return ppe_sr_eng_refuse(eng, io, *why, -EBUSY,
+					 "S-R registers were not at their base at enable");
+	if (!deadline)
+		return ppe_sr_eng_refuse(eng, io, *why, -EINVAL, "no deadline");
+
+	return 0;
+}
+
+/**
+ * ppe_sr_eng_arm() - Arm S-R (WP2-DESIGN §4.4 A0's memory part, A2's plan
+ * checks, A3-A12 but the publish).
+ * @eng: The engine, off.
+ * @io: Register access, flows and the state word; its flush adds what it
+ * drops to @eng->flushed.
+ * @a: What to arm for.
+ * @why: Set to the refusal's reason, PPE_SR_W_OK on success.
+ *
+ * Under RTNL and the lock. The caller holds the conduit for the claim and
+ * lets it go if the state ends OFF, and publishes the topology the plan
+ * came from if it ends READY or ACTIVE.
+ *
+ * Return: 0 (READY, or ACTIVE with @a->offers), or the error of
+ * ppe_sr_eng_arm_check() or ppe_sr_seq_arm() (-EINVAL with @why NOTHING
+ * for no class in scope, -ENOSPC with BUDGET for more than PPE_SR_ID_MAX
+ * or a truncated L3 device list), each counted and said. A refused offers
+ * step leaves the arm READY.
+ */
+int ppe_sr_eng_arm(struct ppe_sr_eng *eng, const struct ppe_sr_io *io,
+		   const struct ppe_sr_eng_arm *a, enum ppe_sr_why *why)
+{
+	unsigned int s, xlo = ~0U, xhi = 0, llo = ~0U, lhi = 0;
+	unsigned long t0;
+	int ret;
+
+	ret = ppe_sr_eng_arm_check(eng, io, a->deadline, why);
+	if (ret)
+		return ret;
+	if (!a->wanted) {
+		*why = PPE_SR_W_NOTHING;
+		return ppe_sr_eng_refuse(eng, io, *why, -EINVAL, "no class in scope");
+	}
+	if (a->wanted > PPE_SR_ID_MAX || a->n != a->wanted || a->l3_truncated) {
+		*why = PPE_SR_W_BUDGET;
+		return ppe_sr_eng_refuse(eng, io, *why, -ENOSPC,
+					 a->l3_truncated ? "too many L3 devices on the bridge" :
+					 "too many classes in scope");
+	}
+
+	t0 = eng_ms(io);
+	eng->flushed = 0;
+	eng_enter(eng);
+	ret = ppe_sr_seq_arm(&eng->seq, io, &a->cfg, a->plan, a->n, why);
+	eng_leave(eng, io);
+	if (!ret && eng->seq.state != PPE_SR_S_READY) {
+		*why = PPE_SR_W_HW;
+		ret = -EIO;
+	}
+	if (ret) {
+		if ((unsigned int)*why < PPE_SR_W_NUM)
+			eng->arm_refused[*why]++;
+		eng->last = (struct ppe_sr_last){ .arm = 1, .why = *why, .err = ret,
+						  .ms = eng_ms(io) - t0, .flushed = eng->flushed };
+		eng_log(io, PPE_SR_LOG_WARN, "refused: arm %s (%d), state %s",
+			ppe_sr_why_name(*why), ret, ppe_sr_state_name(eng->seq.state));
+		return ret;
+	}
+
+	for (s = 0; s < PPE_SR_ID_MAX; s++) {
+		const struct ppe_sr_id *id = &eng->seq.id[s];
+
+		if (!id->used)
+			continue;
+		xlo = id->xlt < xlo ? id->xlt : xlo;
+		xhi = id->xlt > xhi ? id->xlt : xhi;
+		llo = id->l3_if < llo ? id->l3_if : llo;
+		lhi = id->l3_if > lhi ? id->l3_if : lhi;
+	}
+	eng->s_ports = a->cfg.s_ports;
+	eng->bridge_ifindex = a->bridge_ifindex;
+	eng->deadline = a->deadline;
+	eng->dirty = 0;
+	eng->dirty_ports = 0;
+	eng->recopy = 0;
+	eng->lost_queued = 0;
+	eng->conduit_gone = 0;
+	eng->arm_ok++;
+	eng->last = (struct ppe_sr_last){ .arm = 1, .why = PPE_SR_W_OK, .ms = eng_ms(io) - t0,
+					  .flushed = eng->flushed };
+	eng_log(io, PPE_SR_LOG_INFO, "armed ids %u xlt %u-%u l3_if %u-%u flushed %u ms %u",
+		eng->seq.nid, xlo, xhi, llo, lhi, eng->last.flushed, eng->last.ms);
+
+	if (a->offers)
+		ppe_sr_eng_offers(eng, io, true);
+
+	return 0;
+}
+
+/**
+ * ppe_sr_eng_offers() - Turn S-R offers on or off (WP2-DESIGN §4.5).
+ * @eng: The engine.
+ * @io: The state word and the flows.
+ * @on: READY to ACTIVE, or ACTIVE to READY with every flow dropped.
+ *
+ * Under the lock.
+ *
+ * Return: 0 (also when already so), -EINVAL unless READY or ACTIVE, -EBUSY
+ * if the switch refuses ACTIVE, -EIO in or into FAULT.
+ */
+int ppe_sr_eng_offers(struct ppe_sr_eng *eng, const struct ppe_sr_io *io, bool on)
+{
+	u8 before = eng->seq.state;
+	int ret;
+
+	if (before == PPE_SR_S_FAULT)
+		return -EIO;
+	eng->flushed = 0;
+	eng_enter(eng);
+	ret = ppe_sr_seq_offers(&eng->seq, io, on);
+	eng_leave(eng, io);
+	if (eng->seq.state == PPE_SR_S_FAULT)
+		return -EIO;
+	if (!ret && eng->seq.state != before)
+		eng_log(io, PPE_SR_LOG_INFO, "offers %s flushed %u", on ? "on" : "off",
+			eng->flushed);
+
+	return ret;
+}
+
+/**
+ * ppe_sr_eng_disarm() - Disarm S-R (WP2-DESIGN §4.6).
+ * @eng: The engine.
+ * @io: Register access, flows and the state word.
+ * @trigger: Why (enum ppe_sr_trigger).
+ *
+ * Under the lock; RTNL is not needed. The caller lets the conduit go and
+ * withdraws the topology once the state is OFF.
+ *
+ * Return: 0 (OFF; also when already OFF), -EIO in or into FAULT, -EBUSY
+ * while an arm or a disarm is under way (not under the lock).
+ */
+int ppe_sr_eng_disarm(struct ppe_sr_eng *eng, const struct ppe_sr_io *io,
+		      enum ppe_sr_trigger trigger)
+{
+	unsigned long t0;
+	int ret;
+
+	switch (eng->seq.state) {
+	case PPE_SR_S_OFF:
+		return 0;
+	case PPE_SR_S_FAULT:
+		return -EIO;
+	case PPE_SR_S_READY:
+	case PPE_SR_S_ACTIVE:
+		break;
+	default:
+		return -EBUSY;
+	}
+
+	if ((unsigned int)trigger < PPE_SR_T_NUM)
+		eng->trig[trigger]++;
+	t0 = eng_ms(io);
+	eng->flushed = 0;
+	eng_enter(eng);
+	ret = ppe_sr_seq_disarm(&eng->seq, io);
+	eng_leave(eng, io);
+	eng->last = (struct ppe_sr_last){ .trigger = trigger, .err = ret, .ms = eng_ms(io) - t0,
+					  .flushed = eng->flushed };
+	if (ret || eng->seq.state != PPE_SR_S_OFF)
+		return ret ? ret : -EIO;
+
+	eng->dirty = 0;
+	eng->dirty_ports = 0;
+	eng->recopy = 0;
+	eng->lost_queued = 0;
+	eng->deadline = 0;
+	eng_log(io, PPE_SR_LOG_INFO, "disarmed (%s) flushed %u ms %u",
+		ppe_sr_trigger_name(trigger), eng->last.flushed, eng->last.ms);
+
+	return 0;
+}
+
+/**
+ * ppe_sr_eng_topo_event() - A bridge, port or conduit change concerning S-R
+ * (WP2-DESIGN D14, §2.4).
+ * @eng: The engine.
+ * @io: The flows, for the flush.
+ * @ports: The switch ports concerned; PPE_SR_PORTS_ALL for every port.
+ * @recopy: The conduit's L3 interface changed: every port, and the resync
+ * rewrites every identity's copy.
+ *
+ * Under the lock, while RTNL is held by the change. Marks the ports dirty
+ * (offers wait for the resync), bumps the generation, then drops the
+ * ports' flows; one that stays is FAULT.
+ *
+ * Return: whether a resync is to be queued (READY or ACTIVE after it).
+ */
+bool ppe_sr_eng_topo_event(struct ppe_sr_eng *eng, const struct ppe_sr_io *io, u16 ports,
+			   bool recopy)
+{
+	unsigned int stuck;
+
+	ports &= PPE_SR_PORTS_ALL;
+	if (!eng_armed(eng->seq.state) || (!ports && !recopy))
+		return false;
+
+	if (recopy) {
+		eng->recopy = 1;
+		ports = PPE_SR_PORTS_ALL;
+	}
+	if (ports == PPE_SR_PORTS_ALL)
+		eng->dirty = 1;
+	else
+		eng->dirty_ports |= ports;
+	ppe_sr_eng_bump(eng);
+
+	eng_enter(eng);
+	stuck = io->flush(io->ctx, PPE_SR_FLUSH_PORTS, ports);
+	eng_leave(eng, io);
+	if (stuck)
+		ppe_sr_seq_fault(&eng->seq, io, PPE_SR_F_STUCK_FLOW, PPE_SR_STEP_FLUSH_PORT,
+				 -EBUSY);
+
+	return eng_armed(eng->seq.state);
+}
+
+/**
+ * ppe_sr_eng_resync() - Apply a topology or scope change (WP2-DESIGN §5.2).
+ * @eng: The engine.
+ * @io: Register access and flows.
+ * @plan: Every class in scope, sorted, not truncated (ppe_sr_eng_plan()).
+ * @n: Its entries.
+ * @ops: Room for PPE_SR_OPS_MAX operations.
+ * @declined: Set to the classes left without an identity.
+ *
+ * Under RTNL and the lock, the plan resolved in the same RTNL section.
+ * Nothing in FAULT (the identities stay as they are); off, only the dirty
+ * marks are cleared. A failed resync or a failed verify (S5) disarms
+ * (VERIFY). On success the marks are cleared and the generation bumped;
+ * the caller publishes the topology the plan came from.
+ *
+ * Return: 0, -EIO in or into FAULT, -EBUSY mid-sequence, or the failure
+ * that made it disarm.
+ */
+int ppe_sr_eng_resync(struct ppe_sr_eng *eng, const struct ppe_sr_io *io,
+		      const struct ppe_sr_class *plan, unsigned int n, struct ppe_sr_op *ops,
+		      unsigned int *declined)
+{
+	u16 flush = eng->dirty ? PPE_SR_PORTS_ALL : eng->dirty_ports;
+	unsigned long t0;
+	int ret;
+
+	*declined = 0;
+	switch (eng->seq.state) {
+	case PPE_SR_S_OFF:
+		eng->dirty = 0;
+		eng->dirty_ports = 0;
+		eng->recopy = 0;
+		return 0;
+	case PPE_SR_S_FAULT:
+		return -EIO;
+	case PPE_SR_S_READY:
+	case PPE_SR_S_ACTIVE:
+		break;
+	default:
+		return -EBUSY;
+	}
+
+	t0 = eng_ms(io);
+	eng->flushed = 0;
+	eng_enter(eng);
+	ret = ppe_sr_seq_resync(&eng->seq, io, plan, n, eng->recopy, flush, ops, declined);
+	if (!ret)
+		ret = ppe_sr_seq_verify(&eng->seq, io, PPE_SR_VERIFY_RESYNC);
+	eng_leave(eng, io);
+	if (eng->seq.state == PPE_SR_S_FAULT)
+		return -EIO;
+	if (ret) {
+		eng_log(io, PPE_SR_LOG_ERR, "resync failed (%d): disarming", ret);
+		ppe_sr_eng_disarm(eng, io, PPE_SR_T_VERIFY);
+		return ret;
+	}
+
+	eng->dirty = 0;
+	eng->dirty_ports = 0;
+	eng->recopy = 0;
+	eng->resyncs++;
+	eng->resync_declined += *declined;
+	ppe_sr_eng_bump(eng);
+	eng_log(io, PPE_SR_LOG_INFO, "resync ids %u declined %u flushed %u ms %u", eng->seq.nid,
+		*declined, eng->flushed, (u32)(eng_ms(io) - t0));
+
+	return 0;
+}
+
+/**
+ * ppe_sr_eng_verify_idle() - Read back everything S-R relies on (S8).
+ * @eng: The engine.
+ * @io: Register access.
+ *
+ * Under the lock, idle only: a full XLT scan. A mismatch while ACTIVE
+ * disarms (VERIFY); in READY or FAULT it is only said.
+ *
+ * Return: 0, -EBADMSG on a mismatch, -ENOENT when nothing is armed, or a
+ * read error.
+ */
+int ppe_sr_eng_verify_idle(struct ppe_sr_eng *eng, const struct ppe_sr_io *io)
+{
+	u8 state = eng->seq.state;
+	int ret;
+
+	if (!eng_armed(state) && state != PPE_SR_S_FAULT)
+		return -ENOENT;
+	ret = ppe_sr_seq_verify(&eng->seq, io, PPE_SR_VERIFY_IDLE);
+	if (ret == -EBADMSG && state == PPE_SR_S_ACTIVE)
+		ppe_sr_eng_disarm(eng, io, PPE_SR_T_VERIFY);
+
+	return ret;
+}
+
+/**
+ * ppe_sr_eng_conduit_gone() - The conduit is being unregistered.
+ * @eng: The engine.
+ * @io: Register access, flows and the state word.
+ *
+ * Under RTNL and the lock. Armed, it disarms (CONDUIT_GONE). In FAULT,
+ * nothing is written and the claim stays, but the reference must go for
+ * the unregister to complete (D13); the FAULT record stays.
+ *
+ * Return: whether the caller must drop its reference on the conduit now.
+ */
+bool ppe_sr_eng_conduit_gone(struct ppe_sr_eng *eng, const struct ppe_sr_io *io)
+{
+	switch (eng->seq.state) {
+	case PPE_SR_S_OFF:
+		return false;
+	case PPE_SR_S_FAULT:
+		break;
+	default:
+		ppe_sr_eng_disarm(eng, io, PPE_SR_T_CONDUIT_GONE);
+		if (eng->seq.state == PPE_SR_S_OFF)
+			return true;
+		if (eng->seq.state != PPE_SR_S_FAULT)
+			return false;
+		break;
+	}
+
+	if (eng->conduit_gone)
+		return false;
+	eng->conduit_gone = 1;
+	eng_log(io, PPE_SR_LOG_WARN,
+		"conduit gone while in FAULT: its reference dropped, the claim and the registers kept");
+
+	return true;
+}
+
+/**
+ * ppe_sr_eng_td_fits() - Whether the switch is in step with the PPE state.
+ * @state: enum ppe_sr_state.
+ * @word: The rtl8_4s state word, -1 for no switch.
+ *
+ * Return: false if READY or ACTIVE while the word says otherwise (the
+ * switch left READY: only its REMOVE and SHUTDOWN can), true else.
+ */
+bool ppe_sr_eng_td_fits(u8 state, int word)
+{
+	switch (state) {
+	case PPE_SR_S_READY:
+		return word >= 0 && rtl8_4s_word_state(word) == RTL8_4S_ST_SR_READY;
+	case PPE_SR_S_ACTIVE:
+		return word >= 0 && rtl8_4s_word_state(word) == RTL8_4S_ST_ACTIVE;
+	default:
+		return true;
+	}
+}
+
+/**
+ * ppe_sr_eng_lost() - A statistics request found the switch's word
+ * (WP2-DESIGN D17).
+ * @eng: The engine.
+ * @word: The rtl8_4s state word, -1 for no switch.
+ *
+ * Under the lock, while ACTIVE. Memory only.
+ *
+ * Return: true when the disarm is to be queued (once until it ran).
+ */
+bool ppe_sr_eng_lost(struct ppe_sr_eng *eng, int word)
+{
+	if (eng->lost_queued || ppe_sr_eng_td_fits(eng->seq.state, word))
+		return false;
+	eng->lost_queued = 1;
+
+	return true;
+}
+
+/**
+ * ppe_sr_eng_lost_work() - The queued disarm (SWITCH_NOT_READY).
+ * @eng: The engine.
+ * @io: Register access, flows and the state word.
+ * @word: The rtl8_4s state word read now, -1 for no switch.
+ *
+ * Under the lock. Nothing if the switch is back in step (or S-R went off).
+ *
+ * Return: 0, or ppe_sr_eng_disarm()'s error.
+ */
+int ppe_sr_eng_lost_work(struct ppe_sr_eng *eng, const struct ppe_sr_io *io, int word)
+{
+	eng->lost_queued = 0;
+	if (ppe_sr_eng_td_fits(eng->seq.state, word))
+		return 0;
+	if (word < 0)
+		eng_log(io, PPE_SR_LOG_WARN, "switch gone: disarming");
+	else
+		eng_log(io, PPE_SR_LOG_WARN, "switch left READY (state word %#x): disarming",
+			(unsigned int)word);
+
+	return ppe_sr_eng_disarm(eng, io, PPE_SR_T_SWITCH_NOT_READY);
+}
+
+/**
+ * ppe_sr_eng_rebind() - Whether a port's L3 binding may be written
+ * (WP2-DESIGN §5.3).
+ * @eng: The engine.
+ * @port: The PPE port.
+ *
+ * Under the lock. While S-R is not off (FAULT included) the conduit's
+ * binding is S-R's: not written, counted.
+ *
+ * Return: true if the binding may be written.
+ */
+bool ppe_sr_eng_rebind(struct ppe_sr_eng *eng, u32 port)
+{
+	if (eng->seq.state == PPE_SR_S_OFF || port != eng->seq.cfg.ppe_port)
+		return true;
+	eng->rebind_skipped++;
+
+	return false;
+}
+
+/**
+ * ppe_sr_eng_boot_check() - S-R's registers at their base at enable (S9).
+ * @eng: The engine, off.
+ * @io: Register access.
+ * @ppe_port: A PPE port a conduit could be on.
+ *
+ * Under RTNL and the lock, at enable. A port not at base (left by an S-R
+ * mode that never disarmed) refuses S-R until reboot; E is not affected.
+ *
+ * Return: 0, or ppe_sr_seq_boot_check()'s error.
+ */
+int ppe_sr_eng_boot_check(struct ppe_sr_eng *eng, const struct ppe_sr_io *io, u8 ppe_port)
+{
+	int ret;
+
+	if (eng->seq.state != PPE_SR_S_OFF)
+		return 0;
+	ret = ppe_sr_seq_boot_check(io, ppe_port);
+	if (!ret || eng->inert_fail)
+		return ret;
+	eng->inert_fail = 1;
+	eng->seq.fault = PPE_SR_F_NOT_INERT_AT_BOOT;
+	eng->seq.fault_err = ret;
+
+	return ret;
+}
+
+static bool eng_class_ok(const struct ppe_sr_class *c)
+{
+	return c->port < PPE_SR_PORTS && (c->form == PPE_SR_U || c->form == PPE_SR_T) &&
+	       c->vid && c->vid < 4095 && !rtl8_4s_vid_reserved(c->vid);
+}
+
+/**
+ * ppe_sr_scope_check() - Whether a scope is well formed.
+ * @scope: The scope.
+ *
+ * Return: 0, or -EINVAL for too many entries, classes not sorted or
+ * repeated, or a class no resolver makes.
+ */
+int ppe_sr_scope_check(const struct ppe_sr_scope *scope)
+{
+	unsigned int i;
+
+	if (scope->ncls > PPE_SR_SCOPE_CLS_MAX || scope->nclients > PPE_SR_SCOPE_CLIENTS_MAX)
+		return -EINVAL;
+	for (i = 0; i < scope->ncls; i++)
+		if (!eng_class_ok(&scope->cls[i]) ||
+		    (i && ppe_sr_class_cmp(&scope->cls[i - 1], &scope->cls[i]) >= 0))
+			return -EINVAL;
+
+	return 0;
+}
+
+/**
+ * ppe_sr_scope_has() - Whether a class is in scope.
+ * @scope: A scope that passed ppe_sr_scope_check(), or NULL (none).
+ * @cls: The class.
+ *
+ * Return: true if listed.
+ */
+bool ppe_sr_scope_has(const struct ppe_sr_scope *scope, const struct ppe_sr_class *cls)
+{
+	unsigned int lo = 0, hi;
+
+	if (!scope)
+		return false;
+	hi = scope->ncls < PPE_SR_SCOPE_CLS_MAX ? scope->ncls : PPE_SR_SCOPE_CLS_MAX;
+	while (lo < hi) {
+		unsigned int mid = lo + (hi - lo) / 2;
+		int c = ppe_sr_class_cmp(&scope->cls[mid], cls);
+
+		if (!c)
+			return true;
+		if (c < 0)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+
+	return false;
+}
+
+/**
+ * ppe_sr_scope_client() - Whether a client address is in scope.
+ * @scope: The scope, or NULL (none).
+ * @client: The address.
+ *
+ * Return: true if every client is, or this one is listed.
+ */
+bool ppe_sr_scope_client(const struct ppe_sr_scope *scope, __be32 client)
+{
+	unsigned int i, n;
+
+	if (!scope)
+		return false;
+	if (scope->any_client)
+		return true;
+	n = scope->nclients < PPE_SR_SCOPE_CLIENTS_MAX ? scope->nclients :
+	    PPE_SR_SCOPE_CLIENTS_MAX;
+	for (i = 0; i < n; i++)
+		if (scope->clients[i] == client)
+			return true;
+
+	return false;
+}
+
+struct eng_plan_ctx {
+	const struct ppe_sr_scope *scope;
+	bool u_uploads;
+};
+
+static bool eng_in_scope(const void *ctx, const struct ppe_sr_class *cls)
+{
+	const struct eng_plan_ctx *p = ctx;
+
+	return (cls->form != PPE_SR_U || p->u_uploads) && ppe_sr_scope_has(p->scope, cls);
+}
+
+/**
+ * ppe_sr_eng_plan() - The classes to give an identity (WP2-DESIGN D2, D4).
+ * @topo: The topology.
+ * @scope: The scope; NULL gives none.
+ * @u_uploads: U classes get identities (qcom_ppe.sr_u_uploads; without,
+ * U-class uploads decline and downloads are not affected).
+ * @plan: Filled with the classes, in @topo order.
+ * @max: Room in @plan.
+ * @wanted: Set to the number of classes the plan should have.
+ *
+ * Return: the classes written, at most @max.
+ */
+unsigned int ppe_sr_eng_plan(const struct ppe_sr_topo *topo, const struct ppe_sr_scope *scope,
+			     bool u_uploads, struct ppe_sr_class *plan, unsigned int max,
+			     unsigned int *wanted)
+{
+	const struct eng_plan_ctx p = { .scope = scope, .u_uploads = u_uploads };
+
+	*wanted = 0;
+	if (!scope)
+		return 0;
+
+	return ppe_sr_topo_plan(topo, eng_in_scope, &p, plan, max, wanted);
+}
+
+/**
+ * ppe_sr_deadline_cap() - The deadline of an arm.
+ * @now: Jiffies now.
+ * @want: The deadline asked for.
+ * @disarm_at: The switch's own deadline (rtl8_4s_tagger_data::disarm_at,
+ * never 0 while it is armed).
+ * @margin: How long before @disarm_at the PPE's must be at the latest.
+ * @min_left: How long the result must at least leave from @now.
+ * @deadline: Set to @want, capped at @disarm_at - @margin; never 0.
+ *
+ * Every comparison holds across a jiffies wrap.
+ *
+ * Return: 0, or -ERANGE if the switch is not armed or less than @min_left
+ * would be left.
+ */
+int ppe_sr_deadline_cap(unsigned long now, unsigned long want, unsigned long disarm_at,
+			unsigned long margin, unsigned long min_left, unsigned long *deadline)
+{
+	unsigned long cap = disarm_at - margin, dl = want;
+
+	if (!disarm_at)
+		return -ERANGE;
+	if (eng_before(cap, dl))
+		dl = cap;
+	if (!dl)
+		dl--;
+	if (eng_before(dl, now + min_left))
+		return -ERANGE;
+	*deadline = dl;
+
+	return 0;
+}
+
+/**
+ * ppe_sr_deadline_fwd() - A later deadline for an armed S-R mode.
+ * @now: Jiffies now.
+ * @cur: The deadline in force.
+ * @want: The one asked for.
+ * @disarm_at: The switch's own deadline, as extended (WP3).
+ * @margin: As for ppe_sr_deadline_cap().
+ * @deadline: Set to @want capped, which is not before @cur.
+ *
+ * Return: 0, or -ERANGE if the result would be before @cur or @now, or the
+ * switch is not armed.
+ */
+int ppe_sr_deadline_fwd(unsigned long now, unsigned long cur, unsigned long want,
+			unsigned long disarm_at, unsigned long margin, unsigned long *deadline)
+{
+	unsigned long dl;
+	int ret;
+
+	ret = ppe_sr_deadline_cap(now, want, disarm_at, margin, 0, &dl);
+	if (ret)
+		return ret;
+	if (eng_before(dl, cur))
+		return -ERANGE;
+	*deadline = dl;
+
+	return 0;
+}
