 static void ppe_offload_strip_work(struct work_struct *work);
 static void ppe_offload_pin_timeout(struct work_struct *work);
 
+/**
+ * ppe_offload_set_degraded() - Latch priv->degraded (WP2-DESIGN D13).
+ * @priv: The offload.
+ *
+ * Every site that latches it, or loses a flow entry, goes through here, so
+ * that while the S-R mode is not off it moves to FAULT: its claim and its
+ * registers stay as they are until reboot. Under priv->lock.
+ */
+void ppe_offload_set_degraded(struct ppe_offload_priv *priv)
+{
+	lockdep_assert_held(&priv->lock);
+
+	priv->degraded = true;
+	ppe_sr_degraded(&priv->sr);
+}
+
+/**
+ * ppe_offload_sr() - The S-R mode of an offload.
+ * @priv: The offload.
+ *
+ * Return: its struct ppe_sr.
+ */
+struct ppe_sr *ppe_offload_sr(struct ppe_offload_priv *priv)
+{
+	return &priv->sr;
+}
+
 /* Let go of the table entries a flow points at. Under priv->lock. */
