+/**
+ * struct ppe_sr_eng - The S-R mode in memory (WP2-DESIGN §6.2's struct
+ * ppe_sr, but for what only the kernel holds).
+ * @seq: The sequences' state: the state, the write records, the
+ * identities and the FAULT record.
+ * @gen: Bumped under the lock by every change an offer depends on (every
+ * state change, a topology event, a resync, a scope change, a publish);
+ * read lockless with acquire (ppe_sr_eng_gen()).
+ * @dirty: The topology of every port may have changed: offers wait for
+ * the resync.
+ * @dirty_ports: The switch ports whose topology may have changed.
+ * @recopy: The conduit's L3 interface changed: the resync rewrites every
+ * identity's copy.
+ * @inert_fail: The boot check found S-R registers not at their base: S-R
+ * is refused until reboot.
+ * @lost_queued: A check found the switch out of step with the state; the
+ * disarm (SWITCH_NOT_READY) is queued.
+ * @conduit_gone: The conduit went away in FAULT and its reference was
+ * dropped; the FAULT record stays.
+ * @in_seq: A sequence is running: a degraded latch inside it is acted on
+ * when it returns, if its flush did not report it (ppe_sr_eng_flush_stuck()).
+ * @degraded_in_seq: Such a latch happened.
+ * @latched: Degraded latches seen, for ppe_sr_eng_flush_stuck().
+ * @s_ports: The switch's S-R port mask, fixed at arm.
+ * @bridge_ifindex: The S-R bridge, fixed at arm; 0 for none.
+ * @deadline: Jiffies at which the S-R mode is to be disarmed (WP3).
+ * @flushed: Flows the io's flush dropped since the transition began (the
+ * io adds to it).
+ * @arm_ok: Arms that reached READY.
+ * @arm_refused: Arms refused or failed, by enum ppe_sr_why.
+ * @trig: Disarms run, by enum ppe_sr_trigger.
+ * @resyncs: Resyncs applied.
+ * @resync_declined: Classes resyncs left without an identity.
+ * @rebind_skipped: Conduit L3 bindings not written because S-R holds the
+ * port (ppe_sr_eng_rebind()).
+ * @last: The last arm or disarm.
+ */
+struct ppe_sr_eng {
+	struct ppe_sr_seq seq;
+	u32 gen;
+	u8 dirty;
+	u16 dirty_ports;
+	u8 recopy;
+	u8 inert_fail;
+	u8 lost_queued;
+	u8 conduit_gone;
+	u8 in_seq;
+	u8 degraded_in_seq;
+	u32 latched;
+	u16 s_ports;
+	int bridge_ifindex;
+	unsigned long deadline;
+	u32 flushed;
+	u32 arm_ok;
+	u32 arm_refused[PPE_SR_W_NUM];
+	u32 trig[PPE_SR_T_NUM];
+	u32 resyncs;
+	u32 resync_declined;
+	u32 rebind_skipped;
+	struct ppe_sr_last last;
+};
