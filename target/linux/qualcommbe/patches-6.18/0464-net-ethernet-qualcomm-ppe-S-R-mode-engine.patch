+ * Taken lockless (ppe_sr_eng_ticket()) when the offer starts; the offer
+ * may write hardware only if ppe_sr_eng_ticket_ok() still holds under the
+ * lock, so that nothing judged under one mode is added under another.
+ */
+struct ppe_sr_ticket {
+	u32 gen;
