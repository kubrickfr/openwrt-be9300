+/* A topology event concerning every switch port (the bridge itself). */
+#define PPE_SR_PORTS_ALL		((u16)((1U << PPE_SR_PORTS) - 1))
+
+/* The PPE's deadline ends at least this long before the switch's own
+ * (rtl8_4s_tagger_data::disarm_at), and an arm leaves it at least
+ * PPE_SR_DEADLINE_MIN_S (WP2-DESIGN §6.4, WP1-DESIGN:41).
+ */
+#define PPE_SR_DEADLINE_MARGIN_S	30
+#define PPE_SR_DEADLINE_MIN_S		60
+
+/* A scope lists at most this many classes and client addresses. */
+#define PPE_SR_SCOPE_CLS_MAX		PPE_SR_CLS_MAX
+#define PPE_SR_SCOPE_CLIENTS_MAX	64
+
+/**
+ * struct ppe_sr_scope - What S-R may offload (WP2-DESIGN D2, §6.4).
+ * @ncls: Entries of @cls.
+ * @cls: The classes that get an identity and whose flows may be offered,
+ * sorted (ppe_sr_class_cmp()), without duplicates.
+ * @any_client: Every client address is in scope.
+ * @nclients: Entries of @clients.
+ * @clients: Else the client addresses in scope: a LAN host, the source of
+ * an upload and the translated destination of a download.
+ *
+ * Set by WP3's control through ppe_sr_scope_set(); none denies every
+ * class and gives no identity.
+ */
+struct ppe_sr_scope {
+	unsigned int ncls;
+	struct ppe_sr_class cls[PPE_SR_SCOPE_CLS_MAX];
+	bool any_client;
+	unsigned int nclients;
+	__be32 clients[PPE_SR_SCOPE_CLIENTS_MAX];
+};
